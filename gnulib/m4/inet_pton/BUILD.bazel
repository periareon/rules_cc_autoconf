"""https://github.com/coreutils/gnulib/blob/1039a5f2cee3cda1c11f64a5eb3a15b2e87cd2f0/m4/inet_pton.m4"""

load("//autoconf:autoconf_toolchain.bzl", autoconf = "autoconf_cache")
load("//autoconf:checks.bzl", "checks")

# Prologue of the AC_CHECK_DECLS([inet_pton]) probes.  The m4 uses
# <ws2tcpip.h> on native Windows and <arpa/inet.h> (+ <netdb.h>) elsewhere;
# the HAVE_* guards come from compile_defines.
_DECL_INCLUDES = [
    "#if HAVE_WINSOCK2_H",
    "# include <ws2tcpip.h>",
    "#else",
    "# include <arpa/inet.h>",
    "# if HAVE_NETDB_H",
    "#  include <netdb.h>",
    "# endif",
    "#endif",
]

# gl_FUNC_INET_PTON
autoconf(
    name = "gl_FUNC_INET_PTON",
    checks = [
        # HAVE_INET_PTON=1
        # INET_PTON_LIB=
        # gl_PREREQ_SYS_H_WINSOCK2
        # if test $HAVE_WINSOCK2_H = 1; then
        #   dnl Native Windows provides it in -lws2_32 with stdcall calling
        #   dnl convention: REPLACE_INET_PTON=1, and if <ws2tcpip.h> declares it
        #   dnl INET_PTON_LIB="-lws2_32" else HAVE_DECL_INET_PTON=0.
        # else
        #   AC_SEARCH_LIBS([inet_pton], [nsl resolv network socket], [],
        #     [AC_CHECK_FUNCS([inet_pton]); if no: HAVE_INET_PTON=0])
        #   AC_CHECK_HEADERS_ONCE([netdb.h])
        #   AC_CHECK_DECLS([inet_pton]) with <arpa/inet.h> and <netdb.h>
        #   if no: HAVE_DECL_INET_PTON=0
        # fi
        # (On glibc/macOS inet_pton is in libc, so INET_PTON_LIB stays empty.)
        checks.AC_CHECK_FUNC(
            "inet_pton",
            name = "_gl_cv_func_inet_pton",
            requires = ["HAVE_WINSOCK2_H==0"],
        ),
        checks.AC_SUBST(
            "HAVE_INET_PTON",
            condition = "HAVE_WINSOCK2_H==1 || _gl_cv_func_inet_pton",
            if_false = "0",
            if_true = "1",
        ),
        # (The probe is not gated on the Unix branch: on native Windows the
        # header is absent, so the result is the same #undef, and the ungated
        # probe shares its result with gl_NETDB_H.)
        checks.AC_CHECK_HEADER(
            "netdb.h",
            define = "HAVE_NETDB_H",
        ),
        checks.AC_CHECK_DECL(
            "inet_pton",
            compile_defines = [
                "HAVE_WINSOCK2_H",
                "HAVE_NETDB_H",
            ],
            define = "HAVE_DECL_INET_PTON",
            includes = _DECL_INCLUDES,
        ),
        checks.AC_SUBST(
            "HAVE_DECL_INET_PTON",
            condition = "ac_cv_have_decl_inet_pton",
            if_false = "0",
            if_true = "1",
        ),
        checks.AC_SUBST(
            "INET_PTON_LIB",
            condition = "HAVE_WINSOCK2_H==1 && ac_cv_have_decl_inet_pton",
            if_false = "",
            if_true = "-lws2_32",
        ),
        checks.AC_SUBST(
            "REPLACE_INET_PTON",
            condition = "HAVE_WINSOCK2_H==1",
            if_false = "0",
            if_true = "1",
        ),
    ],
    visibility = ["//visibility:public"],
    deps = [
        # AC_REQUIRE([gl_ARPA_INET_H_DEFAULTS]) is satisfied by the toolchain.
        "//autoconf/macros/AC_CHECK_INCLUDES_DEFAULT",
        "//gnulib/m4/extensions",
        "//autoconf/macros/AC_C_RESTRICT",
        # gl_PREREQ_SYS_H_WINSOCK2 (HAVE_WINSOCK2_H)
        "//gnulib/m4/sys_socket_h:gl_PREREQ_SYS_H_WINSOCK2",
    ],
)

# gl_PREREQ_INET_PTON - AC_REQUIRE([gl_SOCKET_FAMILIES])
autoconf(
    name = "gl_PREREQ_INET_PTON",
    visibility = ["//visibility:public"],
    deps = [
        "//gnulib/m4/sockpfaf:gl_SOCKET_FAMILIES",
    ],
)

# Package-level aggregator (matches package name).
autoconf(
    name = "inet_pton",
    visibility = ["//visibility:public"],
    deps = [
        ":gl_FUNC_INET_PTON",
        ":gl_PREREQ_INET_PTON",
    ],
)
