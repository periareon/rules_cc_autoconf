"""https://github.com/coreutils/gnulib/blob/1039a5f2cee3cda1c11f64a5eb3a15b2e87cd2f0/m4/remove.m4"""

load("//autoconf:autoconf_toolchain.bzl", autoconf = "autoconf_cache")
load("//autoconf:checks.bzl", "checks")

autoconf(
    name = "gl_FUNC_REMOVE",
    checks = [
        # gl_FUNC_REMOVE: REPLACE_REMOVE=1 unless both gl_cv_func_rmdir_works
        # and gl_cv_func_unlink_honors_slashes are "yes"; in that case an
        # AC_RUN_IFELSE probe checks that remove() handles directories
        # (M4 guesses "no" on mingw/windows, "yes" elsewhere - and the two
        # cache variables are already "no" on native Windows).
        checks.AC_SUBST(
            "REPLACE_REMOVE",
            condition = "!gl_cv_func_rmdir_works || !gl_cv_func_unlink_honors_slashes",
        ),
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//autoconf/macros/AC_CANONICAL_HOST",  # AC_REQUIRE([AC_CANONICAL_HOST])
        "//gnulib/m4/rmdir",  # AC_REQUIRE([gl_FUNC_RMDIR])
        # Note: gl_STDIO_H_DEFAULTS is a _DEFAULTS function, so we don't track it as a dependency
        "//gnulib/m4/unlink",  # AC_REQUIRE([gl_FUNC_UNLINK])
    ],
)

autoconf(
    name = "remove",
    visibility = ["//visibility:public"],
    deps = [
        ":gl_FUNC_REMOVE",
    ],
)
