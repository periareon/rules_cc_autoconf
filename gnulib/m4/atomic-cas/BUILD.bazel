"""https://github.com/coreutils/gnulib/blob/1039a5f2cee3cda1c11f64a5eb3a15b2e87cd2f0/m4/atomic-cas.m4"""

load("//autoconf:autoconf_toolchain.bzl", autoconf = "autoconf_cache")
load("//autoconf:checks.bzl", "checks")

autoconf(
    name = "gl_ATOMIC_COMPARE_AND_SWAP",
    checks = [
        # gl_ATOMIC_COMPARE_AND_SWAP: AC_LINK_IFELSE, not just a compile test.
        # MSVC compiles the call as an implicit declaration (C4013) and only
        # the link step reveals that __sync_val_compare_and_swap is missing.
        checks.AC_TRY_LINK(
            name = "gl_cv_builtin_sync_bool_compare_and_swap",
            code = """int cmpxchg (int* value, int comp_val, int new_val)
{
    return __sync_val_compare_and_swap (value, comp_val, new_val);
}

int main(void) {
    int x = 0;
    return cmpxchg(&x, 0, 1);
}""",
            language = "c",
        ),
        checks.AC_DEFINE(
            "HAVE_ATOMIC_COMPARE_AND_SWAP_GCC41",
            condition = "gl_cv_builtin_sync_bool_compare_and_swap",
            if_false = None,
            if_true = 1,
        ),
    ],
    visibility = ["//visibility:public"],
)

autoconf(
    name = "atomic-cas",
    visibility = ["//visibility:public"],
    deps = [
        ":gl_ATOMIC_COMPARE_AND_SWAP",
    ],
)
