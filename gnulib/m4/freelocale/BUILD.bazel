"""https://github.com/coreutils/gnulib/blob/1039a5f2cee3cda1c11f64a5eb3a15b2e87cd2f0/m4/freelocale.m4"""

load("//autoconf:autoconf_toolchain.bzl", autoconf = "autoconf_cache")
load("//autoconf:checks.bzl", "checks")
load("//gnulib:macros.bzl", gl_macros = "macros")

autoconf(
    name = "gl_FUNC_FREELOCALE",
    # if test $HAVE_LOCALE_T = 1; then
    #   gl_CHECK_FUNCS_ANDROID([freelocale], [[#include <locale.h>]])
    # else  (e.g. MSVC: no locale_t)
    #   gl_cv_onwards_func_freelocale='future OS version'; gl_func_freelocale=no
    # fi
    # The probe calls freelocale through <locale.h> (like the newlocale port)
    # so that platforms with availability-guarded prototypes link reliably.
    checks = gl_macros.GL_CHECK_FUNCS_ANDROID(
        ["freelocale"],
        code = """#include <locale.h>
int main(void) {
    freelocale((locale_t)0);
    return 0;
}
""",
        requires = ["HAVE_LOCALE_T==1"],
    ) + [
        # if test $gl_func_freelocale != yes; then HAVE_FREELOCALE=0
        # (overrides the gl_LOCALE_H_DEFAULTS value of 1)
        checks.AC_SUBST(
            "HAVE_FREELOCALE",
            condition = "ac_cv_func_freelocale",
            if_false = "0",
            if_true = "1",
        ),
        #   case "$gl_cv_onwards_func_freelocale" in future*) REPLACE_FREELOCALE=1
        # The "future OS version" value only arises here when locale_t is missing.
        checks.AC_SUBST(
            "REPLACE_FREELOCALE",
            condition = "HAVE_LOCALE_T==0",
            if_false = "0",
            if_true = "1",
        ),
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//autoconf/macros/AC_CHECK_INCLUDES_DEFAULT",
        "//gnulib/m4/extensions",
        "//gnulib/m4/locale_h:gl_LOCALE_T",
    ],
)

autoconf(
    name = "gl_PREREQ_FREELOCALE",
    visibility = ["//visibility:public"],
)

autoconf(
    name = "freelocale",
    visibility = ["//visibility:public"],
    deps = [
        ":gl_FUNC_FREELOCALE",
        ":gl_PREREQ_FREELOCALE",
    ],
)
