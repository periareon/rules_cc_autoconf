"""https://github.com/coreutils/gnulib/blob/1039a5f2cee3cda1c11f64a5eb3a15b2e87cd2f0/m4/mntent_h.m4"""

load("//autoconf:autoconf_defaults.bzl", "autoconf_defaults")
load("//autoconf:autoconf_toolchain.bzl", autoconf = "autoconf_cache")
load("//autoconf:checks.bzl", "checks", "macros")

autoconf(
    name = "gl_MNTENT_H",
    # From mntent_h.m4:
    #   if test $ac_cv_header_mntent_h = yes; then
    #     gl_CHECK_NEXT_HEADERS([mntent.h])
    #   fi
    # This means:
    # - Check if mntent.h exists
    # - Set NEXT_* to "<mntent.h>" if header exists (Linux)
    # - Set NEXT_* to "" if header doesn't exist (macOS)
    checks = [
        # Use conditional AC_SUBST: "<mntent.h>" when exists, "" when doesn't
        checks.AC_SUBST(
            "NEXT_MNTENT_H",
            condition = "ac_cv_header_mntent_h",
            if_false = "",
            if_true = "<mntent.h>",
        ),
        checks.AC_SUBST(
            "NEXT_AS_FIRST_DIRECTIVE_MNTENT_H",
            condition = "ac_cv_header_mntent_h",
            if_false = "",
            if_true = "<mntent.h>",
        ),
    ],
    default_deps = [
        ":defaults",  # AC_REQUIRE: gl_MNTENT_H_DEFAULTS
    ],
    visibility = ["//visibility:public"],
    deps = [
        ":HAVE_MNTENT_H",  # AC_CHECK_HEADERS_ONCE([mntent.h])
        "//autoconf/macros/AC_CHECK_INCLUDES_DEFAULT",
        "//gnulib/m4/include_next",  # Required for INCLUDE_NEXT variables
    ],
)

# AC_CHECK_HEADERS_ONCE([mntent.h]) on its own: modules such as nproc and
# mountlist only probe the header and must not inherit gl_MNTENT_H's defaults.
autoconf(
    name = "HAVE_MNTENT_H",
    checks = macros.AC_CHECK_HEADERS(["mntent.h"]),
    visibility = ["//visibility:public"],
)

# From mntent_h.m4: "Assume proper GNU behavior unless another module says otherwise"
autoconf_defaults(
    name = "gl_MNTENT_H_DEFAULTS",
    substs = {
        "HAVE_HASMNTOPT": "1",
        "HAVE_SETMNTENT": "1",
        "REPLACE_HASMNTOPT": "0",
    },
    visibility = ["//visibility:public"],
)

autoconf_defaults(
    name = "gl_MNTENT_H_REQUIRE_DEFAULTS",
    substs = {
        "GNULIB_HASMNTOPT": "0",
    },
    visibility = ["//visibility:private"],
    deps = [
        ":gl_MNTENT_H_DEFAULTS",
    ],
)

autoconf_defaults(
    name = "defaults",
    visibility = ["//visibility:public"],
    deps = [
        ":gl_MNTENT_H_REQUIRE_DEFAULTS",
    ],
)

autoconf(
    name = "mntent_h",
    default_deps = [
        ":defaults",  # the header's own defaults, as its m4 requires
    ],
    visibility = ["//visibility:public"],
    deps = [
        ":gl_MNTENT_H",
    ],
)
