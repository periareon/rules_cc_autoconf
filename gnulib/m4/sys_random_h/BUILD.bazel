"""https://github.com/coreutils/gnulib/blob/1039a5f2cee3cda1c11f64a5eb3a15b2e87cd2f0/m4/sys_random_h.m4"""

load("//autoconf:autoconf_defaults.bzl", "autoconf_defaults")
load("//autoconf:autoconf_toolchain.bzl", autoconf = "autoconf_cache")
load("//autoconf:checks.bzl", "checks")
load("//gnulib:macros.bzl", gl_macros = "macros")

autoconf(
    name = "gl_SYS_RANDOM_H",
    checks = [
        checks.AC_CHECK_HEADER(
            "sys/random.h",
            define = "HAVE_SYS_RANDOM_H",
            subst = "HAVE_SYS_RANDOM_H",
        ),
    ] + gl_macros.GL_CHECK_NEXT_HEADERS(["sys/random.h"]) + [
        # if test $ac_cv_header_sys_random_h = yes; then UNISTD_H_HAVE_SYS_RANDOM_H=1
        # (otherwise the gl_UNISTD_H_DEFAULTS value of 0 remains)
        checks.AC_SUBST(
            "UNISTD_H_HAVE_SYS_RANDOM_H",
            condition = "ac_cv_header_sys_random_h",
            if_false = "0",
            if_true = "1",
        ),
        # On macOS, sys/random.h exists but getrandom is not declared
        # The golden file shows HAVE_GETRANDOM is undefined
    ],
    default_deps = [
        "//gnulib/m4/unistd_h:defaults",  # AC_REQUIRE: gl_UNISTD_H_DEFAULTS
        ":defaults",  # AC_REQUIRE: gl_SYS_RANDOM_H_DEFAULTS
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//autoconf/macros/AC_CHECK_INCLUDES_DEFAULT",
        "//gnulib/m4/include_next",  # gl_CHECK_NEXT_HEADERS([sys/random.h])
    ],
)

autoconf_defaults(
    name = "gl_SYS_RANDOM_H_DEFAULTS",
    substs = {
        "HAVE_GETRANDOM": "1",
        "REPLACE_GETRANDOM": "0",
    },
    visibility = ["//visibility:private"],
)

autoconf_defaults(
    name = "gl_SYS_RANDOM_H_REQUIRE_DEFAULTS",
    substs = {
        "GNULIB_GETRANDOM": "0",
    },
    visibility = ["//visibility:private"],
    deps = [
        ":gl_SYS_RANDOM_H_DEFAULTS",
    ],
)

autoconf_defaults(
    name = "defaults",
    visibility = ["//visibility:public"],
    deps = [
        ":gl_SYS_RANDOM_H_REQUIRE_DEFAULTS",
    ],
)

# gl_SYS_RANDOM_MODULE_INDICATOR([modulename]): gl_SYS_RANDOM_H_REQUIRE_DEFAULTS (the
# defaults are supplied through the toolchain's :defaults target) and
# GNULIB_<module>=1 for the named module; no checks of its own.
autoconf(
    name = "gl_SYS_RANDOM_MODULE_INDICATOR",
    checks = [],
    default_deps = [
        ":defaults",  # through a macro it invokes: gl_SYS_RANDOM_H_DEFAULTS
    ],
    visibility = ["//visibility:public"],
)

autoconf(
    name = "sys_random_h",
    default_deps = [
        ":defaults",  # the header's own defaults, as its m4 requires
    ],
    visibility = ["//visibility:public"],
    deps = [
        ":gl_SYS_RANDOM_H",
        ":gl_SYS_RANDOM_MODULE_INDICATOR",
    ],
)
