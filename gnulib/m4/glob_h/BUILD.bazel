"""https://github.com/coreutils/gnulib/blob/1039a5f2cee3cda1c11f64a5eb3a15b2e87cd2f0/m4/glob_h.m4"""

load("//autoconf:autoconf_defaults.bzl", "autoconf_defaults")
load("//autoconf:autoconf_toolchain.bzl", autoconf = "autoconf_cache")
load("//autoconf:checks.bzl", "checks")
load("//gnulib:macros.bzl", gl_macros = "macros")

# gl_GLOB_H - Header check and GNULIB module indicators

autoconf(
    name = "glob_h",
    checks = [
        checks.AC_CHECK_HEADER(
            "glob.h",
            define = "HAVE_GLOB_H",
            subst = True,
        ),
    ] + gl_macros.GL_CHECK_NEXT_HEADERS(["glob.h"]),
    default_deps = [
        ":defaults",  # the header's own defaults, as its m4 requires
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//gnulib/m4/include_next",
        # Note: AC_CHECK_INCLUDES_DEFAULT is added for test compatibility
        "//autoconf/macros/AC_CHECK_INCLUDES_DEFAULT",
    ],
)

autoconf_defaults(
    name = "gl_GLOB_H_DEFAULTS",
    substs = {
        "HAVE_GLOB": "1",
        "HAVE_GLOB_PATTERN_P": "1",
        "REPLACE_GLOB": "0",
        "REPLACE_GLOB_PATTERN_P": "0",
    },
    visibility = ["//visibility:private"],
)

autoconf_defaults(
    name = "gl_GLOB_H_REQUIRE_DEFAULTS",
    substs = {
        "GNULIB_GLOB": "0",
    },
    visibility = ["//visibility:private"],
    deps = [
        ":gl_GLOB_H_DEFAULTS",
    ],
)

autoconf_defaults(
    name = "defaults",
    visibility = ["//visibility:public"],
    deps = [
        ":gl_GLOB_H_REQUIRE_DEFAULTS",
    ],
)
