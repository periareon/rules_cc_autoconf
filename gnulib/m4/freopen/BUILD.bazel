"""https://github.com/coreutils/gnulib/blob/1039a5f2cee3cda1c11f64a5eb3a15b2e87cd2f0/m4/freopen.m4"""

load("//autoconf:autoconf_toolchain.bzl", autoconf = "autoconf_cache")
load("//autoconf:checks.bzl", "checks")

autoconf(
    name = "gl_FUNC_FREOPEN",
    checks = select({
        # case "$host_os" in
        #   mingw* | windows* | pw* | os2*) REPLACE_FREOPEN=1 ;;
        "@platforms//os:windows": [
            checks.AC_SUBST("REPLACE_FREOPEN", 1),
        ],
        #   *) AC_CACHE_CHECK([whether freopen works on closed fds],
        #        [gl_cv_func_freopen_works_on_closed], [AC_RUN_IFELSE(...)])
        # The runtime test passes on glibc and macOS, so REPLACE_FREOPEN keeps
        # its gl_STDIO_H_DEFAULTS value of 0.
        "//conditions:default": [],
    }),
    visibility = ["//visibility:public"],
    deps = [
        "//autoconf/macros/AC_CANONICAL_HOST",  # AC_REQUIRE([AC_CANONICAL_HOST])
    ],
)

# AC_DEFUN([gl_PREREQ_FREOPEN], [:])
autoconf(
    name = "gl_PREREQ_FREOPEN",
    checks = [],
    visibility = ["//visibility:public"],
)

autoconf(
    name = "freopen",
    visibility = ["//visibility:public"],
    deps = [
        ":gl_FUNC_FREOPEN",
        ":gl_PREREQ_FREOPEN",
    ],
)
