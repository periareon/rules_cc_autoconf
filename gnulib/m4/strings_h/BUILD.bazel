"""https://github.com/coreutils/gnulib/blob/1039a5f2cee3cda1c11f64a5eb3a15b2e87cd2f0/m4/strings_h.m4"""

load("//autoconf:autoconf_defaults.bzl", "autoconf_defaults")
load("//autoconf:autoconf_toolchain.bzl", autoconf = "autoconf_cache")
load("//autoconf:checks.bzl", "checks")
load("//gnulib:macros.bzl", gl_macros = "macros")

# gl_STRINGS_H - lines 11-32 (AC_DEFUN_ONCE)
# Configure a replacement for <strings.h>.
autoconf(
    name = "gl_STRINGS_H",
    checks = gl_macros.GL_CHECK_NEXT_HEADERS(["strings.h"]) + [
        # M4: if test $ac_cv_header_strings_h = yes; then HAVE_STRINGS_H=1
        #     else HAVE_STRINGS_H=0; fi; AC_SUBST([HAVE_STRINGS_H])
        # ac_cv_header_strings_h is populated by AC_CHECK_INCLUDES_DEFAULT,
        # which already runs AC_CHECK_HEADER("strings.h").
        checks.AC_SUBST(
            "HAVE_STRINGS_H",
            condition = "ac_cv_header_strings_h",
            if_false = "0",
            if_true = "1",
        ),
    ],
    default_deps = [
        ":defaults",  # AC_REQUIRE: gl_STRINGS_H_DEFAULTS
    ],
    visibility = ["//visibility:public"],
    deps = [
        # Provides ac_cv_header_strings_h (and AC_REQUIRE([gl_STRINGS_H_DEFAULTS])
        # is fulfilled by the toolchain-provided :defaults below).
        "//autoconf/macros/AC_CHECK_INCLUDES_DEFAULT",
        "//gnulib/m4/include_next",
    ],
)

# gl_STRINGS_H_DEFAULTS - lines 62-75
# Default AC_SUBST values; supplied to the toolchain so all consumers see them.
autoconf_defaults(
    name = "gl_STRINGS_H_DEFAULTS",
    substs = {
        "HAVE_DECL_STRNCASECMP": "1",
        # Assume proper GNU behavior unless another module says otherwise.
        "HAVE_FFS": "1",
        "HAVE_STRCASECMP": "1",
        "HAVE_STRCASECMP_L": "1",
        "HAVE_STRNCASECMP": "1",
        "HAVE_STRNCASECMP_L": "1",
        "REPLACE_STRCASECMP": "0",
        "REPLACE_STRCASECMP_L": "0",
        "REPLACE_STRNCASECMP": "0",
        "REPLACE_STRNCASECMP_L": "0",
    },
    visibility = ["//visibility:private"],
)

# gl_STRINGS_H_REQUIRE_DEFAULTS - lines 47-60
# Initializes the GNULIB_* module-indicator default values, then AC_REQUIREs
# gl_STRINGS_H_DEFAULTS.
autoconf_defaults(
    name = "gl_STRINGS_H_REQUIRE_DEFAULTS",
    substs = {
        "GNULIB_FFS": "0",
        "GNULIB_STRCASECMP": "0",
        "GNULIB_STRCASECMP_L": "0",
        "GNULIB_STRNCASECMP": "0",
        "GNULIB_STRNCASECMP_L": "0",
    },
    visibility = ["//visibility:private"],
    deps = [
        ":gl_STRINGS_H_DEFAULTS",
    ],
)

# Public defaults target consumed by //gnulib/toolchain.
autoconf_defaults(
    name = "defaults",
    visibility = ["//visibility:public"],
    deps = [
        ":gl_STRINGS_H_REQUIRE_DEFAULTS",
    ],
)

# Package-level aggregator (matches the package name). No checks - just deps
# on the AC_DEFUN targets, excluding *_DEFAULTS (provided by the toolchain).
autoconf(
    name = "strings_h",
    default_deps = [
        ":defaults",  # the header's own defaults, as its m4 requires
    ],
    visibility = ["//visibility:public"],
    deps = [
        ":gl_STRINGS_H",
    ],
)
