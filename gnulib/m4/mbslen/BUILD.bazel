"""https://github.com/coreutils/gnulib/blob/1039a5f2cee3cda1c11f64a5eb3a15b2e87cd2f0/m4/mbslen.m4"""

load("//autoconf:autoconf_toolchain.bzl", autoconf = "autoconf_cache")
load("//autoconf:checks.bzl", "checks", "macros")

autoconf(
    name = "gl_FUNC_MBSLEN",
    checks = macros.AC_CHECK_FUNCS(
        ["mbslen"],
    ) + [
        checks.AC_SUBST(
            "HAVE_MBSLEN",
            condition = "ac_cv_func_mbslen",
            if_false = 0,
            if_true = 1,
        ),
    ],
    default_deps = ["//gnulib/m4/string_h:defaults"],
    visibility = ["//visibility:public"],
)

autoconf(
    name = "mbslen",
    visibility = ["//visibility:public"],
    deps = [":gl_FUNC_MBSLEN"],
)
