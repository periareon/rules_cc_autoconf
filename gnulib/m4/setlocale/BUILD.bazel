"""https://github.com/coreutils/gnulib/blob/1039a5f2cee3cda1c11f64a5eb3a15b2e87cd2f0/m4/setlocale.m4"""

load("//autoconf:autoconf_toolchain.bzl", autoconf = "autoconf_cache")
load("//autoconf:checks.bzl", "checks")

autoconf(
    name = "gl_FUNC_SETLOCALE",
    checks = [
        # Library and replacement flags
        checks.AC_SUBST("LIB_SETLOCALE", ""),
        checks.AC_SUBST("SETLOCALE_LIB", ""),
        # NEED_SETLOCALE_MTSAFE=0
        # if test $SETLOCALE_NULL_ALL_MTSAFE = 0 || test $SETLOCALE_NULL_ONE_MTSAFE = 0; then
        #   NEED_SETLOCALE_MTSAFE=1
        # fi
        # (Linux/Windows: both 1 -> 0; macOS: SETLOCALE_NULL_ALL_MTSAFE=0 -> 1)
        checks.AC_DEFINE(
            "NEED_SETLOCALE_MTSAFE",
            condition = "SETLOCALE_NULL_ALL_MTSAFE==0 || SETLOCALE_NULL_ONE_MTSAFE==0",
            if_false = 0,
            if_true = 1,
        ),
        # if test $NEED_SETLOCALE_IMPROVED = 1 || test $NEED_SETLOCALE_MTSAFE = 1; then
        #   REPLACE_SETLOCALE=1
        # fi
        checks.AC_SUBST(
            "REPLACE_SETLOCALE",
            condition = "NEED_SETLOCALE_IMPROVED==1 || NEED_SETLOCALE_MTSAFE==1",
            if_false = "0",
            if_true = "1",
        ),
    ] + select({
        # NEED_SETLOCALE_IMPROVED=0
        # case "$host_os" in
        #   mingw* | windows*) NEED_SETLOCALE_IMPROVED=1 ;;  (setlocale is buggy)
        #   *-android*)        NEED_SETLOCALE_IMPROVED=1 ;;
        # esac
        "@platforms//os:windows": [
            checks.AC_DEFINE("NEED_SETLOCALE_IMPROVED", 1),
        ],
        "//conditions:default": [
            checks.AC_DEFINE("NEED_SETLOCALE_IMPROVED", 0),
        ],
    }),
    visibility = ["//visibility:public"],
    deps = [
        "//gnulib/m4/locale_h",  # AC_REQUIRE([gl_LOCALE_H_DEFAULTS])
        "//gnulib/m4/setlocale_null",  # AC_REQUIRE([gl_FUNC_SETLOCALE_NULL])
        "//gnulib/m4/threadlib",  # AC_REQUIRE([gl_PTHREADLIB])
        # For test compatibility
        "//autoconf/macros/AC_CHECK_INCLUDES_DEFAULT",
    ],
)

# Prerequisites of lib/setlocale.c: AC_DEFUN([gl_PREREQ_SETLOCALE], [:]) - nothing to do.
autoconf(
    name = "gl_PREREQ_SETLOCALE",
    checks = [],
    visibility = ["//visibility:public"],
)

autoconf(
    name = "setlocale",
    visibility = ["//visibility:public"],
    deps = [
        ":gl_FUNC_SETLOCALE",
        ":gl_PREREQ_SETLOCALE",
    ],
)
