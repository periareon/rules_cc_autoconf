"""https://github.com/coreutils/gnulib/blob/1039a5f2cee3cda1c11f64a5eb3a15b2e87cd2f0/m4/fnmatch_h.m4"""

load("//autoconf:autoconf_toolchain.bzl", autoconf = "autoconf_cache")
load("//autoconf:checks.bzl", "checks")
load("//gnulib:macros.bzl", gl_macros = "macros")

autoconf(
    name = "gl_FNMATCH_H",
    checks = [
        # gl_FNMATCH_H checks for fnmatch.h header
        checks.AC_CHECK_HEADER(
            "fnmatch.h",
            define = "HAVE_FNMATCH_H",
        ),
    ] + gl_macros.GL_CHECK_NEXT_HEADERS(["fnmatch.h"]) + [
        # GL_GENERATE_FNMATCH_H: upstream sets this true when gl_POSIXCHECK is
        # defined, a C++ GNULIB_NAMESPACE is in use, or fnmatch.h is missing.
        # Since GL_CHECK_NEXT_HEADERS is invoked unconditionally here, the
        # wrapper is always generated.
        checks.M4_VARIABLE("GL_GENERATE_FNMATCH_H", "true"),
        # if test $ac_cv_header_fnmatch_h = yes; then HAVE_FNMATCH_H=1 else 0
        checks.AC_SUBST(
            "HAVE_FNMATCH_H",
            condition = "ac_cv_header_fnmatch_h",
            if_false = "0",
            if_true = "1",
        ),
        # GNU extension checks (from gl_FNMATCH_H)
        checks.AC_TRY_COMPILE(
            code = "int x = FNM_CASEFOLD; (void)x;",
            define = "HAVE_FNM_CASEFOLD",
            includes = ["#include <fnmatch.h>"],
        ),
        checks.AC_TRY_COMPILE(
            code = "int x = FNM_EXTMATCH; (void)x;",
            define = "HAVE_FNM_EXTMATCH",
            includes = ["#include <fnmatch.h>"],
        ),
        checks.AC_TRY_COMPILE(
            code = "int x = FNM_FILE_NAME; (void)x;",
            define = "HAVE_FNM_FILE_NAME",
            includes = ["#include <fnmatch.h>"],
        ),
        checks.AC_TRY_COMPILE(
            code = "int x = FNM_LEADING_DIR; (void)x;",
            define = "HAVE_FNM_LEADING_DIR",
            includes = ["#include <fnmatch.h>"],
        ),
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//gnulib/m4/include_next",  # gl_CHECK_NEXT_HEADERS([fnmatch.h])
        "//gnulib/m4/extensions",  # AC_REQUIRE([AC_USE_SYSTEM_EXTENSIONS])
        # For test compatibility
        "//autoconf/macros/AC_CHECK_INCLUDES_DEFAULT",
    ],
)

# m4 line 53: gl_REPLACE_FNMATCH_H - invokes gl_FNMATCH_H_REQUIRE_DEFAULTS
# (provided through :defaults by the toolchain, like the other *_H_DEFAULTS)
# and sets GL_GENERATE_FNMATCH_H=true, which gl_FNMATCH_H already records.
autoconf(
    name = "gl_REPLACE_FNMATCH_H",
    checks = [],
    visibility = ["//visibility:public"],
    deps = [
        ":gl_FNMATCH_H",
    ],
)

# m4 line 63: gl_FNMATCH_MODULE_INDICATOR([modulename]) - parameterised;
# invokes gl_FNMATCH_H_REQUIRE_DEFAULTS (see above) and sets the per-module
# GNULIB_<MODULE> indicator, which the invoking module target owns.
autoconf(
    name = "gl_FNMATCH_MODULE_INDICATOR",
    checks = [],
    visibility = ["//visibility:public"],
)

autoconf(
    name = "gl_FNMATCH_H_DEFAULTS",
    checks = [
        checks.AC_SUBST("HAVE_FNMATCH", 1),
        checks.AC_SUBST("REPLACE_FNMATCH", 0),
    ],
    visibility = ["//visibility:private"],
)

autoconf(
    name = "gl_FNMATCH_H_REQUIRE_DEFAULTS",
    checks = [
        checks.AC_SUBST("GNULIB_FNMATCH", 0),
    ],
    visibility = ["//visibility:private"],
    deps = [
        ":gl_FNMATCH_H_DEFAULTS",
    ],
)

autoconf(
    name = "defaults",
    visibility = ["//visibility:public"],
    deps = [
        ":gl_FNMATCH_H_REQUIRE_DEFAULTS",
    ],
)

autoconf(
    name = "fnmatch_h",
    visibility = ["//visibility:public"],
    deps = [
        ":gl_FNMATCH_H",
        ":gl_FNMATCH_MODULE_INDICATOR",
        ":gl_REPLACE_FNMATCH_H",
    ],
)
