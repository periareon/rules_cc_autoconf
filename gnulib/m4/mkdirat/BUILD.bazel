"""https://github.com/coreutils/gnulib/blob/1039a5f2cee3cda1c11f64a5eb3a15b2e87cd2f0/m4/mkdirat.m4"""

load("//autoconf:autoconf_toolchain.bzl", autoconf = "autoconf_cache")
load("//autoconf:checks.bzl", "checks")

autoconf(
    name = "gl_FUNC_MKDIRAT",
    checks = [
        # Equivalent to gl_FUNC_MKDIRAT macro from mkdirat.m4
        checks.AC_CHECK_FUNC(
            "mkdirat",
            define = "HAVE_MKDIRAT",
        ),
        # if test $ac_cv_func_mkdirat != yes; then HAVE_MKDIRAT=0
        checks.AC_SUBST(
            "HAVE_MKDIRAT",
            condition = "ac_cv_func_mkdirat",
        ),
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//gnulib/m4/extensions",  # AC_REQUIRE([gl_USE_SYSTEM_EXTENSIONS])

        # Note: AC_CHECK_INCLUDES_DEFAULT is added for test compatibility
        "//autoconf/macros/AC_CHECK_INCLUDES_DEFAULT",
        "//gnulib/m4/sys_stat_h",  # AC_REQUIRE([gl_SYS_STAT_H_DEFAULTS])
    ],
)

# gl_PREREQ_MKDIRAT: prerequisite of mkdirat's declaration and of lib/mkdirat.c.
autoconf(
    name = "gl_PREREQ_MKDIRAT",
    checks = [],
    visibility = ["//visibility:public"],
    deps = [
        "//autoconf/macros/AC_TYPE_MODE_T",  # AC_REQUIRE([AC_TYPE_MODE_T])
    ],
)

autoconf(
    name = "mkdirat",
    visibility = ["//visibility:public"],
    deps = [
        ":gl_FUNC_MKDIRAT",
        ":gl_PREREQ_MKDIRAT",
    ],
)
