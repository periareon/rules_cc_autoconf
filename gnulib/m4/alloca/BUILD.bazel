"""https://github.com/coreutils/gnulib/blob/1039a5f2cee3cda1c11f64a5eb3a15b2e87cd2f0/m4/alloca.m4"""

load("//autoconf:autoconf_toolchain.bzl", autoconf = "autoconf_cache")
load("//autoconf:checks.bzl", "checks")

autoconf(
    name = "gl_FUNC_ALLOCA",
    checks = [
        # gl_cv_rpl_alloca: is alloca available as a compiler built-in?
        # Upstream uses AC_EGREP_CPP to look for `__GNUC__ || _AIX || _MSC_VER`.
        # AC_TRY_COMPILE gives the same yes/no answer: compilation succeeds
        # when one of the macros is defined and fails (via #error) otherwise.
        # Only checked when alloca.h actually works (ac_cv_working_alloca_h).
        checks.AC_TRY_COMPILE(
            name = "gl_cv_rpl_alloca",
            code = """\
#if !(defined __GNUC__ || defined _AIX || defined _MSC_VER)
#error "alloca is not a compiler built-in on this compiler"
#endif
int main(void) { return 0; }
""",
            language = "c",
            requires = ["ac_cv_working_alloca_h"],
        ),

        # The AC_DEFINE([HAVE_ALLOCA]) in the rpl_alloca branch is implied by
        # AC_FUNC_ALLOCA's own HAVE_ALLOCA (a working alloca.h means alloca
        # works), so it is not repeated here.

        # if test $ac_cv_working_alloca_h = yes; then HAVE_ALLOCA_H=1; else HAVE_ALLOCA_H=0; fi
        # AC_SUBST([HAVE_ALLOCA_H])
        checks.AC_SUBST(
            "HAVE_ALLOCA_H",
            condition = "ac_cv_working_alloca_h",
        ),

        # GL_GENERATE_ALLOCA_H: plain shell variable in upstream serial 21
        # (no AC_SUBST / AM_CONDITIONAL), set to "true" when gnulib should
        # ship its own alloca.h wrapper:
        #   - working_alloca_h=no                          → true
        #   - working_alloca_h=yes && rpl_alloca=yes       → true  (builtin: wrap it)
        #   - working_alloca_h=yes && rpl_alloca=no        → false (system header is fine)
        # Collapsing those branches: !working_alloca_h || rpl_alloca.
        # Tracked as M4_VARIABLE so downstream `requires=[...]` can branch on
        # it without it leaking into config.h / subst.h.
        checks.M4_VARIABLE(
            "GL_GENERATE_ALLOCA_H",
            condition = "ac_cv_working_alloca_h && !gl_cv_rpl_alloca",
            if_false = "true",
            if_true = "false",
        ),
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//autoconf/macros/AC_FUNC_ALLOCA",
        # For standard headers (HAVE_INTTYPES_H, etc.)
        "//autoconf/macros/AC_CHECK_INCLUDES_DEFAULT",
    ],
)

# Prerequisites of lib/alloca.c - empty in this case
autoconf(
    name = "gl_PREREQ_ALLOCA",
    checks = [],
    visibility = ["//visibility:public"],
)

# Top-level target that aggregates all AC_DEFUN functions
autoconf(
    name = "alloca",
    checks = [],
    visibility = ["//visibility:public"],
    deps = [
        ":gl_FUNC_ALLOCA",
        ":gl_PREREQ_ALLOCA",
        # Ensure AC_FUNC_ALLOCA's defines are included
        "//autoconf/macros/AC_FUNC_ALLOCA",
        # Ensure standard headers are included
        "//autoconf/macros/AC_CHECK_INCLUDES_DEFAULT",
    ],
)
