"""https://github.com/coreutils/gnulib/blob/1039a5f2cee3cda1c11f64a5eb3a15b2e87cd2f0/m4/c32rtomb.m4"""

load("//autoconf:autoconf_toolchain.bzl", autoconf = "autoconf_cache")
load("//autoconf:checks.bzl", "checks")

# gl_FUNC_C32RTOMB - lines 9-65
autoconf(
    name = "gl_FUNC_C32RTOMB",
    checks = [
        # M4: if test $gl_cv_func_c32rtomb = no; then HAVE_C32RTOMB=0; fi
        # Override the gl_UCHAR_H_DEFAULTS toolchain default (1) when the
        # function is absent.
        checks.AC_SUBST(
            "HAVE_C32RTOMB",
            condition = "gl_cv_func_c32rtomb",
            if_false = "0",
            if_true = "1",
        ),
        # M4 lines 23-58: inside the "c32rtomb exists" arm, set
        # REPLACE_C32RTOMB=1 if ANY of:
        #   (a) HAVE_WORKING_MBRTOC32 == 0 (line 25-27)
        #   (b) gl_cv_func_c32rtomb_retval != yes (runtime; line 28-51)
        #       cross-compile guess: aix*=no, others=yes
        #   (c) HAVE_WORKING_C32RTOMB == 0 (line 56-58)
        # (a) and (c) are real substs from sibling modules. (b) is a runtime
        # probe and the cross-compile guess is "yes" everywhere except AIX,
        # which we don't target - so we don't model it here.
        checks.AC_SUBST(
            "REPLACE_C32RTOMB",
            condition = "gl_cv_func_c32rtomb==1 && (HAVE_WORKING_MBRTOC32==0 || HAVE_WORKING_C32RTOMB==0)",
            if_false = "0",
            if_true = "1",
        ),
    ],
    visibility = ["//visibility:public"],
    deps = [
        # AC_REQUIRE([gl_UCHAR_H_DEFAULTS]) is satisfied by the toolchain.
        # AC_REQUIRE([AC_CANONICAL_HOST]) - line 11
        "//autoconf/macros/AC_CANONICAL_HOST",
        # AC_REQUIRE([gl_MBRTOC32_SANITYCHECK]) - line 13 (provides HAVE_WORKING_MBRTOC32)
        "//gnulib/m4/mbrtoc32:gl_MBRTOC32_SANITYCHECK",
        # AC_REQUIRE([gl_C32RTOMB_SANITYCHECK]) - line 14 (provides HAVE_WORKING_C32RTOMB)
        ":gl_C32RTOMB_SANITYCHECK",
        # AC_REQUIRE([gl_CHECK_FUNC_C32RTOMB]) - line 16 (provides gl_cv_func_c32rtomb)
        ":gl_CHECK_FUNC_C32RTOMB",
        # Locale dependencies for test compatibility.
        "//gnulib/m4/locale-fr",
        "//gnulib/m4/locale-zh",
        "//autoconf/macros/AC_CHECK_INCLUDES_DEFAULT",
    ],
)

# gl_CHECK_FUNC_C32RTOMB - lines 67-95
autoconf(
    name = "gl_CHECK_FUNC_C32RTOMB",
    checks = [
        # AC_CHECK_DECL([c32rtomb], ..., [includes]) - lines 70-74
        # M4 includes (semantic order matters - do NOT split into individual
        # list elements; alphabetical sorters will reorder and break the
        # #ifdef/#endif pairing):
        #   #ifdef __HAIKU__
        #    #include <stdint.h>
        #   #endif
        #   #include <uchar.h>
        checks.AC_CHECK_DECL(
            "c32rtomb",
            name = "ac_cv_have_decl_c32rtomb",
            includes = ["#ifdef __HAIKU__\n#include <stdint.h>\n#endif\n#include <uchar.h>"],
        ),
        # M4: if test $ac_cv_have_decl_c32rtomb = yes; then AC_LINK_IFELSE(...)
        # else gl_cv_func_c32rtomb=no
        # We can't use AC_CHECK_FUNC because c32rtomb() is defined as a
        # static inline function on Haiku 2020, so we use AC_TRY_LINK.
        checks.AC_TRY_LINK(
            name = "gl_cv_func_c32rtomb",
            code = """\
#include <stdlib.h>
#ifdef __HAIKU__
#include <stdint.h>
#endif
#include <uchar.h>

int main(void) {
    char buf[8];
    return c32rtomb(buf, 0, NULL) == 0;
}
""",
            requires = ["ac_cv_have_decl_c32rtomb==1"],
        ),
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//autoconf/macros/AC_CHECK_INCLUDES_DEFAULT",
    ],
)

# gl_C32RTOMB_SANITYCHECK - lines 100-180
# Test whether c32rtomb works not worse than wcrtomb. Result is
# HAVE_WORKING_C32RTOMB.
autoconf(
    name = "gl_C32RTOMB_SANITYCHECK",
    checks = [
        # M4: if test $GNULIBHEADERS_OVERRIDE_CHAR32_T = 1 || test $gl_cv_func_c32rtomb = no; then
        #       HAVE_WORKING_C32RTOMB=0
        #     else
        #       AC_RUN_IFELSE (runtime probe in zh_CN.GB18030 locale)
        #       case "$gl_cv_func_c32rtomb_sanitycheck" in
        #         *yes) HAVE_WORKING_C32RTOMB=1; AC_DEFINE([HAVE_WORKING_C32RTOMB], [1]) ;;
        #         *)    HAVE_WORKING_C32RTOMB=0 ;;
        #       esac
        #     fi
        #     AC_SUBST([HAVE_WORKING_C32RTOMB])
        # The runtime check isn't portable; cross-compile guess is "yes"
        # everywhere except non-Oracle Solaris, which we don't target. So
        # when neither GNULIBHEADERS_OVERRIDE_CHAR32_T nor gl_cv_func_c32rtomb
        # forces 0, we assume the runtime check succeeds.
        # Positive form: HAVE_WORKING_C32RTOMB=1 iff char32_t isn't overridden
        # AND the function exists. `&&` short-circuits, so on macOS (where
        # GNULIBHEADERS_OVERRIDE_CHAR32_T=1) the second arm — which references
        # a cache var that may not exist when the c32rtomb decl check failed
        # and the requires-gated link probe was skipped — is never evaluated.
        # The negated OR form (`OVERRIDE==1 || func==0`) hits the missing-var
        # evaluation and the whole condition errors out -> false -> wrong arm.
        checks.AC_SUBST(
            "HAVE_WORKING_C32RTOMB",
            condition = "GNULIBHEADERS_OVERRIDE_CHAR32_T==0 && gl_cv_func_c32rtomb==1",
            if_false = "0",
            if_true = "1",
        ),
        # M4 emits AC_DEFINE([HAVE_WORKING_C32RTOMB], [1]) only in the *yes
        # branch of the runtime case statement (inside the "not overridden
        # and function exists" arm); when either gate fires, the define is
        # absent from config.h.
        checks.AC_DEFINE(
            "HAVE_WORKING_C32RTOMB",
            condition = "GNULIBHEADERS_OVERRIDE_CHAR32_T==0 && gl_cv_func_c32rtomb==1",
            if_false = None,  # don't emit the define when condition is false
            if_true = 1,
        ),
    ],
    visibility = ["//visibility:public"],
    deps = [
        # AC_REQUIRE([gl_TYPE_CHAR32_T]) - line 104 (provides GNULIBHEADERS_OVERRIDE_CHAR32_T)
        "//gnulib/m4/uchar_h",
        # AC_REQUIRE([gl_CHECK_FUNC_C32RTOMB]) - line 105 (provides gl_cv_func_c32rtomb)
        ":gl_CHECK_FUNC_C32RTOMB",
        # AC_REQUIRE([AC_CANONICAL_HOST]) - line 107
        "//autoconf/macros/AC_CANONICAL_HOST",
        # AC_REQUIRE([gt_LOCALE_ZH_CN]) - line 106 (runtime locale; only used
        # by the un-modeled runtime probe but kept for graph completeness).
        "//autoconf/macros/AC_CHECK_INCLUDES_DEFAULT",
    ],
)

# Package-level aggregator (matches package name). No checks - deps on the
# AC_DEFUN targets.
autoconf(
    name = "c32rtomb",
    visibility = ["//visibility:public"],
    deps = [
        ":gl_C32RTOMB_SANITYCHECK",
        ":gl_CHECK_FUNC_C32RTOMB",
        ":gl_FUNC_C32RTOMB",
    ],
)
