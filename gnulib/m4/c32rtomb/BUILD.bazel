"""https://github.com/coreutils/gnulib/blob/1039a5f2cee3cda1c11f64a5eb3a15b2e87cd2f0/m4/c32rtomb.m4"""

load("//autoconf:autoconf_toolchain.bzl", autoconf = "autoconf_cache")
load("//autoconf:checks.bzl", "checks")

# gl_FUNC_C32RTOMB - lines 9-65
autoconf(
    name = "gl_FUNC_C32RTOMB",
    checks = [
        # M4: if test $gl_cv_func_c32rtomb = no; then HAVE_C32RTOMB=0; fi
        # Override the gl_UCHAR_H_DEFAULTS toolchain default (1) when the
        # function is absent.
        checks.AC_SUBST(
            "HAVE_C32RTOMB",
            condition = "gl_cv_func_c32rtomb",
            if_false = "0",
            if_true = "1",
        ),
        # M4 lines 23-58: inside the "c32rtomb exists" arm, set
        # REPLACE_C32RTOMB=1 if ANY of:
        #   (a) HAVE_WORKING_MBRTOC32 == 0 (line 25-27)
        #   (b) gl_cv_func_c32rtomb_retval != yes (runtime; line 28-51)
        #       cross-compile guess: aix*=no, others=yes
        #   (c) HAVE_WORKING_C32RTOMB == 0 (line 56-58)
        # (a) and (c) are real substs from sibling modules. (b) is a runtime
        # probe and the cross-compile guess is "yes" everywhere except AIX,
        # which we don't target - so we don't model it here.
        checks.AC_SUBST(
            "REPLACE_C32RTOMB",
            condition = "gl_cv_func_c32rtomb==1 && (HAVE_WORKING_MBRTOC32==0 || HAVE_WORKING_C32RTOMB==0)",
            if_false = "0",
            if_true = "1",
        ),
    ],
    visibility = ["//visibility:public"],
    deps = [
        # AC_REQUIRE([gl_UCHAR_H_DEFAULTS]) is satisfied by the toolchain.
        # AC_REQUIRE([AC_CANONICAL_HOST]) - line 11
        "//autoconf/macros/AC_CANONICAL_HOST",
        # AC_REQUIRE([gl_MBRTOC32_SANITYCHECK]) - line 13 (provides HAVE_WORKING_MBRTOC32)
        "//gnulib/m4/mbrtoc32:gl_MBRTOC32_SANITYCHECK",
        # AC_REQUIRE([gl_C32RTOMB_SANITYCHECK]) - line 14 (provides HAVE_WORKING_C32RTOMB)
        ":gl_C32RTOMB_SANITYCHECK",
        # AC_REQUIRE([gl_CHECK_FUNC_C32RTOMB]) - line 16 (provides gl_cv_func_c32rtomb)
        ":gl_CHECK_FUNC_C32RTOMB",
        # Locale dependencies for test compatibility.
        "//gnulib/m4/locale-fr",
        "//gnulib/m4/locale-zh",
        "//autoconf/macros/AC_CHECK_INCLUDES_DEFAULT",
    ],
)

# gl_CHECK_FUNC_C32RTOMB - lines 67-95
autoconf(
    name = "gl_CHECK_FUNC_C32RTOMB",
    checks = [
        # AC_CHECK_DECL([c32rtomb], ..., [includes]) - lines 70-74
        # M4 includes (semantic order matters - do NOT split into individual
        # list elements; alphabetical sorters will reorder and break the
        # #ifdef/#endif pairing):
        #   #ifdef __HAIKU__
        #    #include <stdint.h>
        #   #endif
        #   #include <uchar.h>
        # Keep the AC_CHECK_DECL gate for the Haiku case (where c32rtomb
        # is a static inline, so AC_CHECK_FUNC would miss it). macOS
        # gates the decl in <uchar.h> behind _DARWIN_C_SOURCE; pass it
        # via `compile_defines` (as a real -D flag) so the macro is set
        # BEFORE the auto-prepended AC_INCLUDES_DEFAULT pulls in any
        # system header — an inline `#define` is too late at that point.
        checks.AC_CHECK_DECL(
            "c32rtomb",
            name = "ac_cv_have_decl_c32rtomb",
            compile_defines = [
                "_DARWIN_C_SOURCE",
                "_GNU_SOURCE",
            ],
            includes = ["#ifdef __HAIKU__\n#include <stdint.h>\n#endif\n#include <uchar.h>"],
        ),
        # M4: if test $ac_cv_have_decl_c32rtomb = yes; then AC_LINK_IFELSE(...)
        # else gl_cv_func_c32rtomb=no. Same feature-define story as the
        # decl probe — must be -D flags, not in-source.
        checks.AC_TRY_LINK(
            name = "gl_cv_func_c32rtomb",
            code = """\
#include <stdlib.h>
#ifdef __HAIKU__
#include <stdint.h>
#endif
#include <uchar.h>

int main(void) {
    char buf[8];
    return c32rtomb(buf, 0, NULL) == 0;
}
""",
            compile_defines = [
                "_DARWIN_C_SOURCE",
                "_GNU_SOURCE",
            ],
            requires = ["ac_cv_have_decl_c32rtomb==1"],
        ),
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//autoconf/macros/AC_CHECK_INCLUDES_DEFAULT",
        # Provides _DARWIN_C_SOURCE / _GNU_SOURCE defines (via
        # AC_USE_SYSTEM_EXTENSIONS) that both probes reference through
        # `compile_defines` so they reach the compiler as -D flags.
        "//gnulib/m4/extensions",
    ],
)

# gl_C32RTOMB_SANITYCHECK - lines 100-180
# Test whether c32rtomb works not worse than wcrtomb. Result is
# HAVE_WORKING_C32RTOMB.
autoconf(
    name = "gl_C32RTOMB_SANITYCHECK",
    # M4 m4/c32rtomb.m4:
    #   if test $GNULIBHEADERS_OVERRIDE_CHAR32_T = 1 \
    #      || test $gl_cv_func_c32rtomb = no; then
    #       HAVE_WORKING_C32RTOMB=0
    #   else
    #       AC_RUN_IFELSE (zh_CN.GB18030 locale; cross-compile guess is
    #       "yes" everywhere except non-Oracle Solaris)
    #       case ... in *yes) HAVE_WORKING_C32RTOMB=1
    #                         AC_DEFINE([HAVE_WORKING_C32RTOMB], [1])
    #   fi
    #
    # The runtime probe can't be ported. We approximate the guess as "yes"
    # (matching every platform we care about) and only need to check the
    # two static gates: OVERRIDE_CHAR32_T and the c32rtomb link probe.
    # `&&` short-circuits, so if OVERRIDE=1 (i.e. <uchar.h> char32_t is
    # replaced) we never look at gl_cv_func_c32rtomb — which is important
    # on platforms where the c32rtomb decl probe failed and the
    # requires-gated link probe was skipped, leaving the cache var unset.
    checks = [
        checks.AC_SUBST(
            "HAVE_WORKING_C32RTOMB",
            condition = "GNULIBHEADERS_OVERRIDE_CHAR32_T==0 && gl_cv_func_c32rtomb==1",
            if_false = "0",
            if_true = "1",
        ),
        # M4 only emits the AC_DEFINE in the *yes branch of the runtime
        # case statement (i.e. when both gates pass AND the runtime probe
        # succeeds). When the condition is false the define is absent.
        checks.AC_DEFINE(
            "HAVE_WORKING_C32RTOMB",
            condition = "GNULIBHEADERS_OVERRIDE_CHAR32_T==0 && gl_cv_func_c32rtomb==1",
            if_false = None,
            if_true = 1,
        ),
    ],
    visibility = ["//visibility:public"],
    deps = [
        # AC_REQUIRE([gl_TYPE_CHAR32_T]) - provides GNULIBHEADERS_OVERRIDE_CHAR32_T
        "//gnulib/m4/uchar_h",
        # AC_REQUIRE([gl_CHECK_FUNC_C32RTOMB]) - provides gl_cv_func_c32rtomb
        ":gl_CHECK_FUNC_C32RTOMB",
        # AC_REQUIRE([AC_CANONICAL_HOST])
        "//autoconf/macros/AC_CANONICAL_HOST",
        # AC_REQUIRE([gt_LOCALE_ZH_CN]) - runtime locale; only used by the
        # un-modeled runtime probe but kept for graph completeness.
        "//autoconf/macros/AC_CHECK_INCLUDES_DEFAULT",
    ],
)

# Package-level aggregator (matches package name). No checks - deps on the
# AC_DEFUN targets.
autoconf(
    name = "c32rtomb",
    visibility = ["//visibility:public"],
    deps = [
        ":gl_C32RTOMB_SANITYCHECK",
        ":gl_CHECK_FUNC_C32RTOMB",
        ":gl_FUNC_C32RTOMB",
    ],
)
