"""https://github.com/coreutils/gnulib/blob/1039a5f2cee3cda1c11f64a5eb3a15b2e87cd2f0/m4/memrchr.m4"""

load("//autoconf:autoconf_toolchain.bzl", autoconf = "autoconf_cache")
load("//autoconf:checks.bzl", "checks")

autoconf(
    name = "memrchr",
    checks = [
        # The declaration needs _GNU_SOURCE on glibc (configure enables the
        # extensions before gnulib's checks run).  Probed everywhere rather
        # than answered per platform: gnulib.mk's GL_COND_OBJ_MEMRCHR reads
        # ac_cv_func_memrchr, which only a probe produces.
        checks.AC_CHECK_DECL(
            "memrchr",
            compile_defines = ["_GNU_SOURCE"],
            define = "HAVE_DECL_MEMRCHR",
            includes = ["#include <string.h>"],
            subst = True,
        ),
        checks.AC_CHECK_FUNC(
            "memrchr",
            define = "HAVE_MEMRCHR",
        ),
    ],
    default_deps = [
        "//gnulib/m4/string_h:defaults",  # AC_REQUIRE: gl_STRING_H_DEFAULTS
    ],
    visibility = ["//visibility:public"],
    deps = [
        # Provides system extension defines (_ALL_SOURCE, _DARWIN_C_SOURCE, etc.)
        "//gnulib/m4/extensions",
        # AC_REQUIRE([gl_STRING_H_DEFAULTS]) - line 16 (ignore, it's a _DEFAULTS function)
        # Note: AC_CHECK_INCLUDES_DEFAULT is added for test compatibility
        "//autoconf/macros/AC_CHECK_INCLUDES_DEFAULT",
    ],
)
