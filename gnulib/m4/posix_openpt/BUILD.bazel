"""https://github.com/coreutils/gnulib/blob/1039a5f2cee3cda1c11f64a5eb3a15b2e87cd2f0/m4/posix_openpt.m4"""

load("//autoconf:autoconf_toolchain.bzl", autoconf = "autoconf_cache")
load("//autoconf:checks.bzl", "checks")

# gl_CHECK_FUNCS_ANDROID([posix_openpt], [[#include <stdlib.h>]]): the link
# probe and the HAVE_POSIX_OPENPT config.h define.  gl_FUNC_OPENPTY (pty.m4)
# runs the same probe when openpty is absent, so it shares this target.
autoconf(
    name = "gl_CHECK_FUNCS_ANDROID_posix_openpt",
    checks = [
        checks.AC_CHECK_FUNC(
            "posix_openpt",
            define = "HAVE_POSIX_OPENPT",
        ),
    ],
    visibility = ["//gnulib:__subpackages__"],
    deps = [
        "//autoconf/macros/AC_CHECK_INCLUDES_DEFAULT",
        "//gnulib/m4/extensions",  # AC_REQUIRE([AC_USE_SYSTEM_EXTENSIONS])
    ],
)

autoconf(
    name = "gl_FUNC_POSIX_OPENPT",
    checks = [
        # if test $ac_cv_func_posix_openpt != yes; then HAVE_POSIX_OPENPT=0
        checks.AC_SUBST(
            "HAVE_POSIX_OPENPT",
            condition = "ac_cv_func_posix_openpt",
            if_false = 0,
            if_true = 1,
        ),
    ],
    visibility = ["//visibility:public"],
    deps = [
        ":gl_CHECK_FUNCS_ANDROID_posix_openpt",
        # Note: gl_STDLIB_H_DEFAULTS is a _DEFAULTS function, so we don't track it as a dependency
        "//autoconf/macros/AC_CHECK_INCLUDES_DEFAULT",
        "//gnulib/m4/extensions",  # AC_REQUIRE([AC_USE_SYSTEM_EXTENSIONS])
        "//gnulib/m4/wchar_h:gl_WCHAR_H_CORE",
    ],
)

autoconf(
    name = "posix_openpt",
    visibility = ["//visibility:public"],
    deps = [
        ":gl_FUNC_POSIX_OPENPT",
    ],
)
