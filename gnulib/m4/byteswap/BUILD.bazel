"""https://github.com/coreutils/gnulib/blob/1039a5f2cee3cda1c11f64a5eb3a15b2e87cd2f0/m4/byteswap.m4"""

load("//autoconf:autoconf_toolchain.bzl", autoconf = "autoconf_cache")
load("//autoconf:checks.bzl", "checks")

autoconf(
    name = "byteswap",
    checks = [
        # Standard header defines are provided by AC_CHECK_INCLUDES_DEFAULT dependency
        checks.AC_CHECK_HEADER(
            "byteswap.h",
            define = "HAVE_BYTESWAP_H",
        ),
        # GL_GENERATE_BYTESWAP_H: true when byteswap.h is missing — gnulib then
        # ships its own replacement.  Plain shell variable in upstream m4 (not
        # AC_SUBSTed); tracked here so consumers can branch on it via requires.
        checks.M4_VARIABLE(
            "GL_GENERATE_BYTESWAP_H",
            condition = "ac_cv_header_byteswap_h",
            if_false = "true",
            if_true = "false",
        ),
    ],
    visibility = ["//visibility:public"],
    deps = [
        # Note: AC_CHECK_INCLUDES_DEFAULT is added for test compatibility
        # (golden files include standard header checks even though not AC_REQUIREd)
        "//autoconf/macros/AC_CHECK_INCLUDES_DEFAULT",
    ],
)
