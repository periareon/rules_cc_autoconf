"""https://github.com/coreutils/gnulib/blob/1039a5f2cee3cda1c11f64a5eb3a15b2e87cd2f0/m4/qsort_r.m4"""

load("//autoconf:autoconf_toolchain.bzl", autoconf = "autoconf_cache")
load("//autoconf:checks.bzl", "checks", "utils")

autoconf(
    name = "gl_FUNC_QSORT_R",
    checks = [
        # gl_CHECK_FUNCS_ANDROID([qsort_r], [[#include <stdlib.h>]])
        # HAVE_QSORT_R is defined in config.h only when the function is found.
        checks.AC_CHECK_FUNC(
            "qsort_r",
            define = "HAVE_QSORT_R",
        ),

        # AC_CACHE_CHECK([for qsort_r signature], [gl_cv_qsort_r_signature], ...)
        # Only run when qsort_r exists. First try the GNU signature ...
        checks.AC_TRY_LINK(
            name = "gl_cv_qsort_r_signature_GNU",
            code = utils.AC_LANG_PROGRAM(
                [
                    "#include <stdlib.h>",
                    "void qsort_r (void *, size_t, size_t,",
                    "              int (*) (void const *, void const *,",
                    "                       void *),",
                    "              void *);",
                    "void (*p) (void *, size_t, size_t,",
                    "           int (*) (void const *, void const *,",
                    "                    void *),",
                    "           void *) = qsort_r;",
                ],
                "",
            ),
            requires = ["ac_cv_func_qsort_r"],
        ),
        # ... then the BSD signature.
        checks.AC_TRY_LINK(
            name = "gl_cv_qsort_r_signature_BSD",
            code = utils.AC_LANG_PROGRAM(
                [
                    "#include <stdlib.h>",
                    "void qsort_r (void *, size_t, size_t, void *,",
                    "              int (*) (void *,",
                    "                       void const *,",
                    "                       void const *));",
                    "void (*p) (void *, size_t, size_t, void *,",
                    "           int (*) (void *, void const *,",
                    "                    void const *)) = qsort_r;",
                ],
                "",
            ),
            requires = [
                "ac_cv_func_qsort_r",
                "!gl_cv_qsort_r_signature_GNU",
            ],
        ),

        # case $gl_cv_qsort_r_signature in
        #   GNU)     ;;
        #   BSD)     REPLACE_QSORT_R=1 ;;
        #   unknown) HAVE_QSORT_R=0 REPLACE_QSORT_R=1 ;;
        # esac
        # else HAVE_QSORT_R=0 (function absent, e.g. MSVC)
        checks.AC_SUBST(
            "HAVE_QSORT_R",
            condition = "ac_cv_func_qsort_r && (gl_cv_qsort_r_signature_GNU || gl_cv_qsort_r_signature_BSD)",
            if_false = 0,
            if_true = 1,
        ),
        checks.AC_SUBST(
            "REPLACE_QSORT_R",
            condition = "ac_cv_func_qsort_r && !gl_cv_qsort_r_signature_GNU",
            if_false = 0,
            if_true = 1,
        ),
    ],
    visibility = ["//visibility:public"],
    deps = [
        # Note: gl_STDLIB_H_DEFAULTS is a _DEFAULTS function, so we don't track it as a dependency
        "//gnulib/m4/extensions",  # AC_REQUIRE([gl_USE_SYSTEM_EXTENSIONS])
        "//gnulib/m4/wchar_h:gl_WCHAR_H_CORE",
        # For test compatibility - need basic header defines
        "//autoconf/macros/AC_CHECK_INCLUDES_DEFAULT",
    ],
)

autoconf(
    name = "qsort_r",
    visibility = ["//visibility:public"],
    deps = [
        ":gl_FUNC_QSORT_R",
    ],
)
