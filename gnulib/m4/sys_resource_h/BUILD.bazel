"""https://github.com/coreutils/gnulib/blob/1039a5f2cee3cda1c11f64a5eb3a15b2e87cd2f0/m4/sys_resource_h.m4"""

load("//autoconf:autoconf_defaults.bzl", "autoconf_defaults")
load("//autoconf:autoconf_toolchain.bzl", autoconf = "autoconf_cache")
load("//autoconf:checks.bzl", "checks")
load("//gnulib:macros.bzl", gl_macros = "macros")

autoconf(
    name = "sys_resource_h",
    checks = [
        checks.AC_CHECK_HEADER(
            "sys/resource.h",
            define = "HAVE_SYS_RESOURCE_H",
            subst = "HAVE_SYS_RESOURCE_H",
        ),
    ] + gl_macros.GL_CHECK_NEXT_HEADERS(["sys/resource.h"]),
    default_deps = [
        ":defaults",  # the header's own defaults, as its m4 requires
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//gnulib/m4/include_next",

        # Note: AC_CHECK_INCLUDES_DEFAULT is added for test compatibility
        "//autoconf/macros/AC_CHECK_INCLUDES_DEFAULT",
    ],
)

autoconf_defaults(
    name = "gl_SYS_RESOURCE_H_DEFAULTS",
    substs = {
        # Assume the function is present unless the gnulib/m4/getrusage
        # probe overrides this subst.  Moved from the main `sys_resource_h`
        # target so downstream probes can supply a toolchain-correct value
        # — defaults are mergeable with dep substs, main-target substs
        # are not.
        "HAVE_GETRUSAGE": "1",
    },
    visibility = ["//visibility:private"],
)

autoconf_defaults(
    name = "gl_SYS_RESOURCE_H_REQUIRE_DEFAULTS",
    substs = {
        "GNULIB_GETRUSAGE": "0",
    },
    visibility = ["//visibility:private"],
    deps = [
        ":gl_SYS_RESOURCE_H_DEFAULTS",
    ],
)

autoconf_defaults(
    name = "defaults",
    visibility = ["//visibility:public"],
    deps = [
        ":gl_SYS_RESOURCE_H_REQUIRE_DEFAULTS",
    ],
)
