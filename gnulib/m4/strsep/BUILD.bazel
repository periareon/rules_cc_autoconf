"""https://github.com/coreutils/gnulib/blob/1039a5f2cee3cda1c11f64a5eb3a15b2e87cd2f0/m4/strsep.m4"""

load("//autoconf:autoconf_toolchain.bzl", autoconf = "autoconf_cache")
load("//autoconf:checks.bzl", "checks")

autoconf(
    name = "gl_FUNC_STRSEP",
    checks = [
        # Note: gl_STRING_H_DEFAULTS is a _DEFAULTS function, so we ignore it per user's instruction
        checks.AC_CHECK_FUNC(
            "strsep",
            name = "ac_cv_func_strsep",
        ),

        # AC_CHECK_FUNCS([strsep]) defines HAVE_STRSEP in config.h only when
        # the function is found; otherwise the macro stays undefined.
        checks.AC_DEFINE(
            "HAVE_STRSEP",
            condition = "ac_cv_func_strsep",
            if_false = None,
            if_true = 1,
        ),

        # if test $ac_cv_func_strsep = no; then
        #   HAVE_STRSEP=0
        # fi
        # Overrides the gl_STRING_H_DEFAULTS value of 1 (e.g. MSVC lacks strsep).
        checks.AC_SUBST(
            "HAVE_STRSEP",
            condition = "ac_cv_func_strsep",
            if_false = 0,
            if_true = 1,
        ),
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//autoconf/macros/AC_CHECK_INCLUDES_DEFAULT",
        "//autoconf/macros/AC_C_RESTRICT",  # AC_REQUIRE([AC_C_RESTRICT])
        "//gnulib/m4/extensions",  # AC_REQUIRE([AC_USE_SYSTEM_EXTENSIONS])
        "//gnulib/m4/string_h",  # AC_REQUIRE([gl_STRING_H_DEFAULTS])
    ],
)

# Prerequisites of lib/strsep.c (empty)
autoconf(
    name = "gl_PREREQ_STRSEP",
    checks = [],
    visibility = ["//visibility:public"],
)

autoconf(
    name = "strsep",
    visibility = ["//visibility:public"],
    deps = [
        ":gl_FUNC_STRSEP",
        ":gl_PREREQ_STRSEP",
    ],
)
