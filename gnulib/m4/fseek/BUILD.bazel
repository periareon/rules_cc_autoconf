"""https://github.com/coreutils/gnulib/blob/1039a5f2cee3cda1c11f64a5eb3a15b2e87cd2f0/m4/fseek.m4"""

load("//autoconf:autoconf_toolchain.bzl", autoconf = "autoconf_cache")
load("//autoconf:checks.bzl", "checks")

autoconf(
    name = "gl_FUNC_FSEEK",
    checks = [
        # if test $HAVE_FSEEKO = 0 || test $REPLACE_FSEEKO = 1; then
        #   REPLACE_FSEEK=1
        # fi
        # HAVE_FSEEKO=0 iff the gl_cv_func_fseeko link probe fails (MSVC).
        checks.AC_SUBST(
            "REPLACE_FSEEK",
            condition = "!gl_cv_func_fseeko || REPLACE_FSEEKO==1",
            if_false = "0",
            if_true = "1",
        ),
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//gnulib/m4/fseeko:gl_FUNC_FSEEKO",
    ],
)

autoconf(
    name = "fseek",
    visibility = ["//visibility:public"],
    deps = [
        ":gl_FUNC_FSEEK",
    ],
)
