"""https://github.com/coreutils/gnulib/blob/1039a5f2cee3cda1c11f64a5eb3a15b2e87cd2f0/m4/arpa_inet_h.m4"""

load("//autoconf:autoconf_defaults.bzl", "autoconf_defaults")
load("//autoconf:autoconf_toolchain.bzl", autoconf = "autoconf_cache")
load("//autoconf:checks.bzl", "checks")
load("//gnulib:macros.bzl", gl_macros = "macros")

# gl_ARPA_INET_H (AC_DEFUN_ONCE)
# Top-level arpa/inet.h support: requires defaults, then header check.
autoconf(
    name = "gl_ARPA_INET_H",
    checks = [
        checks.AC_CHECK_HEADER(
            "arpa/inet.h",
            define = "HAVE_ARPA_INET_H",
            subst = True,
        ),
    ] + gl_macros.GL_NEXT_HEADERS(["arpa/inet.h"]),
    default_deps = [
        ":defaults",  # AC_REQUIRE: gl_ARPA_INET_H_DEFAULTS
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//autoconf/macros/AC_CHECK_INCLUDES_DEFAULT",
        "//gnulib/m4/extensions",
        "//gnulib/m4/gnulib-common:gl_FEATURES_H",
        "//gnulib/m4/include_next",
        # gl_PREREQ_SYS_H_WS2TCPIP (HAVE_WS2TCPIP_H); gl_ARPA_INET_H does not
        # invoke gl_SYS_SOCKET_H / gl_PREREQ_SYS_H_SOCKET.
        "//gnulib/m4/sys_socket_h:gl_PREREQ_SYS_H_WS2TCPIP",
    ],
)

# gl_ARPA_INET_MODULE_INDICATOR([modulename])
# Ensures defaults are expanded; sets GNULIB_<module> for the given module.
# Other modules depend on this and pull in arpa_inet defaults.
autoconf(
    name = "gl_ARPA_INET_MODULE_INDICATOR",
    checks = [],
    default_deps = [
        ":defaults",  # through a macro it invokes: gl_ARPA_INET_H_DEFAULTS
    ],
    visibility = ["//visibility:public"],
    deps = [
    ],
)

# gl_ARPA_INET_H_REQUIRE_DEFAULTS
autoconf_defaults(
    name = "gl_ARPA_INET_H_REQUIRE_DEFAULTS",
    substs = {
        "GNULIB_INET_NTOP": "0",
        "GNULIB_INET_PTON": "0",
    },
    visibility = ["//visibility:private"],
    deps = [
        ":gl_ARPA_INET_H_DEFAULTS",
    ],
)

# gl_ARPA_INET_H_DEFAULTS
autoconf_defaults(
    name = "gl_ARPA_INET_H_DEFAULTS",
    substs = {
        "HAVE_DECL_HTONL": "1",
        "HAVE_DECL_HTONS": "1",
        "HAVE_DECL_INET_NTOP": "1",
        "HAVE_DECL_INET_PTON": "1",
        "HAVE_DECL_NTOHL": "1",
        "HAVE_DECL_NTOHS": "1",
        "REPLACE_INET_NTOP": "0",
        "REPLACE_INET_PTON": "0",
    },
    visibility = ["//visibility:private"],
)

# Public header target (main entry point; backward compatibility)
autoconf(
    name = "arpa_inet_h",
    default_deps = [
        ":defaults",  # the header's own defaults, as its m4 requires
    ],
    visibility = ["//visibility:public"],
    deps = [
        ":gl_ARPA_INET_H",
    ],
)

autoconf_defaults(
    name = "defaults",
    visibility = ["//visibility:public"],
    deps = [
        ":gl_ARPA_INET_H_REQUIRE_DEFAULTS",
    ],
)
