"""https://github.com/coreutils/gnulib/blob/1039a5f2cee3cda1c11f64a5eb3a15b2e87cd2f0/m4/getline.m4"""

load("//autoconf:autoconf_toolchain.bzl", autoconf = "autoconf_cache")
load("//autoconf:checks.bzl", "checks")

# Prerequisites of lib/getline.c
autoconf(
    name = "gl_PREREQ_GETLINE",
    checks = [
        # Empty - no prerequisites
    ],
    visibility = ["//visibility:public"],
    deps = [
        # Note: AC_CHECK_INCLUDES_DEFAULT is added for test compatibility
        "//autoconf/macros/AC_CHECK_INCLUDES_DEFAULT",
    ],
)

autoconf(
    name = "gl_FUNC_GETLINE",
    checks = [
        # Note: gl_STDIO_H_DEFAULTS is a _DEFAULTS function, so we ignore it per user's instruction
        checks.AC_CHECK_DECL(
            "getline",
            define = "HAVE_DECL_GETLINE",
            includes = ["#include <stdio.h>"],
            subst = True,
        ),

        # Use AC_CHECK_FUNC which performs a link test and is equivalent to gl_CHECK_FUNCS_ANDROID
        # on non-Android systems
        checks.AC_CHECK_FUNC(
            "getline",
            name = "_am_cv_func_getline",
        ),

        # gl_CHECK_FUNCS_ANDROID -> AC_CHECK_FUNCS: HAVE_GETLINE is defined in
        # config.h only when the function is found (e.g. MSVC has no getline).
        checks.AC_DEFINE(
            "HAVE_GETLINE",
            condition = "_am_cv_func_getline",
            if_false = None,
            if_true = 1,
        ),

        # getline.m4 never sets a HAVE_GETLINE shell variable and gl_STDIO_H_DEFAULTS
        # does not AC_SUBST it, so no subst is produced here.
        # AC_CHECK_DECL already creates HAVE_DECL_GETLINE define if found

        # if test $ac_cv_func_getline = yes; then
        #   ... am_cv_func_working_getline (AC_RUN_IFELSE; passes on glibc and
        #   macOS, cross-compile guess "yes" for glibc/musl) ...
        # else
        #   am_cv_func_working_getline=no
        # fi
        # case "$am_cv_func_working_getline" in *yes) ;; *) REPLACE_GETLINE=1 ;; esac
        # So an absent getline is also "replaced" (REPLACE_GETLINE=1).
        checks.AC_SUBST(
            "REPLACE_GETLINE",
            condition = "_am_cv_func_getline",
            if_false = 1,
            if_true = 0,
        ),
    ],
    visibility = ["//visibility:public"],
    deps = [
        # Note: gl_STDIO_H_DEFAULTS is a _DEFAULTS function, so we ignore it per user's instruction
        "//autoconf/macros/AC_CANONICAL_HOST",
        "//gnulib/m4/extensions",
        # gl_PREREQ_GETLINE is not invoked by gl_FUNC_GETLINE; the :getline umbrella collects both.
        # Note: AC_CHECK_INCLUDES_DEFAULT is added for test compatibility
        "//autoconf/macros/AC_CHECK_INCLUDES_DEFAULT",
    ],
)

autoconf(
    name = "getline",
    visibility = ["//visibility:public"],
    deps = [
        ":gl_FUNC_GETLINE",
        ":gl_PREREQ_GETLINE",
    ],
)
