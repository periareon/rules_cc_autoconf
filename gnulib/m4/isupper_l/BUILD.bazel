"""https://github.com/coreutils/gnulib/blob/1039a5f2cee3cda1c11f64a5eb3a15b2e87cd2f0/m4/isupper_l.m4"""

load("//autoconf:autoconf_toolchain.bzl", autoconf = "autoconf_cache")
load("//autoconf:checks.bzl", "checks")

autoconf(
    name = "gl_FUNC_ISUPPER_L",
    checks = [
        # AC_CHECK_FUNCS_ONCE([isupper_l]): autoconf's plain link probe, which
        # declares the function itself.  A probe through <ctype.h> would miss
        # it on macOS, where isupper_l is declared only via <xlocale.h>.
        checks.AC_CHECK_FUNC(
            "isupper_l",
            define = "HAVE_ISUPPER_L",
        ),
        # if test $ac_cv_func_isupper_l = no; then HAVE_ISUPPER_L=0; fi
        # Overrides the gl_CTYPE_H_DEFAULTS value of 1 (e.g. MSVC has no isupper_l).
        checks.AC_SUBST(
            "HAVE_ISUPPER_L",
            condition = "ac_cv_func_isupper_l",
            if_false = "0",
            if_true = "1",
        ),
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//autoconf/macros/AC_CHECK_INCLUDES_DEFAULT",
        "//gnulib/m4/ctype_h",  # AC_REQUIRE([gl_CTYPE_H_DEFAULTS])
        "//gnulib/m4/extensions",  # AC_REQUIRE([AC_USE_SYSTEM_EXTENSIONS]) - needed for isupper_l to be declared
        "//gnulib/m4/intl-thread-locale:gt_FUNC_USELOCALE",  # AC_REQUIRE([gt_FUNC_USELOCALE])
    ],
)

# Umbrella target kept for existing dependants.
autoconf(
    name = "isupper_l",
    visibility = ["//visibility:public"],
    deps = [
        ":gl_FUNC_ISUPPER_L",
        "//gnulib/m4/c-strtod",  # kept from the previous shape for existing dependants
    ],
)
