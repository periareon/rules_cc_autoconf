"""https://github.com/coreutils/gnulib/blob/1039a5f2cee3cda1c11f64a5eb3a15b2e87cd2f0/m4/getdtablesize.m4"""

load("//autoconf:autoconf_toolchain.bzl", autoconf = "autoconf_cache")
load("//autoconf:checks.bzl", "checks")

autoconf(
    name = "gl_FUNC_GETDTABLESIZE",
    checks = [
        # Standard header defines are provided by AC_CHECK_INCLUDES_DEFAULT dependency
        # Equivalent to gl_FUNC_GETDTABLESIZE macro from getdtablesize.m4
        # Note: Full implementation includes runtime checks that are not easily replicable in Bazel
        checks.AC_CHECK_FUNC(
            "getdtablesize",
            define = "HAVE_GETDTABLESIZE",
            subst = True,
        ),
        # Note: subst=False because golden expects @HAVE_DECL_GETDTABLESIZE@ (unsubstituted)
        checks.AC_CHECK_DECL(
            "getdtablesize",
            define = "HAVE_DECL_GETDTABLESIZE",
            includes = ["#include <unistd.h>"],
        ),
        # REPLACE_GETDTABLESIZE=1 only when getdtablesize exists, is declared
        # and the AC_RUN_IFELSE probe fails (cross-compile guess "no" on
        # Cygwin only); without the function the M4 sets HAVE_GETDTABLESIZE=0
        # and leaves REPLACE_GETDTABLESIZE alone (0); consumers compile
        # lib/getdtablesize.c when HAVE_GETDTABLESIZE==0 ||
        # REPLACE_GETDTABLESIZE==1 (gnulib GL_COND_OBJ_GETDTABLESIZE).
        checks.AC_SUBST("REPLACE_GETDTABLESIZE", 0),
    ],
    visibility = ["//visibility:public"],
    deps = [
        # Note: gl_UNISTD_H_DEFAULTS is a _DEFAULTS function, so we don't track it as a dependency,

        # Note: AC_CHECK_INCLUDES_DEFAULT is added for test compatibility
        "//autoconf/macros/AC_CHECK_INCLUDES_DEFAULT",

        # Note: AC_REQUIRE([AC_CANONICAL_HOST]) is a standard autoconf macro
    ],
)

# AC_DEFUN([gl_PREREQ_GETDTABLESIZE], [:])
autoconf(
    name = "gl_PREREQ_GETDTABLESIZE",
    checks = [],
    visibility = ["//visibility:public"],
)

autoconf(
    name = "getdtablesize",
    visibility = ["//visibility:public"],
    deps = [
        ":gl_FUNC_GETDTABLESIZE",
        ":gl_PREREQ_GETDTABLESIZE",
    ],
)
