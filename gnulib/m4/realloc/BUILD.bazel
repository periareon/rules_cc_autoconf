"""https://github.com/coreutils/gnulib/blob/1039a5f2cee3cda1c11f64a5eb3a15b2e87cd2f0/m4/realloc.m4"""

load("//autoconf:autoconf_toolchain.bzl", autoconf = "autoconf_cache")
load("//autoconf:checks.bzl", "checks")

# gl_FUNC_REALLOC_SANITIZED: AC_CACHE_CHECK([whether realloc should abort upon
# undefined behaviour], [gl_cv_func_realloc_sanitize]) only honours a value
# preset by the user and otherwise yields "no", so nothing is defined here.
autoconf(
    name = "gl_FUNC_REALLOC_SANITIZED",
    checks = [],
    visibility = ["//visibility:public"],
)

# Test whether 'realloc' is POSIX compliant (sets errno to ENOMEM when it fails)
autoconf(
    name = "gl_FUNC_REALLOC_POSIX",
    checks = [
        # Note: gl_STDLIB_H_DEFAULTS is a _DEFAULTS function, so we ignore it per user's instruction

        # Uses AC_RUN_IFELSE which is not portable
        # For cross-compilation, we guess based on platform
        checks.AC_DEFINE("HAVE_REALLOC_POSIX", "1"),
        # REPLACE_REALLOC_FOR_REALLOC_POSIX is set to 2 by gl_FUNC_REALLOC_0_NONNULL
        # (below) when realloc (..., 0) returns NULL; realloc itself is POSIX
        # compliant everywhere we build, so this macro never sets it to 1. The
        # subst lives here because both targets must agree on a single value.
        #   AS_CASE([$gl_cv_func_realloc_0_nonnull], [*yes], [...],
        #     [... REPLACE_REALLOC_FOR_REALLOC_POSIX=2])
    ] + select({
        # AC_RUN_IFELSE: realloc (p, 0) returns nonnull on the BSDs/macOS; the
        # cross-compile guess is "yes" for the same set of hosts.
        "@platforms//os:macos": [
            checks.AC_SUBST("REPLACE_REALLOC_FOR_REALLOC_POSIX", "0"),
        ],
        # glibc and MSVC free the block and return NULL -> "no" -> 2.
        "//conditions:default": [
            checks.AC_SUBST("REPLACE_REALLOC_FOR_REALLOC_POSIX", "2"),
        ],
    }),
    visibility = ["//visibility:public"],
    deps = [
        ":gl_FUNC_REALLOC_SANITIZED",  # AC_REQUIRE([gl_FUNC_REALLOC_SANITIZED])
        "//gnulib/m4/malloc:gl_FUNC_MALLOC_POSIX",  # AC_REQUIRE([gl_FUNC_MALLOC_POSIX])
        "//autoconf/macros/AC_CANONICAL_HOST",  # AC_REQUIRE([AC_CANONICAL_HOST])
        # For test compatibility
        "//autoconf/macros/AC_CHECK_INCLUDES_DEFAULT",
    ],
)

# Replace realloc if realloc (..., 0) returns null
autoconf(
    name = "gl_FUNC_REALLOC_0_NONNULL",
    checks = [
        # Note: gl_STDLIB_H_DEFAULTS is a _DEFAULTS function, so we ignore it per user's instruction

        # AC_CACHE_CHECK([whether realloc (..., 0) returns nonnull],
        #   [gl_cv_func_realloc_0_nonnull], [AC_RUN_IFELSE(...)])
        # Runtime test; the cross-compile guess is "yes" on the BSDs, macOS,
        # musl, Solaris, Cygwin and "no" (gl_cross_guess_normal) elsewhere.
        # glibc and MSVC realloc (p, 0) free the block and return NULL.
    ] + select({
        "@platforms//os:macos": [
            checks.AC_DEFINE("HAVE_REALLOC_0_NONNULL", "1"),
        ],
        "//conditions:default": [
            # HAVE_REALLOC_0_NONNULL stays undefined.
        ],
    }),
    visibility = ["//visibility:public"],
    deps = [
        "//autoconf/macros/AC_CANONICAL_HOST",
        ":gl_FUNC_REALLOC_POSIX",
        # For test compatibility
        "//autoconf/macros/AC_CHECK_INCLUDES_DEFAULT",
    ],
)

autoconf(
    name = "realloc",
    visibility = ["//visibility:public"],
    deps = [
        ":gl_FUNC_REALLOC_0_NONNULL",
        ":gl_FUNC_REALLOC_POSIX",
        ":gl_FUNC_REALLOC_SANITIZED",
    ],
)
