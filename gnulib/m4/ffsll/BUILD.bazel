"""https://github.com/coreutils/gnulib/blob/1039a5f2cee3cda1c11f64a5eb3a15b2e87cd2f0/m4/ffsll.m4"""

load("//autoconf:autoconf_toolchain.bzl", autoconf = "autoconf_cache")
load("//autoconf:checks.bzl", "checks")

autoconf(
    name = "gl_FUNC_FFSLL",
    checks = [
        # AC_CACHE_CHECK([for ffsll], [gl_cv_func_ffsll], [AC_LINK_IFELSE(...)])
        # Upstream uses a link test instead of AC_CHECK_FUNC because ffsll()
        # may be a static inline function (Android) and must be declared so
        # that the GCC built-in is not picked up silently. Fails on MSVC,
        # which has no <strings.h>.
        checks.AC_TRY_LINK(
            name = "gl_cv_func_ffsll",
            code = """\
#include <string.h>
#include <strings.h>
long long x;

int main(void) {
    int (*func) (long long) = ffsll;
    return func (x);
}
""",
            language = "c",
        ),

        # if test $gl_cv_func_ffsll = yes; then
        #   ... AC_RUN_IFELSE (gl_cv_func_ffsll_works) only fails on AIX, so
        #   REPLACE_FFSLL keeps the gl_STRING_H_DEFAULTS value of 0 ...
        # else
        #   HAVE_FFSLL=0
        # fi
        # Overrides the gl_STRING_H_DEFAULTS value of 1.
        checks.AC_SUBST(
            "HAVE_FFSLL",
            condition = "gl_cv_func_ffsll",
            if_false = 0,
            if_true = 1,
        ),
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//gnulib/m4/extensions",  # AC_REQUIRE([AC_USE_SYSTEM_EXTENSIONS])
        "//gnulib/m4/string_h",  # AC_REQUIRE([gl_STRING_H_DEFAULTS])
        # For test compatibility
        "//autoconf/macros/AC_CHECK_INCLUDES_DEFAULT",
    ],
)

autoconf(
    name = "ffsll",
    visibility = ["//visibility:public"],
    deps = [
        ":gl_FUNC_FFSLL",
    ],
)
