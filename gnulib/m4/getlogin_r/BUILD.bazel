"""https://github.com/coreutils/gnulib/blob/1039a5f2cee3cda1c11f64a5eb3a15b2e87cd2f0/m4/getlogin_r.m4"""

load("//autoconf:autoconf_toolchain.bzl", autoconf = "autoconf_cache")
load("//autoconf:checks.bzl", "checks")

# AC_CHECK_FUNCS([getlogin_r]) on its own: glob only runs this probe and
# must not inherit gl_FUNC_GETLOGIN_R's unistd.h defaults.
autoconf(
    name = "ac_cv_func_getlogin_r",
    checks = [
        checks.AC_CHECK_FUNC(
            "getlogin_r",
            define = "HAVE_GETLOGIN_R",
        ),
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//autoconf/macros/AC_CHECK_INCLUDES_DEFAULT",
    ],
)

# gl_FUNC_GETLOGIN_R
autoconf(
    name = "gl_FUNC_GETLOGIN_R",
    checks = [
        # gl_FUNC_GETLOGIN_R checks for getlogin_r function and declarations
        checks.AC_CHECK_DECL(
            "getlogin_r",
            define = "HAVE_DECL_GETLOGIN_R",
            includes = ["#include <unistd.h>"],
            subst = True,
        ),
    ] + select({
        # Gnulib replaces getlogin_r on macOS (truncation bug workaround); golden expects REPLACE_GETLOGIN_R "1"
        "@platforms//os:macos": [
            checks.AC_SUBST("REPLACE_GETLOGIN_R", "1"),
        ],
        "//conditions:default": [
            checks.AC_SUBST("REPLACE_GETLOGIN_R", "0"),
        ],
    }),
    default_deps = [
        "//gnulib/m4/unistd_h:defaults",  # AC_REQUIRE: gl_UNISTD_H_DEFAULTS
    ],
    visibility = ["//visibility:public"],
    deps = [
        ":ac_cv_func_getlogin_r",  # AC_CHECK_FUNCS_ONCE([getlogin_r])
        "//gnulib/m4/extensions",  # AC_REQUIRE([gl_USE_SYSTEM_EXTENSIONS])
        # For test compatibility
        "//autoconf/macros/AC_CHECK_INCLUDES_DEFAULT",
    ],
)

# Prerequisites of lib/getlogin_r.c.
autoconf(
    name = "gl_PREREQ_GETLOGIN_R",
    checks = [],
    visibility = ["//visibility:public"],
    deps = [
        # ac_cv_have_decl_getlogin from getlogin:gl_HAVE_DECL_GETLOGIN
        "//gnulib/m4/getlogin:gl_HAVE_DECL_GETLOGIN",  # AC_CHECK_DECLS_ONCE([getlogin])
    ],
)

autoconf(
    name = "getlogin_r",
    visibility = ["//visibility:public"],
    deps = [
        ":gl_FUNC_GETLOGIN_R",
        ":gl_PREREQ_GETLOGIN_R",
    ],
)
