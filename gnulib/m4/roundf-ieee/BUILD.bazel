"""https://github.com/coreutils/gnulib/blob/1039a5f2cee3cda1c11f64a5eb3a15b2e87cd2f0/m4/roundf-ieee.m4

gl_FUNC_ROUNDF_IEEE: same shape as round-ieee but for the float variant. The
IEEE check is an AC_RUN_IFELSE, which the Bazel checker cannot express, so the
port follows what GNU configure (autoconf 2.73, run by the conformance tests
with the Bazel toolchain's flags) reports: roundf works on x86_64 and aarch64
glibc as well as macOS, i.e. REPLACE_ROUNDF=0, and the floor/ceil fallbacks
(HAVE_FLOORF_AND_CEILF, HAVE_DECL_FLOORF, HAVE_DECL_CEILF) are not evaluated.
An earlier per-CPU override claimed the opposite on aarch64; the oracle
contradicted it.
"""

load("//autoconf:autoconf_toolchain.bzl", autoconf = "autoconf_cache")
load("//autoconf:checks.bzl", "checks")

autoconf(
    name = "gl_FUNC_ROUNDF_IEEE",
    checks = [
        checks.AC_CHECK_DECL(
            "roundf",
            includes = ["#include <math.h>"],
        ),
        checks.AC_SUBST("ROUNDF_LIBM", ""),
        checks.AC_SUBST("REPLACE_ROUNDF", 0),
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//autoconf/macros/AC_CHECK_INCLUDES_DEFAULT",
        "//gnulib/m4/extensions",
    ],
)

autoconf(
    name = "roundf-ieee",
    visibility = ["//visibility:public"],
    deps = [
        ":gl_FUNC_ROUNDF_IEEE",
    ],
)
