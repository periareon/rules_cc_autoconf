"""https://github.com/coreutils/gnulib/blob/1039a5f2cee3cda1c11f64a5eb3a15b2e87cd2f0/m4/roundf-ieee.m4

gl_FUNC_ROUNDF_IEEE: same shape as round-ieee but for the float variant. The
runtime check (AC_RUN_IFELSE) fails on aarch64 glibc (roundf(-0.0) loses
sign bit), so REPLACE_ROUNDF=1 there. When REPLACE_ROUNDF=1, gl_FUNC_ROUNDF
also calls gl_FUNC_FLOOR_LIBS/gl_FUNC_CEIL_LIBS which expose
HAVE_DECL_FLOORF and HAVE_DECL_CEILF; we model that dep too.

Upstream m4/roundf.m4 IEEE-check cross-compile fallback (case "$host_os"):
  *-gnu* | gnu*  -> "guessing yes" -> REPLACE=0
  ... (other libcs similar)
The M4 guess for *-gnu* is "yes" but real autoconf on aarch64 glibc finds
the bug present, so we override per CPU.
"""

load("//autoconf:autoconf_toolchain.bzl", autoconf = "autoconf_cache")
load("//autoconf:checks.bzl", "checks")

autoconf(
    name = "gl_FUNC_ROUNDF_IEEE",
    checks = [
        checks.AC_CHECK_DECL(
            "roundf",
            includes = ["#include <math.h>"],
        ),
        checks.AC_SUBST("ROUNDF_LIBM", ""),
    ] + select({
        # aarch64 glibc: roundf(-0.0) loses sign bit -> REPLACE=1; pulls in
        # floor/ceil deps so HAVE_DECL_CEILF / HAVE_DECL_FLOORF get defined.
        "//gnulib/tests:linux_aarch64": [
            checks.AC_SUBST("REPLACE_ROUNDF", 1),
            checks.AC_DEFINE("HAVE_FLOORF_AND_CEILF", "1"),
        ],
        # Other libcs: M4 cross-compile guess "yes" -> REPLACE=0
        "//conditions:default": [
            checks.AC_SUBST("REPLACE_ROUNDF", 0),
        ],
    }),
    visibility = ["//visibility:public"],
    deps = [
        "//autoconf/macros/AC_CHECK_INCLUDES_DEFAULT",
        "//gnulib/m4/extensions",
    ] + select({
        # When REPLACE_ROUNDF=1 the replacement needs floor/ceil; pull in
        # the dep modules so their HAVE_DECL_FLOORF / HAVE_DECL_CEILF land
        # in config.h to match upstream gnulib's flow.
        "//gnulib/tests:linux_aarch64": [
            "//gnulib/m4/ceilf",
            "//gnulib/m4/floorf",
        ],
        "//conditions:default": [],
    }),
)

autoconf(
    name = "roundf-ieee",
    visibility = ["//visibility:public"],
    deps = [
        ":gl_FUNC_ROUNDF_IEEE",
    ],
)
