"""https://github.com/coreutils/gnulib/blob/1039a5f2cee3cda1c11f64a5eb3a15b2e87cd2f0/m4/rmdir.m4"""

load("//autoconf:autoconf_toolchain.bzl", autoconf = "autoconf_cache")
load("//autoconf:checks.bzl", "checks")

# gl_FUNC_RMDIR - m4/rmdir.m4
#
# M4 runs an AC_RUN_IFELSE probe (rmdir of "file/" must fail with ENOTDIR,
# rmdir of "dir/./" must fail). Cross-compile guess table:
#   linux-*|linux|midipix*|*-gnu*|gnu*    -> yes
#   mingw*|windows*                       -> no
#   *                                     -> gl_cross_guess_normal
# Linux and macOS pass natively. We keep the upstream cache var name
# (`gl_cv_func_rmdir_works`) populated because gl_FUNC_REMOVE consumes it.
autoconf(
    name = "gl_FUNC_RMDIR",
    checks = select({
        "@platforms//os:windows": [
            checks.AC_TRY_LINK(
                name = "gl_cv_func_rmdir_works",
                code = """\
#error "RMDIR_TRAILING_SLASH_BUG"
int main(void) { return 0; }
""",
            ),
        ],
        "//conditions:default": [
            checks.AC_TRY_LINK(
                name = "gl_cv_func_rmdir_works",
                code = "int main(void) { return 0; }",
            ),
        ],
    }) + [
        # case "$gl_cv_func_rmdir_works" in *yes) ;; *) REPLACE_RMDIR=1 ;; esac
        checks.AC_SUBST(
            "REPLACE_RMDIR",
            condition = "!gl_cv_func_rmdir_works",
        ),
        # HAVE_DECL_EXECVPE comes from unistd_h:defaults via toolchain defaults
        # (AC_REQUIRE([gl_UNISTD_H_DEFAULTS]) in rmdir.m4 line 11)
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//autoconf/macros/AC_CANONICAL_HOST",
        # For test compatibility
        "//autoconf/macros/AC_CHECK_INCLUDES_DEFAULT",
    ],
)

autoconf(
    name = "rmdir",
    visibility = ["//visibility:public"],
    deps = [
        ":gl_FUNC_RMDIR",
    ],
)
