"""https://github.com/coreutils/gnulib/blob/1039a5f2cee3cda1c11f64a5eb3a15b2e87cd2f0/m4/mkfifo.m4"""

load("//autoconf:autoconf_toolchain.bzl", autoconf = "autoconf_cache")
load("//autoconf:checks.bzl", "checks", "utils")

autoconf(
    name = "gl_FUNC_MKFIFO",
    checks = [
        checks.AC_TRY_LINK(
            name = "gl_cv_func_mkfifo",
            code = utils.AC_LANG_PROGRAM(
                ["#include <sys/stat.h>"],
                "return mkfifo(\" / \",0);",
            ),
        ),
        checks.AC_DEFINE(
            "HAVE_MKFIFO",
            requires = ["gl_cv_func_mkfifo"],
        ),
        checks.AC_SUBST(
            "HAVE_MKFIFO",
            condition = "gl_cv_func_mkfifo",
        ),
    ] + select({
        # M4 m4/mkfifo.m4 runs AC_RUN_IFELSE for the trailing-slash bug. On
        # macOS the SDK probe decides; Linux/glibc never had the bug.
        "@platforms//os:macos": [
            checks.AC_DEFINE(
                "MKFIFO_TRAILING_SLASH_BUG",
                if_true = 1,
                requires = ["!gl_cv_macos_sdk_modern"],
            ),
            checks.AC_SUBST(
                "REPLACE_MKFIFO",
                condition = "gl_cv_macos_sdk_modern",
                if_false = "1",
                if_true = "0",
            ),
        ],
        # Windows: mkfifo doesn't exist in MSVCRT, so the M4 takes the
        # HAVE_MKFIFO=0 branch and never sets REPLACE_MKFIFO (0); the
        # trailing-slash bug-define stays absent because the probe never ran.
        # Consumers must compile lib/mkfifo.c when HAVE_MKFIFO==0 ||
        # REPLACE_MKFIFO==1 (gnulib GL_COND_OBJ_MKFIFO).
        # Linux: cross-compile guess "yes".
        "//conditions:default": [
            checks.AC_SUBST("REPLACE_MKFIFO", "0"),
        ],
    }),
    visibility = ["//visibility:public"],
    deps = [
        "//autoconf/macros/AC_CANONICAL_HOST",  # AC_REQUIRE([AC_CANONICAL_HOST])
        "//autoconf/macros/AC_CHECK_INCLUDES_DEFAULT",
        "//gnulib/m4/gnulib-common:gl_HOST_MACOS_SDK_MODERN",
        # AC_REQUIRE([gl_SYS_STAT_H_DEFAULTS]) is a _DEFAULTS macro (toolchain defaults).
        # AC_CHECK_FUNCS_ONCE([lstat]) - probe + config.h define only; the
        # HAVE_LSTAT subst keeps its gl_SYS_STAT_H_DEFAULTS value.
        "//gnulib/m4/lstat:AC_CHECK_FUNCS_ONCE_lstat",
    ],
)

autoconf(
    name = "mkfifo",
    visibility = ["//visibility:public"],
    deps = [
        ":gl_FUNC_MKFIFO",
    ],
)
