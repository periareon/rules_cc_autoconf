"""https://github.com/coreutils/gnulib/blob/1039a5f2cee3cda1c11f64a5eb3a15b2e87cd2f0/m4/chmod.m4"""

load("//autoconf:autoconf_toolchain.bzl", autoconf = "autoconf_cache")
load("//autoconf:checks.bzl", "checks")

autoconf(
    name = "gl_FUNC_CHMOD",
    checks = [
        # Equivalent to gl_FUNC_CHMOD macro from chmod.m4
        # Note: Full implementation includes runtime checks for trailing slash
        # handling that are not easily replicable in Bazel
        checks.AC_CHECK_FUNC(
            "chmod",
            define = "HAVE_CHMOD",
        ),
    ] + select({
        # gl_cv_func_chmod_works is an AC_RUN_IFELSE probe (trailing slash on a
        # non-directory must fail with ENOTDIR). M4 guesses "no" on AIX and
        # native Windows (error EINVAL there) and "yes" on glibc, musl,
        # macOS, the BSDs, Solaris, Haiku and Cygwin.
        "@platforms//os:windows": [
            checks.AC_SUBST("REPLACE_CHMOD", 1),
        ],
        "//conditions:default": [],
    }),
    visibility = ["//visibility:public"],
    deps = [
        "//gnulib/m4/sys_stat_h",  # AC_REQUIRE([gl_SYS_STAT_H_DEFAULTS])
        "//autoconf/macros/AC_CANONICAL_HOST",  # AC_REQUIRE([AC_CANONICAL_HOST])
        # Note: AC_CHECK_INCLUDES_DEFAULT is added for test compatibility
        # (golden files include standard header checks even though not AC_REQUIREd)
        "//autoconf/macros/AC_CHECK_INCLUDES_DEFAULT",
    ],
)

# m4 line 86: gl_PREREQ_CHMOD - prerequisites of lib/chmod.c (none).
autoconf(
    name = "gl_PREREQ_CHMOD",
    checks = [],
    visibility = ["//visibility:public"],
)

autoconf(
    name = "chmod",
    visibility = ["//visibility:public"],
    deps = [
        ":gl_FUNC_CHMOD",
        ":gl_PREREQ_CHMOD",
    ],
)
