"""https://github.com/coreutils/gnulib/blob/1039a5f2cee3cda1c11f64a5eb3a15b2e87cd2f0/m4/dirent_h.m4"""

load("//autoconf:autoconf_defaults.bzl", "autoconf_defaults")
load("//autoconf:autoconf_toolchain.bzl", autoconf = "autoconf_cache")
load("//autoconf:checks.bzl", "checks", "macros")
load("//gnulib:macros.bzl", gl_macros = "macros")

# Sets DIR_HAS_FD_MEMBER based on platform
autoconf(
    name = "gl_DIRENT_DIR",
    checks = select({
        "@platforms//os:windows": [
            checks.AC_SUBST("DIR_HAS_FD_MEMBER", 0),
        ],
        "//conditions:default": [
            checks.AC_SUBST("DIR_HAS_FD_MEMBER", 1),
        ],
    }),
    default_deps = [
        ":defaults",  # through a macro it invokes: gl_DIRENT_H_DEFAULTS
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//autoconf/macros/AC_CANONICAL_HOST",
    ],
)

autoconf(
    name = "gl_DIRENT_H",
    checks = macros.AC_CHECK_HEADERS(
        ["dirent.h"],
    ) + gl_macros.GL_CHECK_NEXT_HEADERS(
        ["dirent.h"],
    ) + [
        checks.AC_SUBST(
            "HAVE_DIRENT_H",
            condition = "ac_cv_header_dirent_h",
        ),
    ],
    default_deps = [
        ":defaults",  # AC_REQUIRE: gl_DIRENT_H_DEFAULTS
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//gnulib/m4/include_next",
        ":gl_DIRENT_DIR",
        # Note: AC_CHECK_INCLUDES_DEFAULT is added for test compatibility
        # (golden files include standard header checks even though not AC_REQUIREd)
        "//autoconf/macros/AC_CHECK_INCLUDES_DEFAULT",
    ],
)

autoconf_defaults(
    name = "gl_DIRENT_H_DEFAULTS",
    substs = {
        "HAVE_ALPHASORT": "1",
        "HAVE_CLOSEDIR": "1",
        "HAVE_DECL_DIRFD": "1",
        "HAVE_DECL_FDOPENDIR": "1",
        "HAVE_FDOPENDIR": "1",
        "HAVE_OPENDIR": "1",
        "HAVE_READDIR": "1",
        "HAVE_REWINDDIR": "1",
        "HAVE_SCANDIR": "1",
        "REPLACE_CLOSEDIR": "0",
        "REPLACE_DIRFD": "0",
        "REPLACE_FDOPENDIR": "0",
        "REPLACE_OPENDIR": "0",
        "REPLACE_READDIR": "0",
        "REPLACE_REWINDDIR": "0",
    },
    visibility = ["//visibility:private"],
)

autoconf_defaults(
    name = "gl_DIRENT_H_REQUIRE_DEFAULTS",
    substs = {
        "GNULIB_ALPHASORT": "0",
        "GNULIB_CLOSEDIR": "0",
        "GNULIB_DIRFD": "0",
        "GNULIB_FDOPENDIR": "0",
        "GNULIB_OPENDIR": "0",
        "GNULIB_READDIR": "0",
        "GNULIB_REWINDDIR": "0",
        "GNULIB_SCANDIR": "0",
    },
    visibility = ["//visibility:private"],
    deps = [
        ":gl_DIRENT_H_DEFAULTS",
    ],
)

autoconf_defaults(
    name = "defaults",
    visibility = ["//visibility:public"],
    deps = [
        ":gl_DIRENT_H_REQUIRE_DEFAULTS",
    ],
)

autoconf(
    name = "dirent_h",
    default_deps = [
        "//gnulib/m4/unistd_h:defaults",  # module: gl_DIRENT_H_REQUIRE_DEFAULTS invokes gl_UNISTD_H_REQUIRE_DEFAULTS, for REPLACE_FCHDIR
        ":defaults",  # the header's own defaults, as its m4 requires
    ],
    visibility = ["//visibility:public"],
    deps = [
        ":gl_DIRENT_DIR",
        ":gl_DIRENT_H",
    ],
)
