"""https://github.com/coreutils/gnulib/blob/1039a5f2cee3cda1c11f64a5eb3a15b2e87cd2f0/m4/unlockpt.m4"""

load("//autoconf:autoconf_toolchain.bzl", autoconf = "autoconf_cache")
load("//autoconf:checks.bzl", "checks")

autoconf(
    name = "gl_FUNC_UNLOCKPT",
    checks = [
        # AC_CHECK_FUNCS([unlockpt]): HAVE_UNLOCKPT is only #defined when found.
        checks.AC_CHECK_FUNC(
            "unlockpt",
            define = "HAVE_UNLOCKPT",
        ),
        # if test $ac_cv_func_unlockpt = no; then HAVE_UNLOCKPT=0
        checks.AC_SUBST(
            "HAVE_UNLOCKPT",
            condition = "ac_cv_func_unlockpt",
            if_false = 0,
            if_true = 1,
        ),
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//autoconf/macros/AC_CHECK_INCLUDES_DEFAULT",
        "//gnulib/m4/extensions",  # AC_REQUIRE([AC_USE_SYSTEM_EXTENSIONS])
    ],
)

# Prerequisites of lib/unlockpt.c.
autoconf(
    name = "gl_PREREQ_UNLOCKPT",
    checks = [
        # gl_PREREQ_UNLOCKPT: AC_CHECK_FUNCS([revoke]) - config.h only.
        checks.AC_CHECK_FUNC(
            "revoke",
            define = "HAVE_REVOKE",
        ),
    ],
    visibility = ["//visibility:public"],
)

autoconf(
    name = "unlockpt",
    visibility = ["//visibility:public"],
    deps = [
        ":gl_FUNC_UNLOCKPT",
        ":gl_PREREQ_UNLOCKPT",
    ],
)
