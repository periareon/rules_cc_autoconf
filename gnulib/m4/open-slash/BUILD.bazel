"""https://github.com/coreutils/gnulib/blob/1039a5f2cee3cda1c11f64a5eb3a15b2e87cd2f0/m4/open-slash.m4"""

load("//autoconf:autoconf_toolchain.bzl", autoconf = "autoconf_cache")
load("//autoconf:checks.bzl", "checks")

autoconf(
    name = "open-slash",
    # gl_OPEN_TRAILING_SLASH_BUG runs AC_RUN_IFELSE; cross-compile guess
    # for darwin falls to gl_cross_guess_normal ("no" = bug present). On
    # macOS the SDK probe decides; elsewhere M4's guess of "yes" applies.
    checks = select({
        "@platforms//os:macos": [
            checks.AC_DEFINE(
                "OPEN_TRAILING_SLASH_BUG",
                if_true = 1,
                requires = ["!gl_cv_macos_sdk_modern"],
            ),
        ],
        "//conditions:default": [],
    }),
    visibility = ["//visibility:public"],
    deps = [
        "//autoconf/macros/AC_CHECK_INCLUDES_DEFAULT",
        "//gnulib/m4/gnulib-common:gl_HOST_MACOS_SDK_MODERN",
        # HAVE_LSTAT define (single source of truth)
        "//gnulib/m4/lstat:HAVE_LSTAT",
    ],
)
