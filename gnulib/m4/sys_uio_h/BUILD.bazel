"""https://github.com/coreutils/gnulib/blob/1039a5f2cee3cda1c11f64a5eb3a15b2e87cd2f0/m4/sys_uio_h.m4"""

load("//autoconf:autoconf_defaults.bzl", "autoconf_defaults")
load("//autoconf:autoconf_toolchain.bzl", autoconf = "autoconf_cache")
load("//autoconf:checks.bzl", "checks")
load("//gnulib:macros.bzl", gl_macros = "macros")

autoconf(
    name = "sys_uio_h",
    checks = [
        checks.AC_CHECK_HEADER(
            "sys/uio.h",
            define = "HAVE_SYS_UIO_H",
            subst = "HAVE_SYS_UIO_H",
        ),
    ] + gl_macros.GL_CHECK_NEXT_HEADERS(["sys/uio.h"]) + [
    ],
    default_deps = [
        ":defaults",  # the header's own defaults, as its m4 requires
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//gnulib/m4/include_next",

        # Note: AC_CHECK_INCLUDES_DEFAULT is added for test compatibility
        "//autoconf/macros/AC_CHECK_INCLUDES_DEFAULT",
    ],
)

# Note: sys_uio_h has _DEFAULTS but no variables in it
autoconf_defaults(
    name = "gl_SYS_UIO_H_DEFAULTS",
    visibility = ["//visibility:private"],
)

# Note: sys_uio_h has _REQUIRE_DEFAULTS but no GNULIB_* variables
autoconf_defaults(
    name = "gl_SYS_UIO_H_REQUIRE_DEFAULTS",
    visibility = ["//visibility:private"],
    deps = [
        ":gl_SYS_UIO_H_DEFAULTS",
    ],
)

autoconf_defaults(
    name = "defaults",
    visibility = ["//visibility:public"],
    deps = [
        ":gl_SYS_UIO_H_REQUIRE_DEFAULTS",
    ],
)
