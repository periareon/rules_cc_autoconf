"""https://github.com/coreutils/gnulib/blob/1039a5f2cee3cda1c11f64a5eb3a15b2e87cd2f0/m4/frexp.m4"""

load("//autoconf:autoconf_toolchain.bzl", autoconf = "autoconf_cache")
load("//autoconf:checks.bzl", "checks")

# gl_CHECK_FREXP_NO_LIBM: frexp() is available in libc without -lm.  This is
# true on modern systems (macOS, Linux glibc).  printf-frexp needs only this
# probe, not gl_FUNC_FREXP and its math.h defaults.
autoconf(
    name = "gl_CHECK_FREXP_NO_LIBM",
    checks = [
        checks.AC_DEFINE("HAVE_FREXP_IN_LIBC", "1"),
        # The shell variable gl_CONDITIONAL([GL_COND_OBJ_FREXP], [test $gl_func_frexp_no_libm = no])
        # reads: frexp works without -lm wherever HAVE_FREXP_IN_LIBC holds.
        checks.M4_VARIABLE("gl_func_frexp_no_libm", "yes"),
    ],
    visibility = ["//visibility:public"],
)

autoconf(
    name = "frexp",
    checks = [
        # gl_FUNC_FREXP checks for frexp function
        checks.AC_CHECK_FUNC(
            "frexp",
            define = "HAVE_FREXP",
        ),
        # Canonical owner of FREXP_LIBM (empty on macOS); asinl/acosl get it from here to avoid duplicate in //... build
        checks.AC_SUBST("FREXP_LIBM", ""),
        # gl_FUNC_FREXP's verdict after gl_FUNC_FREXP_WORKS: frexp works on every
        # libc the ports support, so the module's object is not compiled
        # (gl_CONDITIONAL([GL_COND_OBJ_FREXP], [test $gl_func_frexp_no_libm = no || test $gl_func_frexp = no])).
        checks.M4_VARIABLE("gl_func_frexp", "yes"),
    ],
    default_deps = [
        "//gnulib/m4/math_h:defaults",  # AC_REQUIRE: gl_MATH_H_DEFAULTS
    ],
    visibility = ["//visibility:public"],
    deps = [
        ":gl_CHECK_FREXP_NO_LIBM",  # AC_REQUIRE([gl_CHECK_FREXP_NO_LIBM])
        "//gnulib/m4/extensions",  # AC_REQUIRE([gl_USE_SYSTEM_EXTENSIONS])
        "//gnulib/m4/math_h",  # AC_REQUIRE([gl_MATH_H_DEFAULTS])
        "//autoconf/macros/AC_CHECK_DECLS_ONCE_ALARM",  # AC_CHECK_DECLS_ONCE([alarm]) in gl_FUNC_FREXP_WORKS
        # For test compatibility
        "//autoconf/macros/AC_CHECK_INCLUDES_DEFAULT",
    ],
)
