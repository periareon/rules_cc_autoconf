"""https://github.com/coreutils/gnulib/blob/1039a5f2cee3cda1c11f64a5eb3a15b2e87cd2f0/m4/save-cwd.m4"""

load("//autoconf:autoconf_toolchain.bzl", autoconf = "autoconf_cache")

autoconf(
    name = "gl_SAVE_CWD",
    checks = [
        # gl_SAVE_CWD is just AC_CHECK_FUNCS_ONCE([fchdir]): the config.h
        # define only; the HAVE_FCHDIR subst keeps its gl_UNISTD_H_DEFAULTS value.
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//gnulib/m4/fchdir:AC_CHECK_FUNCS_ONCE_fchdir",
        # For test compatibility
        "//autoconf/macros/AC_CHECK_INCLUDES_DEFAULT",
    ],
)

autoconf(
    name = "save-cwd",
    visibility = ["//visibility:public"],
    deps = [
        ":gl_SAVE_CWD",
    ],
)
