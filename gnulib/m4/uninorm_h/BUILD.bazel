"""https://github.com/coreutils/gnulib/blob/1039a5f2cee3cda1c11f64a5eb3a15b2e87cd2f0/m4/uninorm_h.m4"""

load("//autoconf:autoconf_defaults.bzl", "autoconf_defaults")
load("//autoconf:autoconf_toolchain.bzl", autoconf = "autoconf_cache")

autoconf(
    name = "gl_UNINORM_H",
    checks = [
        # No actual checks - just initializes defaults
    ],
    default_deps = [
        ":defaults",  # AC_REQUIRE: gl_UNINORM_H_DEFAULTS
    ],
    visibility = ["//visibility:public"],
)

autoconf(
    name = "gl_UNINORM_MODULE_INDICATOR",
    checks = [
        # No actual checks - just initializes defaults
    ],
    default_deps = [
        ":defaults",  # through a macro it invokes: gl_UNINORM_H_DEFAULTS
    ],
    visibility = ["//visibility:public"],
)

autoconf_defaults(
    name = "gl_UNINORM_H_DEFAULTS",
    visibility = ["//visibility:private"],
)

autoconf_defaults(
    name = "gl_UNINORM_H_REQUIRE_DEFAULTS",
    substs = {
        "GNULIB_UNINORM_NFC_DLL_VARIABLE": "LIBUNISTRING_DLL_VARIABLE",
        # gl_MODULE_INDICATOR_INIT_VARIABLE defaults from uninorm_h.m4
        "GNULIB_UNINORM_NFD_DLL_VARIABLE": "LIBUNISTRING_DLL_VARIABLE",
        "GNULIB_UNINORM_NFKC_DLL_VARIABLE": "LIBUNISTRING_DLL_VARIABLE",
        "GNULIB_UNINORM_NFKD_DLL_VARIABLE": "LIBUNISTRING_DLL_VARIABLE",
    },
    visibility = ["//visibility:private"],
    deps = [
        ":gl_UNINORM_H_DEFAULTS",
    ],
)

autoconf_defaults(
    name = "defaults",
    visibility = ["//visibility:public"],
    deps = [
        ":gl_UNINORM_H_REQUIRE_DEFAULTS",
    ],
)

autoconf(
    name = "uninorm_h",
    default_deps = [
        ":defaults",  # the header's own defaults, as its m4 requires
    ],
    visibility = ["//visibility:public"],
    deps = [
        ":gl_UNINORM_H",
        ":gl_UNINORM_MODULE_INDICATOR",
    ],
)
