"""https://github.com/coreutils/gnulib/blob/1039a5f2cee3cda1c11f64a5eb3a15b2e87cd2f0/m4/wcsnrtombs.m4"""

load("//autoconf:autoconf_toolchain.bzl", autoconf = "autoconf_cache")
load("//autoconf:checks.bzl", "checks")
load("//gnulib:macros.bzl", gl_macros = "macros")

autoconf(
    name = "gl_FUNC_WCSNRTOMBS",
    checks = gl_macros.GL_CHECK_FUNCS_ANDROID(
        ["wcsnrtombs"],
        includes = ["#include <wchar.h>"],
    ) + [
        checks.AC_SUBST(
            "HAVE_WCSNRTOMBS",
            condition = "ac_cv_func_wcsnrtombs",
            if_false = 0,
            if_true = 1,
        ),
        checks.AC_SUBST("REPLACE_WCSNRTOMBS", 0),
    ],
    visibility = ["//visibility:public"],
    deps = [
        # Note: wchar_h provides HAVE_DECL_WCSDUP, but golden file expects it undefined
        # "//gnulib/m4/wchar_h",  # AC_REQUIRE([gl_WCHAR_H_DEFAULTS]) - but pulls in HAVE_DECL_WCSDUP
        ":gl_WCSNRTOMBS_WORKS_IN_TRADITIONAL_LOCALE",
        "//autoconf/macros/AC_TYPE_MBSTATE_T",
        "//gnulib/m4/mbrtowc:gl_MBSTATE_T_BROKEN",
    ],
)

autoconf(
    name = "gl_PREREQ_WCSNRTOMBS",
    visibility = ["//gnulib:__subpackages__"],
)

autoconf(
    name = "gl_WCSNRTOMBS_WORKS_IN_TRADITIONAL_LOCALE",
    visibility = ["//gnulib:__subpackages__"],
    deps = [
        "//autoconf/macros/AC_CANONICAL_HOST",
        "//gnulib/m4/locale-fr",
    ],
)

autoconf(
    name = "wcsnrtombs",
    visibility = ["//visibility:public"],
    deps = [
        ":gl_FUNC_WCSNRTOMBS",
        ":gl_PREREQ_WCSNRTOMBS",
        ":gl_WCSNRTOMBS_WORKS_IN_TRADITIONAL_LOCALE",
    ],
)
