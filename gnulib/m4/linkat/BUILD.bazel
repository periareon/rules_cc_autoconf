"""https://github.com/coreutils/gnulib/blob/1039a5f2cee3cda1c11f64a5eb3a15b2e87cd2f0/m4/linkat.m4"""

load("//autoconf:autoconf_toolchain.bzl", autoconf = "autoconf_cache")
load("//autoconf:checks.bzl", "checks")

autoconf(
    name = "gl_FUNC_LINKAT",
    checks = [
        # Note: HAVE_SYMLINK is already provided by openat -> fcntl_h -> fcntl-o
        # (AC_CHECK_FUNCS_ONCE([symlink]), config.h define only)

        # gl_CHECK_FUNCS_ANDROID is similar to AC_CHECK_FUNC but with Android-specific handling
        checks.AC_CHECK_FUNC(
            "linkat",
            define = "HAVE_LINKAT",
            subst = True,
        ),

        # gl_FUNC_LINK_FOLLOWS_SYMLINK (AC_REQUIREd) provides LINK_FOLLOWS_SYMLINKS
        # and the readlink probe (see link-follow).

        # Runtime checks for linkat behavior (lines 25-102) can't be easily ported
        # Based on golden files, on macOS:
        # - LINKAT_SYMLINK_NOTSUP=0 (linkat can create hardlinks to symlinks)
        # - LINKAT_TRAILING_SLASH_BUG=1 (linkat fails to recognize trailing slash)
        # - REPLACE_LINKAT=1 (linkat needs replacement due to bugs)
    ] + select({
        # Linux: linkat works.
        "@platforms//os:linux": [
            checks.AC_SUBST("REPLACE_LINKAT", 0),
        ],
        # macOS: runtime probes for LINKAT_SYMLINK_NOTSUP /
        # LINKAT_TRAILING_SLASH_BUG; SDK probe drives both bug-defines and
        # the REPLACE_LINKAT subst.
        "@platforms//os:macos": [
            checks.AC_DEFINE(
                "LINKAT_SYMLINK_NOTSUP",
                if_true = 0,
                requires = ["!gl_cv_macos_sdk_modern"],
            ),
            checks.AC_DEFINE(
                "LINKAT_TRAILING_SLASH_BUG",
                if_true = 1,
                requires = ["!gl_cv_macos_sdk_modern"],
            ),
            checks.AC_SUBST(
                "REPLACE_LINKAT",
                condition = "gl_cv_macos_sdk_modern",
                if_false = "1",
                if_true = "0",
            ),
        ],
        # Windows: without linkat the M4 sets HAVE_LINKAT=0 and leaves
        # REPLACE_LINKAT alone (0; no "future" declaration there). Consumers
        # must compile lib/linkat.c when HAVE_LINKAT==0 || REPLACE_LINKAT==1
        # (gnulib GL_COND_OBJ_LINKAT).
        "//conditions:default": [
            checks.AC_SUBST("REPLACE_LINKAT", 0),
        ],
    }),
    visibility = ["//visibility:public"],
    deps = [
        "//autoconf/macros/AC_CANONICAL_HOST",  # AC_REQUIRE([AC_CANONICAL_HOST])
        "//autoconf/macros/AC_CHECK_INCLUDES_DEFAULT",
        "//gnulib/m4/extensions",  # AC_REQUIRE([gl_USE_SYSTEM_EXTENSIONS])
        "//gnulib/m4/gnulib-common:gl_HOST_MACOS_SDK_MODERN",
        "//gnulib/m4/link-follow:gl_FUNC_LINK_FOLLOWS_SYMLINK",  # AC_REQUIRE([gl_FUNC_LINK_FOLLOWS_SYMLINK])
        "//gnulib/m4/openat:gl_FUNC_OPENAT",  # AC_REQUIRE([gl_FUNC_OPENAT])
        # AC_REQUIRE([gl_UNISTD_H_DEFAULTS]) is a _DEFAULTS macro (toolchain defaults).
    ],
)

autoconf(
    name = "linkat",
    visibility = ["//visibility:public"],
    deps = [
        ":gl_FUNC_LINKAT",
    ],
)
