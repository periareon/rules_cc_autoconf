"""https://github.com/coreutils/gnulib/blob/1039a5f2cee3cda1c11f64a5eb3a15b2e87cd2f0/m4/opendir.m4"""

load("//autoconf:autoconf_toolchain.bzl", autoconf = "autoconf_cache")
load("//autoconf:checks.bzl", "checks")

autoconf(
    name = "gl_FUNC_OPENDIR",
    checks = [
        checks.AC_CHECK_FUNC(
            "opendir",
            name = "_gl_cv_func_opendir",
        ),

        # Set HAVE_OPENDIR as define if function exists
        checks.AC_DEFINE(
            "HAVE_OPENDIR",
            "1",
            requires = ["_gl_cv_func_opendir==1"],
        ),
        # if test $ac_cv_func_opendir = no; then HAVE_OPENDIR=0
        checks.AC_SUBST(
            "HAVE_OPENDIR",
            condition = "_gl_cv_func_opendir",
        ),

        # REPLACE_OPENDIR is set to 1 only when opendir exists and
        # - DIR_HAS_FD_MEMBER = 0 (DIR structure doesn't have fd member, e.g., on Windows), or
        # - gl_TEST_FCHDIR finds HAVE_FCHDIR = 0.
        # Without opendir the M4 sets HAVE_OPENDIR=0 and never runs
        # gl_TEST_FCHDIR, so the HAVE_FCHDIR subst keeps its default there.
        checks.AC_SUBST(
            "REPLACE_OPENDIR",
            condition = "_gl_cv_func_opendir && (DIR_HAS_FD_MEMBER==0 || !ac_cv_func_fchdir)",
        ),
    ],
    visibility = ["//visibility:public"],
    deps = [
        # Note: gl_DIRENT_H_DEFAULTS is a _DEFAULTS function, so we ignore it per user's instruction
        "//autoconf/macros/AC_CANONICAL_HOST",
        # DIR_HAS_FD_MEMBER comes from dirent_h (gl_DIRENT_DIR)
        "//gnulib/m4/dirent_h",
        "//gnulib/m4/dirent_h:gl_DIRENT_DIR",
        # AC_CHECK_FUNCS_ONCE([fchdir]) - probe + config.h define only
        "//gnulib/m4/fchdir:AC_CHECK_FUNCS_ONCE_fchdir",
        # Note: AC_CHECK_INCLUDES_DEFAULT is added for test compatibility
        "//autoconf/macros/AC_CHECK_INCLUDES_DEFAULT",
    ],
)

autoconf(
    name = "opendir",
    visibility = ["//visibility:public"],
    deps = [
        ":gl_FUNC_OPENDIR",
    ],
)
