"""https://github.com/coreutils/gnulib/blob/1039a5f2cee3cda1c11f64a5eb3a15b2e87cd2f0/m4/times.m4"""

load("//autoconf:autoconf_toolchain.bzl", autoconf = "autoconf_cache")
load("//autoconf:checks.bzl", "checks")

autoconf(
    name = "gl_FUNC_TIMES",
    checks = [
        # Note: gl_SYS_TIMES_H_DEFAULTS is a _DEFAULTS function, so we ignore it per user's instruction
        # AC_CHECK_FUNCS_ONCE([times]) defines HAVE_TIMES only when found.
        checks.AC_CHECK_FUNC(
            "times",
            define = "HAVE_TIMES",
        ),

        # if test $ac_cv_func_times = no; then
        #   HAVE_TIMES=0
        # fi
        checks.AC_SUBST(
            "HAVE_TIMES",
            condition = "ac_cv_func_times",
            if_false = 0,
            if_true = 1,
        ),
    ],
    visibility = ["//visibility:public"],
    deps = [
        # Note: gl_SYS_TIMES_H_DEFAULTS is a _DEFAULTS function, so we ignore it per user's instruction
        # HAVE_STRUCT_TMS comes from defaults via the toolchain
        "//autoconf/macros/AC_CHECK_INCLUDES_DEFAULT",
    ],
)

autoconf(
    name = "times",
    visibility = ["//visibility:public"],
    deps = [
        ":gl_FUNC_TIMES",
    ],
)
