"""https://github.com/coreutils/gnulib/blob/1039a5f2cee3cda1c11f64a5eb3a15b2e87cd2f0/m4/gethostname.m4"""

load("//autoconf:autoconf_toolchain.bzl", autoconf = "autoconf_cache")
load("//autoconf:checks.bzl", "checks")

# Provide HOST_NAME_MAX when <limits.h> lacks it.
autoconf(
    name = "gl_PREREQ_HOST_NAME_MAX",
    checks = select({
        # On Linux, HOST_NAME_MAX is defined in limits.h, don't redefine
        "@platforms//os:linux": [],
        # On macOS, HOST_NAME_MAX is not in limits.h, so we define it as 256
        "//conditions:default": [
            checks.AC_DEFINE("HOST_NAME_MAX", 256),
        ],
    }),
    visibility = ["//visibility:public"],
    deps = [
        # AC_CHECK_HEADERS_ONCE([sys/param.h]) / ([netdb.h]) - config.h defines
        # only; the HAVE_SYS_PARAM_H / HAVE_NETDB_H substitutions belong to
        # gl_UNISTD_H / gl_NETDB_H and keep their toolchain defaults here.
        # AC_CHECK_HEADERS_ONCE([sys/param.h]): the shared config.h define.
        "//gnulib/macros/HAVE_SYS_PARAM_H",
        ":gl_PREREQ_HOST_NAME_MAX_headers",
        # Deduplicate globally AC_CHECK_HEADERS_ONCE([sys/socket.h])
        "//gnulib/m4/socklen:gl_CHECK_SOCKET_HEADERS",
        # Note: AC_CHECK_INCLUDES_DEFAULT is added for test compatibility
        "//autoconf/macros/AC_CHECK_INCLUDES_DEFAULT",
    ],
)

# AC_CHECK_HEADERS_ONCE([netdb.h]) from gl_PREREQ_HOST_NAME_MAX:
# only the config.h defines (no substitution).
autoconf(
    name = "gl_PREREQ_HOST_NAME_MAX_headers",
    checks = [
        checks.AC_CHECK_HEADER(
            "netdb.h",
            define = "HAVE_NETDB_H",
        ),
    ],
    visibility = ["//visibility:private"],
    deps = [
        "//autoconf/macros/AC_CHECK_INCLUDES_DEFAULT",
        "//gnulib/macros/HAVE_SYS_PARAM_H:ac_cv_header_sys_param_h",
    ],
)

# Prerequisites of lib/gethostname.c.
autoconf(
    name = "gl_PREREQ_GETHOSTNAME",
    checks = [
        # if test "$gl_cv_w32_gethostname" != "yes"; then
        #   AC_CHECK_FUNCS([uname])   (config.h define only; the HAVE_UNAME
        #                              subst keeps the gl_SYS_UTSNAME_H_DEFAULTS value)
        # fi
        # gl_cv_w32_gethostname=yes is exactly GETHOSTNAME_LIB="-lws2_32".
        # The probe is the shared //gnulib/m4/uname:AC_CHECK_FUNCS_uname: uname
        # does not exist where gl_cv_w32_gethostname is yes, so the result is
        # the same without gating on GETHOSTNAME_LIB.
    ],
    visibility = ["//visibility:public"],
    deps = [
        ":gl_FUNC_GETHOSTNAME",
        "//gnulib/m4/uname:AC_CHECK_FUNCS_uname",
        # Note: AC_CHECK_INCLUDES_DEFAULT is added for test compatibility
        "//autoconf/macros/AC_CHECK_INCLUDES_DEFAULT",
    ],
)

# Ensure the gethostname() function and HOST_NAME_MAX macro.
autoconf(
    name = "gl_FUNC_GETHOSTNAME",
    checks = [
        # Note: gl_UNISTD_H_DEFAULTS is a _DEFAULTS function, so we ignore it per user's instruction
        # gl_PREREQ_SYS_H_WINSOCK2 - line 15 (not ported, likely Windows-specific)

        # This creates ac_cv_func_gethostname cache variable and HAVE_GETHOSTNAME define
        checks.AC_CHECK_FUNC(
            "gethostname",
            define = "HAVE_GETHOSTNAME",
            subst = True,
        ),

        # GETHOSTNAME_LIB=
        # AC_CHECK_FUNCS([gethostname], , [
        #   AC_CACHE_CHECK([for gethostname in winsock2.h and -lws2_32],
        #     [gl_cv_w32_gethostname], link gethostname(NULL, 0) with -lws2_32)
        #   if yes: GETHOSTNAME_LIB="-lws2_32"])
        # On Unix gethostname is in libc ("" from the first search step); on
        # native Windows it is only found in ws2_32 ("-lws2_32").
        checks.AC_SEARCH_LIBS(
            "gethostname",
            ["ws2_32"],
            name = "gl_cv_w32_gethostname",
            subst = "GETHOSTNAME_LIB",
        ),

        # Note: gl_PREREQ_HOST_NAME_MAX sets HAVE_SYS_PARAM_H subst variable
    ],
    visibility = ["//visibility:public"],
    deps = [
        # Note: gl_UNISTD_H_DEFAULTS is a _DEFAULTS function, so we don't track it as a dependency
        # This sets HOST_NAME_MAX and checks for sys/param.h, sys/socket.h, netdb.h
        ":gl_PREREQ_HOST_NAME_MAX",
        # gl_PREREQ_SYS_H_WINSOCK2 - line 15
        "//gnulib/m4/sys_socket_h:gl_PREREQ_SYS_H_WINSOCK2",
        # Note: AC_CHECK_INCLUDES_DEFAULT is added for test compatibility
        "//autoconf/macros/AC_CHECK_INCLUDES_DEFAULT",
    ],
)

# Top-level target that aggregates all AC_DEFUN functions
autoconf(
    name = "gethostname",
    checks = [],
    visibility = ["//visibility:public"],
    deps = [
        ":gl_FUNC_GETHOSTNAME",
        # gl_PREREQ_GETHOSTNAME is not called by gl_FUNC_GETHOSTNAME,
        # but may be called directly in configure.ac, so include it
        ":gl_PREREQ_GETHOSTNAME",
    ],
)
