"""https://github.com/coreutils/gnulib/blob/1039a5f2cee3cda1c11f64a5eb3a15b2e87cd2f0/m4/wcslen.m4"""

load("//autoconf:autoconf_toolchain.bzl", autoconf = "autoconf_cache")
load("//autoconf:checks.bzl", "checks")

# AC_CHECK_FUNCS([wcslen]) - the bare probe plus its config.h define.
# vasnprintf only runs this probe and must not inherit gl_FUNC_WCSLEN's
# wchar.h defaults.
autoconf(
    name = "AC_CHECK_FUNCS_wcslen",
    checks = [
        checks.AC_CHECK_FUNC(
            "wcslen",
            name = "ac_cv_func_wcslen",
        ),
        # Define HAVE_WCSLEN in config.h if function exists
        checks.AC_DEFINE(
            "HAVE_WCSLEN",
            requires = ["ac_cv_func_wcslen==1"],
        ),
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//autoconf/macros/AC_CHECK_INCLUDES_DEFAULT",
    ],
)

autoconf(
    name = "wcslen",
    checks = [
        # if test $ac_cv_func_wcslen = no; then
        # fi
        # Set HAVE_WCSLEN as substitution variable (subst.h)
        # AC_SUBST with condition creates the variable regardless of condition result
    ],
    default_deps = [
        "//gnulib/m4/wchar_h:defaults",  # AC_REQUIRE: gl_WCHAR_H_DEFAULTS
    ],
    visibility = ["//visibility:public"],
    deps = [
        ":AC_CHECK_FUNCS_wcslen",  # AC_CHECK_FUNCS_ONCE([wcslen])
        # Note: gl_WCHAR_H_DEFAULTS is a _DEFAULTS function, so we ignore it per user's instruction
        "//autoconf/macros/AC_CHECK_INCLUDES_DEFAULT",
    ],
)
