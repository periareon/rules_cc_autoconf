"""https://github.com/coreutils/gnulib/blob/1039a5f2cee3cda1c11f64a5eb3a15b2e87cd2f0/m4/sys_ioctl_h.m4"""

load("//autoconf:autoconf_defaults.bzl", "autoconf_defaults")
load("//autoconf:autoconf_toolchain.bzl", autoconf = "autoconf_cache")
load("//autoconf:checks.bzl", "checks")
load("//gnulib:macros.bzl", gl_macros = "macros")

# gl_SYS_IOCTL_H - Header check and GNULIB module indicators

autoconf(
    name = "ac_cv_header_sys_ioctl_h",
    checks = [
        checks.AC_CHECK_HEADER(
            "sys/ioctl.h",
            define = "HAVE_SYS_IOCTL_H",
        ),
    ],
    visibility = ["//gnulib:__subpackages__"],
)

autoconf(
    name = "gl_SYS_IOCTL_H",
    checks = [
        checks.AC_SUBST(
            "HAVE_SYS_IOCTL_H",
            condition = "ac_cv_header_sys_ioctl_h",
        ),
    ] + gl_macros.GL_CHECK_NEXT_HEADERS(["sys/ioctl.h"]) + [
    ],
    default_deps = [
        ":defaults",  # AC_REQUIRE: gl_SYS_IOCTL_H_DEFAULTS
    ],
    visibility = ["//visibility:public"],
    deps = [
        ":ac_cv_header_sys_ioctl_h",
        "//gnulib/m4/include_next",

        # Note: AC_CHECK_INCLUDES_DEFAULT is added for test compatibility
        "//autoconf/macros/AC_CHECK_INCLUDES_DEFAULT",
    ],
)

autoconf_defaults(
    name = "gl_SYS_IOCTL_H_DEFAULTS",
    substs = {
        "REPLACE_IOCTL": "0",
        "SYS_IOCTL_H_HAVE_WINSOCK2_H": "0",
        "SYS_IOCTL_H_HAVE_WINSOCK2_H_AND_USE_SOCKETS": "0",
    },
    visibility = ["//visibility:private"],
)

autoconf_defaults(
    name = "gl_SYS_IOCTL_H_REQUIRE_DEFAULTS",
    substs = {
        "GNULIB_IOCTL": "0",
    },
    visibility = ["//visibility:private"],
    deps = [
        ":gl_SYS_IOCTL_H_DEFAULTS",
    ],
)

autoconf_defaults(
    name = "defaults",
    visibility = ["//visibility:public"],
    deps = [
        ":gl_SYS_IOCTL_H_REQUIRE_DEFAULTS",
    ],
)

autoconf(
    name = "sys_ioctl_h",
    default_deps = [
        ":defaults",  # the header's own defaults, as its m4 requires
    ],
    visibility = ["//visibility:public"],
    deps = [
        ":gl_SYS_IOCTL_H",
    ],
)
