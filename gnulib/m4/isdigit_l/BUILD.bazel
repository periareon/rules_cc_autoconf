"""https://github.com/coreutils/gnulib/blob/1039a5f2cee3cda1c11f64a5eb3a15b2e87cd2f0/m4/isdigit_l.m4"""

load("//autoconf:autoconf_toolchain.bzl", autoconf = "autoconf_cache")
load("//autoconf:checks.bzl", "checks")

autoconf(
    name = "gl_FUNC_ISDIGIT_L",
    checks = [
        # AC_CHECK_FUNCS_ONCE([isdigit_l]): autoconf's plain link probe, which
        # declares the function itself.  A probe through <ctype.h> would miss
        # it on macOS, where isdigit_l is declared only via <xlocale.h>.
        checks.AC_CHECK_FUNC(
            "isdigit_l",
            define = "HAVE_ISDIGIT_L",
        ),
        # if test $ac_cv_func_isdigit_l = no; then HAVE_ISDIGIT_L=0; fi
        # Overrides the gl_CTYPE_H_DEFAULTS value of 1 (e.g. MSVC has no isdigit_l).
        checks.AC_SUBST(
            "HAVE_ISDIGIT_L",
            condition = "ac_cv_func_isdigit_l",
            if_false = "0",
            if_true = "1",
        ),
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//autoconf/macros/AC_CHECK_INCLUDES_DEFAULT",
        "//gnulib/m4/c-strtod",
        "//gnulib/m4/ctype_h",
        "//gnulib/m4/extensions",  # AC_REQUIRE([AC_USE_SYSTEM_EXTENSIONS]) - needed for isdigit_l to be declared
    ],
)

autoconf(
    name = "isdigit_l",
    visibility = ["//visibility:public"],
    deps = [
        ":gl_FUNC_ISDIGIT_L",
    ],
)
