"""https://github.com/coreutils/gnulib/blob/1039a5f2cee3cda1c11f64a5eb3a15b2e87cd2f0/m4/unlinkdir.m4"""

load("//autoconf:autoconf_toolchain.bzl", autoconf = "autoconf_cache")
load("//autoconf:checks.bzl", "checks")

autoconf(
    name = "gl_UNLINKDIR",
    checks = select({
        # On Linux: unprivileged processes cannot unlink directories
        "@platforms//os:linux": [
            checks.AC_DEFINE("UNLINK_CANNOT_UNLINK_DIR", "1"),
        ],
        # mingw* | windows*: never lets anyone unlink directories either
        "@platforms//os:windows": [
            checks.AC_DEFINE("UNLINK_CANNOT_UNLINK_DIR", "1"),
        ],
        "//conditions:default": [],
    }),
    visibility = ["//visibility:public"],
    deps = [
        # gl_UNLINKDIR requires neither gl_UNISTD_H nor gl_UNISTD_H_DEFAULTS;
        # HAVE_UNISTD_H is a config.h define only (AC_CHECK_HEADERS_ONCE).
        "//autoconf/macros/AC_CHECK_INCLUDES_DEFAULT",
    ],
)

autoconf(
    name = "unlinkdir",
    visibility = ["//visibility:public"],
    deps = [
        ":gl_UNLINKDIR",
    ],
)
