"""https://github.com/coreutils/gnulib/blob/1039a5f2cee3cda1c11f64a5eb3a15b2e87cd2f0/m4/gettimeofday.m4"""

load("//autoconf:autoconf_toolchain.bzl", autoconf = "autoconf_cache")
load("//autoconf:checks.bzl", "checks")

autoconf(
    name = "gl_FUNC_GETTIMEOFDAY",
    checks = [
        # Equivalent to gl_FUNC_GETTIMEOFDAY macro from gettimeofday.m4.
        # Bind both define and subst — the gnulib sys/time.h wrapper
        # template gates its own declaration on @HAVE_GETTIMEOFDAY@, so
        # without writing the subst here the wrapper would fall back to
        # the HAVE_GETTIMEOFDAY=1 default from gl_SYS_TIME_H_DEFAULTS and
        # skip the declaration on toolchains lacking gettimeofday (e.g.
        # MSVC / clang-cl on Windows).
        checks.AC_CHECK_FUNC(
            "gettimeofday",
            define = "HAVE_GETTIMEOFDAY",
            subst = "HAVE_GETTIMEOFDAY",
        ),
        # if test $ac_cv_func_gettimeofday != yes; then
        #   HAVE_GETTIMEOFDAY=0
        # else
        #   AC_CACHE_CHECK([for gettimeofday with POSIX signature],
        #     [gl_cv_func_gettimeofday_posix_signature], ...)
        checks.AC_TRY_COMPILE(
            name = "gl_cv_func_gettimeofday_posix_signature",
            code = """#include <sys/time.h>

struct timeval c;
int gettimeofday (struct timeval *restrict, void *restrict);

int main(void) {
    int (*f) (struct timeval *restrict, void *restrict) = gettimeofday;
    int x = f (&c, 0);
    return !(x | c.tv_sec | c.tv_usec);
}""",
            language = "c",
            requires = ["ac_cv_func_gettimeofday"],
        ),
        #   if test $gl_cv_func_gettimeofday_posix_signature != yes; then
        #     REPLACE_GETTIMEOFDAY=1
        #   fi
        #   if test $REPLACE_STRUCT_TIMEVAL = 1; then
        #     REPLACE_GETTIMEOFDAY=1
        #   fi
        #   case "$host_os" in
        #     mingw* | windows*) REPLACE_GETTIMEOFDAY=1 ;;
        #   esac
        # fi
    ] + select({
        "@platforms//os:windows": [
            checks.AC_SUBST(
                "REPLACE_GETTIMEOFDAY",
                condition = "ac_cv_func_gettimeofday",
                if_false = 0,
                if_true = 1,
            ),
        ],
        "//conditions:default": [
            checks.AC_SUBST(
                "REPLACE_GETTIMEOFDAY",
                condition = "ac_cv_func_gettimeofday && (!gl_cv_func_gettimeofday_posix_signature || REPLACE_STRUCT_TIMEVAL==1)",
                if_false = 0,
                if_true = 1,
            ),
        ],
    }) + [
        # GETTIMEOFDAY_TIMEZONE: The type of the second argument to gettimeofday
        # On POSIX systems it's 'void', on some older systems it's 'struct timezone'
        checks.AC_DEFINE("GETTIMEOFDAY_TIMEZONE", "void"),
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//gnulib/m4/sys_time_h",  # AC_REQUIRE([gl_SYS_TIME_H_DEFAULTS, gl_SYS_TIME_H])

        # Note: AC_CHECK_INCLUDES_DEFAULT is added for test compatibility
        "//autoconf/macros/AC_CHECK_INCLUDES_DEFAULT",
        "//autoconf/macros/AC_C_RESTRICT",  # AC_REQUIRE([AC_C_RESTRICT])
        "//autoconf/macros/AC_CANONICAL_HOST",  # AC_REQUIRE([AC_CANONICAL_HOST])
    ],
)

# AC_DEFUN([gl_PREREQ_GETTIMEOFDAY], [:])
autoconf(
    name = "gl_PREREQ_GETTIMEOFDAY",
    checks = [],
    visibility = ["//visibility:public"],
)

autoconf(
    name = "gettimeofday",
    visibility = ["//visibility:public"],
    deps = [
        ":gl_FUNC_GETTIMEOFDAY",
        ":gl_PREREQ_GETTIMEOFDAY",
    ],
)
