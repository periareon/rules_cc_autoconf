"""https://github.com/coreutils/gnulib/blob/1039a5f2cee3cda1c11f64a5eb3a15b2e87cd2f0/m4/toupper_l.m4"""

load("//autoconf:autoconf_toolchain.bzl", autoconf = "autoconf_cache")
load("//autoconf:checks.bzl", "checks")

autoconf(
    name = "gl_FUNC_TOUPPER_L",
    checks = [
        # gl_FUNC_TOUPPER_L checks for toupper_l function
        checks.AC_CHECK_FUNC(
            "toupper_l",
            define = "HAVE_TOUPPER_L",
        ),
        # if test $ac_cv_func_toupper_l = no; then HAVE_TOUPPER_L=0; fi
        # Overrides the toolchain default of 1 (e.g. MSVC has no toupper_l).
        checks.AC_SUBST(
            "HAVE_TOUPPER_L",
            condition = "ac_cv_func_toupper_l",
            if_false = "0",
            if_true = "1",
        ),
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//gnulib/m4/c-strtod",  # AC_REQUIRE([gt_FUNC_USELOCALE])
        "//gnulib/m4/wchar_h:gl_WCHAR_H_CORE",
        # For test compatibility - need basic header defines
        "//autoconf/macros/AC_CHECK_INCLUDES_DEFAULT",
    ],
)

autoconf(
    name = "toupper_l",
    visibility = ["//visibility:public"],
    deps = [
        ":gl_FUNC_TOUPPER_L",
    ],
)
