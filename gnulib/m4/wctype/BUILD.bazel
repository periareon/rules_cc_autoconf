"""https://github.com/coreutils/gnulib/blob/1039a5f2cee3cda1c11f64a5eb3a15b2e87cd2f0/m4/wctype.m4"""

load("//autoconf:autoconf_toolchain.bzl", autoconf = "autoconf_cache")
load("//autoconf:checks.bzl", "checks")

autoconf(
    name = "gl_FUNC_WCTYPE",
    checks = [
        # Equivalent to gl_FUNC_WCTYPE macro from wctype.m4
        # Note: Full implementation includes runtime checks for "blank" and "punct"
        # character classes that are not easily replicable in Bazel
        checks.AC_CHECK_FUNC(
            "wctype",
            define = "HAVE_WCTYPE",
        ),
    ] + select({
        # HAVE_WCTYPE=$HAVE_WCTYPE_T; if test $HAVE_WCTYPE = 1; then
        #   gl_cv_func_wctype_works: AC_RUN_IFELSE, "guessing no" on native
        #   Windows (mingw lacks the "blank" class, MSVC 14 iswctype disagrees
        #   with iswblank); the native run on MSVC confirms "no".
        #   case ... *yes) ;; *) REPLACE_WCTYPE=1 ;;
        "@platforms//os:windows": [
            checks.AC_SUBST(
                "REPLACE_WCTYPE",
                condition = "HAVE_WCTYPE_T==1",
                if_false = 0,
                if_true = 1,
            ),
        ],
        # Linux/macOS: the runtime test passes, REPLACE_WCTYPE keeps the
        # gl_WCTYPE_H_DEFAULTS value of 0.
        "//conditions:default": [],
    }),
    visibility = ["//visibility:public"],
    deps = [
        "//gnulib/m4/wctype_h",  # AC_REQUIRE([gl_WCTYPE_H_DEFAULTS,

        # Note: AC_CHECK_INCLUDES_DEFAULT is added for test compatibility
        "//autoconf/macros/AC_CHECK_INCLUDES_DEFAULT",
    ],
)

autoconf(
    name = "wctype",
    visibility = ["//visibility:public"],
    deps = [
        ":gl_FUNC_WCTYPE",
    ],
)
