"""https://github.com/coreutils/gnulib/blob/1039a5f2cee3cda1c11f64a5eb3a15b2e87cd2f0/m4/rpmatch.m4"""

load("//autoconf:autoconf_toolchain.bzl", autoconf = "autoconf_cache")
load("//autoconf:checks.bzl", "checks")

autoconf(
    name = "gl_FUNC_RPMATCH",
    checks = [
        # AC_CHECK_FUNCS([rpmatch])
        checks.AC_CHECK_FUNC(
            "rpmatch",
            define = "HAVE_RPMATCH",
        ),
        # if test $ac_cv_func_rpmatch = no; then HAVE_RPMATCH=0; fi
        # Overrides the gl_STDLIB_H_DEFAULTS value of 1 (e.g. on MSVC).
        checks.AC_SUBST(
            "HAVE_RPMATCH",
            condition = "ac_cv_func_rpmatch",
            if_false = 0,
            if_true = 1,
        ),
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//gnulib/m4/extensions",  # AC_REQUIRE([AC_USE_SYSTEM_EXTENSIONS])
        # Note: gl_STDLIB_H_DEFAULTS is a _DEFAULTS function, so we do not track it as a dependency
        # Note: AC_CHECK_INCLUDES_DEFAULT is added for test compatibility
        "//autoconf/macros/AC_CHECK_INCLUDES_DEFAULT",
    ],
)

# Prerequisites of lib/rpmatch.c.
autoconf(
    name = "gl_PREREQ_RPMATCH",
    checks = [],
    visibility = ["//visibility:public"],
    deps = [
        # AC_CHECK_HEADERS_ONCE([langinfo.h]) is a config.h define only;
        # gl_LANGINFO_H (which substitutes HAVE_LANGINFO_H) is not required.
        "//gnulib/m4/langinfo_h:AC_CHECK_HEADERS_ONCE_langinfo_h",
    ],
)

autoconf(
    name = "rpmatch",
    visibility = ["//visibility:public"],
    deps = [
        ":gl_FUNC_RPMATCH",
        ":gl_PREREQ_RPMATCH",
    ],
)
