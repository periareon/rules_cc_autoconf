"""https://github.com/coreutils/gnulib/blob/1039a5f2cee3cda1c11f64a5eb3a15b2e87cd2f0/m4/time_h.m4"""

load("//autoconf:autoconf_defaults.bzl", "autoconf_defaults")
load("//autoconf:autoconf_toolchain.bzl", autoconf = "autoconf_cache")
load("//autoconf:checks.bzl", "checks")
load("//gnulib:macros.bzl", gl_macros = "macros")

autoconf(
    name = "gl_TIME_H",
    checks = [
        # gl_TIME_H checks for time.h header
        checks.AC_CHECK_HEADER(
            "time.h",
            define = "HAVE_TIME_H",
        ),
    ] + gl_macros.GL_NEXT_HEADERS(["time.h"]) + [
        # AC_CACHE_CHECK([for TIME_UTC in <time.h>], ...): TIME_H_DEFINES_TIME_UTC
        checks.AC_SUBST("TIME_H_DEFINES_TIME_UTC", "1"),
    ],
    default_deps = [
        ":defaults",  # AC_REQUIRE: gl_TIME_H_DEFAULTS
    ],
    visibility = ["//visibility:public"],
    deps = [
        ":gl_CHECK_TYPE_STRUCT_TIMESPEC",  # AC_REQUIRE([gl_CHECK_TYPE_STRUCT_TIMESPEC])
        "//gnulib/m4/include_next",  # gl_NEXT_HEADERS([time.h])
        "//gnulib/m4/extensions",
        # For test compatibility
        "//autoconf/macros/AC_CHECK_INCLUDES_DEFAULT",
    ],
)

# gl_CHECK_TYPE_STRUCT_TIMESPEC - m4 lines 54-117: AC_CHECK_HEADERS_ONCE([sys/time.h])
# and the "struct timespec in <time.h> / <sys/time.h> / <pthread.h> / <unistd.h>"
# cache checks; every supported platform declares it in <time.h>.
autoconf(
    name = "gl_CHECK_TYPE_STRUCT_TIMESPEC",
    checks = [
        checks.AC_SUBST("PTHREAD_H_DEFINES_STRUCT_TIMESPEC", "0"),
        checks.AC_SUBST("SYS_TIME_H_DEFINES_STRUCT_TIMESPEC", "0"),
        checks.AC_SUBST("TIME_H_DEFINES_STRUCT_TIMESPEC", "1"),
        checks.AC_SUBST("UNISTD_H_DEFINES_STRUCT_TIMESPEC", "0"),
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//gnulib/m4/sys_time_h:HAVE_SYS_TIME_H",  # AC_CHECK_HEADERS_ONCE([sys/time.h])
        # For test compatibility
        "//autoconf/macros/AC_CHECK_INCLUDES_DEFAULT",
    ],
)

# gl_TIME_MODULE_INDICATOR([modulename]): gl_TIME_H_REQUIRE_DEFAULTS (the
# defaults are supplied through the toolchain's :defaults target) and
# GNULIB_<module>=1 for the named module; no checks of its own.
autoconf(
    name = "gl_TIME_MODULE_INDICATOR",
    checks = [],
    default_deps = [
        ":defaults",  # through a macro it invokes: gl_TIME_H_DEFAULTS
    ],
    visibility = ["//visibility:public"],
)

autoconf(
    name = "time_h",
    default_deps = [
        ":defaults",  # the header's own defaults, as its m4 requires
    ],
    visibility = ["//visibility:public"],
    deps = [
        ":gl_CHECK_TYPE_STRUCT_TIMESPEC",
        ":gl_TIME_H",
        ":gl_TIME_MODULE_INDICATOR",
    ],
)

autoconf_defaults(
    name = "gl_TIME_H_DEFAULTS",
    substs = {
        "HAVE_DECL_LOCALTIME_R": "1",
        "HAVE_NANOSLEEP": "1",
        "HAVE_STRPTIME": "1",
        "HAVE_TIMEGM": "1",
        "HAVE_TIMESPEC_GET": "1",
        "HAVE_TIMESPEC_GETRES": "1",
        "HAVE_TIMEZONE_T": "0",
        "HAVE_TZALLOC": "0",
        "REPLACE_CTIME": "0",
        "REPLACE_GMTIME": "0",
        "REPLACE_LOCALTIME": "0",
        "REPLACE_LOCALTIME_R": "0",
        "REPLACE_LOCALTIME_RZ": "0",
        "REPLACE_MKTIME": "0",
        "REPLACE_MKTIME_Z": "0",
        "REPLACE_NANOSLEEP": "0",
        "REPLACE_STRFTIME": "0",
        "REPLACE_TIME": "0",
        "REPLACE_TIMEGM": "0",
        "REPLACE_TIMESPEC_GET": "0",
        "REPLACE_TIMESPEC_GETRES": "0",
        "REPLACE_TZSET": "0",
    },
    visibility = ["//visibility:private"],
)

autoconf_defaults(
    name = "gl_TIME_H_REQUIRE_DEFAULTS",
    substs = {
        "GNULIB_ASCTIME": "0",
        "GNULIB_ASCTIME_R": "0",
        "GNULIB_CTIME": "0",
        "GNULIB_CTIME_R": "0",
        "GNULIB_GMTIME": "0",
        "GNULIB_GMTIME_R": "0",
        "GNULIB_LOCALTIME": "0",
        "GNULIB_LOCALTIME_R": "0",
        # Microsoft deprecated alias function names
        "GNULIB_MDA_TZSET": "1",
        "GNULIB_MKTIME": "0",
        "GNULIB_NANOSLEEP": "0",
        "GNULIB_STRFTIME": "0",
        "GNULIB_STRPTIME": "0",
        "GNULIB_TIME": "0",
        "GNULIB_TIMEGM": "0",
        "GNULIB_TIMESPEC_GET": "0",
        "GNULIB_TIMESPEC_GETRES": "0",
        "GNULIB_TIME_R": "0",
        "GNULIB_TIME_RZ": "0",
        "GNULIB_TZNAME": "0",
        "GNULIB_TZSET": "0",
    },
    visibility = ["//visibility:private"],
    deps = [
        ":gl_TIME_H_DEFAULTS",
    ],
)

autoconf_defaults(
    name = "defaults",
    visibility = ["//visibility:public"],
    deps = [
        ":gl_TIME_H_REQUIRE_DEFAULTS",
    ],
)
