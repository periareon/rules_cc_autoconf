"""https://github.com/coreutils/gnulib/blob/1039a5f2cee3cda1c11f64a5eb3a15b2e87cd2f0/m4/copy-file.m4"""

load("//autoconf:autoconf_toolchain.bzl", autoconf = "autoconf_cache")

autoconf(
    name = "gl_COPY_FILE",
    checks = [
        # gl_COPY_FILE does AC_CHECK_FUNCS([chown]): the config.h define only;
        # the HAVE_CHOWN subst keeps its gl_UNISTD_H_DEFAULTS value.
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//gnulib/m4/chown:AC_CHECK_FUNCS_ONCE_chown",  # AC_CHECK_FUNCS([chown])
        # AC_CHECK_HEADERS_ONCE([unistd.h]) / for test compatibility
        "//autoconf/macros/AC_CHECK_INCLUDES_DEFAULT",
    ],
)

autoconf(
    name = "copy-file",
    visibility = ["//visibility:public"],
    deps = [
        ":gl_COPY_FILE",
    ],
)
