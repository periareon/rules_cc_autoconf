    ],
    visibility = ["//visibility:public"],
    deps = [
        ":HAVE_WCHAR_H_SUBST",
        ":gl_WCHAR_H_CORE",
    ],
)

# wchar_h - public name; same as gl_WCHAR_H for backward compatibility
autoconf(
    name = "wchar_h",
    default_deps = [
        "//gnulib/m4/stdlib_h:defaults",  # module: gl_WCHAR_H_REQUIRE_DEFAULTS invokes gl_STDLIB_H_REQUIRE_DEFAULTS
        ":defaults",  # the header's own defaults, as its m4 requires
    ],
    visibility = ["//visibility:public"],
    deps = [
        ":gl_WCHAR_H",
    ],
)

# defaults - public defaults target (gl_WCHAR_H_REQUIRE_DEFAULTS)
autoconf_defaults(
