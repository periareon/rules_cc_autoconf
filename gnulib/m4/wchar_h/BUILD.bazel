# gl_WCHAR_H_CORE - Core wchar.h checks without HAVE_WCHAR_H subst.
# Modeled from the body of gl_WCHAR_H minus the HAVE_WCHAR_H AC_SUBST so that
# downstream modules can pull in the NEXT_*/HAVE_WINT_T/HAVE_DECL_WCSDUP
# substitutions without also overriding HAVE_WCHAR_H (which can conflict in
# aggregated graphs).
autoconf(
    name = "gl_WCHAR_H_CORE",
    checks = gl_macros.GL_CHECK_NEXT_HEADERS(["wchar.h"]) + [
        # AC_CHECK_DECLS([wcsdup], [], [], [#include <wchar.h>]) - lines 56-59
        checks.AC_CHECK_DECL(
            "wcsdup",
            name = "_gl_cv_have_decl_wcsdup",
            includes = ["#include <wchar.h>"],
        ),
        # AC_CHECK_DECLS auto-defines HAVE_DECL_WCSDUP (1 if declared, else 0).
        checks.AC_DEFINE(
            "HAVE_DECL_WCSDUP",
            requires = ["_gl_cv_have_decl_wcsdup==1"],
        ),
        # M4: if test $ac_cv_have_decl_wcsdup = no; then HAVE_DECL_WCSDUP=0
        # Override the gl_WCHAR_H_DEFAULTS toolchain default when not declared.
        checks.AC_SUBST(
            "HAVE_DECL_WCSDUP",
            condition = "_gl_cv_have_decl_wcsdup",
            if_false = "0",
            if_true = "1",
        ),
    ],
    visibility = ["//gnulib:__subpackages__"],
    deps = [
        ":gl_WCHAR_H_INLINE_OK",
        "//autoconf/macros/AC_CHECK_INCLUDES_DEFAULT",
        "//gnulib/m4/extensions",
        "//gnulib/m4/gnulib-common:gl_FEATURES_H",
        "//gnulib/m4/include_next",
        "//gnulib/m4/wint_t:AC_SUBST_HAVE_WINT_T",
        "//gnulib/m4/wint_t:gl_TYPE_WINT_T_PREREQ",
        "//gnulib/m4/wint_t:gt_TYPE_WINT_T",
    ],
)

# HAVE_WCHAR_H_SUBST - Shared substitution for HAVE_WCHAR_H, conditional on
# whether <wchar.h> exists. M4: if test $ac_cv_header_wchar_h = yes;
# then HAVE_WCHAR_H=1 else HAVE_WCHAR_H=0; fi; AC_SUBST([HAVE_WCHAR_H]).
# The cache variable is populated by AC_CHECK_INCLUDES_DEFAULT.
autoconf(
    name = "HAVE_WCHAR_H_SUBST",
    checks = [
        checks.AC_SUBST(
            "HAVE_WCHAR_H",
            condition = "ac_cv_header_wchar_h",
            if_false = "0",
            if_true = "1",
        ),
    ],
    visibility = ["//gnulib:__subpackages__"],
    deps = [
        # Provides ac_cv_header_wchar_h.
        "//autoconf/macros/AC_CHECK_INCLUDES_DEFAULT",
    ],
)

# gl_WCHAR_H - AC_DEFUN_ONCE([gl_WCHAR_H], ...)
