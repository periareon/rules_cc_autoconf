"""https://github.com/coreutils/gnulib/blob/1039a5f2cee3cda1c11f64a5eb3a15b2e87cd2f0/m4/isblank.m4"""

load("//autoconf:autoconf_toolchain.bzl", autoconf = "autoconf_cache")
load("//autoconf:checks.bzl", "checks")

# AC_CHECK_FUNCS_ONCE([isblank]) and AC_CHECK_DECLS([isblank]) - the bare
# probes plus their config.h defines.  regex only runs these and must not
# inherit gl_FUNC_ISBLANK's ctype.h defaults.
autoconf(
    name = "AC_CHECK_FUNCS_ONCE_isblank",
    checks = [
        checks.AC_CHECK_DECL(
            "isblank",
            define = "HAVE_DECL_ISBLANK",
            includes = ["#include <ctype.h>"],
        ),
        checks.AC_CHECK_FUNC(
            "isblank",
            define = "HAVE_ISBLANK",
        ),
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//autoconf/macros/AC_CHECK_INCLUDES_DEFAULT",
    ],
)

autoconf(
    name = "isblank",
    checks = [
        # if test $ac_cv_func_isblank = no; then HAVE_ISBLANK=0; fi
        # (lowers the gl_CTYPE_H_DEFAULTS substitution).
        checks.AC_SUBST(
            "HAVE_ISBLANK",
            condition = "ac_cv_func_isblank",
            if_false = 0,
            if_true = 1,
        ),
    ],
    default_deps = [
        "//gnulib/m4/ctype_h:defaults",  # AC_REQUIRE: gl_CTYPE_H_DEFAULTS
    ],
    visibility = ["//visibility:public"],
    deps = [
        ":AC_CHECK_FUNCS_ONCE_isblank",  # AC_CHECK_FUNCS_ONCE([isblank])
        # Note: gl_CTYPE_H_DEFAULTS is a _DEFAULTS function, so we ignore it per user's instruction
        # "//gnulib/m4/ctype_h",  # Ignored - _DEFAULTS function
        "//gnulib/m4/extensions",

        # Note: AC_CHECK_INCLUDES_DEFAULT is added for test compatibility
        "//autoconf/macros/AC_CHECK_INCLUDES_DEFAULT",
    ],
)
