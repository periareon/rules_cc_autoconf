"""https://github.com/coreutils/gnulib/blob/1039a5f2cee3cda1c11f64a5eb3a15b2e87cd2f0/m4/strsignal.m4"""

load("//autoconf:autoconf_toolchain.bzl", autoconf = "autoconf_cache")
load("//autoconf:checks.bzl", "checks")

autoconf(
    name = "gl_FUNC_STRSIGNAL",
    checks = [
        checks.AC_CHECK_DECL(
            "strsignal",
            name = "ac_cv_have_decl_strsignal",
            includes = [
                "#include <signal.h>",
                "#include <string.h>",
            ],
        ),
        # AC_CHECK_DECLS_ONCE([strsignal]) defines HAVE_DECL_STRSIGNAL to 1 or 0.
        checks.AC_DEFINE(
            "HAVE_DECL_STRSIGNAL",
            condition = "ac_cv_have_decl_strsignal",
            if_true = 1,
        ),
        # if test $ac_cv_have_decl_strsignal = no; then
        #   HAVE_DECL_STRSIGNAL=0
        # fi
        # Overrides the gl_STRING_H_DEFAULTS value of 1 (e.g. MSVC has no strsignal).
        checks.AC_SUBST(
            "HAVE_DECL_STRSIGNAL",
            condition = "ac_cv_have_decl_strsignal",
            if_false = 0,
            if_true = 1,
        ),
        checks.AC_CHECK_FUNC(
            "strsignal",
            name = "ac_cv_func_strsignal",
        ),
        # AC_CHECK_FUNCS([strsignal]) defines HAVE_STRSIGNAL in config.h only
        # when the function is found; otherwise the macro stays undefined.
        checks.AC_DEFINE(
            "HAVE_STRSIGNAL",
            condition = "ac_cv_func_strsignal",
            if_false = None,
            if_true = 1,
        ),
        # REPLACE_STRSIGNAL=1 only when strsignal exists but the AC_RUN_IFELSE
        # gl_cv_func_working_strsignal fails, which is only known to happen on
        # Solaris and AIX. An absent strsignal (MSVC) is not a replacement.
        checks.AC_SUBST("REPLACE_STRSIGNAL", 0),
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//autoconf/macros/AC_CANONICAL_HOST",  # AC_REQUIRE([AC_CANONICAL_HOST])
        "//autoconf/macros/AC_CHECK_INCLUDES_DEFAULT",
        "//gnulib/m4/extensions",  # AC_REQUIRE([AC_USE_SYSTEM_EXTENSIONS])
        "//gnulib/m4/string_h",  # AC_REQUIRE([gl_STRING_H_DEFAULTS])
    ],
)

autoconf(
    name = "gl_PREREQ_STRSIGNAL",
    checks = [
        # AC_CHECK_HEADERS_ONCE([unistd.h]): HAVE_UNISTD_H comes from
        # AC_CHECK_INCLUDES_DEFAULT.
        # AC_CHECK_DECLS([sys_siglist], [], [], [[#include <signal.h>]])
        checks.AC_CHECK_DECL(
            "sys_siglist",
            name = "ac_cv_have_decl_sys_siglist",
            includes = ["#include <signal.h>"],
        ),
        # AC_CHECK_DECLS([_sys_siglist], [], [], [[#include <signal.h>]])
        checks.AC_CHECK_DECL(
            "_sys_siglist",
            name = "ac_cv_have_decl__sys_siglist",
            includes = ["#include <signal.h>"],
        ),
        checks.AC_DEFINE(
            "HAVE_DECL_SYS_SIGLIST",
            condition = "ac_cv_have_decl_sys_siglist",
            if_false = 0,
            if_true = 1,
        ),
        checks.AC_DEFINE(
            "HAVE_DECL__SYS_SIGLIST",
            condition = "ac_cv_have_decl__sys_siglist",
            if_false = 0,
            if_true = 1,
        ),
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//autoconf/macros/AC_CHECK_INCLUDES_DEFAULT",
    ],
)

autoconf(
    name = "strsignal",
    visibility = ["//visibility:public"],
    deps = [
        ":gl_FUNC_STRSIGNAL",
        ":gl_PREREQ_STRSIGNAL",
    ],
)
