"""https://github.com/coreutils/gnulib/blob/1039a5f2cee3cda1c11f64a5eb3a15b2e87cd2f0/m4/getgroups.m4"""

load("//autoconf:autoconf_toolchain.bzl", autoconf = "autoconf_cache")
load("//autoconf:checks.bzl", "checks")

# m4 line 15: AC_DEFUN([AC_FUNC_GETGROUPS]) - gnulib's override of the Autoconf
# builtin.  The probe (AC_CHECK_FUNC([getgroups]) / HAVE_GETGROUPS) is modelled
# once, by //autoconf/macros/AC_FUNC_GETGROUPS, which this target forwards to.
autoconf(
    name = "AC_FUNC_GETGROUPS",
    checks = [],
    visibility = ["//visibility:public"],
    deps = [
        "//autoconf/macros/AC_CANONICAL_HOST",  # AC_REQUIRE([AC_CANONICAL_HOST])
        "//autoconf/macros/AC_FUNC_GETGROUPS",
        "//autoconf/macros/AC_TYPE_GETGROUPS",  # AC_REQUIRE([AC_TYPE_GETGROUPS])
        "//autoconf/macros/AC_TYPE_SIZE_T",  # AC_REQUIRE([AC_TYPE_SIZE_T])
    ],
)

autoconf(
    name = "gl_FUNC_GETGROUPS",
    checks = [
        # m4 line 25: HAVE_GETGROUPS=0 when AC_FUNC_GETGROUPS found no getgroups.
        checks.AC_SUBST(
            "HAVE_GETGROUPS",
            condition = "ac_cv_func_getgroups",
            if_false = 0,
            if_true = 1,
        ),
    ],
    visibility = ["//visibility:public"],
    deps = [
        ":AC_FUNC_GETGROUPS",  # m4 line 69: AC_FUNC_GETGROUPS
        "//autoconf/macros/AC_TYPE_GETGROUPS",  # AC_REQUIRE([AC_TYPE_GETGROUPS])
        "//autoconf/macros/AC_CANONICAL_HOST",  # AC_REQUIRE([AC_CANONICAL_HOST])
        # Note: gl_FUNC_GETGROUPS requires gl_UNISTD_H_DEFAULTS, but we can't depend on
        # unistd_h:defaults because it checks for HAVE_DECL_EXECVPE which the golden file
        # expects to be undefined, not 0. The golden file doesn't show unistd_h defaults anyway.
        # For test compatibility
        "//autoconf/macros/AC_CHECK_INCLUDES_DEFAULT",
    ],
)

autoconf(
    name = "getgroups",
    visibility = ["//visibility:public"],
    deps = [
        ":AC_FUNC_GETGROUPS",
        ":gl_FUNC_GETGROUPS",
    ],
)
