"""https://github.com/coreutils/gnulib/blob/1039a5f2cee3cda1c11f64a5eb3a15b2e87cd2f0/m4/sys_select_h.m4"""

load("//autoconf:autoconf_defaults.bzl", "autoconf_defaults")
load("//autoconf:autoconf_toolchain.bzl", autoconf = "autoconf_cache")
load("//autoconf:checks.bzl", "checks")
load("//gnulib:macros.bzl", gl_macros = "macros")

autoconf(
    name = "sys_select_h",
    checks = [
        checks.AC_CHECK_HEADER(
            "sys/select.h",
            define = "HAVE_SYS_SELECT_H",
            subst = True,
        ),
    ] + gl_macros.GL_CHECK_NEXT_HEADERS(["sys/select.h"]) + [
        checks.AC_TRY_COMPILE(
            code = """\
#include <sys/select.h>
int main(void) { return 0; }
""",
            define = "HAVE_SYS_SELECT_H_SELFCONTAINED",
            language = "c",
        ),
    ],
    default_deps = [
        ":defaults",  # the header's own defaults, as its m4 requires
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//gnulib/m4/include_next",
        "//gnulib/m4/sys_socket_h:gl_PREREQ_SYS_H_WINSOCK2",  # AC_REQUIRE([gl_PREREQ_SYS_H_WINSOCK2])

        # Note: AC_CHECK_INCLUDES_DEFAULT is added for test compatibility
        "//autoconf/macros/AC_CHECK_INCLUDES_DEFAULT",
    ],
)

autoconf_defaults(
    name = "gl_SYS_SELECT_H_DEFAULTS",
    substs = {
        "HAVE_PSELECT": "1",
        "REPLACE_PSELECT": "0",
        "REPLACE_SELECT": "0",
    },
    visibility = ["//visibility:private"],
)

autoconf_defaults(
    name = "gl_SYS_SELECT_H_REQUIRE_DEFAULTS",
    substs = {
        "GNULIB_PSELECT": "0",
        "GNULIB_SELECT": "0",
    },
    visibility = ["//visibility:private"],
    deps = [
        ":gl_SYS_SELECT_H_DEFAULTS",
    ],
)

autoconf_defaults(
    name = "defaults",
    visibility = ["//visibility:public"],
    deps = [
        ":gl_SYS_SELECT_H_REQUIRE_DEFAULTS",
    ],
)
