"""https://github.com/coreutils/gnulib/blob/1039a5f2cee3cda1c11f64a5eb3a15b2e87cd2f0/m4/sched_yield.m4"""

load("//autoconf:autoconf_toolchain.bzl", autoconf = "autoconf_cache")
load("//autoconf:checks.bzl", "checks")

autoconf(
    name = "gl_FUNC_SCHED_YIELD",
    checks = [
        # Note: gl_SCHED_H_DEFAULTS is a _DEFAULTS function, so we ignore it per user's instruction

        # if { case "$host_os" in mingw* | windows*) true;; *) false;; esac; } \
        #    && test $gl_threads_api = windows; then
        #   REPLACE_SCHED_YIELD=1
        # else
        #   AC_CHECK_DECL([sched_yield], , [HAVE_SCHED_YIELD=0], [[#include <sched.h>]])
        # fi
        #
        # gl_FUNC_SCHED_YIELD only requires gl_PTHREADLIB, not gl_THREADLIB, so
        # gl_threads_api is unset here and the else branch applies everywhere:
        # REPLACE_SCHED_YIELD stays 0 and HAVE_SCHED_YIELD follows the
        # declaration check (MSVC has no <sched.h>).
        checks.AC_CHECK_DECL(
            "sched_yield",
            includes = ["#include <sched.h>"],
        ),
        checks.AC_SUBST(
            "HAVE_SCHED_YIELD",
            condition = "ac_cv_have_decl_sched_yield",
            if_false = "0",
            if_true = "1",
        ),
        checks.AC_SUBST("REPLACE_SCHED_YIELD", 0),
    ],
    visibility = ["//visibility:public"],
    deps = [
        # Note: gl_SCHED_H_DEFAULTS is a _DEFAULTS function, so we ignore it per user's instruction
        # Provides thread library info
        "//gnulib/m4/threadlib",
        "//autoconf/macros/AC_CANONICAL_HOST",
        "//autoconf/macros/AC_CHECK_INCLUDES_DEFAULT",
    ],
)

autoconf(
    name = "sched_yield",
    visibility = ["//visibility:public"],
    deps = [
        ":gl_FUNC_SCHED_YIELD",
    ],
)
