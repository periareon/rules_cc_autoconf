"""https://github.com/coreutils/gnulib/blob/1039a5f2cee3cda1c11f64a5eb3a15b2e87cd2f0/m4/socklen.m4"""

load("//autoconf:autoconf_toolchain.bzl", autoconf = "autoconf_cache")
load("//autoconf:checks.bzl", "checks")

SOCKET_HEADERS = [
    "#include <sys/types.h>",
    "#if HAVE_SYS_SOCKET_H",
    "# include <sys/socket.h>",
    "#elif HAVE_WS2TCPIP_H",
    "# include <ws2tcpip.h>",
    "#endif",
]

# gl_TYPE_SOCKLEN_T only AC_CHECK_HEADERS_ONCEs <sys/socket.h> (config.h
# define); the HAVE_SYS_SOCKET_H substitution belongs to gl_PREREQ_SYS_H_SOCKET
# in sys_socket_h.m4.
autoconf(
    name = "gl_TYPE_SOCKLEN_T",
    checks = [
        checks.AC_CHECK_TYPE(
            "socklen_t",
            compile_defines = [
                "HAVE_SYS_SOCKET_H",
                "HAVE_WS2TCPIP_H",
            ],
            includes = SOCKET_HEADERS,
        ),
    ],
    visibility = ["//visibility:public"],
    deps = [
        ":gl_CHECK_SOCKET_HEADERS",  # AC_REQUIRE([gl_CHECK_SOCKET_HEADERS])
    ],
)

# gl_SOCKET_HEADERS - m4 lines 53-64: expands to the bare #include list above
# (SOCKET_HEADERS), used as the prologue of other macros' test programs; it
# performs no checks itself.
autoconf(
    name = "gl_SOCKET_HEADERS",
    checks = [],
    visibility = ["//visibility:public"],
)

autoconf(
    name = "gl_CHECK_SOCKET_HEADERS",
    checks = [
        checks.AC_CHECK_HEADER(
            "sys/socket.h",
            define = "HAVE_SYS_SOCKET_H",
        ),
        checks.AC_CHECK_HEADER(
            "ws2tcpip.h",
            define = "HAVE_WS2TCPIP_H",
            requires = ["!ac_cv_header_sys_socket_h"],
        ),
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//autoconf/macros/AC_CHECK_INCLUDES_DEFAULT",
    ],
)

autoconf(
    name = "socklen",
    visibility = ["//visibility:public"],
    deps = [
        ":gl_CHECK_SOCKET_HEADERS",
        ":gl_SOCKET_HEADERS",
        ":gl_TYPE_SOCKLEN_T",
    ],
)
