"""https://github.com/coreutils/gnulib/blob/1039a5f2cee3cda1c11f64a5eb3a15b2e87cd2f0/m4/sys_stat_h.m4"""

load("//autoconf:autoconf_defaults.bzl", "autoconf_defaults")
load("//autoconf:autoconf_toolchain.bzl", autoconf = "autoconf_cache")
load("//autoconf:checks.bzl", "checks")
load("//gnulib:macros.bzl", gl_macros = "macros")

autoconf(
    name = "gl_SYS_STAT_H",
    checks = [
        # gl_SYS_STAT_H checks for sys/stat.h header
    ] + gl_macros.GL_CHECK_NEXT_HEADERS(["sys/stat.h"]) + select({
        "@platforms//os:windows": [
            # On Windows (MSVC and MinGW), the UCRT's struct stat has
            # st_atim, st_mtim, st_ctim as struct timespec members.
            # gnulib's sys_stat.in.h uses this to add timespec fields to
            # its replacement struct stat and define _GL_WINDOWS_STAT_TIMESPEC.
            checks.AC_SUBST("WINDOWS_STAT_TIMESPEC", 1),
        ],
        "//conditions:default": [
            checks.AC_SUBST("WINDOWS_STAT_TIMESPEC", 0),
        ],
    }),
    default_deps = [
        ":defaults",  # AC_REQUIRE: gl_SYS_STAT_H_DEFAULTS
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//gnulib/m4/include_next",  # gl_CHECK_NEXT_HEADERS uses include_next
        "//gnulib/m4/largefile",
        # For test compatibility - provides standard headers and HAVE_SYS_STAT_H
        "//autoconf/macros/AC_CHECK_INCLUDES_DEFAULT",
    ],
)

autoconf_defaults(
    name = "gl_SYS_STAT_H_DEFAULTS",
    substs = {
        # HAVE_* defaults - gl_SYS_STAT_H_DEFAULTS
        "HAVE_FCHMODAT": "1",
        "HAVE_FSTATAT": "1",
        "HAVE_FUTIMENS": "1",
        "HAVE_GETUMASK": "1",
        "HAVE_LCHMOD": "1",
        "HAVE_LSTAT": "1",
        "HAVE_MKDIRAT": "1",
        "HAVE_MKFIFO": "1",
        "HAVE_MKFIFOAT": "1",
        "HAVE_MKNOD": "1",
        "HAVE_MKNODAT": "1",
        "HAVE_UTIMENSAT": "1",
        # REPLACE_* defaults
        "REPLACE_CHMOD": "0",
        "REPLACE_FCHMODAT": "0",
        "REPLACE_FSTAT": "0",
        "REPLACE_FSTATAT": "0",
        "REPLACE_FUTIMENS": "0",
        "REPLACE_LSTAT": "0",
        "REPLACE_MKDIR": "0",
        "REPLACE_MKFIFO": "0",
        "REPLACE_MKFIFOAT": "0",
        "REPLACE_MKNOD": "0",
        "REPLACE_MKNODAT": "0",
        "REPLACE_STAT": "0",
        "REPLACE_UTIMENSAT": "0",
    },
    visibility = ["//visibility:private"],
)

autoconf_defaults(
    name = "gl_SYS_STAT_H_REQUIRE_DEFAULTS",
    substs = {
        "GNULIB_CHMOD": "0",
        "GNULIB_FCHMODAT": "0",
        "GNULIB_FSTAT": "0",
        "GNULIB_FSTATAT": "0",
        "GNULIB_FUTIMENS": "0",
        "GNULIB_GETUMASK": "0",
        "GNULIB_LCHMOD": "0",
        "GNULIB_LSTAT": "0",
        # Microsoft deprecated alias function names
        "GNULIB_MDA_CHMOD": "1",
        "GNULIB_MDA_MKDIR": "1",
        "GNULIB_MDA_UMASK": "1",
        "GNULIB_MKDIR": "0",
        "GNULIB_MKDIRAT": "0",
        "GNULIB_MKFIFO": "0",
        "GNULIB_MKFIFOAT": "0",
        "GNULIB_MKNOD": "0",
        "GNULIB_MKNODAT": "0",
        "GNULIB_OVERRIDES_STRUCT_STAT": "0",
        "GNULIB_STAT": "0",
        "GNULIB_UTIMENSAT": "0",
    },
    visibility = ["//visibility:private"],
    deps = [
        ":gl_SYS_STAT_H_DEFAULTS",
    ],
)

autoconf_defaults(
    name = "defaults",
    visibility = ["//visibility:public"],
    deps = [
        ":gl_SYS_STAT_H_REQUIRE_DEFAULTS",
    ],
)

autoconf(
    name = "sys_stat_h",
    default_deps = [
        "//gnulib/m4/unistd_h:defaults",  # module: gl_SYS_STAT_H_REQUIRE_DEFAULTS invokes gl_UNISTD_H_REQUIRE_DEFAULTS, for REPLACE_FCHDIR
        ":defaults",  # the header's own defaults, as its m4 requires
    ],
    visibility = ["//visibility:public"],
    deps = [
        ":gl_SYS_STAT_H",
    ],
)
