"""https://github.com/coreutils/gnulib/blob/1039a5f2cee3cda1c11f64a5eb3a15b2e87cd2f0/m4/strerror_r.m4"""

load("//autoconf:autoconf_toolchain.bzl", autoconf = "autoconf_cache")
load("//autoconf:checks.bzl", "checks")
load("//gnulib:macros.bzl", gl_macros = "macros")

# link check). Sets HAVE_STRERROR_R and ac_cv_func_strerror_r.
autoconf(
    name = "gl_FUNC_STRERROR_R_WORKS",
    visibility = ["//visibility:public"],
    deps = [
        "//autoconf/macros/AC_CANONICAL_HOST",
        "//autoconf/macros/AC_CHECK_INCLUDES_DEFAULT",
        "//autoconf/macros/AC_FUNC_STRERROR_R:HAVE_STRERROR_R",
        "//autoconf/macros/AC_FUNC_STRERROR_R:ac_cv_have_decl_strerror_r",
        "//gnulib/m4/errno_h",
        "//gnulib/m4/extensions",
        "//gnulib/m4/strerror:gl_FUNC_STRERROR_0",
        "//gnulib/m4/string_h",
    ],
)

# Prerequisites for lib/strerror_r.c: __xpg_strerror_r, catgets, HAVE_DECL_STRERROR_R, HAVE_SNPRINTF.
autoconf(
    name = "gl_PREREQ_STRERROR_R",
    checks = gl_macros.GL_CHECK_FUNCS_ANDROID(
        ["catgets"],
        includes = ["#include <nl_types.h>"],
    ),
    visibility = ["//visibility:public"],
    deps = [
        ":gl_FUNC_STRERROR_R_WORKS",
        # HAVE___XPG_STRERROR_R comes from canonical source to avoid duplicates
        "//gnulib/m4/strerror:gl_HAVE___XPG_STRERROR_R",
        "//autoconf/macros/AC_CHECK_INCLUDES_DEFAULT",
        "//autoconf/macros/AC_FUNC_STRERROR_R",
        "//gnulib/m4/string_h",
        "//gnulib/macros/AC_FUNC_SNPRINTF",
    ],
)

# Set REPLACE_STRERROR_R when strerror_r is missing or broken.
autoconf(
    name = "gl_FUNC_STRERROR_R",
    checks = [
        # AC_CHECK_DECLS_ONCE([strerror_r])
        # if test $ac_cv_have_decl_strerror_r = no; then HAVE_DECL_STRERROR_R=0; fi
        # Overrides the gl_STRING_H_DEFAULTS value of 1 (e.g. MSVC has no strerror_r).
        checks.AC_SUBST(
            "HAVE_DECL_STRERROR_R",
            condition = "ac_cv_have_decl_strerror_r",
            if_false = 0,
            if_true = 1,
        ),
        # if test $ac_cv_func_strerror_r = yes; then
        #   if test "$GL_GENERATE_ERRNO_H:$REPLACE_STRERROR_0" = false:0; then
        #     if test $gl_cv_func_strerror_r_posix_signature = yes; then
        #       case "$gl_cv_func_strerror_r_works" in *no) REPLACE_STRERROR_R=1 ;; esac
        #     else
        #       REPLACE_STRERROR_R=1
        #     fi
        #   else
        #     REPLACE_STRERROR_R=1
        #   fi
        # fi
        # Every branch inside "strerror_r exists" ends in REPLACE_STRERROR_R=1 on
        # the supported platforms: glibc has the GNU (non-POSIX) signature,
        # macOS has REPLACE_STRERROR_0=1. Where strerror_r does not exist at all
        # (MSVC) the m4 leaves REPLACE_STRERROR_R at its default of 0.
        checks.AC_SUBST(
            "REPLACE_STRERROR_R",
            condition = "ac_cv_func_strerror_r",
            if_false = 0,
            if_true = 1,
        ),
    ],
    visibility = ["//visibility:public"],
    deps = [
        ":gl_PREREQ_STRERROR_R",
        "//gnulib/m4/string_h",
    ],
)

# strerror_r - top-level module
autoconf(
    name = "strerror_r",
    visibility = ["//visibility:public"],
    deps = [
        ":gl_FUNC_STRERROR_R",
        ":gl_FUNC_STRERROR_R_WORKS",
        ":gl_PREREQ_STRERROR_R",
    ],
)
