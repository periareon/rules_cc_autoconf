"""https://github.com/coreutils/gnulib/blob/1039a5f2cee3cda1c11f64a5eb3a15b2e87cd2f0/m4/freadseek.m4"""

load("//autoconf:autoconf_toolchain.bzl", autoconf = "autoconf_cache")
load("//autoconf:checks.bzl", "macros")

autoconf(
    name = "gl_FUNC_FREADSEEK",
    checks = macros.AC_CHECK_FUNCS(
        ["__freadptrinc"],
    ),
    visibility = ["//visibility:public"],
)

autoconf(
    name = "freadseek",
    visibility = ["//visibility:public"],
    deps = [":gl_FUNC_FREADSEEK"],
)
