"""https://github.com/coreutils/gnulib/blob/1039a5f2cee3cda1c11f64a5eb3a15b2e87cd2f0/m4/mknod.m4"""

load("//autoconf:autoconf_toolchain.bzl", autoconf = "autoconf_cache")
load("//autoconf:checks.bzl", "checks")

autoconf(
    name = "mknod",
    checks = [
        checks.AC_CHECK_FUNC(
            "mknod",
            define = "HAVE_MKNOD",
        ),
        # M4 m4/mknod.m4 runs AC_RUN_IFELSE for the MKNOD_FIFO_BUG (creating
        # a FIFO via mknod with S_IFIFO mode). Modern Linux glibc and modern
        # macOS both pass the probe (verified via real ./configure on each
        # host), so the bug-define and the replacement are both absent.
        checks.AC_SUBST("REPLACE_MKNOD", "0"),
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//autoconf/macros/AC_CHECK_INCLUDES_DEFAULT",
        "//gnulib/m4/extensions",
        "//gnulib/m4/mkfifo",
        "//gnulib/m4/sys_stat_h",
    ],
)
