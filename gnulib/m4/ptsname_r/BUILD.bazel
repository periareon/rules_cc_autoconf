"""https://github.com/coreutils/gnulib/blob/1039a5f2cee3cda1c11f64a5eb3a15b2e87cd2f0/m4/ptsname_r.m4"""

load("//autoconf:autoconf_toolchain.bzl", autoconf = "autoconf_cache")
load("//autoconf:checks.bzl", "checks")

autoconf(
    name = "gl_FUNC_PTSNAME_R",
    checks = [
        # AC_CHECK_FUNCS_ONCE([ptsname_r])
        checks.AC_CHECK_FUNC(
            "ptsname_r",
            define = "HAVE_PTSNAME_R",
        ),
        # if test $ac_cv_func_ptsname_r = no; then
        #   HAVE_PTSNAME_R=0
        # else
        #   AC_DEFINE([HAVE_ESSENTIALLY_WORKING_PTSNAME_R], [1], ...)
        checks.AC_SUBST(
            "HAVE_PTSNAME_R",
            condition = "ac_cv_func_ptsname_r",
            if_false = 0,
            if_true = 1,
        ),
        checks.AC_DEFINE(
            "HAVE_ESSENTIALLY_WORKING_PTSNAME_R",
            condition = "ac_cv_func_ptsname_r",
            if_false = None,
            if_true = 1,
        ),
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//autoconf/macros/AC_CANONICAL_HOST",  # AC_REQUIRE([AC_CANONICAL_HOST])
        "//autoconf/macros/AC_CHECK_INCLUDES_DEFAULT",
        "//gnulib/m4/extensions",  # AC_REQUIRE([AC_USE_SYSTEM_EXTENSIONS])
        "//gnulib/m4/sys_types_h",
        "//gnulib/m4/wchar_h:gl_WCHAR_H_CORE",
    ],
)

# gl_PREREQ_PTSNAME_R: "whether isatty sets errno when it fails" is an
# AC_RUN_IFELSE.  Its cross-compilation guess is what we can reproduce:
# "guessing yes" everywhere except Solaris and MSVC (mingw gets "guessing
# yes" via an AC_EGREP_CPP on __MINGW32__).  On MSVC isatty(-1) indeed
# fails without setting errno, so the define is emitted there.
autoconf(
    name = "gl_PREREQ_PTSNAME_R",
    checks = select({
        "@platforms//os:windows": [
            checks.AC_TRY_COMPILE(
                name = "gl_cv_func_isatty_sets_errno",
                code = """\
#ifdef __MINGW32__
 Known
#else
 #error "MSVC: isatty does not set errno"
#endif
int main(void) { return 0; }
""",
                language = "c",
            ),
            checks.AC_DEFINE(
                "ISATTY_FAILS_WITHOUT_SETTING_ERRNO",
                condition = "gl_cv_func_isatty_sets_errno",
                if_false = 1,
                if_true = None,
            ),
        ],
        "//conditions:default": [],
    }),
    visibility = ["//visibility:public"],
    deps = [
        "//autoconf/macros/AC_CANONICAL_HOST",  # AC_REQUIRE([AC_CANONICAL_HOST])
    ],
)

autoconf(
    name = "ptsname_r",
    visibility = ["//visibility:public"],
    deps = [
        ":gl_FUNC_PTSNAME_R",
        ":gl_PREREQ_PTSNAME_R",
    ],
)
