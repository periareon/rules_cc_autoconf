"""https://github.com/coreutils/gnulib/blob/1039a5f2cee3cda1c11f64a5eb3a15b2e87cd2f0/m4/duplocale.m4"""

load("//autoconf:autoconf_toolchain.bzl", autoconf = "autoconf_cache")
load("//autoconf:checks.bzl", "checks")
load("//gnulib:macros.bzl", gl_macros = "macros")

# gl_CHECK_FUNCS_ANDROID([duplocale], [[#include <locale.h>]]) - the link
# check, the HAVE_DUPLOCALE config.h define and the HAVE_DUPLOCALE
# substitution, shared by gl_FUNC_DUPLOCALE and gl_PREREQ_GETLOCALENAME_L_UNSAFE
# (getlocalename_l.m4).  The REPLACE_DUPLOCALE logic differs between the two
# macros, so it is not part of this target.
autoconf(
    name = "gl_CHECK_FUNC_DUPLOCALE",
    checks = gl_macros.GL_CHECK_FUNCS_ANDROID(
        ["duplocale"],
        code = """#include <locale.h>

#ifdef __cplusplus
extern "C"
#endif
locale_t duplocale(locale_t);

int main(void) {
    return duplocale((locale_t)0) != (locale_t)0;
}
""",
    ) + [
        # Both macros derive the same value:
        # gl_FUNC_DUPLOCALE: if test $ac_cv_func_duplocale = yes; then
        #   if test $HAVE_LOCALE_T = 1; then ... else HAVE_DUPLOCALE=0; fi
        # else HAVE_DUPLOCALE=0; fi
        # gl_PREREQ_GETLOCALENAME_L_UNSAFE: probe only if $HAVE_LOCALE_T = 1;
        #   if test $gl_func_duplocale != yes; then HAVE_DUPLOCALE=0; fi
        checks.AC_SUBST(
            "HAVE_DUPLOCALE",
            condition = "HAVE_LOCALE_T==1 && ac_cv_func_duplocale",
            if_false = "0",
            if_true = "1",
        ),
    ],
    visibility = ["//gnulib:__subpackages__"],
    deps = [
        "//autoconf/macros/AC_CHECK_INCLUDES_DEFAULT",
        "//gnulib/m4/locale_h:gl_LOCALE_T",  # AC_REQUIRE([gl_LOCALE_H]) -> gl_LOCALE_T
    ],
)

autoconf(
    name = "gl_FUNC_DUPLOCALE",
    checks = [
        # HAVE_DUPLOCALE (define and subst) comes from :gl_CHECK_FUNC_DUPLOCALE.
        # HAVE_NL_LANGINFO_L comes from nl_langinfo_l dependency
        checks.AC_CHECK_FUNC(
            "snprintf_l",
            define = "HAVE_SNPRINTF_L",
        ),

        # REPLACE_DUPLOCALE: gl_FUNC_DUPLOCALE sets it to 1 only when the
        # AC_RUN_IFELSE "whether duplocale(LC_GLOBAL_LOCALE) works" fails or
        # guesses no (glibc < 2.12, uClibc, AIX, NetBSD), or when
        # gl_cv_onwards_func_duplocale is 'future OS version' (Android).  None
        # of that applies to the platforms we target, so this macro leaves the
        # gl_LOCALE_H_DEFAULTS value of 0 alone.  The only override among our
        # ports comes from gl_PREREQ_GETLOCALENAME_L_UNSAFE (no locale_t, e.g.
        # MSVC), which therefore owns the REPLACE_DUPLOCALE substitution.
        #
        # if test $REPLACE_DUPLOCALE = 1; then DUPLOCALE_LIB="$SETLOCALE_NULL_LIB"
        # else DUPLOCALE_LIB=; fi   -- empty here (REPLACE_DUPLOCALE=0, above).
        checks.AC_SUBST("DUPLOCALE_LIB", ""),
        checks.AC_SUBST("LIB_DUPLOCALE", ""),
    ],
    visibility = ["//visibility:public"],
    deps = [
        ":gl_CHECK_FUNC_DUPLOCALE",  # gl_CHECK_FUNCS_ANDROID([duplocale])
        "//gnulib/m4/nl_langinfo:nl_langinfo_l",
        # Note: gl_LOCALE_H_DEFAULTS is a _DEFAULTS function, so we ignore it per user's instruction
        # "//gnulib/m4/locale_h",  # Ignored - _DEFAULTS function
        "//autoconf/macros/AC_CANONICAL_HOST",  # AC_REQUIRE([AC_CANONICAL_HOST])
        # Note: gl_FUNC_SETLOCALE_NULL is conditionally required, but we include it
        # to match GNU autoconf test behavior (all m4 files are included)
        "//gnulib/m4/setlocale_null",  # AC_REQUIRE([gl_FUNC_SETLOCALE_NULL])
        "//gnulib/m4/locale_h:gl_LOCALE_H",  # AC_REQUIRE([gl_LOCALE_H])
        # HAVE_PTHREAD_API comes from threadlib (via toolchain defaults or explicit dependency)
        # The golden file expects it, so we include threadlib to match GNU autoconf behavior
        "//gnulib/m4/threadlib:gl_PTHREADLIB_BODY",
        # Note: AC_CHECK_INCLUDES_DEFAULT is added for test compatibility
        "//autoconf/macros/AC_CHECK_INCLUDES_DEFAULT",
    ],
)

# m4 line 133: gl_PREREQ_DUPLOCALE - prerequisites of lib/duplocale.c (no-op).
autoconf(
    name = "gl_PREREQ_DUPLOCALE",
    checks = [],
    visibility = ["//visibility:public"],
)

autoconf(
    name = "duplocale",
    visibility = ["//visibility:public"],
    deps = [
        ":gl_FUNC_DUPLOCALE",
        ":gl_PREREQ_DUPLOCALE",
    ],
)
