"""https://github.com/coreutils/gnulib/blob/1039a5f2cee3cda1c11f64a5eb3a15b2e87cd2f0/m4/stpcpy.m4"""

load("//autoconf:autoconf_toolchain.bzl", autoconf = "autoconf_cache")
load("//autoconf:checks.bzl", "checks")

autoconf(
    name = "gl_FUNC_STPCPY",
    checks = [
        # gl_CHECK_FUNCS_ANDROID([stpcpy], [[#include <string.h>]])
        # Outside Android this is plain AC_CHECK_FUNCS([stpcpy]): HAVE_STPCPY
        # is defined in config.h only when the function is found.
        checks.AC_CHECK_FUNC("stpcpy"),
        checks.AC_DEFINE(
            "HAVE_STPCPY",
            condition = "ac_cv_func_stpcpy",
            if_false = None,
            if_true = 1,
        ),

        # if test $ac_cv_func_stpcpy = no; then
        #   HAVE_STPCPY=0
        #   case "$gl_cv_onwards_func_stpcpy" in
        #     future*) REPLACE_STPCPY=1 ;;
        #   esac
        # fi
        # Overrides the gl_STRING_H_DEFAULTS value of 1 (e.g. MSVC has no stpcpy).
        checks.AC_SUBST(
            "HAVE_STPCPY",
            condition = "ac_cv_func_stpcpy",
            if_false = 0,
            if_true = 1,
        ),
        # gl_cv_onwards_func_stpcpy is only ever "future..." on Android, so
        # REPLACE_STPCPY keeps the gl_STRING_H_DEFAULTS value of 0 elsewhere.
        checks.AC_SUBST("REPLACE_STPCPY", 0),
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//autoconf/macros/AC_CHECK_INCLUDES_DEFAULT",
        "//autoconf/macros/AC_C_RESTRICT",  # AC_REQUIRE([AC_C_RESTRICT])
        "//gnulib/m4/extensions",  # AC_REQUIRE([AC_USE_SYSTEM_EXTENSIONS])
        "//gnulib/m4/string_h",  # AC_REQUIRE([gl_STRING_H_DEFAULTS])
    ],
)

# gl_PREREQ_STPCPY - lines 28-30 (empty)
autoconf(
    name = "gl_PREREQ_STPCPY",
    checks = [],
    visibility = ["//visibility:public"],
)

autoconf(
    name = "stpcpy",
    visibility = ["//visibility:public"],
    deps = [
        ":gl_FUNC_STPCPY",
        ":gl_PREREQ_STPCPY",
    ],
)
