"""https://github.com/coreutils/gnulib/blob/1039a5f2cee3cda1c11f64a5eb3a15b2e87cd2f0/m4/log10l.m4

gl_FUNC_LOG10L:
- AC_REQUIRE([gl_MATH_H_DEFAULTS])
- AC_REQUIRE([gl_LONG_DOUBLE_VS_DOUBLE])
- AC_REQUIRE([gl_FUNC_LOG10])
- AC_REQUIRE([gl_USE_SYSTEM_EXTENSIONS])
- AC_CHECK_DECL([log10l], , [HAVE_DECL_LOG10L=0], [[#include <math.h>]])
- AC_CHECK_FUNCS([log10l]) with LIBS="$LIBS $LOG10_LIBM"
- if found: gl_FUNC_LOG10L_WORKS -> REPLACE_LOG10L=1 when it fails
- else: HAVE_LOG10L=0; AC_CHECK_DECLS([log10l], [REPLACE_LOG10L=1], , [[#include <math.h>]])
- AC_SUBST([LOG10L_LIBM])

gl_FUNC_LOG10L_WORKS is exposed as its own target.
"""

load("//autoconf:autoconf_toolchain.bzl", autoconf = "autoconf_cache")
load("//autoconf:checks.bzl", "checks")

# m4 line 69: gl_FUNC_LOG10L_WORKS test program (AC_RUN_IFELSE).
_LOG10L_WORKS_CODE = """\
#ifndef __NO_MATH_INLINES
# define __NO_MATH_INLINES 1 /* for glibc */
#endif
#include <float.h>
#include <math.h>
/* Override the values of <float.h>, like done in float.in.h.  */
#if defined __i386__ && (defined __BEOS__ || defined __OpenBSD__)
# undef LDBL_MANT_DIG
# define LDBL_MANT_DIG   64
# undef LDBL_MIN_EXP
# define LDBL_MIN_EXP    (-16381)
# undef LDBL_MAX_EXP
# define LDBL_MAX_EXP    16384
#endif
#if defined __i386__ && (defined __FreeBSD__ || defined __DragonFly__)
# undef LDBL_MANT_DIG
# define LDBL_MANT_DIG   64
# undef LDBL_MIN_EXP
# define LDBL_MIN_EXP    (-16381)
# undef LDBL_MAX_EXP
# define LDBL_MAX_EXP    16384
#endif
#if (defined _ARCH_PPC || defined _POWER) && defined _AIX && (LDBL_MANT_DIG == 106) && defined __GNUC__
# undef LDBL_MIN_EXP
# define LDBL_MIN_EXP DBL_MIN_EXP
#endif
#undef log10l /* for AIX */
extern
#ifdef __cplusplus
"C"
#endif
long double log10l (long double);
static long double dummy (long double x) { return 0; }
volatile long double gx;
long double gy;
int main (int argc, char *argv[])
{
  long double (* volatile my_log10l) (long double) = argc ? log10l : dummy;
  const long double TWO_LDBL_MANT_DIG = /* 2^LDBL_MANT_DIG */
    (long double) (1U << ((LDBL_MANT_DIG - 1) / 5))
    * (long double) (1U << ((LDBL_MANT_DIG - 1 + 1) / 5))
    * (long double) (1U << ((LDBL_MANT_DIG - 1 + 2) / 5))
    * (long double) (1U << ((LDBL_MANT_DIG - 1 + 3) / 5))
    * (long double) (1U << ((LDBL_MANT_DIG - 1 + 4) / 5));
  int result = 0;
  /* Dummy call, to trigger the AIX 5.1 bug.  */
  gx = 0.6L;
  gy = log10l (gx);
  /* This test fails on AIX 5.1.  */
  {
    gx = -0.0L;
    gy = log10l (gx);
    if (!(gy + gy == gy))
      result |= 1;
  }
  /* This test fails on musl 1.2.2/arm64, musl 1.2.2/s390x,
     NetBSD 9.3 except arm64.  */
  {
    long double x = 7.90097792256024576L;
    long double err = (my_log10l (x) + my_log10l (1.0L / x)) * TWO_LDBL_MANT_DIG;
    if (!(err >= -100.0L && err <= 100.0L))
      result |= 2;
  }
  /* This test fails on NetBSD 9.3/arm64.  */
  {
    long double x = 13.53398352203022253L;
    long double err = (my_log10l (x) + my_log10l (1.0L / x)) * TWO_LDBL_MANT_DIG;
    if (!(err >= -100.0L && err <= 100.0L))
      result |= 4;
  }
  return result;
}
"""

autoconf(
    name = "gl_FUNC_LOG10L_WORKS",
    checks = [
        # m4 line 63: whether log10l works (AC_RUN_IFELSE, modelled as a link
        # test; the program compiles and links wherever GNU's run reports yes).
        checks.AC_TRY_LINK(
            name = "gl_cv_func_log10l_works",
            code = _LOG10L_WORKS_CODE,
        ),
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//autoconf/macros/AC_CANONICAL_HOST",  # AC_REQUIRE([AC_CANONICAL_HOST])
    ],
)

autoconf(
    name = "gl_FUNC_LOG10L",
    checks = [
        # m4 line 18: AC_CHECK_DECL([log10l], , [HAVE_DECL_LOG10L=0], [[#include <math.h>]])
        # Plain AC_CHECK_DECL: cache variable only, no define.
        checks.AC_CHECK_DECL(
            "log10l",
            includes = ["#include <math.h>"],
        ),
        checks.AC_SUBST(
            "HAVE_DECL_LOG10L",
            condition = "ac_cv_have_decl_log10l",
            if_false = 0,
            if_true = 1,
        ),
        # m4 line 22: AC_CHECK_FUNCS([log10l])
        # On MSVC log10l is an inline in <math.h>, so the plain link probe fails
        # (as in GNU's config.log) even though the function is declared.
        checks.AC_CHECK_FUNC(
            "log10l",
            define = "HAVE_LOG10L",
        ),
        # m4 line 36: HAVE_LOG10L=0 when the function was not found
        checks.AC_SUBST(
            "HAVE_LOG10L",
            condition = "ac_cv_func_log10l",
            if_false = 0,
            if_true = 1,
        ),
        # m4 line 37: AC_CHECK_DECLS([log10l], [REPLACE_LOG10L=1], , [[#include <math.h>]])
        # only in the "not found" branch; AC_CHECK_DECLS defines HAVE_DECL_LOG10L to 1/0
        # (the cached ac_cv_have_decl_log10l result from line 18 is reused).
        checks.AC_DEFINE(
            "HAVE_DECL_LOG10L",
            condition = "ac_cv_have_decl_log10l",
            if_false = 0,
            if_true = 1,
            requires = ["!ac_cv_func_log10l"],
        ),
        # m4 line 33/37: REPLACE_LOG10L=1 when log10l exists but does not work,
        # or when it is only declared.
        checks.AC_SUBST(
            "REPLACE_LOG10L",
            condition = "(ac_cv_func_log10l && !gl_cv_func_log10l_works) || (!ac_cv_func_log10l && ac_cv_have_decl_log10l)",
            if_false = 0,
            if_true = 1,
        ),
        # m4 line 39-49: LOG10L_LIBM is LOG10_LIBM / LOGL_LIBM (both empty here)
        checks.AC_SUBST("LOG10L_LIBM", ""),
        # LOGL_LIBM comes from logl dependency
    ],
    visibility = ["//visibility:public"],
    deps = [
        ":gl_FUNC_LOG10L_WORKS",
        "//gnulib/m4/extensions",  # AC_REQUIRE([gl_USE_SYSTEM_EXTENSIONS])
        "//gnulib/m4/log10",  # AC_REQUIRE([gl_FUNC_LOG10])
        "//gnulib/m4/logl",  # AC_REQUIRE([gl_FUNC_LOGL])
        "//gnulib/m4/math_h",  # AC_REQUIRE([gl_MATH_H_DEFAULTS])
        "//gnulib/m4/math_h:long-double-vs-double",  # AC_REQUIRE([gl_LONG_DOUBLE_VS_DOUBLE])
    ],
)

# Umbrella target kept for existing dependants.
autoconf(
    name = "log10l",
    visibility = ["//visibility:public"],
    deps = [
        ":gl_FUNC_LOG10L",
        ":gl_FUNC_LOG10L_WORKS",
        "//gnulib/m4/asinl",  # Provides FREXPL_LIBM for golden
        "//gnulib/m4/isnanl",
        "//gnulib/m4/log",  # Provides LOG_LIBM for golden (canonical owner)
    ],
)
