"""https://github.com/coreutils/gnulib/blob/1039a5f2cee3cda1c11f64a5eb3a15b2e87cd2f0/m4/mbrlen.m4"""

load("//autoconf:autoconf_toolchain.bzl", autoconf = "autoconf_cache")
load("//autoconf:checks.bzl", "checks")

autoconf(
    name = "gl_FUNC_MBRLEN",
    checks = [
        # Use internal define to avoid conflict with substitution variable
        checks.AC_CHECK_FUNC(
            "mbrlen",
            name = "_gl_cv_func_mbrlen",
        ),

        # Set HAVE_MBRLEN as define if function exists, or as substitution variable if not
        checks.AC_DEFINE(
            "HAVE_MBRLEN",
            "1",
            requires = ["_gl_cv_func_mbrlen==1"],
        ),
        # Check for mbrlen declaration (for Minix 3.1.8 which declares but doesn't have it)
        # Lines 22-28
        checks.AC_CHECK_DECL(
            "mbrlen",
            define = "HAVE_DECL_MBRLEN",
            includes = ["#include <wchar.h>"],
            requires = ["!_gl_cv_func_mbrlen"],
        ),

        # if test $ac_cv_func_mbrlen = no; then
        #   if test $ac_cv_have_decl_mbrlen = yes; then REPLACE_MBRLEN=1; fi
        # else
        #   if test $REPLACE_MBRTOWC = 1; then REPLACE_MBRLEN=1; fi
        # fi
        # (Linux and MSVC: REPLACE_MBRTOWC=1 -> 1; macOS: 0)
        checks.AC_SUBST(
            "REPLACE_MBRLEN",
            condition = "(!_gl_cv_func_mbrlen && ac_cv_have_decl_mbrlen) || (_gl_cv_func_mbrlen && REPLACE_MBRTOWC==1)",
            if_false = "0",
            if_true = "1",
        ),
    ],
    visibility = ["//visibility:public"],
    deps = [
        # AC_REQUIRE([gl_WCHAR_H_DEFAULTS]) - line 15 (ignore, it's a _DEFAULTS function)
        "//autoconf/macros/AC_TYPE_MBSTATE_T",  # AC_REQUIRE([AC_TYPE_MBSTATE_T])
        "//gnulib/m4/mbrtowc:gl_FUNC_MBRTOWC",  # AC_REQUIRE([gl_FUNC_MBRTOWC])
        # Note: AC_CHECK_INCLUDES_DEFAULT is added for test compatibility
        "//autoconf/macros/AC_CHECK_INCLUDES_DEFAULT",
    ],
)

# The gl_MBRLEN_* probes below are AC_RUN_IFELSE locale tests that
# gl_FUNC_MBRLEN never invokes (it reuses the mbrtowc results instead);
# they are modelled as deps-only targets.

