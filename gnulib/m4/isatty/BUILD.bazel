"""https://github.com/coreutils/gnulib/blob/1039a5f2cee3cda1c11f64a5eb3a15b2e87cd2f0/m4/isatty.m4"""

load("//autoconf:autoconf_toolchain.bzl", autoconf = "autoconf_cache")
load("//autoconf:checks.bzl", "checks")

# gl_FUNC_ISATTY: the only decision is made on $host_os.
#   case "$host_os" in
#     mingw* | windows*) REPLACE_ISATTY=1 ;;
#   esac
autoconf(
    name = "gl_FUNC_ISATTY",
    checks = select({
        "@platforms//os:windows": [
            checks.AC_SUBST("REPLACE_ISATTY", 1),
        ],
        "//conditions:default": [],
    }),
    visibility = ["//visibility:public"],
    deps = [
        "//autoconf/macros/AC_CANONICAL_HOST",  # AC_REQUIRE([AC_CANONICAL_HOST]),
    ],
)

# AC_DEFUN([gl_PREREQ_ISATTY], [:])
autoconf(
    name = "gl_PREREQ_ISATTY",
    checks = [],
    visibility = ["//visibility:public"],
)

autoconf(
    name = "isatty",
    visibility = ["//visibility:public"],
    deps = [
        ":gl_FUNC_ISATTY",
        ":gl_PREREQ_ISATTY",
    ],
)
