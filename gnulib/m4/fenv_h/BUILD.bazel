"""https://github.com/coreutils/gnulib/blob/1039a5f2cee3cda1c11f64a5eb3a15b2e87cd2f0/m4/fenv_h.m4"""

load("//autoconf:autoconf_defaults.bzl", "autoconf_defaults")
load("//autoconf:autoconf_toolchain.bzl", autoconf = "autoconf_cache")
load("//autoconf:checks.bzl", "checks")
load("//gnulib:macros.bzl", gl_macros = "macros")

# gl_FENV_H (AC_DEFUN_ONCE)
# gl_CHECK_NEXT_HEADERS([fenv.h]), HAVE_FENV_H=1/0, AC_SUBST, gl_WARN_ON_USE_PREPARE.
autoconf(
    name = "gl_FENV_H",
    checks = [
        checks.AC_CHECK_HEADER(
            "fenv.h",
            define = "HAVE_FENV_H",
            subst = "HAVE_FENV_H",
        ),
    ] + gl_macros.GL_CHECK_NEXT_HEADERS(["fenv.h"]),
    default_deps = [
        ":defaults",  # AC_REQUIRE: gl_FENV_H_DEFAULTS
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//autoconf/macros/AC_CHECK_INCLUDES_DEFAULT",
        "//gnulib/m4/include_next",
    ],
)

# gl_FENV_MODULE_INDICATOR([modulename])
# Ensures defaults are expanded once; sets GNULIB_<module> for the given module.
# Other modules depend on this and set their own GNULIB_* when they use it.
autoconf(
    name = "gl_FENV_MODULE_INDICATOR",
    checks = [],
    default_deps = [
        ":defaults",  # through a macro it invokes: gl_FENV_H_DEFAULTS
        ":gl_FENV_H_REQUIRE_DEFAULTS",
    ],
    visibility = ["//visibility:public"],
)

# gl_FENV_H_REQUIRE_DEFAULTS
autoconf_defaults(
    name = "gl_FENV_H_REQUIRE_DEFAULTS",
    substs = {
        "GNULIB_FECLEAREXCEPT": "0",
        "GNULIB_FEDISABLEEXCEPT": "0",
        "GNULIB_FEENABLEEXCEPT": "0",
        "GNULIB_FEGETENV": "0",
        "GNULIB_FEGETEXCEPT": "0",
        "GNULIB_FEGETEXCEPTFLAG": "0",
        "GNULIB_FEGETROUND": "0",
        "GNULIB_FEHOLDEXCEPT": "0",
        "GNULIB_FERAISEEXCEPT": "0",
        "GNULIB_FESETENV": "0",
        "GNULIB_FESETEXCEPT": "0",
        "GNULIB_FESETEXCEPTFLAG": "0",
        "GNULIB_FESETROUND": "0",
        "GNULIB_FETESTEXCEPT": "0",
        "GNULIB_FETESTEXCEPTFLAG": "0",
        "GNULIB_FEUPDATEENV": "0",
    },
    visibility = ["//visibility:private"],
    deps = [
        ":gl_FENV_H_DEFAULTS",
    ],
)

# gl_FENV_H_DEFAULTS
# Must not be AC_REQUIREd; only invoked outside or in non-AC_REQUIREd macros.
autoconf_defaults(
    name = "gl_FENV_H_DEFAULTS",
    substs = {
        "HAVE_FECLEAREXCEPT": "1",
        "HAVE_FEDISABLEEXCEPT": "1",
        "HAVE_FEENABLEEXCEPT": "1",
        "HAVE_FEGETENV": "1",
        "HAVE_FEGETEXCEPT": "1",
        "HAVE_FEGETEXCEPTFLAG": "1",
        "HAVE_FEGETROUND": "1",
        "HAVE_FEHOLDEXCEPT": "1",
        "HAVE_FERAISEEXCEPT": "1",
        "HAVE_FESETENV": "1",
        "HAVE_FESETEXCEPT": "1",
        "HAVE_FESETEXCEPTFLAG": "1",
        "HAVE_FESETROUND": "1",
        "HAVE_FETESTEXCEPT": "1",
        "HAVE_FETESTEXCEPTFLAG": "1",
        "HAVE_FEUPDATEENV": "1",
        "REPLACE_FECLEAREXCEPT": "0",
        "REPLACE_FEDISABLEEXCEPT": "0",
        "REPLACE_FEENABLEEXCEPT": "0",
        "REPLACE_FEGETENV": "0",
        "REPLACE_FEGETEXCEPT": "0",
        "REPLACE_FEGETEXCEPTFLAG": "0",
        "REPLACE_FEGETROUND": "0",
        "REPLACE_FEHOLDEXCEPT": "0",
        "REPLACE_FERAISEEXCEPT": "0",
        "REPLACE_FESETENV": "0",
        "REPLACE_FESETEXCEPT": "0",
        "REPLACE_FESETEXCEPTFLAG": "0",
        "REPLACE_FESETROUND": "0",
        "REPLACE_FETESTEXCEPT": "0",
        "REPLACE_FETESTEXCEPTFLAG": "0",
        "REPLACE_FEUPDATEENV": "0",
    },
    visibility = ["//visibility:private"],
)

# fenv_h - main module (public target)
autoconf(
    name = "fenv_h",
    default_deps = [
        ":defaults",  # the header's own defaults, as its m4 requires
    ],
    visibility = ["//visibility:public"],
    deps = [
        ":gl_FENV_H",
    ],
)

autoconf_defaults(
    name = "defaults",
    visibility = ["//visibility:public"],
    deps = [
        ":gl_FENV_H_REQUIRE_DEFAULTS",
    ],
)
