"""https://github.com/coreutils/gnulib/blob/1039a5f2cee3cda1c11f64a5eb3a15b2e87cd2f0/m4/iconv_open.m4"""

load("//autoconf:autoconf_toolchain.bzl", autoconf = "autoconf_cache")
load("//autoconf:checks.bzl", "checks")

autoconf(
    name = "gl_FUNC_ICONV_OPEN",
    checks = select({
        "@platforms//os:macos": [
            # macOS: iconv is available via libiconv but is not GNU.
            # _am_cv_func_iconv fails because AC_TRY_LINK doesn't add -liconv,
            # but REPLACE_ICONV_OPEN is unconditionally 1 on macOS (the m4's
            # gl_REPLACE_ICONV_OPEN is called via the UTF-support failure path).
            checks.AC_SUBST("REPLACE_ICONV_OPEN", "1"),
            checks.AC_DEFINE("REPLACE_ICONV_UTF", 1),
            checks.AC_SUBST("REPLACE_ICONV", "1"),
            checks.AC_SUBST("REPLACE_ICONV_UTF", "1"),
        ],
        "//conditions:default": [
            # glibc's iconv is GNU (gl_func_iconv_gnu=yes) and passes the
            # UTF-16/32 support test, and MSVC has no iconv at all, so neither
            # path reaches gl_REPLACE_ICONV_OPEN: the gl_ICONV_H_DEFAULTS value
            # stands.
            checks.AC_SUBST("REPLACE_ICONV_OPEN", "0"),
            checks.AC_SUBST("REPLACE_ICONV", "0"),
            checks.AC_SUBST("REPLACE_ICONV_UTF", "0"),
        ],
    }),
    visibility = ["//visibility:public"],
    deps = [
        "//gnulib/m4/iconv",  # AC_REQUIRE([AM_ICONV])
        "//gnulib/m4/iconv:AM_ICONV_LINKFLAGS_BODY",
        # For test compatibility
        "//autoconf/macros/AC_CHECK_INCLUDES_DEFAULT",
    ],
)

# m4 line 57: AC_DEFUN([gl_REPLACE_ICONV_OPEN]) = gl_REPLACE_ICONV_H;
# REPLACE_ICONV_OPEN=1; REPLACE_ICONV=1.  It is only reached from
# gl_FUNC_ICONV_OPEN's failure paths, whose outcome is folded into the
# platform select above (a subst may only be produced by one target), so this
# target carries no checks of its own.
autoconf(
    name = "gl_REPLACE_ICONV_OPEN",
    checks = [],
    visibility = ["//visibility:public"],
)

autoconf(
    name = "iconv_open",
    visibility = ["//visibility:public"],
    deps = [
        ":gl_FUNC_ICONV_OPEN",
        ":gl_REPLACE_ICONV_OPEN",
    ],
)
