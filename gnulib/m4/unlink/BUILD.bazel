"""https://github.com/coreutils/gnulib/blob/1039a5f2cee3cda1c11f64a5eb3a15b2e87cd2f0/m4/unlink.m4"""

load("//autoconf:autoconf_toolchain.bzl", autoconf = "autoconf_cache")
load("//autoconf:checks.bzl", "checks")

# gl_FUNC_UNLINK - m4/unlink.m4
#
# M4 runs an AC_RUN_IFELSE probe (unlink of "file/" must fail with ENOTDIR).
# Cross-compile guess table:
#   linux-*|linux|midipix*|*-gnu*         -> yes
#   mingw*|windows*                       -> no
#   *                                     -> gl_cross_guess_normal
# Linux and macOS pass natively. The second probe (unlink of a parent
# directory) is only run on darwin*, where modern macOS passes. We keep the
# upstream cache var name (`gl_cv_func_unlink_honors_slashes`) populated
# because gl_FUNC_REMOVE consumes it.
autoconf(
    name = "gl_FUNC_UNLINK",
    checks = select({
        "@platforms//os:windows": [
            checks.AC_TRY_LINK(
                name = "gl_cv_func_unlink_honors_slashes",
                code = """\
#error "UNLINK_TRAILING_SLASH_BUG"
int main(void) { return 0; }
""",
            ),
        ],
        "//conditions:default": [
            checks.AC_TRY_LINK(
                name = "gl_cv_func_unlink_honors_slashes",
                code = "int main(void) { return 0; }",
            ),
        ],
    }) + [
        # case "$gl_cv_func_unlink_honors_slashes" in *no) REPLACE_UNLINK=1 ;; esac
        checks.AC_SUBST(
            "REPLACE_UNLINK",
            condition = "!gl_cv_func_unlink_honors_slashes",
        ),
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//autoconf/macros/AC_CANONICAL_HOST",
        # For test compatibility
        "//autoconf/macros/AC_CHECK_INCLUDES_DEFAULT",
    ],
)

autoconf(
    name = "unlink",
    visibility = ["//visibility:public"],
    deps = [
        ":gl_FUNC_UNLINK",
    ],
)
