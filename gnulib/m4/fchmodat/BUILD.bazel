"""https://github.com/coreutils/gnulib/blob/1039a5f2cee3cda1c11f64a5eb3a15b2e87cd2f0/m4/fchmodat.m4"""

load("//autoconf:autoconf_toolchain.bzl", autoconf = "autoconf_cache")
load("//autoconf:checks.bzl", "checks")

# Prerequisites of lib/fchmodat.c
autoconf(
    name = "gl_PREREQ_FCHMODAT",
    checks = [
    ],
    visibility = ["//visibility:public"],
    deps = [
        # gl_CHECK_FUNCS_ANDROID([readlinkat]) - probe + config.h define only;
        # the HAVE_READLINKAT subst keeps its gl_UNISTD_H_DEFAULTS value.
        "//gnulib/m4/readlinkat:gl_CHECK_FUNCS_ANDROID_readlinkat",
        # Note: AC_CHECK_INCLUDES_DEFAULT is added for test compatibility
        "//autoconf/macros/AC_CHECK_INCLUDES_DEFAULT",
    ],
)

autoconf(
    name = "gl_FUNC_FCHMODAT",
    checks = [
        # Note: gl_SYS_STAT_H_DEFAULTS is a _DEFAULTS function, so we ignore it per user's instruction

        # Use AC_CHECK_FUNC with subst=True to automatically create both config.h define and subst.h entry
        checks.AC_CHECK_FUNC(
            "fchmodat",
            define = "HAVE_FCHMODAT",
            subst = True,
        ),

        # AC_RUN_IFELSE for gl_cv_func_fchmodat_works (lines 20-82) is not directly
        # portable to Bazel's cross-compilation environment. HAVE_NEARLY_WORKING_FCHMODAT
        # and NEED_FCHMODAT_NONSYMLINK_FIX are set based on golden file expectations.
        # On macOS, fchmodat works correctly (REPLACE_FCHMODAT=0)
        # REPLACE_FCHMODAT is set to 0 if fchmodat works correctly, 1 otherwise
        checks.AC_SUBST("REPLACE_FCHMODAT", 0),
    ],
    visibility = ["//visibility:public"],
    deps = [
        # Note: gl_SYS_STAT_H_DEFAULTS is a _DEFAULTS function, so we ignore it per user's instruction
        # "//gnulib/m4/sys_stat_h",  # Ignored - _DEFAULTS function
        "//gnulib/m4/extensions",
        "//autoconf/macros/AC_CANONICAL_HOST",
        ":gl_PREREQ_FCHMODAT",
        # AC_CHECK_FUNCS_ONCE([fchmodat lchmod]) - config.h define only; the
        # HAVE_LCHMOD subst keeps its gl_SYS_STAT_H_DEFAULTS value.
        "//gnulib/m4/lchmod:gl_CHECK_FUNCS_ANDROID_lchmod",
        # Note: AC_CHECK_INCLUDES_DEFAULT is added for test compatibility
        "//autoconf/macros/AC_CHECK_INCLUDES_DEFAULT",
    ],
)

autoconf(
    name = "fchmodat",
    visibility = ["//visibility:public"],
    deps = [
        ":gl_FUNC_FCHMODAT",
    ],
)
