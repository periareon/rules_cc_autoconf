"""https://github.com/coreutils/gnulib/blob/1039a5f2cee3cda1c11f64a5eb3a15b2e87cd2f0/m4/musl.m4"""

load("//autoconf:autoconf_toolchain.bzl", autoconf = "autoconf_cache")
load("//autoconf:checks.bzl", "checks")

autoconf(
    name = "gl_MUSL_LIBC",
    checks = select({
        "@platforms//os:linux": [
            checks.AC_DEFINE("MUSL_LIBC", 1),
        ],
        "//conditions:default": [],
    }),
    visibility = ["//visibility:public"],
    deps = ["//autoconf/macros/AC_CANONICAL_HOST"],
)

autoconf(
    name = "musl",
    visibility = ["//visibility:public"],
    deps = [":gl_MUSL_LIBC"],
)
