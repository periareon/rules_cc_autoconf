"""https://github.com/coreutils/gnulib/blob/1039a5f2cee3cda1c11f64a5eb3a15b2e87cd2f0/m4/open.m4"""

load("//autoconf:autoconf_toolchain.bzl", autoconf = "autoconf_cache")

autoconf(
    name = "gl_FUNC_OPEN",
    checks = [
        # On macOS/Linux, REPLACE_OPEN stays 0 (O_CLOEXEC works, open handles
        # a trailing slash, fchdir exists). On native Windows the M4 sets
        # REPLACE_OPEN=1 unconditionally (and gl_cv_header_working_fcntl_h=no)
        # before gl_TEST_FCHDIR would run, so HAVE_FCHDIR keeps its default
        # there. The REPLACE_OPEN subst itself is left to consumers (the m4
        # overlay sets it locally), as before.
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//autoconf/macros/AC_CANONICAL_HOST",  # AC_REQUIRE([AC_CANONICAL_HOST])
        "//gnulib/m4/open-cloexec",  # AC_REQUIRE([gl_PREPROC_O_CLOEXEC])
        # Note: This depends on unistd_h which defines HAVE_DECL_EXECVPE
        # But the golden file expects HAVE_DECL_EXECVPE to be undefined
        # This is a conflict - maybe unistd_h shouldn't define it in config.h
        # Actually, unistd_h uses AC_CHECK_DECL which will set it to 0 if not found
        # But the golden file expects it to be undefined
        # This might be an issue with unistd_h BUILD.bazel
        "//gnulib/m4/fcntl-o",  # AC_REQUIRE([gl_FCNTL_O_FLAGS])
        "//gnulib/m4/open-slash:gl_OPEN_TRAILING_SLASH_BUG",  # gl_OPEN_TRAILING_SLASH_BUG
        # AC_CHECK_FUNCS_ONCE([fchdir]) - probe + config.h define only (not
        # HAVE_DECL_FCHDIR: macOS golden expects /* #undef HAVE_DECL_FCHDIR */)
        "//gnulib/m4/fchdir:AC_CHECK_FUNCS_ONCE_fchdir",  # gl_TEST_FCHDIR
        # Note: AC_CHECK_INCLUDES_DEFAULT is added for test compatibility
        "//autoconf/macros/AC_CHECK_INCLUDES_DEFAULT",
    ],
)

# gl_PREREQ_OPEN: prerequisites of lib/open.c.
autoconf(
    name = "gl_PREREQ_OPEN",
    checks = [],
    visibility = ["//visibility:public"],
    deps = [
        "//gnulib/m4/mode_t:gl_PROMOTED_TYPE_MODE_T",  # AC_REQUIRE([gl_PROMOTED_TYPE_MODE_T])
    ],
)

autoconf(
    name = "open",
    visibility = ["//visibility:public"],
    deps = [
        ":gl_FUNC_OPEN",
        ":gl_PREREQ_OPEN",
    ],
)
