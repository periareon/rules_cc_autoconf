"""https://github.com/coreutils/gnulib/blob/1039a5f2cee3cda1c11f64a5eb3a15b2e87cd2f0/m4/unlinkat.m4"""

load("//autoconf:autoconf_toolchain.bzl", autoconf = "autoconf_cache")
load("//autoconf:checks.bzl", "checks")

autoconf(
    name = "gl_FUNC_UNLINKAT",
    checks = [
        # AC_CHECK_FUNCS_ONCE([unlinkat])
        # On macOS, unlinkat is available
        checks.AC_CHECK_FUNC(
            "unlinkat",
            define = "HAVE_UNLINKAT",
            subst = True,
        ),
    ] + select({
        # On macOS the SDK probe decides.
        "@platforms//os:macos": [
            checks.AC_SUBST(
                "REPLACE_UNLINKAT",
                condition = "gl_cv_macos_sdk_modern",
                if_false = "1",
                if_true = "0",
            ),
        ],
        # M4 m4/unlinkat.m4 sets REPLACE_UNLINKAT when the trailing-slash /
        # AT_REMOVEDIR probes fail. The BCR overlay maps lib/unlinkat.c
        # inclusion to `REPLACE_UNLINKAT==1`, so we have to bundle the
        # "function missing" case (M4 normally signals via HAVE=0) under
        # REPLACE_*=1 too — otherwise downstream consumers (e.g. patch on
        # Windows) won't get the replacement compiled in and the link
        # fails with unresolved `unlinkat`.
        "@platforms//os:windows": [
            checks.AC_SUBST("REPLACE_UNLINKAT", "1"),
        ],
        "//conditions:default": [
            checks.AC_SUBST("REPLACE_UNLINKAT", "0"),
        ],
    }),
    visibility = ["//visibility:public"],
    deps = [
        # AC_REQUIRE([gl_USE_SYSTEM_EXTENSIONS,

        # Note: AC_CHECK_INCLUDES_DEFAULT is added for test compatibility
        "//gnulib/m4/extensions",
        "//gnulib/m4/unlink",
        "//gnulib/m4/lstat",
        # Note: gl_UNISTD_H_DEFAULTS is a _DEFAULTS function, so we don't track it as a dependency
        "//autoconf/macros/AC_CHECK_INCLUDES_DEFAULT",
    ],
)

autoconf(
    name = "unlinkat",
    visibility = ["//visibility:public"],
    deps = [
        ":gl_FUNC_UNLINKAT",
    ],
)
