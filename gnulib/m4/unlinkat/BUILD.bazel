"""https://github.com/coreutils/gnulib/blob/1039a5f2cee3cda1c11f64a5eb3a15b2e87cd2f0/m4/unlinkat.m4"""

load("//autoconf:autoconf_toolchain.bzl", autoconf = "autoconf_cache")
load("//autoconf:checks.bzl", "checks")

autoconf(
    name = "gl_FUNC_UNLINKAT",
    checks = [
        # AC_CHECK_FUNCS_ONCE([unlinkat])
        # On macOS, unlinkat is available
        checks.AC_CHECK_FUNC(
            "unlinkat",
            define = "HAVE_UNLINKAT",
            subst = True,
        ),
    ] + select({
        # On macOS the SDK probe decides.
        "@platforms//os:macos": [
            checks.AC_SUBST(
                "REPLACE_UNLINKAT",
                condition = "gl_cv_macos_sdk_modern",
                if_false = "1",
                if_true = "0",
            ),
        ],
        # M4 m4/unlinkat.m4: with unlinkat present, replace it when lstat
        # mishandles trailing slashes (Solaris 9) or when unlink itself is
        # replaced. Without unlinkat (Windows) the M4 sets HAVE_UNLINKAT=0
        # and leaves REPLACE_UNLINKAT alone (0). Consumers must compile
        # lib/unlinkat.c when HAVE_UNLINKAT==0 || REPLACE_UNLINKAT==1 (gnulib
        # GL_COND_OBJ_UNLINKAT).
        "//conditions:default": [
            checks.AC_SUBST(
                "REPLACE_UNLINKAT",
                condition = "ac_cv_func_unlinkat && (!gl_cv_func_lstat_dereferences_slashed_symlink || REPLACE_UNLINK==1)",
            ),
        ],
    }),
    visibility = ["//visibility:public"],
    deps = [
        # AC_REQUIRE([gl_USE_SYSTEM_EXTENSIONS,

        # Note: AC_CHECK_INCLUDES_DEFAULT is added for test compatibility
        "//gnulib/m4/extensions",
        "//gnulib/m4/unlink",
        # AC_REQUIRE([gl_FUNC_LSTAT_FOLLOWS_SLASHED_SYMLINK])
        "//gnulib/m4/lstat:gl_FUNC_LSTAT_FOLLOWS_SLASHED_SYMLINK",
        # Note: gl_UNISTD_H_DEFAULTS is a _DEFAULTS function, so we don't track it as a dependency
        "//autoconf/macros/AC_CHECK_INCLUDES_DEFAULT",
    ],
)

autoconf(
    name = "unlinkat",
    visibility = ["//visibility:public"],
    deps = [
        ":gl_FUNC_UNLINKAT",
    ],
)
