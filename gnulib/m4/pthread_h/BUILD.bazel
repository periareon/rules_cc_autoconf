# gl_PTHREAD_H_PART1 - First part of pthread.h checks (without PTHREAD_MUTEX_ROBUST etc)
#
# This is used by gl_PTHREAD_SPIN which only requires PART1, not the full gl_PTHREAD_H.
# Provides:
# - HAVE_PTHREAD_H (define + subst)
# - HAVE_PTHREAD_T (define + subst, overrides default if check fails)
# - HAVE_PTHREAD_SPINLOCK_T (define + subst, overrides default if type doesn't exist)
# - HAVE_PTHREAD_SPIN_* / REPLACE_PTHREAD_SPIN_* (subst, gl_PTHREAD_SPIN logic)
# - NEXT_PTHREAD_H, NEXT_AS_FIRST_DIRECTIVE_PTHREAD_H (subst)
autoconf(
    name = "gl_PTHREAD_H_PART1",
    checks = gl_macros.GL_CHECK_NEXT_HEADERS(["pthread.h"]) + [
        # AC_CHECK_HEADERS_ONCE([pthread.h]) (run by gl_CHECK_NEXT_HEADERS)
        # defines HAVE_PTHREAD_H only when the header exists.
        checks.AC_DEFINE(
            "HAVE_PTHREAD_H",
            condition = "ac_cv_header_pthread_h",
            if_false = None,
            if_true = 1,
        ),
    ] + select({
        # case "$host_os" in mingw* | windows*) && test $gl_threads_api = windows:
        # HAVE_PTHREAD_H=0 even when a <pthread.h> (winpthreads) is present.
        "@platforms//os:windows": [
            checks.AC_SUBST("HAVE_PTHREAD_H", "0"),
        ],
        "//conditions:default": [
            checks.AC_SUBST(
                "HAVE_PTHREAD_H",
                condition = "ac_cv_header_pthread_h",
                if_false = "0",
                if_true = "1",
            ),
        ],
    }) + [
        # AC_CHECK_TYPES([pthread_t, pthread_spinlock_t], [], [],
        #   [AC_INCLUDES_DEFAULT[ #if HAVE_PTHREAD_H #include <pthread.h> #endif]])
        # HAVE_PTHREAD_T=0 / HAVE_PTHREAD_SPINLOCK_T=0 when the type is missing.
        checks.AC_CHECK_TYPE(
            "pthread_t",
            define = "HAVE_PTHREAD_T",
            includes = ["#include <pthread.h>"],
        ),
        checks.AC_SUBST(
            "HAVE_PTHREAD_T",
            condition = "ac_cv_type_pthread_t",
            if_false = "0",
            if_true = "1",
        ),
        checks.AC_CHECK_TYPE(
            "pthread_spinlock_t",
            define = "HAVE_PTHREAD_SPINLOCK_T",
            includes = ["#include <pthread.h>"],
        ),
        checks.AC_SUBST(
            "HAVE_PTHREAD_SPINLOCK_T",
            condition = "ac_cv_type_pthread_spinlock_t",
            if_false = "0",
            if_true = "1",
        ),
    ] + select({
        # gl_PTHREAD_SPIN on mingw/windows with gl_threads_api = windows:
        # gnulib's windows-spin implementation replaces the functions; the
        # HAVE_PTHREAD_SPIN_* defaults (1) are left alone.
        "@platforms//os:windows": [
            checks.AC_SUBST("REPLACE_PTHREAD_SPIN_INIT", "1"),
            checks.AC_SUBST("REPLACE_PTHREAD_SPIN_LOCK", "1"),
            checks.AC_SUBST("REPLACE_PTHREAD_SPIN_TRYLOCK", "1"),
            checks.AC_SUBST("REPLACE_PTHREAD_SPIN_UNLOCK", "1"),
            checks.AC_SUBST("REPLACE_PTHREAD_SPIN_DESTROY", "1"),
        ],
        # gl_PTHREAD_SPIN elsewhere:
        #   if test $HAVE_PTHREAD_H = 0 || test $HAVE_PTHREAD_SPINLOCK_T = 0:
        #     HAVE_PTHREAD_SPIN_*=0
        #   else AC_CACHE_CHECK([for pthread_spin_init]) (link test); when it
        #     fails: HAVE_PTHREAD_SPIN_*=0 and REPLACE_PTHREAD_SPIN_*=1
        "//conditions:default": [
            checks.AC_TRY_LINK(
                name = "gl_cv_func_pthread_spin_init_in_LIBMULTITHREAD",
                code = utils.AC_LANG_PROGRAM(
                    ["#include <pthread.h>"],
                    [
                        "pthread_spinlock_t lock;",
                        "return pthread_spin_init (&lock, 0);",
                    ],
                ),
                requires = [
                    "ac_cv_header_pthread_h",
                    "ac_cv_type_pthread_spinlock_t",
                ],
            ),
            checks.AC_SUBST(
                "HAVE_PTHREAD_SPIN_INIT",
                condition = "ac_cv_header_pthread_h && ac_cv_type_pthread_spinlock_t && gl_cv_func_pthread_spin_init_in_LIBMULTITHREAD",
                if_false = "0",
                if_true = "1",
            ),
            checks.AC_SUBST(
                "HAVE_PTHREAD_SPIN_LOCK",
                condition = "ac_cv_header_pthread_h && ac_cv_type_pthread_spinlock_t && gl_cv_func_pthread_spin_init_in_LIBMULTITHREAD",
                if_false = "0",
                if_true = "1",
            ),
            checks.AC_SUBST(
                "HAVE_PTHREAD_SPIN_TRYLOCK",
                condition = "ac_cv_header_pthread_h && ac_cv_type_pthread_spinlock_t && gl_cv_func_pthread_spin_init_in_LIBMULTITHREAD",
                if_false = "0",
                if_true = "1",
            ),
            checks.AC_SUBST(
                "HAVE_PTHREAD_SPIN_UNLOCK",
                condition = "ac_cv_header_pthread_h && ac_cv_type_pthread_spinlock_t && gl_cv_func_pthread_spin_init_in_LIBMULTITHREAD",
                if_false = "0",
                if_true = "1",
            ),
            checks.AC_SUBST(
                "HAVE_PTHREAD_SPIN_DESTROY",
                condition = "ac_cv_header_pthread_h && ac_cv_type_pthread_spinlock_t && gl_cv_func_pthread_spin_init_in_LIBMULTITHREAD",
                if_false = "0",
                if_true = "1",
            ),
            checks.AC_SUBST(
                "REPLACE_PTHREAD_SPIN_INIT",
                condition = "ac_cv_header_pthread_h && ac_cv_type_pthread_spinlock_t && !gl_cv_func_pthread_spin_init_in_LIBMULTITHREAD",
                if_false = "0",
                if_true = "1",
            ),
            checks.AC_SUBST(
                "REPLACE_PTHREAD_SPIN_LOCK",
                condition = "ac_cv_header_pthread_h && ac_cv_type_pthread_spinlock_t && !gl_cv_func_pthread_spin_init_in_LIBMULTITHREAD",
                if_false = "0",
                if_true = "1",
            ),
            checks.AC_SUBST(
                "REPLACE_PTHREAD_SPIN_TRYLOCK",
                condition = "ac_cv_header_pthread_h && ac_cv_type_pthread_spinlock_t && !gl_cv_func_pthread_spin_init_in_LIBMULTITHREAD",
                if_false = "0",
                if_true = "1",
            ),
            checks.AC_SUBST(
                "REPLACE_PTHREAD_SPIN_UNLOCK",
                condition = "ac_cv_header_pthread_h && ac_cv_type_pthread_spinlock_t && !gl_cv_func_pthread_spin_init_in_LIBMULTITHREAD",
                if_false = "0",
                if_true = "1",
            ),
            checks.AC_SUBST(
                "REPLACE_PTHREAD_SPIN_DESTROY",
                condition = "ac_cv_header_pthread_h && ac_cv_type_pthread_spinlock_t && !gl_cv_func_pthread_spin_init_in_LIBMULTITHREAD",
                if_false = "0",
                if_true = "1",
            ),
        ],
    }),
    visibility = ["//gnulib:__subpackages__"],
    deps = [
        "//autoconf/macros/AC_CHECK_INCLUDES_DEFAULT",  # For test compatibility
        "//gnulib/m4/extensions",
        "//gnulib/m4/include_next",
        # AC_REQUIRE([gl_PTHREADLIB]). gl_THREADLIB_BODY because the m4 does
        # AC_REQUIRE([gl_THREADLIB]) whenever threadlib.m4 is present (it
        # always is); gl_STDTHREADLIB_BODY for the HAVE_THREADS_H template line.
        "//gnulib/m4/threadlib:gl_PTHREADLIB",
        "//gnulib/m4/threadlib:gl_STDTHREADLIB_BODY",
        "//gnulib/m4/threadlib:gl_THREADLIB_BODY",
    ],
)

# gl_PTHREAD_H - Full pthread.h checks including the PTHREAD_* constants
#
# AC_CACHE_CHECK([for PTHREAD_CREATE_DETACHED]) etc.: each is an
# AC_COMPILE_IFELSE of `#include <pthread.h> int x = CONSTANT;`; when it
# fails the corresponding HAVE_* subst becomes 0 (macOS lacks
# PTHREAD_MUTEX_ROBUST, MSVC has no <pthread.h> at all).
# Use this for modules that call gl_PTHREAD_H (not just gl_PTHREAD_SPIN).
autoconf(
    name = "gl_PTHREAD_H",
    checks = [
        checks.AC_TRY_COMPILE(
            name = "gl_cv_const_PTHREAD_CREATE_DETACHED",
            code = """\
#include <pthread.h>
int x = PTHREAD_CREATE_DETACHED;
""",
        ),
        checks.AC_SUBST(
            "HAVE_PTHREAD_CREATE_DETACHED",
            condition = "gl_cv_const_PTHREAD_CREATE_DETACHED",
            if_false = "0",
            if_true = "1",
        ),
        checks.AC_TRY_COMPILE(
            name = "gl_cv_const_PTHREAD_MUTEX_RECURSIVE",
            code = """\
#include <pthread.h>
int x = PTHREAD_MUTEX_RECURSIVE;
""",
        ),
        checks.AC_SUBST(
            "HAVE_PTHREAD_MUTEX_RECURSIVE",
            condition = "gl_cv_const_PTHREAD_MUTEX_RECURSIVE",
            if_false = "0",
            if_true = "1",
        ),
        checks.AC_TRY_COMPILE(
            name = "gl_cv_const_PTHREAD_MUTEX_ROBUST",
            code = """\
#include <pthread.h>
int x = PTHREAD_MUTEX_ROBUST;
""",
        ),
        checks.AC_SUBST(
            "HAVE_PTHREAD_MUTEX_ROBUST",
            condition = "gl_cv_const_PTHREAD_MUTEX_ROBUST",
            if_false = "0",
            if_true = "1",
        ),
        checks.AC_TRY_COMPILE(
            name = "gl_cv_const_PTHREAD_PROCESS_SHARED",
            code = """\
#include <pthread.h>
int x = PTHREAD_PROCESS_SHARED;
""",
        ),
        checks.AC_SUBST(
            "HAVE_PTHREAD_PROCESS_SHARED",
            condition = "gl_cv_const_PTHREAD_PROCESS_SHARED",
            if_false = "0",
            if_true = "1",
        ),
    ],
    visibility = ["//visibility:public"],
    deps = [
        ":gl_PTHREAD_H_PART1",
    ],
)

# gl_PTHREAD_MODULE_INDICATOR([modulename])
# Ensures defaults are expanded; sets GNULIB_<module> for the given module.
# Deliberately not a dependency of :gl_PTHREAD_H_REQUIRE_DEFAULTS, so that the
# HAVE_PTHREAD_* / REPLACE_PTHREAD_* defaults do not collide with the values
# gl_PTHREAD_H_PART1 / gl_PTHREAD_H and the pthread-* modules set.
autoconf(
    name = "gl_PTHREAD_MODULE_INDICATOR",
    checks = [],
    visibility = ["//visibility:public"],
)

# Public pthread_h target
autoconf(
    name = "pthread_h",
    visibility = ["//visibility:public"],
    deps = [
        ":gl_PTHREAD_H",
        ":gl_PTHREAD_MODULE_INDICATOR",
    ],
)
