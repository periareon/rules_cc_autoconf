"""https://github.com/coreutils/gnulib/blob/1039a5f2cee3cda1c11f64a5eb3a15b2e87cd2f0/m4/symlink.m4"""

load("//autoconf:autoconf_toolchain.bzl", autoconf = "autoconf_cache")
load("//autoconf:checks.bzl", "checks")

# AC_CHECK_FUNCS_ONCE([symlink]) - the bare probe plus its config.h define.
#
# Modules that only run this probe (fcntl-o, linkat, ...) must not touch the
# HAVE_SYMLINK subst: its gl_UNISTD_H_DEFAULTS value (1) is lowered by
# gl_FUNC_SYMLINK alone.
autoconf(
    name = "AC_CHECK_FUNCS_ONCE_symlink",
    checks = [
        checks.AC_CHECK_FUNC(
            "symlink",
            define = "HAVE_SYMLINK",
        ),
    ],
    visibility = ["//gnulib:__subpackages__"],
    deps = [
        "//autoconf/macros/AC_CANONICAL_HOST",
        "//autoconf/macros/AC_CHECK_INCLUDES_DEFAULT",
    ],
)

autoconf(
    name = "gl_FUNC_SYMLINK",
    checks = [
        # if test $ac_cv_func_symlink = no; then HAVE_SYMLINK=0
        checks.AC_SUBST(
            "HAVE_SYMLINK",
            condition = "ac_cv_func_symlink",
        ),
    ] + select({
        # M4 m4/symlink.m4 runs AC_RUN_IFELSE for the trailing-slash bug;
        # cross-compile guess for darwin falls to gl_cross_guess_normal.
        # On macOS the SDK probe decides.
        "@platforms//os:macos": [
            checks.AC_SUBST(
                "REPLACE_SYMLINK",
                condition = "gl_cv_macos_sdk_modern",
                if_false = "1",
                if_true = "0",
            ),
        ],
        # Linux: cross-compile guess "yes". Windows: symlink is absent, so the
        # M4 takes the HAVE_SYMLINK=0 branch and never sets REPLACE_SYMLINK.
        "//conditions:default": [
            checks.AC_SUBST("REPLACE_SYMLINK", "0"),
        ],
    }),
    visibility = ["//visibility:public"],
    deps = [
        ":AC_CHECK_FUNCS_ONCE_symlink",  # AC_CHECK_FUNCS_ONCE([symlink]) + AC_REQUIRE([AC_CANONICAL_HOST])
        "//gnulib/m4/gnulib-common:gl_HOST_MACOS_SDK_MODERN",
    ],
)

autoconf(
    name = "symlink",
    visibility = ["//visibility:public"],
    deps = [
        ":gl_FUNC_SYMLINK",
    ],
)
