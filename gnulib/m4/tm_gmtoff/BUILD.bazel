"""https://github.com/coreutils/gnulib/blob/1039a5f2cee3cda1c11f64a5eb3a15b2e87cd2f0/m4/tm_gmtoff.m4"""

load("//autoconf:autoconf_toolchain.bzl", autoconf = "autoconf_cache")
load("//autoconf:checks.bzl", "checks")

autoconf(
    name = "gl_TM_GMTOFF",
    checks = [
        # AC_CHECK_MEMBERS([struct tm.tm_gmtoff, struct tm.tm_zone])
        checks.AC_CHECK_MEMBER(
            "struct tm.tm_gmtoff",
            define = "HAVE_STRUCT_TM_TM_GMTOFF",
            includes = ["#include <time.h>"],
        ),
        checks.AC_CHECK_MEMBER(
            "struct tm.tm_zone",
            define = "HAVE_STRUCT_TM_TM_ZONE",
            includes = ["#include <time.h>"],
        ),
        # Backward compatibility: AC_DEFINE([HAVE_TM_GMTOFF]) only when the
        # tm_gmtoff member exists; otherwise the macro stays undefined.
        checks.AC_DEFINE(
            "HAVE_TM_GMTOFF",
            condition = "HAVE_STRUCT_TM_TM_GMTOFF",
            if_false = None,
            if_true = 1,
        ),
        # AC_STRUCT_TIMEZONE (required by gl_TZNAME) defines HAVE_TM_ZONE the
        # same way when struct tm has tm_zone.
        checks.AC_DEFINE(
            "HAVE_TM_ZONE",
            condition = "HAVE_STRUCT_TM_TM_ZONE",
            if_false = None,
            if_true = 1,
        ),
    ],
    visibility = ["//visibility:public"],
)

autoconf(
    name = "tm_gmtoff",
    visibility = ["//visibility:public"],
    deps = [
        ":gl_TM_GMTOFF",
    ],
)
