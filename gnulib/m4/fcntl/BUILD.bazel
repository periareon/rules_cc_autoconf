"""https://github.com/coreutils/gnulib/blob/1039a5f2cee3cda1c11f64a5eb3a15b2e87cd2f0/m4/fcntl.m4"""

load("//autoconf:autoconf_toolchain.bzl", autoconf = "autoconf_cache")
load("//autoconf:checks.bzl", "checks")

# gl_REPLACE_FCNTL - m4 line 144:
#   AC_CHECK_FUNCS_ONCE([fcntl])
#   if test $ac_cv_func_fcntl = no; then HAVE_FCNTL=0 else REPLACE_FCNTL=1 fi
autoconf(
    name = "gl_REPLACE_FCNTL",
    checks = [
        # Note: gl_FCNTL_H_DEFAULTS is a _DEFAULTS function, so we ignore it per user's instruction
        checks.AC_CHECK_FUNC(
            "fcntl",
            name = "ac_cv_func_fcntl",
        ),

        # if test $ac_cv_func_fcntl = no; then
        # else
        #   ... runtime checks ...
        # fi
        # Define HAVE_FCNTL in config.h only if the function exists
        checks.AC_DEFINE(
            "HAVE_FCNTL",
            condition = "ac_cv_func_fcntl",
            if_false = None,
            if_true = 1,
        ),

        # if test $ac_cv_func_fcntl = no; then HAVE_FCNTL=0
        # Lowers the gl_FCNTL_H_DEFAULTS substitution so fcntl.in.h declares
        # the gnulib replacement where the libc has no fcntl (MSVC, MinGW).
        checks.AC_SUBST(
            "HAVE_FCNTL",
            condition = "ac_cv_func_fcntl",
            if_false = 0,
            if_true = 1,
        ),
        # gl_REPLACE_FCNTL logic:
        # - If function doesn't exist: HAVE_FCNTL=0, REPLACE_FCNTL stays 0
        # - If function exists but F_DUPFD doesn't work correctly, REPLACE_FCNTL=1
        # - If function exists but F_DUPFD_CLOEXEC doesn't work, REPLACE_FCNTL=1
        # - If function exists but HAVE_FCHDIR=0, REPLACE_FCNTL=1
        # The AC_RUN_IFELSE checks can't be done in Bazel; on all supported platforms
        # where fcntl exists (macOS, Linux) it needs replacement (F_DUPFD_CLOEXEC issues).
        # Without fcntl (MSVC) the M4 sets HAVE_FCNTL=0 and leaves REPLACE_FCNTL
        # alone (0); consumers compile lib/fcntl.c when
        # HAVE_FCNTL==0 || REPLACE_FCNTL==1 (gnulib GL_COND_OBJ_FCNTL).
        checks.AC_SUBST(
            "REPLACE_FCNTL",
            condition = "ac_cv_func_fcntl",
            if_false = 0,  # Function absent: HAVE_FCNTL=0 pulls the replacement
            if_true = 1,  # Function exists but has bugs (F_DUPFD_CLOEXEC issues)
        ),
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//autoconf/macros/AC_CHECK_INCLUDES_DEFAULT",
    ],
)

# gl_FUNC_FCNTL - m4 line 18. Its own probes (gl_cv_func_fcntl_f_dupfd_works,
# gl_cv_func_fcntl_f_dupfd_cloexec: AC_RUN_IFELSE) are not modelled; on every
# supported host it ends up invoking gl_REPLACE_FCNTL, which carries the
# shared AC_CHECK_FUNCS_ONCE([fcntl]) probe and the REPLACE_FCNTL result.
autoconf(
    name = "gl_FUNC_FCNTL",
    checks = [],
    visibility = ["//visibility:public"],
    deps = [
        ":gl_REPLACE_FCNTL",  # AC_CHECK_FUNCS_ONCE([fcntl]) / gl_REPLACE_FCNTL
        "//gnulib/m4/extensions",  # AC_REQUIRE([gl_USE_SYSTEM_EXTENSIONS])
        # Note: gl_FCNTL_H_DEFAULTS is a _DEFAULTS function, so we ignore it per user's instruction
        "//autoconf/macros/AC_CANONICAL_HOST",  # AC_REQUIRE([AC_CANONICAL_HOST])
        # The m4 file conditionally uses gl_FUNC_FCHDIR to check if fchdir exists
        # If HAVE_FCHDIR=0, it triggers gl_REPLACE_FCNTL
        "//gnulib/m4/fchdir:gl_FUNC_FCHDIR_FOR_CLOSE",  # gl_TEST_FCHDIR
        "//autoconf/macros/AC_CHECK_INCLUDES_DEFAULT",
    ],
)

autoconf(
    name = "fcntl",
    visibility = ["//visibility:public"],
    deps = [
        ":gl_FUNC_FCNTL",
        ":gl_REPLACE_FCNTL",
    ],
)
