"""https://github.com/coreutils/gnulib/blob/1039a5f2cee3cda1c11f64a5eb3a15b2e87cd2f0/m4/stddef_h.m4"""

load("//autoconf:autoconf_toolchain.bzl", autoconf = "autoconf_cache")
load("//autoconf:checks.bzl", "checks")
load("//gnulib:macros.bzl", gl_macros = "macros")

# gl_STDDEF_H macro from stddef_h.m4
autoconf(
    name = "stddef_h",
    checks = [
        # gl_CHECK_NEXT_HEADERS([stddef.h]) - sets NEXT_STDDEF_H and NEXT_AS_FIRST_DIRECTIVE_STDDEF_H
    ] + gl_macros.GL_CHECK_NEXT_HEADERS(["stddef.h"]) + [
        # GL_GENERATE_STDDEF_H: upstream starts at "false" and flips to "true"
        # if max_align_t is missing, wchar_t is missing, NULL is broken, or
        # unreachable() is unavailable.  Because we call GL_CHECK_NEXT_HEADERS
        # unconditionally above, gnulib's stddef.h wrapper is always generated.
        checks.M4_VARIABLE("GL_GENERATE_STDDEF_H", "true"),
        # Check that stddef.h can be included
        checks.AC_CHECK_HEADER("stddef.h"),
        # unreachable() is C23; the probe runs in the toolchain's default
        # language mode, exactly like GNU configure does under the
        # conformance test (which pins ac_cv_prog_cc_c23=no).
        checks.AC_TRY_LINK(
            name = "gl_cv_c_func_unreachable",
            code = """#include <stddef.h>
int main(void) {
    unreachable();
    return 0;
}
""",
            language = "c",
        ),
        checks.AC_SUBST(
            "HAVE_C_UNREACHABLE",
            condition = "gl_cv_c_func_unreachable",
            if_false = 0,
            if_true = 1,
        ),
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//gnulib/m4/include_next",
        "//gnulib/m4/extensions",
        # For test compatibility
        "//autoconf/macros/AC_CHECK_INCLUDES_DEFAULT",
    ],
)

autoconf(
    name = "gl_STDDEF_H_DEFAULTS",
    checks = [
        checks.AC_SUBST("REPLACE_NULL", 0),
        # HAVE_WCHAR_T default — present on every libc we target.  Upstream's
        # gl_STDDEF_H probes it explicitly; we mirror the result as a static
        # default since no platform we support is missing wchar_t.
        checks.AC_SUBST("HAVE_WCHAR_T", 1),
    ] + select({
        # On Ubuntu 24.04 (glibc 2.39 / GCC 14), nullptr_t is provided
        # natively and stddef.h is NOT idempotent.
        "@platforms//os:linux": [
            checks.AC_SUBST("NULLPTR_T_NEEDS_STDDEF", 0),
            checks.AC_SUBST("STDDEF_NOT_IDEMPOTENT", 1),
        ],
        "//conditions:default": [
            checks.AC_SUBST("NULLPTR_T_NEEDS_STDDEF", 1),
            checks.AC_SUBST("STDDEF_NOT_IDEMPOTENT", 0),
        ],
    }) + select({
        "@rules_cc//cc/compiler:msvc-cl": [
            # MSVC in C mode does not provide max_align_t in <stddef.h>;
            # gnulib's stddef.in.h supplies rpl_max_align_t when this is 0.
            # MinGW GCC provides max_align_t via _GCC_MAX_ALIGN_T so it
            # does not need this override.
            checks.AC_SUBST("HAVE_MAX_ALIGN_T", 0),
        ],
        "//conditions:default": [
            checks.AC_SUBST("HAVE_MAX_ALIGN_T", 1),
        ],
    }),
    visibility = ["//visibility:private"],
)

# Note: stddef_h has _REQUIRE_DEFAULTS but no GNULIB_* variables
autoconf(
    name = "gl_STDDEF_H_REQUIRE_DEFAULTS",
    checks = [
    ],
    visibility = ["//visibility:private"],
    deps = [
        ":gl_STDDEF_H_DEFAULTS",
    ],
)

autoconf(
    name = "defaults",
    visibility = ["//visibility:public"],
    deps = [
        ":gl_STDDEF_H_REQUIRE_DEFAULTS",
    ],
)
