"""https://github.com/coreutils/gnulib/blob/1039a5f2cee3cda1c11f64a5eb3a15b2e87cd2f0/m4/mbsnrtowcs.m4"""

load("//autoconf:autoconf_toolchain.bzl", autoconf = "autoconf_cache")
load("//autoconf:checks.bzl", "checks")
load("//gnulib:macros.bzl", gl_macros = "macros")

autoconf(
    name = "gl_FUNC_MBSNRTOWCS",
    checks = gl_macros.GL_CHECK_FUNCS_ANDROID(
        ["mbsnrtowcs"],
        includes = ["#include <wchar.h>"],
    ) + [
        checks.AC_SUBST(
            "HAVE_MBSNRTOWCS",
            condition = "ac_cv_func_mbsnrtowcs",
            if_false = 0,
            if_true = 1,
        ),
    ] + select({
        # On Linux: mbsnrtowcs may have issues, needs replacement
        "@platforms//os:linux": [
            checks.AC_SUBST("REPLACE_MBSNRTOWCS", "1"),
        ],
        # On macOS: mbsnrtowcs works correctly
        "//conditions:default": [
            checks.AC_SUBST("REPLACE_MBSNRTOWCS", "0"),
        ],
    }),
    visibility = ["//visibility:public"],
    deps = [
        ":gl_MBSNRTOWCS_WORKS_IN_TRADITIONAL_LOCALE",
        "//autoconf/macros/AC_TYPE_MBSTATE_T",
        "//gnulib/m4/extensions",
        "//gnulib/m4/mbrtowc:gl_MBRTOWC_C_LOCALE",
        "//gnulib/m4/mbrtowc:gl_MBSTATE_T_BROKEN",
    ],
)

autoconf(
    name = "gl_PREREQ_MBSNRTOWCS",
    visibility = ["//gnulib:__subpackages__"],
)

autoconf(
    name = "gl_MBSNRTOWCS_WORKS_IN_TRADITIONAL_LOCALE",
    visibility = ["//gnulib:__subpackages__"],
    deps = [
        "//autoconf/macros/AC_CANONICAL_HOST",
        "//gnulib/m4/locale-fr",
    ],
)

autoconf(
    name = "mbsnrtowcs",
    visibility = ["//visibility:public"],
    deps = [
        ":gl_FUNC_MBSNRTOWCS",
        ":gl_MBSNRTOWCS_WORKS_IN_TRADITIONAL_LOCALE",
        ":gl_PREREQ_MBSNRTOWCS",
    ],
)
