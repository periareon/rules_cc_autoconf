"""https://github.com/coreutils/gnulib/blob/1039a5f2cee3cda1c11f64a5eb3a15b2e87cd2f0/m4/printf-frexpl.m4"""

load("//autoconf:autoconf_toolchain.bzl", autoconf = "autoconf_cache")
load("//autoconf:checks.bzl", "checks")

autoconf(
    name = "gl_FUNC_PRINTF_FREXPL",
    checks = [
        # m4 line 17-34: subset of gl_FUNC_FREXPL_NO_LIBM (HAVE_FREXPL_IN_LIBC,
        # HAVE_DECL_FREXPL) - provided by //gnulib/m4/frexpl:gl_FUNC_FREXPL_NO_LIBM.
        # m4 line 37-46: gl_CHECK_LDEXPL_NO_LIBM, gl_FUNC_LDEXPL_WORKS, then
        # AC_DEFINE([HAVE_LDEXPL_IN_LIBC]) (//gnulib/m4/ldexpl:HAVE_LDEXPL_IN_LIBC) and
        # AC_CHECK_DECL([ldexpl], , [HAVE_DECL_LDEXPL=0], [[#include <math.h>]]).
        # gl_FUNC_LDEXPL itself (which AC_REQUIREs gl_FUNC_ISNANL) is not invoked.
        checks.AC_CHECK_DECL(
            "ldexpl",
            includes = ["#include <math.h>"],
        ),
        checks.AC_SUBST(
            "HAVE_DECL_LDEXPL",
            condition = "ac_cv_have_decl_ldexpl",
            if_false = 0,
            if_true = 1,
        ),
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//gnulib/m4/frexpl",  # gl_CHECK_FREXPL_NO_LIBM, gl_FUNC_FREXPL_WORKS
        "//gnulib/m4/ldexpl:HAVE_LDEXPL_IN_LIBC",
        "//gnulib/m4/ldexpl:gl_CHECK_LDEXPL_NO_LIBM",
        "//gnulib/m4/ldexpl:gl_FUNC_LDEXPL_WORKS",
        "//gnulib/m4/math_h",  # AC_REQUIRE([gl_MATH_H_DEFAULTS])
        "//gnulib/m4/math_h:long-double-vs-double",  # AC_REQUIRE([gl_LONG_DOUBLE_VS_DOUBLE])
    ],
)

autoconf(
    name = "printf-frexpl",
    visibility = ["//visibility:public"],
    deps = [
        ":gl_FUNC_PRINTF_FREXPL",
        # For test compatibility
        "//autoconf/macros/AC_CHECK_INCLUDES_DEFAULT",
    ],
)
