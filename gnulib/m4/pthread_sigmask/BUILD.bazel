"""https://github.com/coreutils/gnulib/blob/1039a5f2cee3cda1c11f64a5eb3a15b2e87cd2f0/m4/pthread_sigmask.m4"""

load("//autoconf:autoconf_toolchain.bzl", autoconf = "autoconf_cache")
load("//autoconf:checks.bzl", "checks")

# gl_FUNC_PTHREAD_SIGMASK hides its m4_ifdef([gl_][THREADLIB]) from aclocal,
# so threadlib.m4 is not pulled in and the non-threadlib branch applies:
#   if test $ac_cv_func_pthread_sigmask = yes; then :
#   else HAVE_PTHREAD_SIGMASK=0; REPLACE_PTHREAD_SIGMASK=1; fi
# unless pthread_sigmask is a macro (mingw winpthreads), which also gives
# HAVE_PTHREAD_SIGMASK=0 / REPLACE_PTHREAD_SIGMASK=1.
autoconf(
    name = "gl_FUNC_PTHREAD_SIGMASK",
    checks = [
        # AC_CHECK_FUNCS_ONCE([pthread_sigmask])
        checks.AC_CHECK_FUNC("pthread_sigmask"),

        # AC_CACHE_CHECK([whether pthread_sigmask is a macro]) - AC_EGREP_CPP
        checks.AC_TRY_COMPILE(
            name = "gl_cv_func_pthread_sigmask_macro",
            code = """\
#include <pthread.h>
#include <signal.h>
#if defined _WIN32 && defined pthread_sigmask
int headers_define_pthread_sigmask;
#else
#error "pthread_sigmask is not a macro"
#endif
""",
            language = "c",
        ),
        checks.AC_SUBST(
            "HAVE_PTHREAD_SIGMASK",
            condition = "ac_cv_func_pthread_sigmask && !gl_cv_func_pthread_sigmask_macro",
            if_false = "0",
            if_true = "1",
        ),
        checks.AC_SUBST(
            "REPLACE_PTHREAD_SIGMASK",
            condition = "ac_cv_func_pthread_sigmask && !gl_cv_func_pthread_sigmask_macro",
            if_false = "1",
            if_true = "0",
        ),

        # AC_SUBST([PTHREAD_SIGMASK_LIB]) / LIB_PTHREAD_SIGMASK - library needed
        # for pthread_sigmask. On macOS/Linux it is in libc, so no extra library.
        checks.AC_SUBST("LIB_PTHREAD_SIGMASK", ""),
        checks.AC_SUBST("PTHREAD_SIGMASK_LIB", ""),
    ],
    visibility = ["//visibility:public"],
    deps = [
        # Note: signal_h provides HAVE_SIGSET_T, but golden file expects it undefined
        # "//gnulib/m4/signal_h",  # AC_REQUIRE([gl_SIGNAL_H_DEFAULTS]) - provides HAVE_SIGSET_T (but golden expects undefined)
        "//gnulib/m4/threadlib",  # AC_REQUIRE([gl_PTHREADLIB])
    ],
)

# Prerequisite of lib/pthread_sigmask.c.
autoconf(
    name = "gl_PREREQ_PTHREAD_SIGMASK",
    checks = [
        # gl_PREREQ_PTHREAD_SIGMASK: AC_DEFINE([HAVE_PTHREAD_SIGMASK]) when
        # HAVE_PTHREAD_SIGMASK = 1.
        checks.AC_DEFINE(
            "HAVE_PTHREAD_SIGMASK",
            condition = "ac_cv_func_pthread_sigmask && !gl_cv_func_pthread_sigmask_macro",
            if_false = None,
            if_true = 1,
        ),
    ],
    visibility = ["//visibility:public"],
    deps = [
        ":gl_FUNC_PTHREAD_SIGMASK",  # $HAVE_PTHREAD_SIGMASK is computed by gl_FUNC_PTHREAD_SIGMASK
    ],
)

autoconf(
    name = "pthread_sigmask",
    visibility = ["//visibility:public"],
    deps = [
        ":gl_FUNC_PTHREAD_SIGMASK",
        ":gl_PREREQ_PTHREAD_SIGMASK",
        # For test compatibility
        "//autoconf/macros/AC_CHECK_INCLUDES_DEFAULT",
    ],
)
