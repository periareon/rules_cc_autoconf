"""https://github.com/coreutils/gnulib/blob/1039a5f2cee3cda1c11f64a5eb3a15b2e87cd2f0/m4/lstat.m4"""

load("//autoconf:autoconf_toolchain.bzl", autoconf = "autoconf_cache")
load("//autoconf:checks.bzl", "checks")

# HAVE_LSTAT - Check for lstat function existence and define HAVE_LSTAT
# Single source of truth for HAVE_LSTAT define.
autoconf(
    name = "HAVE_LSTAT",
    checks = [
        checks.AC_CHECK_FUNC("lstat"),
        checks.AC_DEFINE(
            "HAVE_LSTAT",
            requires = ["ac_cv_func_lstat==1"],
        ),
        # Override the sys_stat_h default (HAVE_LSTAT=1) so that the
        # sys_stat.in.h template sees the correct value. When lstat is absent
        # (e.g. Windows), the header defines lstat as stat instead of rpl_lstat.
        checks.AC_SUBST(
            "HAVE_LSTAT",
            condition = "ac_cv_func_lstat",
        ),
    ],
    visibility = ["//gnulib:__subpackages__"],
    deps = [
        "//autoconf/macros/AC_CHECK_INCLUDES_DEFAULT",
    ],
)

# gl_FUNC_LSTAT_FOLLOWS_SLASHED_SYMLINK — m4/lstat.m4
#
# Upstream M4 runs a runtime probe (symlink + lstat with trailing slash).
# Cross-compile guess table:
#   linux-*|linux|midipix*|*-gnu*|gnu*    -> yes
#   mingw*|windows*                       -> no
#   * (incl. darwin, solaris, *bsd)       -> gl_cross_guess_normal ("no")
#
# We populate `gl_cv_func_lstat_dereferences_slashed_symlink` on every host
# because gl_FUNC_LSTAT consumes it for REPLACE_LSTAT. On macOS the SDK
# probe drives both that cache var AND the AC_DEFINE; Linux gets "yes"
# unconditionally; Windows gets "no" (probe fails via #error).
autoconf(
    name = "gl_FUNC_LSTAT_FOLLOWS_SLASHED_SYMLINK",
    checks = select({
        "@platforms//os:macos": [
            # M4's runtime probe is approximated via the shared gnulib-common
            # SDK-version probe. We keep the upstream M4 cache var name
            # (`gl_cv_func_lstat_dereferences_slashed_symlink`) populated
            # because gl_FUNC_LSTAT references it for REPLACE_LSTAT; gate it
            # on the SDK probe result so it flips to "0" on older macOS
            # targets without losing the M4-faithful interface.
            checks.AC_TRY_LINK(
                name = "gl_cv_func_lstat_dereferences_slashed_symlink",
                code = "int main(void) { return 0; }",
                requires = ["gl_cv_macos_sdk_modern==1"],
            ),
            checks.AC_DEFINE(
                "LSTAT_FOLLOWS_SLASHED_SYMLINK",
                if_true = 1,
                requires = ["gl_cv_macos_sdk_modern==1"],
            ),
        ],
        "@platforms//os:windows": [
            # M4 cross-compile guess for mingw*/windows*: no.
            checks.AC_TRY_LINK(
                name = "gl_cv_func_lstat_dereferences_slashed_symlink",
                code = """\
#error "LSTAT_SLASHED_SYMLINK_BUG"
int main(void) { return 0; }
""",
            ),
        ],
        "//conditions:default": [
            # Linux/glibc: M4 cross-compile guess is "yes".
            checks.AC_TRY_LINK(
                name = "gl_cv_func_lstat_dereferences_slashed_symlink",
                code = "int main(void) { return 0; }",
            ),
            checks.AC_DEFINE(
                "LSTAT_FOLLOWS_SLASHED_SYMLINK",
                if_true = 1,
                requires = ["gl_cv_func_lstat_dereferences_slashed_symlink==1"],
            ),
        ],
    }),
    visibility = ["//visibility:public"],
    deps = [
        "//autoconf/macros/AC_CANONICAL_HOST",
        "//autoconf/macros/AC_CHECK_INCLUDES_DEFAULT",
        "//gnulib/m4/gnulib-common:gl_HOST_MACOS_SDK_MODERN",
    ],
)

#
# REPLACE_LSTAT is set based on:
# - darwin* (macOS): ALWAYS replace (regardless of test result)
# - solaris*: ALWAYS replace
# - Other systems: Replace only if gl_cv_func_lstat_dereferences_slashed_symlink=no
autoconf(
    name = "gl_FUNC_LSTAT",
    checks = select({
        "@platforms//os:macos": [
            checks.AC_TRY_LINK(
                name = "gl_cv_func_lstat_darwin_override",
                code = """\
/* darwin always replaces lstat */
#error "DARWIN_LSTAT_REPLACEMENT"
int main(void) { return 0; }
""",
            ),
            checks.AC_SUBST(
                "REPLACE_LSTAT",
                condition = "!gl_cv_func_lstat_darwin_override",
            ),
        ],
        "@platforms//os:windows": [
            checks.AC_SUBST(
                "REPLACE_LSTAT",
                condition = "!gl_cv_func_lstat_dereferences_slashed_symlink",
            ),
        ],
        "//conditions:default": [
            checks.AC_SUBST(
                "REPLACE_LSTAT",
                condition = "!gl_cv_func_lstat_dereferences_slashed_symlink",
            ),
        ],
    }),
    visibility = ["//visibility:public"],
    deps = [
        ":HAVE_LSTAT",
        ":gl_FUNC_LSTAT_FOLLOWS_SLASHED_SYMLINK",
        "//autoconf/macros/AC_CANONICAL_HOST",
        "//autoconf/macros/AC_CHECK_INCLUDES_DEFAULT",
    ],
)

# Package-level aggregator target
autoconf(
    name = "lstat",
    visibility = ["//visibility:public"],
    deps = [
        ":gl_FUNC_LSTAT",
        ":gl_FUNC_LSTAT_FOLLOWS_SLASHED_SYMLINK",
    ],
)
