"""https://github.com/coreutils/gnulib/blob/1039a5f2cee3cda1c11f64a5eb3a15b2e87cd2f0/m4/pthread-thread.m4"""

load("//autoconf:autoconf_toolchain.bzl", autoconf = "autoconf_cache")
load("//autoconf:checks.bzl", "checks")

autoconf(
    name = "gl_PTHREAD_THREAD",
    checks = select({
        # case "$host_os" in mingw* | windows*) && test $gl_threads_api = windows
        # (the Bazel default on @platforms//os:windows, see threadlib): gnulib
        # replaces the functions, the HAVE_* defaults (1) are left alone.
        "@platforms//os:windows": [
            checks.AC_SUBST("REPLACE_PTHREAD_CREATE", "1"),
            checks.AC_SUBST("REPLACE_PTHREAD_ATTR_INIT", "1"),
            checks.AC_SUBST("REPLACE_PTHREAD_ATTR_GETDETACHSTATE", "1"),
            checks.AC_SUBST("REPLACE_PTHREAD_ATTR_SETDETACHSTATE", "1"),
            checks.AC_SUBST("REPLACE_PTHREAD_ATTR_DESTROY", "1"),
            checks.AC_SUBST("REPLACE_PTHREAD_SELF", "1"),
            checks.AC_SUBST("REPLACE_PTHREAD_EQUAL", "1"),
            checks.AC_SUBST("REPLACE_PTHREAD_DETACH", "1"),
            checks.AC_SUBST("REPLACE_PTHREAD_JOIN", "1"),
            checks.AC_SUBST("REPLACE_PTHREAD_EXIT", "1"),
        ],
        # Elsewhere: if test $HAVE_PTHREAD_H = 0 then HAVE_*=0. HAVE_PTHREAD_H
        # is ac_cv_header_pthread_h from gl_PTHREAD_H_PART1.
        "//conditions:default": [
            checks.AC_SUBST(
                "HAVE_PTHREAD_CREATE",
                condition = "ac_cv_header_pthread_h",
                if_false = "0",
                if_true = "1",
            ),
            checks.AC_SUBST(
                "HAVE_PTHREAD_ATTR_INIT",
                condition = "ac_cv_header_pthread_h",
                if_false = "0",
                if_true = "1",
            ),
            checks.AC_SUBST(
                "HAVE_PTHREAD_ATTR_GETDETACHSTATE",
                condition = "ac_cv_header_pthread_h",
                if_false = "0",
                if_true = "1",
            ),
            checks.AC_SUBST(
                "HAVE_PTHREAD_ATTR_SETDETACHSTATE",
                condition = "ac_cv_header_pthread_h",
                if_false = "0",
                if_true = "1",
            ),
            checks.AC_SUBST(
                "HAVE_PTHREAD_ATTR_DESTROY",
                condition = "ac_cv_header_pthread_h",
                if_false = "0",
                if_true = "1",
            ),
            checks.AC_SUBST(
                "HAVE_PTHREAD_SELF",
                condition = "ac_cv_header_pthread_h",
                if_false = "0",
                if_true = "1",
            ),
            checks.AC_SUBST(
                "HAVE_PTHREAD_EQUAL",
                condition = "ac_cv_header_pthread_h",
                if_false = "0",
                if_true = "1",
            ),
            checks.AC_SUBST(
                "HAVE_PTHREAD_DETACH",
                condition = "ac_cv_header_pthread_h",
                if_false = "0",
                if_true = "1",
            ),
            checks.AC_SUBST(
                "HAVE_PTHREAD_JOIN",
                condition = "ac_cv_header_pthread_h",
                if_false = "0",
                if_true = "1",
            ),
            checks.AC_SUBST(
                "HAVE_PTHREAD_EXIT",
                condition = "ac_cv_header_pthread_h",
                if_false = "0",
                if_true = "1",
            ),

            # AC_CACHE_CHECK([whether pthread_create exists as a global function]):
            # AC_LINK_IFELSE with LIBPMULTITHREAD. When it is only an inline
            # function: REPLACE_PTHREAD_CREATE=1, REPLACE_PTHREAD_ATTR_INIT=1
            # and PTHREAD_CREATE_IS_INLINE.
            checks.AC_TRY_LINK(
                name = "gl_cv_func_pthread_create",
                code = """\
extern
#ifdef __cplusplus
"C"
#endif
int pthread_create (void);
int main ()
{
  return pthread_create ();
}
""",
                language = "c",
                requires = ["ac_cv_header_pthread_h"],
            ),
            checks.AC_SUBST(
                "REPLACE_PTHREAD_CREATE",
                condition = "ac_cv_header_pthread_h && !gl_cv_func_pthread_create",
                if_false = "0",
                if_true = "1",
            ),
            checks.AC_SUBST(
                "REPLACE_PTHREAD_ATTR_INIT",
                condition = "ac_cv_header_pthread_h && !gl_cv_func_pthread_create",
                if_false = "0",
                if_true = "1",
            ),
            checks.AC_DEFINE(
                "PTHREAD_CREATE_IS_INLINE",
                condition = "ac_cv_header_pthread_h && !gl_cv_func_pthread_create",
                if_false = None,
                if_true = 1,
            ),
        ],
    }),
    visibility = ["//visibility:public"],
    deps = [
        "//gnulib/m4/pthread_h",
        "//gnulib/m4/threadlib",
        # For test compatibility
        "//autoconf/macros/AC_CHECK_INCLUDES_DEFAULT",
    ],
)

autoconf(
    name = "pthread-thread",
    visibility = ["//visibility:public"],
    deps = [
        ":gl_PTHREAD_THREAD",
    ],
)
