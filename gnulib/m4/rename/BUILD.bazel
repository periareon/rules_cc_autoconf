"""https://github.com/coreutils/gnulib/blob/1039a5f2cee3cda1c11f64a5eb3a15b2e87cd2f0/m4/rename.m4"""

load("//autoconf:autoconf_toolchain.bzl", autoconf = "autoconf_cache")
load("//autoconf:checks.bzl", "checks")

autoconf(
    name = "gl_FUNC_RENAME",
    checks = [
        # AC_CHECK_FUNCS_ONCE([link]) - probe + config.h define only; the
        # HAVE_LINK subst keeps its gl_UNISTD_H_DEFAULTS value (only
        # gl_FUNC_LINK lowers it).
        checks.AC_CHECK_FUNC(
            "link",
            define = "HAVE_LINK",
        ),
    ] + select({
        # M4 m4/rename.m4 runs AC_RUN_IFELSE for the two trailing-slash bugs
        # (dest + source), the hard-link bug and the existing-destination
        # bug. On macOS the SDK probe decides; on Linux M4's cross-compile
        # guesses give "no bug".
        "@platforms//os:macos": [
            checks.AC_DEFINE(
                "RENAME_TRAILING_SLASH_DEST_BUG",
                if_true = 1,
                requires = ["!gl_cv_macos_sdk_modern"],
            ),
            checks.AC_DEFINE(
                "RENAME_TRAILING_SLASH_SOURCE_BUG",
                if_true = 1,
                requires = ["!gl_cv_macos_sdk_modern"],
            ),
            checks.AC_SUBST(
                "REPLACE_RENAME",
                condition = "gl_cv_macos_sdk_modern",
                if_false = "1",
                if_true = "0",
            ),
        ],
        # Native Windows: M4 guesses "no" for the destination trailing-slash
        # probe and for the existing-destination probe ("yes" for source
        # trailing slash and hard links), so both bug-defines are set and
        # rename is replaced.
        "@platforms//os:windows": [
            checks.AC_DEFINE("RENAME_TRAILING_SLASH_DEST_BUG", 1),
            checks.AC_DEFINE("RENAME_DEST_EXISTS_BUG", 1),
            checks.AC_SUBST("REPLACE_RENAME", "1"),
        ],
        "//conditions:default": [
            checks.AC_SUBST("REPLACE_RENAME", "0"),
        ],
    }),
    visibility = ["//visibility:public"],
    deps = [
        "//autoconf/macros/AC_CHECK_INCLUDES_DEFAULT",
        "//gnulib/m4/gnulib-common:gl_HOST_MACOS_SDK_MODERN",
        # AC_CHECK_FUNCS_ONCE([lstat]) - probe + config.h define only; the
        # HAVE_LSTAT subst keeps its gl_SYS_STAT_H_DEFAULTS value.
        "//gnulib/m4/lstat:AC_CHECK_FUNCS_ONCE_lstat",
    ],
)

autoconf(
    name = "rename",
    visibility = ["//visibility:public"],
    deps = [
        ":gl_FUNC_RENAME",
    ],
)
