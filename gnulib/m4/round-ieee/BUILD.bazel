"""https://github.com/coreutils/gnulib/blob/1039a5f2cee3cda1c11f64a5eb3a15b2e87cd2f0/m4/round-ieee.m4

gl_FUNC_ROUND_IEEE:
- m4_divert_text([INIT_PREPARE], [gl_round_required=ieee])
- AC_REQUIRE([gl_FUNC_ROUND])

The divert_text sets gl_round_required=ieee BEFORE gl_FUNC_ROUND runs, causing
it to also run the IEEE compliance test (round(-0.0) sign-bit preservation).
That test is an AC_RUN_IFELSE, which the Bazel checker cannot express, so the
port follows what GNU configure (autoconf 2.73, run by the conformance tests
with the Bazel toolchain's flags) reports: round(-0.0) keeps its sign on
x86_64 and aarch64 glibc as well as macOS, i.e. REPLACE_ROUND=0 everywhere.
An earlier per-CPU override set REPLACE_ROUND=1 on aarch64; the oracle
contradicted it.
"""

load("//autoconf:autoconf_toolchain.bzl", autoconf = "autoconf_cache")
load("//autoconf:checks.bzl", "checks")

autoconf(
    name = "gl_FUNC_ROUND_IEEE",
    checks = [
        checks.AC_SUBST("ROUND_LIBM", ""),
        checks.AC_SUBST("REPLACE_ROUND", 0),
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//autoconf/macros/AC_CHECK_INCLUDES_DEFAULT",
        "//gnulib/m4/extensions",
    ],
)

autoconf(
    name = "round-ieee",
    visibility = ["//visibility:public"],
    deps = [
        ":gl_FUNC_ROUND_IEEE",
    ],
)
