"""https://github.com/coreutils/gnulib/blob/1039a5f2cee3cda1c11f64a5eb3a15b2e87cd2f0/m4/strchrnul.m4"""

load("//autoconf:autoconf_toolchain.bzl", autoconf = "autoconf_cache")
load("//autoconf:checks.bzl", "checks")

autoconf(
    name = "gl_FUNC_STRCHRNUL",
    checks = [

        # Note: gl_STRING_H_DEFAULTS is a _DEFAULTS function, so we ignore it per user's instruction

        # Use AC_TRY_LINK to verify the function actually links and can be called
        # On macOS, strchrnul is only available on macOS 15.4+, so it may be declared
        # but not available at runtime. The m4 file uses AC_RUN_IFELSE to check if it works,
        # but we can't run that. Based on golden files, on macOS the function doesn't work.
        checks.AC_TRY_LINK(
            name = "ac_cv_func_strchrnul",
            code = """\
#include <string.h>
int main(void) {
    const char *buf = "a";
    return strchrnul(buf, 'b') != buf + 1;
}
""",
        ),
    ] + select({
        "@platforms//os:macos": [
            # On macOS, the function may link but doesn't work at runtime (only available on 15.4+)
            # So we don't define HAVE_STRCHRNUL in config.h and set REPLACE_STRCHRNUL=1
            checks.AC_SUBST("REPLACE_STRCHRNUL", 1),
            # Override string_h default HAVE_STRCHRNUL "1" so golden (0) matches
            checks.AC_SUBST("HAVE_STRCHRNUL", "0"),
        ],
        "//conditions:default": [
            # gl_CHECK_FUNCS_ANDROID_MACOS([strchrnul]) -> AC_CHECK_FUNCS: HAVE_STRCHRNUL
            # is defined in config.h only when the function is found.
            checks.AC_DEFINE(
                "HAVE_STRCHRNUL",
                condition = "ac_cv_func_strchrnul",
                if_false = None,
                if_true = 1,
            ),
            # if test $ac_cv_func_strchrnul = no; then
            #   HAVE_STRCHRNUL=0
            # Overrides the gl_STRING_H_DEFAULTS value of 1 (e.g. MSVC has no strchrnul).
            checks.AC_SUBST(
                "HAVE_STRCHRNUL",
                condition = "ac_cv_func_strchrnul",
                if_false = 0,
                if_true = 1,
            ),
            # REPLACE_STRCHRNUL=1 only for Android "future" functions or when the
            # AC_RUN_IFELSE (gl_cv_func_strchrnul_works) fails, which is only known
            # to happen on Cygwin 1.7.9. Absent function -> no replacement.
            checks.AC_SUBST("REPLACE_STRCHRNUL", 0),
        ],
    }),
    visibility = ["//visibility:public"],
    deps = [
        "//gnulib/m4/extensions",  # AC_REQUIRE([AC_USE_SYSTEM_EXTENSIONS])
        # Note: gl_STRING_H_DEFAULTS is a _DEFAULTS function, so we ignore it per user's instruction
        # But string_h dependency may provide other defines
        "//gnulib/m4/string_h",  # AC_REQUIRE([gl_STRING_H_DEFAULTS])
        # For test compatibility
        "//autoconf/macros/AC_CHECK_INCLUDES_DEFAULT",
    ],
)

# gl_PREREQ_STRCHRNUL - line 55 (empty)
autoconf(
    name = "gl_PREREQ_STRCHRNUL",
    checks = [],
    visibility = ["//visibility:public"],
)

autoconf(
    name = "strchrnul",
    visibility = ["//visibility:public"],
    deps = [
        ":gl_FUNC_STRCHRNUL",
        ":gl_PREREQ_STRCHRNUL",
    ],
)
