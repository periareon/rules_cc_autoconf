"""https://github.com/coreutils/gnulib/blob/1039a5f2cee3cda1c11f64a5eb3a15b2e87cd2f0/m4/sys_time_h.m4"""

load("//autoconf:autoconf_toolchain.bzl", autoconf = "autoconf_cache")
load("//autoconf:checks.bzl", "checks")
load("//gnulib:macros.bzl", gl_macros = "macros")

# AC_CHECK_HEADERS_ONCE([sys/time.h]): config.h HAVE_SYS_TIME_H only.  Used
# by the modules that merely need the header check (time_h, stat-time, ...).
autoconf(
    name = "HAVE_SYS_TIME_H",
    checks = [
        checks.AC_CHECK_HEADER(
            "sys/time.h",
            define = "HAVE_SYS_TIME_H",
        ),
    ],
    visibility = ["//visibility:public"],
)

autoconf(
    name = "gl_SYS_TIME_H",
    checks = gl_macros.GL_CHECK_NEXT_HEADERS(["sys/time.h"]) + [
        # if test $ac_cv_header_sys_time_h != yes; then HAVE_SYS_TIME_H=0
        checks.AC_SUBST(
            "HAVE_SYS_TIME_H",
            condition = "ac_cv_header_sys_time_h",
            if_false = 0,
            if_true = 1,
        ),
        # AC_CACHE_CHECK([for struct timeval], [gl_cv_sys_struct_timeval], ...)
        checks.AC_TRY_COMPILE(
            name = "gl_cv_sys_struct_timeval",
            code = """\
\
#if HAVE_SYS_TIME_H
 #include <sys/time.h>
#endif
#include <time.h>
#if HAVE_WINSOCK2_H
# include <winsock2.h>
#endif

int main(void) {
    static struct timeval x; x.tv_sec = x.tv_usec;
    return 0;
}
""",
            compile_defines = [
                "HAVE_SYS_TIME_H",
                "HAVE_WINSOCK2_H",
            ],
            language = "c",
        ),
        # if test $gl_cv_sys_struct_timeval != yes; then HAVE_STRUCT_TIMEVAL=0
        checks.AC_SUBST(
            "HAVE_STRUCT_TIMEVAL",
            condition = "gl_cv_sys_struct_timeval",
            if_false = 0,
            if_true = 1,
        ),
        # else AC_CACHE_CHECK([for wide-enough struct timeval.tv_sec member],
        #        [gl_cv_sys_struct_timeval_tv_sec], ...)
        checks.AC_TRY_COMPILE(
            name = "gl_cv_sys_struct_timeval_tv_sec",
            code = """\
\
#if HAVE_SYS_TIME_H
 #include <sys/time.h>
#endif
#include <time.h>
#if HAVE_WINSOCK2_H
# include <winsock2.h>
#endif

int main(void) {
    static struct timeval x;
    typedef int verify_tv_sec_type[
      sizeof (time_t) <= sizeof x.tv_sec ? 1 : -1
    ];
    return 0;
}
""",
            compile_defines = [
                "HAVE_SYS_TIME_H",
                "HAVE_WINSOCK2_H",
            ],
            language = "c",
            requires = ["gl_cv_sys_struct_timeval"],
        ),
        #   if test $gl_cv_sys_struct_timeval_tv_sec != yes; then
        #     REPLACE_STRUCT_TIMEVAL=1
        checks.AC_SUBST(
            "REPLACE_STRUCT_TIMEVAL",
            condition = "gl_cv_sys_struct_timeval && !gl_cv_sys_struct_timeval_tv_sec",
            if_false = 0,
            if_true = 1,
        ),
    ],
    visibility = ["//visibility:public"],
    deps = [
        ":HAVE_SYS_TIME_H",  # AC_CHECK_HEADERS_ONCE([sys/time.h])
        "//gnulib/m4/include_next",  # gl_CHECK_NEXT_HEADERS([sys/time.h])
        # gl_PREREQ_SYS_H_WINSOCK2: AC_CHECK_HEADERS_ONCE([sys/socket.h]) (via
        # socklen:gl_CHECK_SOCKET_HEADERS) and the winsock2.h probe.  sys_time_h.m4
        # never invokes gl_SYS_SOCKET_H, so the HAVE_SYS_SOCKET_H subst is left alone.
        "//gnulib/m4/sys_socket_h:gl_PREREQ_SYS_H_WINSOCK2",
        # For test compatibility
        "//autoconf/macros/AC_CHECK_INCLUDES_DEFAULT",
    ],
)

autoconf(
    name = "gl_SYS_TIME_H_DEFAULTS",
    checks = [
        checks.AC_SUBST("HAVE_GETTIMEOFDAY", 1),
        checks.AC_SUBST("HAVE_STRUCT_TIMEVAL", 1),
        checks.AC_SUBST("HAVE_SYS_TIME_H", 1),
        checks.AC_SUBST("REPLACE_GETTIMEOFDAY", 0),
        checks.AC_SUBST("REPLACE_STRUCT_TIMEVAL", 0),
    ],
    visibility = ["//visibility:private"],
)

autoconf(
    name = "gl_SYS_TIME_H_REQUIRE_DEFAULTS",
    checks = [
        checks.AC_SUBST("GNULIB_GETTIMEOFDAY", 0),
    ],
    visibility = ["//visibility:private"],
    deps = [
        ":gl_SYS_TIME_H_DEFAULTS",
    ],
)

autoconf(
    name = "defaults",
    visibility = ["//visibility:public"],
    deps = [
        ":gl_SYS_TIME_H_REQUIRE_DEFAULTS",
    ],
)

# gl_SYS_TIME_MODULE_INDICATOR([modulename]): gl_SYS_TIME_H_REQUIRE_DEFAULTS (the
# defaults are supplied through the toolchain's :defaults target) and
# GNULIB_<module>=1 for the named module; no checks of its own.
autoconf(
    name = "gl_SYS_TIME_MODULE_INDICATOR",
    checks = [],
    visibility = ["//visibility:public"],
)

autoconf(
    name = "sys_time_h",
    visibility = ["//visibility:public"],
    deps = [
        ":gl_SYS_TIME_H",
        ":gl_SYS_TIME_MODULE_INDICATOR",
    ],
)
