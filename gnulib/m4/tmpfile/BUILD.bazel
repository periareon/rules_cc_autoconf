"""https://github.com/coreutils/gnulib/blob/1039a5f2cee3cda1c11f64a5eb3a15b2e87cd2f0/m4/tmpfile.m4"""

load("//autoconf:autoconf_toolchain.bzl", autoconf = "autoconf_cache")
load("//autoconf:checks.bzl", "checks")

autoconf(
    name = "gl_FUNC_TMPFILE",
    checks = [
        # AC_CACHE_CHECK([whether tmpfile works], [gl_cv_func_tmpfile_works],
        #   [AC_EGREP_CPP([choke me], [
        #      #if defined _WIN32 && ! defined __CYGWIN__
        #      choke me
        #      #endif], [gl_cv_func_tmpfile_works=no], [AC_RUN_IFELSE(...)])])
        # Native Windows is rejected by the preprocessor test (tmpfile() tries to
        # create the file in the root directory). Elsewhere the runtime test
        # passes (only Android 4.3 is known to fail).
        checks.AC_TRY_COMPILE(
            name = "gl_cv_func_tmpfile_works",
            code = """\
#if defined _WIN32 && ! defined __CYGWIN__
#error "tmpfile does not work on native Windows"
#endif
int main(void) { return 0; }
""",
            language = "c",
        ),
        # case "$gl_cv_func_tmpfile_works" in *yes) ;; *) REPLACE_TMPFILE=1 ;; esac
        checks.AC_SUBST(
            "REPLACE_TMPFILE",
            condition = "gl_cv_func_tmpfile_works",
            if_false = 1,
            if_true = 0,
        ),
    ],
    visibility = ["//visibility:public"],
    deps = [
        # Note: gl_STDIO_H_DEFAULTS is a _DEFAULTS function, so we ignore it per user's instruction
        "//autoconf/macros/AC_CANONICAL_HOST",  # AC_REQUIRE([AC_CANONICAL_HOST])
        "//autoconf/macros/AC_CHECK_INCLUDES_DEFAULT",
    ],
)

# gl_PREREQ_TMPFILE - line 64 (empty)
autoconf(
    name = "gl_PREREQ_TMPFILE",
    checks = [],
    visibility = ["//visibility:public"],
)

autoconf(
    name = "tmpfile",
    visibility = ["//visibility:public"],
    deps = [
        ":gl_FUNC_TMPFILE",
        ":gl_PREREQ_TMPFILE",
    ],
)
