"""https://github.com/coreutils/gnulib/blob/1039a5f2cee3cda1c11f64a5eb3a15b2e87cd2f0/m4/endian_h.m4"""

load("//autoconf:autoconf_toolchain.bzl", autoconf = "autoconf_cache")
load("//autoconf:checks.bzl", "checks")
load("//gnulib:macros.bzl", gl_macros = "macros")

autoconf(
    name = "endian_h",
    checks = [
        # AC_CHECK_HEADERS_ONCE([endian.h]) and ([sys/endian.h]): plain header probes on every
        # platform, as configure runs them.  No macOS SDK ships <sys/endian.h> (they have
        # <machine/endian.h> and <sys/_endian.h>), and configure there gets HAVE_SYS_ENDIAN_H=0,
        # GL_GENERATE_ENDIAN_H=true: gnulib's wrapper then defines the conversion functions
        # itself.  An earlier version of this port answered the sys/endian.h probe on macOS from
        # the deployment target instead, and the wrapper's `#include <sys/endian.h>` failed
        # (gzip's lib/crc.c on the BCR presubmit).
        checks.AC_CHECK_HEADER(
            "endian.h",
            name = "ac_cv_header_endian_h",
        ),
        checks.AC_CHECK_HEADER(
            "sys/endian.h",
            name = "ac_cv_header_sys_endian_h",
        ),
        checks.AC_DEFINE(
            "HAVE_ENDIAN_H",
            requires = ["ac_cv_header_endian_h==1"],
        ),
        checks.AC_SUBST(
            "HAVE_ENDIAN_H",
            condition = "ac_cv_header_endian_h",
            if_false = 0,
            if_true = 1,
        ),
        checks.AC_DEFINE(
            "HAVE_SYS_ENDIAN_H",
            requires = ["ac_cv_header_sys_endian_h==1"],
        ),
        checks.AC_SUBST(
            "HAVE_SYS_ENDIAN_H",
            condition = "ac_cv_header_sys_endian_h",
            if_false = 0,
            if_true = 1,
        ),
        # Whether <endian.h> brings the stdint types, and the byte-order macros and conversion
        # functions.  configure runs these only when the header exists; here they run always
        # and fail without it, which is the same answer.  The matching probes of <sys/endian.h>
        # (gl_cv_header_sys_endian_h_stdint_types, gl_cv_header_working_sys_endian_h) are not
        # ported: the macro says it does not use their results.
        checks.AC_TRY_COMPILE(
            name = "gl_cv_header_endian_h_stdint_types",
            code = """\
#include <endian.h>
int main(void) {
    uint16_t t1 = 0;
    uint32_t t2 = 0;
    uint64_t t3 = 0;
    return !(t1 + t2 + t3);
}
""",
        ),
        checks.AC_TRY_LINK(
            name = "gl_cv_header_working_endian_h",
            code = """\
#include <endian.h>
int main(void) {
#if LITTLE_ENDIAN == BIG_ENDIAN
# error "Endian macros not unique."
#endif
#if BYTE_ORDER != LITTLE_ENDIAN && BYTE_ORDER != BIG_ENDIAN
# error "Byte order not defined."
#endif
    int value16_1 = be16toh (0.0);
    int value32_1 = be32toh (0.0);
    int value64_1 = be64toh (0.0);
    int value16_2 = htobe16 (0.0);
    int value32_2 = htobe32 (0.0);
    int value64_2 = htobe64 (0.0);
    int value16_3 = le16toh (0.0);
    int value32_3 = le32toh (0.0);
    int value64_3 = le64toh (0.0);
    int value16_4 = htole16 (0.0);
    int value32_4 = htole32 (0.0);
    int value64_4 = htole64 (0.0);
    return !(value16_1 + value32_1 + value64_1
             + value16_2 + value32_2 + value64_2
             + value16_3 + value32_3 + value64_3
             + value16_4 + value32_4 + value64_4);
}
""",
        ),
        # GL_GENERATE_ENDIAN_H (gl_CONDITIONAL_HEADER): gnulib ships its own endian.h unless
        # the system's has both.  M4_VARIABLE, like GL_GENERATE_ALLOCA_H: an automake
        # conditional, not a subst.
        checks.M4_VARIABLE(
            "GL_GENERATE_ENDIAN_H",
            condition = "gl_cv_header_endian_h_stdint_types && gl_cv_header_working_endian_h",
            if_false = "true",
            if_true = "false",
        ),
        # ENDIAN_H_JUST_MISSING_STDINT: the macro tests `$GL_GENERATE_ENDIAN_H` as a string
        # (`true` and `false` both pass `test`), so the value is 1 exactly when the system's
        # <endian.h> works, whether or not the wrapper is generated.
        checks.AC_SUBST(
            "ENDIAN_H_JUST_MISSING_STDINT",
            condition = "gl_cv_header_working_endian_h",
            if_false = 0,
            if_true = 1,
        ),
    ] + gl_macros.GL_CHECK_NEXT_HEADERS(["endian.h"]),
    visibility = ["//visibility:public"],
    deps = [
        # Note: AC_CHECK_INCLUDES_DEFAULT is added for test compatibility
        "//autoconf/macros/AC_CHECK_INCLUDES_DEFAULT",
        # gl_ENDIAN_H runs after gl_EARLY's AC_USE_SYSTEM_EXTENSIONS: the probes see the same
        # feature-test defines configure's do.
        "//gnulib/m4/extensions",
        # gl_CHECK_NEXT_HEADERS requires gl_INCLUDE_NEXT which is defined in include_next module
        "//gnulib/m4/include_next",
    ],
)
