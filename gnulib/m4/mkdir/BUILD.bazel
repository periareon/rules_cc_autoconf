"""https://github.com/coreutils/gnulib/blob/1039a5f2cee3cda1c11f64a5eb3a15b2e87cd2f0/m4/mkdir.m4"""

load("//autoconf:autoconf_toolchain.bzl", autoconf = "autoconf_cache")
load("//autoconf:checks.bzl", "checks")

autoconf(
    name = "gl_FUNC_MKDIR",
    # gl_FUNC_MKDIR runs two AC_RUN_IFELSE probes (trailing slash, trailing
    # dot). Linux/glibc and macOS pass both. M4 cross-compile guesses for
    # native Windows: trailing slash works on MSVC, trailing dot does not,
    # so FUNC_MKDIR_DOT_BUG is defined and mkdir is replaced.
    checks = select({
        "@platforms//os:windows": [
            checks.AC_DEFINE("FUNC_MKDIR_DOT_BUG", 1),
            checks.AC_SUBST("REPLACE_MKDIR", 1),
        ],
        "//conditions:default": [],
    }),
    visibility = ["//visibility:public"],
    deps = [
        "//autoconf/macros/AC_CANONICAL_HOST",  # AC_REQUIRE([AC_CANONICAL_HOST])
        "//gnulib/m4/sys_stat_h",  # AC_REQUIRE([gl_SYS_STAT_H_DEFAULTS])
        # For test compatibility
        "//autoconf/macros/AC_CHECK_INCLUDES_DEFAULT",
    ],
)

autoconf(
    name = "mkdir",
    visibility = ["//visibility:public"],
    deps = [
        ":gl_FUNC_MKDIR",
    ],
)
