"""https://github.com/coreutils/gnulib/blob/1039a5f2cee3cda1c11f64a5eb3a15b2e87cd2f0/m4/stdckdint_h.m4"""

load("//autoconf:autoconf_toolchain.bzl", autoconf = "autoconf_cache")
load("//autoconf:checks.bzl", "checks")
load("//gnulib:macros.bzl", gl_macros = "macros")

autoconf(
    name = "stdckdint_h",
    checks = [
        # gl_STDCKDINT_H checks for stdckdint.h header
        # stdckdint.h is a C23 header, not available on Ubuntu 22.04 (glibc 2.35)
        checks.AC_CHECK_HEADER(
            "stdckdint.h",
            name = "ac_cv_header_stdckdint_h",
            define = "HAVE_STDCKDINT_H",
            subst = "HAVE_STDCKDINT_H",
        ),
        checks.AC_SUBST("HAVE_CXX_STDCKDINT_H", "0"),
        checks.AC_SUBST("HAVE_WORKING_CXX_STDCKDINT_H", "0"),
        # gl_cv_header_c_stdckdint_h: can stdckdint.h be included in C?
        checks.AC_TRY_COMPILE(
            name = "gl_cv_header_c_stdckdint_h",
            code = """\
#include <stdckdint.h>
int main(void) {
    return 0;
}
""",
            requires = ["ac_cv_header_stdckdint_h"],
        ),
        checks.AC_SUBST(
            "HAVE_C_STDCKDINT_H",
            condition = "gl_cv_header_c_stdckdint_h",
            if_false = "0",
            if_true = "1",
        ),
        # gl_cv_header_c_stdckdint_h_works: ISO C23 compliant?
        checks.AC_TRY_COMPILE(
            name = "gl_cv_header_c_stdckdint_h_works",
            code = """\
#include <stdckdint.h>
int main(void) {
    int r;
    int a = 1;
    int b = 1;
    return !!(ckd_add(&r, a, b) || ckd_sub(&r, a, b)
              || ckd_mul(&r, a, b));
}
""",
            requires = ["gl_cv_header_c_stdckdint_h"],
        ),
        checks.AC_SUBST(
            "HAVE_WORKING_C_STDCKDINT_H",
            condition = "gl_cv_header_c_stdckdint_h_works",
            if_false = "0",
            if_true = "1",
        ),
    ] + gl_macros.GL_CHECK_NEXT_HEADERS(["stdckdint.h"]),
    visibility = ["//visibility:public"],
    deps = [
        "//gnulib/m4/include_next",  # gl_CHECK_NEXT_HEADERS([stdckdint.h])
        # For test compatibility - need basic header defines
        "//autoconf/macros/AC_CHECK_INCLUDES_DEFAULT",
    ],
)
