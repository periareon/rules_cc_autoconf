"""https://github.com/coreutils/gnulib/blob/1039a5f2cee3cda1c11f64a5eb3a15b2e87cd2f0/m4/htonl.m4"""

load("//autoconf:autoconf_toolchain.bzl", autoconf = "autoconf_cache")
load("//autoconf:checks.bzl", "checks")

autoconf(
    name = "gl_FUNC_HTONL",
    checks = [

        # This checks for HAVE_WINSOCK2_H (Windows-specific, not applicable on macOS)
        # if test $HAVE_WINSOCK2_H = 1; then
        # elif test $ac_cv_header_arpa_inet_h = yes; then
        # fi
        # Based on golden files, HTONL_LIB="" on macOS (not Windows)
        # HTONL_LIB=
        # gl_PREREQ_SYS_H_WINSOCK2
        # if test $HAVE_WINSOCK2_H = 1; then HTONL_LIB="-lws2_32"
        # elif test $ac_cv_header_arpa_inet_h = yes; then
        #   AC_CHECK_DECLS([htons, htonl, ntohs, ntohl],,, [[#include <arpa/inet.h>]])
        # fi
        checks.AC_SUBST(
            "HTONL_LIB",
            condition = "HAVE_WINSOCK2_H==1",
            if_false = "",
            if_true = "-lws2_32",
        ),

        # Only check if arpa/inet.h exists (which it does on macOS)
        # But the declarations might not be found, leaving them undefined
        # Use internal defines to avoid creating public defines if not found
        checks.AC_CHECK_DECL(
            "htons",
            name = "ac_cv_have_decl_htons",
            define = "HAVE_DECL_HTONS",
            includes = ["#include <arpa/inet.h>"],
            requires = [
                "HAVE_WINSOCK2_H==0",
                "ac_cv_header_arpa_inet_h",
            ],
        ),
        checks.AC_CHECK_DECL(
            "htonl",
            name = "ac_cv_have_decl_htonl",
            define = "HAVE_DECL_HTONL",
            includes = ["#include <arpa/inet.h>"],
            requires = [
                "HAVE_WINSOCK2_H==0",
                "ac_cv_header_arpa_inet_h",
            ],
        ),
        checks.AC_CHECK_DECL(
            "ntohs",
            name = "ac_cv_have_decl_ntohs",
            define = "HAVE_DECL_NTOHS",
            includes = ["#include <arpa/inet.h>"],
            requires = [
                "HAVE_WINSOCK2_H==0",
                "ac_cv_header_arpa_inet_h",
            ],
        ),
        checks.AC_CHECK_DECL(
            "ntohl",
            name = "ac_cv_have_decl_ntohl",
            define = "HAVE_DECL_NTOHL",
            includes = ["#include <arpa/inet.h>"],
            requires = [
                "HAVE_WINSOCK2_H==0",
                "ac_cv_header_arpa_inet_h",
            ],
        ),
        # Note: The m4 file doesn't define these in config.h if not found
        # They remain undefined (/* #undef */)
    ],
    visibility = ["//visibility:public"],
    deps = [
        # Use defaults to get substitution variable defaults, but don't create defines in config.h
        "//gnulib/m4/arpa_inet_h",
        # gl_PREREQ_SYS_H_WINSOCK2 (HAVE_WINSOCK2_H); gl_FUNC_HTONL does not
        # invoke gl_SYS_SOCKET_H / gl_PREREQ_SYS_H_SOCKET.
        "//gnulib/m4/sys_socket_h:gl_PREREQ_SYS_H_WINSOCK2",
        # For test compatibility
        "//autoconf/macros/AC_CHECK_INCLUDES_DEFAULT",
    ],
)

autoconf(
    name = "htonl",
    visibility = ["//visibility:public"],
    deps = [
        ":gl_FUNC_HTONL",
    ],
)
