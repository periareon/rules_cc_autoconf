"""https://github.com/coreutils/gnulib/blob/1039a5f2cee3cda1c11f64a5eb3a15b2e87cd2f0/m4/gettime.m4"""

load("//autoconf:autoconf_toolchain.bzl", autoconf = "autoconf_cache")
load("//autoconf:checks.bzl", "checks", "utils")

# gl_CHECK_FUNC_TIMESPEC_GET: AC_CHECK_DECL([timespec_get]) followed by a
# link test (MSVC implements timespec_get as an inline function, so a plain
# AC_CHECK_FUNC link test without <time.h> would fail there).
autoconf(
    name = "gl_CHECK_FUNC_TIMESPEC_GET",
    checks = [
        checks.AC_CHECK_DECL(
            "timespec_get",
            includes = ["#include <time.h>"],
        ),
        checks.AC_TRY_LINK(
            name = "gl_cv_func_timespec_get",
            code = utils.AC_LANG_PROGRAM(
                [
                    "#include <time.h>",
                    "struct timespec ts;",
                ],
                "return timespec_get (&ts, 0);",
            ),
            requires = ["ac_cv_have_decl_timespec_get"],
        ),
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//autoconf/macros/AC_CANONICAL_HOST",
        "//autoconf/macros/AC_CHECK_INCLUDES_DEFAULT",
        "//gnulib/m4/extensions",
    ],
)

autoconf(
    name = "gl_GETTIME",
    checks = [
        # if test $gl_cv_func_timespec_get = yes; then
        #   AC_DEFINE([HAVE_TIMESPEC_GET], [1], ...)
        # fi
        # (the HAVE_TIMESPEC_GET subst is left at its gl_TIME_H_DEFAULTS value)
        checks.AC_DEFINE(
            "HAVE_TIMESPEC_GET",
            condition = "gl_cv_func_timespec_get",
            if_false = None,
            if_true = 1,
        ),
    ],
    visibility = ["//visibility:public"],
    deps = [
        ":gl_CHECK_FUNC_TIMESPEC_GET",
        "//autoconf/macros/AC_CHECK_INCLUDES_DEFAULT",
        "//gnulib/m4/clock_time",  # gl_CLOCK_TIME: HAVE_CLOCK_GETRES, HAVE_CLOCK_GETTIME, HAVE_CLOCK_SETTIME, CLOCK_TIME_LIB
        "//gnulib/m4/extensions",
    ],
)

# gl_GETTIME_RES: M4 uses gl_CHECK_FUNCS_ANDROID([timespec_getres], [[#include <time.h>]]).
# Use the actual check via timespec_getres:gl_FUNC_TIMESPEC_GETRES (do not use select()+AC_DEFINE).
autoconf(
    name = "gl_GETTIME_RES",
    visibility = ["//visibility:public"],
    deps = [
        "//autoconf/macros/AC_CHECK_INCLUDES_DEFAULT",
        "//gnulib/m4/timespec_getres:gl_FUNC_TIMESPEC_GETRES",
    ],
)

autoconf(
    name = "gettime",
    visibility = ["//visibility:public"],
    deps = [
        ":gl_CHECK_FUNC_TIMESPEC_GET",
        ":gl_GETTIME",
        ":gl_GETTIME_RES",
    ],
)
