"""https://github.com/coreutils/gnulib/blob/1039a5f2cee3cda1c11f64a5eb3a15b2e87cd2f0/m4/servent.m4"""

load("//autoconf:autoconf_toolchain.bzl", autoconf = "autoconf_cache")
load("//autoconf:checks.bzl", "checks")

autoconf(
    name = "gl_SERVENT",
    checks = [
        # gl_SERVENT checks for getservbyname function
        checks.AC_CHECK_FUNC(
            "getservbyname",
            define = "HAVE_GETSERVBYNAME",
        ),
        # AC_SUBST([SERVENT_LIB]) - library needed for getservbyname
        # On macOS/Linux, getservbyname is in libc, so SERVENT_LIB is empty
        # AC_SEARCH_LIBS([getservbyname], [...]) finds it in libc on glibc/macOS
        # (SERVENT_LIB stays empty).  Otherwise, on native Windows:
        # AC_CHECK_FUNCS([getservbyname], , [
        #   AC_CACHE_CHECK([for getservbyname in winsock2.h and -lws2_32],
        #     [gl_cv_w32_getservbyname], link "getservbyname(NULL,NULL);" with -lws2_32)
        #   if yes: SERVENT_LIB="-lws2_32"])
        checks.AC_CHECK_LIB(
            "ws2_32",
            "getservbyname",
            name = "gl_cv_w32_getservbyname",
            code = """#ifdef HAVE_WINSOCK2_H
#include <winsock2.h>
#endif
#include <stddef.h>
int main(void) {
    getservbyname(NULL,NULL);
    return 0;
}
""",
            copts = ["-DHAVE_WINSOCK2_H=1"],
            define = "gl_cv_w32_getservbyname",
            requires = [
                "!ac_cv_func_getservbyname",
                "HAVE_WINSOCK2_H==1",
            ],
        ),
        checks.AC_SUBST(
            "SERVENT_LIB",
            condition = "gl_cv_w32_getservbyname",
            if_false = "",
            if_true = "-lws2_32",
        ),
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//gnulib/m4/sys_socket_h:gl_SYS_SOCKET_H",
        # For test compatibility
        "//autoconf/macros/AC_CHECK_INCLUDES_DEFAULT",
    ],
)

autoconf(
    name = "servent",
    visibility = ["//visibility:public"],
    deps = [
        ":gl_SERVENT",
    ],
)
