"""https://github.com/coreutils/gnulib/blob/1039a5f2cee3cda1c11f64a5eb3a15b2e87cd2f0/m4/lcmessage.m4"""

load("//autoconf:autoconf_toolchain.bzl", autoconf = "autoconf_cache")
load("//autoconf:checks.bzl", "checks")

autoconf(
    name = "gt_LC_MESSAGES",
    checks = [
        # AC_CACHE_CHECK([for LC_MESSAGES], [gt_cv_val_LC_MESSAGES],
        #   [AC_LINK_IFELSE([AC_LANG_PROGRAM([[#include <locale.h>]],
        #                                    [[return LC_MESSAGES]])], ...)])
        # if test $gt_cv_val_LC_MESSAGES = yes; then AC_DEFINE([HAVE_LC_MESSAGES], [1])
        # (MSVC's <locale.h> has no LC_MESSAGES, so it stays undefined there.)
        checks.AC_TRY_LINK(
            name = "gt_cv_val_LC_MESSAGES",
            code = """#include <locale.h>
int main(void) {
    return LC_MESSAGES;
}
""",
            define = "HAVE_LC_MESSAGES",
            language = "c",
        ),
    ],
    visibility = ["//visibility:public"],
    deps = [
        # For test compatibility
        "//autoconf/macros/AC_CHECK_INCLUDES_DEFAULT",
    ],
)

autoconf(
    name = "lcmessage",
    visibility = ["//visibility:public"],
    deps = [
        ":gt_LC_MESSAGES",
    ],
)
