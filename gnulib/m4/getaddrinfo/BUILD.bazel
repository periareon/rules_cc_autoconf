"""https://github.com/coreutils/gnulib/blob/1039a5f2cee3cda1c11f64a5eb3a15b2e87cd2f0/m4/getaddrinfo.m4"""

load("//autoconf:autoconf_toolchain.bzl", autoconf = "autoconf_cache")
load("//autoconf:checks.bzl", "checks")

# The probes use `#if HAVE_X` rather than the m4's `#ifdef HAVE_X`: with
# autoconf HAVE_X is either 1 or undefined, so both forms agree, but the
# Bazel checker also injects `#define HAVE_X 0` for failed dependency probes.

# Prologue used by most probes in getaddrinfo.m4.  The HAVE_* guards are
# resolved through compile_defines from the header checks in the deps.
_GAI_INCLUDES = [
    "#include <sys/types.h>",
    "#if HAVE_SYS_SOCKET_H",
    "#include <sys/socket.h>",
    "#endif",
    "#if HAVE_NETDB_H",
    "#include <netdb.h>",
    "#endif",
    "#if HAVE_WS2TCPIP_H",
    "#include <ws2tcpip.h>",
    "#endif",
    "#include <stddef.h>",
]

_GAI_COMPILE_DEFINES = [
    "HAVE_SYS_SOCKET_H",
    "HAVE_NETDB_H",
    "HAVE_WS2TCPIP_H",
]

# gl_PREREQ_GETADDRINFO - prerequisites of lib/netdb.in.h and lib/getaddrinfo.c
autoconf(
    name = "gl_PREREQ_GETADDRINFO",
    checks = [
        # AC_CHECK_MEMBERS([struct sockaddr.sa_len], , , [#include <sys/types.h>
        # #include <sys/socket.h>])
        checks.AC_CHECK_MEMBER(
            "struct sockaddr.sa_len",
            define = "HAVE_STRUCT_SOCKADDR_SA_LEN",
            includes = [
                "#include <sys/socket.h>",
                "#include <sys/types.h>",
            ],
            requires = ["HAVE_SYS_SOCKET_H"],
        ),
        # AC_CHECK_HEADERS_ONCE([netinet/in.h]) is provided by gl_SOCKET_FAMILIES.
        # AC_CHECK_DECLS([getaddrinfo, freeaddrinfo, getnameinfo],,,[...])
        checks.AC_CHECK_DECL(
            "getaddrinfo",
            compile_defines = _GAI_COMPILE_DEFINES,
            define = "HAVE_DECL_GETADDRINFO",
            includes = _GAI_INCLUDES,
        ),
        checks.AC_CHECK_DECL(
            "freeaddrinfo",
            compile_defines = _GAI_COMPILE_DEFINES,
            define = "HAVE_DECL_FREEADDRINFO",
            includes = _GAI_INCLUDES,
        ),
        checks.AC_CHECK_DECL(
            "getnameinfo",
            compile_defines = _GAI_COMPILE_DEFINES,
            define = "HAVE_DECL_GETNAMEINFO",
            includes = _GAI_INCLUDES,
        ),
        # if test $ac_cv_have_decl_getaddrinfo = no; then HAVE_DECL_GETADDRINFO=0 (etc.)
        checks.AC_SUBST(
            "HAVE_DECL_GETADDRINFO",
            condition = "ac_cv_have_decl_getaddrinfo",
            if_false = "0",
            if_true = "1",
        ),
        checks.AC_SUBST(
            "HAVE_DECL_FREEADDRINFO",
            condition = "ac_cv_have_decl_freeaddrinfo",
            if_false = "0",
            if_true = "1",
        ),
        checks.AC_SUBST(
            "HAVE_DECL_GETNAMEINFO",
            condition = "ac_cv_have_decl_getnameinfo",
            if_false = "0",
            if_true = "1",
        ),
        # AC_CHECK_TYPES([struct addrinfo],,,[...]); if absent HAVE_STRUCT_ADDRINFO=0
        checks.AC_CHECK_TYPE(
            "struct addrinfo",
            compile_defines = _GAI_COMPILE_DEFINES,
            define = "HAVE_STRUCT_ADDRINFO",
            includes = _GAI_INCLUDES,
        ),
        checks.AC_SUBST(
            "HAVE_STRUCT_ADDRINFO",
            condition = "ac_cv_type_struct_addrinfo",
            if_false = "0",
            if_true = "1",
        ),
    ],
    visibility = ["//visibility:public"],
    deps = [
        # AC_REQUIRE([gl_NETDB_H_DEFAULTS]) is satisfied by the toolchain.
        "//gnulib/m4/sys_socket_h:gl_SYS_SOCKET_H",
        "//gnulib/m4/hostent",
        "//gnulib/m4/servent",
        "//gnulib/m4/inet_ntop:gl_FUNC_INET_NTOP",
        "//autoconf/macros/AC_C_RESTRICT",
        "//gnulib/m4/sockpfaf:gl_SOCKET_FAMILIES",
        "//gnulib/m4/extensions",
        "//gnulib/m4/netdb_h",
        "//autoconf/macros/AC_CHECK_INCLUDES_DEFAULT",
    ],
)

# gl_GETADDRINFO - getaddrinfo / gai_strerror probes; invokes gl_PREREQ_GETADDRINFO.
autoconf(
    name = "gl_GETADDRINFO",
    checks = [
        # AC_SEARCH_LIBS([getaddrinfo], [socket network net]) finds it in libc on
        # glibc/macOS (GETADDRINFO_LIB stays empty).
        # AC_CACHE_CHECK([for getaddrinfo], [gl_cv_func_getaddrinfo], link test)
        checks.AC_TRY_LINK(
            name = "gl_cv_func_getaddrinfo",
            code = "\n".join(_GAI_INCLUDES) + """

int main(void) {
    getaddrinfo("", "", NULL, NULL);
    return 0;
}
""",
            compile_defines = _GAI_COMPILE_DEFINES,
            language = "c",
        ),
        # if test $gl_cv_func_getaddrinfo = no; then
        #   AC_CACHE_CHECK([for getaddrinfo in ws2tcpip.h and -lws2_32],
        #                  [gl_cv_w32_getaddrinfo], link test with -lws2_32)
        checks.AC_CHECK_LIB(
            "ws2_32",
            "getaddrinfo",
            name = "gl_cv_w32_getaddrinfo",
            code = """#if HAVE_WS2TCPIP_H
#include <ws2tcpip.h>
#endif
#include <stddef.h>
int main(void) {
    getaddrinfo(NULL, NULL, NULL, NULL);
    return 0;
}
""",
            copts = ["-DHAVE_WS2TCPIP_H=1"],
            define = "gl_cv_w32_getaddrinfo",
            requires = [
                "!gl_cv_func_getaddrinfo",
                "HAVE_WS2TCPIP_H==1",
            ],
        ),
        #   if yes: GETADDRINFO_LIB="-lws2_32"
        checks.AC_SUBST(
            "GETADDRINFO_LIB",
            condition = "gl_cv_w32_getaddrinfo",
            if_false = "",
            if_true = "-lws2_32",
        ),
        #     AC_CACHE_CHECK([for getaddrinfo with POSIX signature],
        #       [gl_cv_func_getaddrinfo_posix_signature], ...)
        #     if no: REPLACE_GETADDRINFO=1
        checks.AC_TRY_COMPILE(
            name = "gl_cv_func_getaddrinfo_posix_signature",
            code = "\n".join(_GAI_INCLUDES) + """
extern
#ifdef __cplusplus
"C"
#endif
int getaddrinfo (const char *, const char *, const struct addrinfo *, struct addrinfo **);
int main(void) { return 0; }
""",
            compile_defines = _GAI_COMPILE_DEFINES,
            language = "c",
            requires = ["gl_cv_w32_getaddrinfo"],
        ),
        #   else HAVE_GETADDRINFO=0
        # fi
        # AC_DEFINE_UNQUOTED([HAVE_GETADDRINFO], [$HAVE_GETADDRINFO]) - always 1 or 0
        checks.AC_DEFINE(
            "HAVE_GETADDRINFO",
            condition = "gl_cv_func_getaddrinfo || gl_cv_w32_getaddrinfo",
            if_false = 0,
            if_true = 1,
        ),
        # AC_CHECK_DECLS([gai_strerror], [], [], [...])
        checks.AC_CHECK_DECL(
            "gai_strerror",
            compile_defines = _GAI_COMPILE_DEFINES,
            define = "HAVE_DECL_GAI_STRERROR",
            includes = _GAI_INCLUDES,
        ),
        checks.AC_SUBST(
            "HAVE_DECL_GAI_STRERROR",
            condition = "ac_cv_have_decl_gai_strerror",
            if_false = "0",
            if_true = "1",
        ),
        # if test $ac_cv_have_decl_gai_strerror = yes; then
        #   AC_CHECK_DECLS([gai_strerrorA], [], [], [...])
        checks.AC_CHECK_DECL(
            "gai_strerrorA",
            name = "_gl_cv_have_decl_gai_strerrorA",
            compile_defines = _GAI_COMPILE_DEFINES,
            define = "HAVE_DECL_GAI_STRERRORA",
            includes = _GAI_INCLUDES,
            requires = ["ac_cv_have_decl_gai_strerror"],
        ),
        #   AC_CACHE_CHECK([for gai_strerror with POSIX signature],
        #     [gl_cv_func_gai_strerror_posix_signature], ...)
        checks.AC_TRY_COMPILE(
            name = "gl_cv_func_gai_strerror_posix_signature",
            code = "\n".join(_GAI_INCLUDES) + """
extern
#ifdef __cplusplus
"C"
#endif
const char *gai_strerror(int);
int main(void) { return 0; }
""",
            compile_defines = _GAI_COMPILE_DEFINES,
            language = "c",
            requires = ["ac_cv_have_decl_gai_strerror"],
        ),
        #   if no: REPLACE_GAI_STRERROR=1
        # fi
        checks.AC_SUBST(
            "REPLACE_GAI_STRERROR",
            condition = "ac_cv_have_decl_gai_strerror && !gl_cv_func_gai_strerror_posix_signature",
            if_false = "0",
            if_true = "1",
        ),
    ] + select({
        # if test $HAVE_GETADDRINFO != 0; then
        #   gl_cv_func_getaddrinfo_works (AI_NUMERICHOST / AI_NUMERICSERV):
        #   "Guess no on Solaris, native Windows" and the native MSVC run agrees
        #   -> REPLACE_GETADDRINFO=1.  The POSIX-signature failure path also
        #   sets it.
        "@platforms//os:windows": [
            checks.AC_SUBST(
                "REPLACE_GETADDRINFO",
                condition = "gl_cv_func_getaddrinfo || gl_cv_w32_getaddrinfo",
                if_false = "0",
                if_true = "1",
            ),
        ],
        # glibc/macOS: the runtime check passes; REPLACE_GETADDRINFO keeps the
        # gl_NETDB_H_DEFAULTS value of 0.
        "//conditions:default": [],
    }),
    visibility = ["//visibility:public"],
    deps = [
        # AC_REQUIRE([gl_SYS_SOCKET_H]) dnl for HAVE_SYS_SOCKET_H, HAVE_WINSOCK2_H
        "//gnulib/m4/sys_socket_h:gl_SYS_SOCKET_H",
        # AC_REQUIRE([gl_NETDB_H]) dnl for HAVE_NETDB_H
        "//gnulib/m4/netdb_h",
        "//autoconf/macros/AC_CANONICAL_HOST",
        ":gl_PREREQ_GETADDRINFO",
        "//autoconf/macros/AC_CHECK_INCLUDES_DEFAULT",
    ],
)

autoconf(
    name = "getaddrinfo",
    visibility = ["//visibility:public"],
    deps = [
        ":gl_GETADDRINFO",
        ":gl_PREREQ_GETADDRINFO",
    ],
)
