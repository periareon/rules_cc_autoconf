"""https://github.com/coreutils/gnulib/blob/1039a5f2cee3cda1c11f64a5eb3a15b2e87cd2f0/m4/msvc-inval.m4"""

load("//autoconf:autoconf_toolchain.bzl", autoconf = "autoconf_cache")
load("//autoconf:checks.bzl", "checks")

# gl_MSVC_INVAL macro from msvc-inval.m4
# - AC_CHECK_FUNCS_ONCE([_set_invalid_parameter_handler]) defines
#   HAVE__SET_INVALID_PARAMETER_HANDLER in config.h when found (MSVC).
# - If found: HAVE_MSVC_INVALID_PARAMETER_HANDLER=1 (AC_DEFINE + AC_SUBST)
# - If not: HAVE_MSVC_INVALID_PARAMETER_HANDLER=0 (AC_SUBST only)

autoconf(
    name = "gl_MSVC_INVAL",
    checks = [
        checks.AC_CHECK_FUNC(
            "_set_invalid_parameter_handler",
            define = "HAVE__SET_INVALID_PARAMETER_HANDLER",
        ),
        checks.AC_DEFINE(
            "HAVE_MSVC_INVALID_PARAMETER_HANDLER",
            condition = "ac_cv_func__set_invalid_parameter_handler",
            if_false = None,
            if_true = 1,
        ),
        checks.AC_SUBST(
            "HAVE_MSVC_INVALID_PARAMETER_HANDLER",
            condition = "ac_cv_func__set_invalid_parameter_handler",
            if_false = 0,
            if_true = 1,
        ),
    ],
    visibility = ["//visibility:public"],
)

autoconf(
    name = "msvc-inval",
    visibility = ["//visibility:public"],
    deps = [
        ":gl_MSVC_INVAL",
    ],
)
