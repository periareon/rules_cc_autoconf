"""https://github.com/coreutils/gnulib/blob/1039a5f2cee3cda1c11f64a5eb3a15b2e87cd2f0/m4/tss.m4"""

load("//autoconf:autoconf_toolchain.bzl", autoconf = "autoconf_cache")
load("//gnulib:macros.bzl", gl_macros = "macros")

# gl_CHECK_FUNCS_ANDROID([tss_create], [[#include <threads.h>]]) is an
# unconditional link test (no <threads.h> needed): glibc >= 2.28 and MSVC's
# UCRT link it, macOS does not. The "future*" branch (REPLACE_TSS_*=1) is
# Android-only.
autoconf(
    name = "gl_FUNC_TSS_CREATE",
    checks = gl_macros.GL_CHECK_FUNCS_ANDROID(
        ["tss_create"],
        includes = ["#include <threads.h>"],
    ),
    visibility = ["//visibility:public"],
    deps = [
        "//gnulib/m4/timespec_getres:HAVE_TIMESPEC_GETRES",
        "//gnulib/m4/threads_h",  # AC_REQUIRE([gl_THREADS_H])
        "//gnulib/m4/threadlib",
        # For test compatibility - need basic header defines
        "//autoconf/macros/AC_CHECK_INCLUDES_DEFAULT",
    ],
)

autoconf(
    name = "tss",
    visibility = ["//visibility:public"],
    deps = [
        ":gl_FUNC_TSS_CREATE",
    ],
)
