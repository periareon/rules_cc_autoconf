"""https://github.com/coreutils/gnulib/blob/1039a5f2cee3cda1c11f64a5eb3a15b2e87cd2f0/m4/malloc_h.m4"""

load("//autoconf:autoconf_defaults.bzl", "autoconf_defaults")
load("//autoconf:autoconf_toolchain.bzl", autoconf = "autoconf_cache")
load("//autoconf:checks.bzl", "checks", "macros")
load("//gnulib:macros.bzl", gl_macros = "macros")

autoconf(
    name = "HAVE_MALLOC_H",
    checks = macros.AC_CHECK_HEADERS(["malloc.h"]),
    visibility = ["//gnulib:__subpackages__"],
)

autoconf(
    name = "gl_MALLOC_H",
    checks = [
        # Set HAVE_MALLOC_H as a subst variable based on the header check result
        checks.AC_SUBST(
            "HAVE_MALLOC_H",
            condition = "ac_cv_header_malloc_h",
            if_false = 0,
            if_true = 1,
        ),
    ] + gl_macros.GL_CHECK_NEXT_HEADERS(["malloc.h"]),
    default_deps = [
        ":defaults",  # AC_REQUIRE: gl_MALLOC_H_DEFAULTS
    ],
    visibility = ["//visibility:public"],
    deps = [
        ":HAVE_MALLOC_H",
        "//gnulib/m4/include_next",  # gl_CHECK_NEXT_HEADERS([malloc.h])
    ],
)

autoconf_defaults(
    name = "gl_MALLOC_H_DEFAULTS",
    substs = {
        "HAVE_MEMALIGN": "1",
        "REPLACE_MEMALIGN": "0",
    },
    visibility = ["//visibility:private"],
)

autoconf_defaults(
    name = "gl_MALLOC_H_REQUIRE_DEFAULTS",
    substs = {
        "GNULIB_MEMALIGN": "0",
    },
    visibility = ["//visibility:private"],
    deps = [
        ":gl_MALLOC_H_DEFAULTS",
    ],
)

autoconf_defaults(
    name = "defaults",
    visibility = ["//visibility:public"],
    deps = [
        ":gl_MALLOC_H_REQUIRE_DEFAULTS",
    ],
)

autoconf(
    name = "malloc_h",
    default_deps = [
        ":defaults",  # the header's own defaults, as its m4 requires
    ],
    visibility = ["//visibility:public"],
    deps = [
        ":gl_MALLOC_H",
    ],
)
