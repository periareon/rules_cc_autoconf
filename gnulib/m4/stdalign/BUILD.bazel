"""https://github.com/coreutils/gnulib/blob/1039a5f2cee3cda1c11f64a5eb3a15b2e87cd2f0/m4/stdalign.m4"""

load("//autoconf:autoconf_toolchain.bzl", autoconf = "autoconf_cache")
load("//autoconf:checks.bzl", "checks")
load("//gnulib:macros.bzl", gl_macros = "macros")

_ALIGNASOF_PROGRAM = """\
#include <stdint.h>
#ifdef INCLUDE_STDALIGN_H
 #include <stdalign.h>
#endif
#include <stddef.h>

/* Test that alignof yields a result consistent with offsetof.
   This catches GCC bug 52023
   <https://gcc.gnu.org/PR52023>.  */
#ifdef __cplusplus
   template <class t> struct alignof_helper { char a; t b; };
# define ao(type) offsetof (alignof_helper<type>, b)
#else
# define ao(type) offsetof (struct { char a; type b; }, b)
#endif
char test_double[ao (double) % _Alignof (double) == 0 ? 1 : -1];
char test_long[ao (long int) % _Alignof (long int) == 0 ? 1 : -1];
char test_alignof[alignof (double) == _Alignof (double) ? 1 : -1];

/* Test alignas only on platforms where gnulib can help.  */
#if \\
    ((defined __cplusplus && 201103 <= __cplusplus) \\
     || (__TINYC__ && defined __attribute__) \\
     || (defined __APPLE__ && defined __MACH__ \\
         ? 4 < __GNUC__ + (1 <= __GNUC_MINOR__) \\
         : __GNUC__) \\
     || (__ia64 && (61200 <= __HP_cc || 61200 <= __HP_aCC)) \\
     || __ICC || 0x590 <= __SUNPRO_C || 0x0600 <= __xlC__ \\
     || 1300 <= _MSC_VER)
  struct alignas_test { char c; char alignas (8) alignas_8; };
  char test_alignas[offsetof (struct alignas_test, alignas_8) == 8
                    ? 1 : -1];
#endif

int main(void) {
    return 0;
}
"""

# gl_ALIGNASOF: try "yes, keywords" first, then "yes, <stdalign.h> macros".
autoconf(
    name = "gl_ALIGNASOF",
    checks = [
        checks.AC_TRY_COMPILE(
            name = "gl_cv_header_working_stdalign_h_keywords",
            code = _ALIGNASOF_PROGRAM,
            language = "c",
        ),
        checks.AC_TRY_COMPILE(
            name = "gl_cv_header_working_stdalign_h_macros",
            code = _ALIGNASOF_PROGRAM,
            copts = ["-DINCLUDE_STDALIGN_H"],
            language = "c",
            requires = ["!gl_cv_header_working_stdalign_h_keywords"],
        ),
        # AS_CASE([$gl_cv_header_working_stdalign_h], [yes*keyword*],
        #   [AC_DEFINE([HAVE_C_ALIGNASOF], [1], ...)])
        checks.AC_DEFINE(
            "HAVE_C_ALIGNASOF",
            condition = "gl_cv_header_working_stdalign_h_keywords",
            if_false = None,
            if_true = 1,
        ),
    ],
    visibility = ["//visibility:public"],
)

autoconf(
    name = "gl_STDALIGN_H",
    checks = [
        # if test "$gl_cv_header_working_stdalign_h" = no; then
        #   GL_GENERATE_STDALIGN_H=true
        checks.M4_VARIABLE(
            "GL_GENERATE_STDALIGN_H",
            condition = "gl_cv_header_working_stdalign_h_keywords || gl_cv_header_working_stdalign_h_macros",
            if_false = "true",
            if_true = "false",
        ),
        # gl_CHECK_NEXT_HEADERS([stdalign.h]) -> AC_CHECK_HEADERS_ONCE([stdalign.h])
        checks.AC_CHECK_HEADER(
            "stdalign.h",
            name = "ac_cv_header_stdalign_h",
        ),
        checks.AC_DEFINE(
            "HAVE_STDALIGN_H",
            condition = "ac_cv_header_stdalign_h",
            if_false = None,
            if_true = 1,
        ),
        checks.AC_SUBST(
            "HAVE_STDALIGN_H",
            condition = "ac_cv_header_stdalign_h",
            if_false = 0,
            if_true = 1,
        ),
    ] + gl_macros.GL_CHECK_NEXT_HEADERS(["stdalign.h"]),
    visibility = ["//visibility:public"],
    deps = [
        ":gl_ALIGNASOF",  # AC_REQUIRE([gl_ALIGNASOF])
        "//autoconf/macros/AC_CHECK_INCLUDES_DEFAULT",
        "//gnulib/m4/include_next",  # gl_CHECK_NEXT_HEADERS requires include_next
    ],
)

autoconf(
    name = "stdalign",
    visibility = ["//visibility:public"],
    deps = [
        ":gl_ALIGNASOF",
        ":gl_STDALIGN_H",
    ],
)
