"""https://github.com/coreutils/gnulib/blob/1039a5f2cee3cda1c11f64a5eb3a15b2e87cd2f0/m4/selinux-selinux-h.m4"""

load("//autoconf:autoconf_toolchain.bzl", autoconf = "autoconf_cache")
load("//autoconf:checks.bzl", "checks")
load("//gnulib:macros.bzl", gl_macros = "macros")

# gl_HEADERS_SELINUX_SELINUX_H - lines 16-40
# AC_REQUIRE([gl_CHECK_HEADER_SELINUX_SELINUX_H])
# Conditionally calls gl_CHECK_NEXT_HEADERS([selinux/selinux.h])
# when with_selinux != no and header is found
autoconf(
    name = "gl_HEADERS_SELINUX_SELINUX_H",
    checks = gl_macros.GL_NEXT_HEADERS(
        ["selinux/selinux.h"],
        condition = "USE_SELINUX_SELINUX_H",
    ),
    visibility = ["//visibility:public"],
    deps = [
        ":gl_CHECK_HEADER_SELINUX_SELINUX_H",
    ],
)

# gl_CHECK_HEADER_SELINUX_SELINUX_H - lines 42-70
# AC_REQUIRE([gl_LIBSELINUX])
# Checks for selinux/selinux.h and sets USE_SELINUX_SELINUX_H
autoconf(
    name = "gl_CHECK_HEADER_SELINUX_SELINUX_H",
    checks = [
        checks.AC_CHECK_HEADER(
            "selinux/selinux.h",
            define = "HAVE_SELINUX_SELINUX_H",
        ),
        # AC_CHECK_HEADERS_ONCE probes the header regardless of with_selinux;
        # USE_SELINUX_SELINUX_H also needs the library, as with_selinux=maybe
        # becomes "no" when the search fails.
        checks.AC_DEFINE(
            "USE_SELINUX_SELINUX_H",
            condition = "ac_cv_search_getfilecon_raw && HAVE_SELINUX_SELINUX_H",
            if_false = "0",
            if_true = "1",
            subst = True,
        ),
    ],
    visibility = ["//visibility:public"],
    deps = [
        ":gl_LIBSELINUX",
        "//autoconf/macros/AC_CHECK_INCLUDES_DEFAULT",
        "//gnulib/m4/include_next",
    ],
)

# gl_LIBSELINUX - lines 72-99
# AC_ARG_WITH([selinux]) is not ported: with_selinux is its default, maybe.
autoconf(
    name = "gl_LIBSELINUX",
    checks = [
        checks.AC_SEARCH_LIBS(
            "getfilecon_raw",
            [
                "android-selinux",
                "selinux",
            ],
            subst = "LIB_SELINUX",
        ),
    ],
    visibility = ["//visibility:public"],
)

# Package-level aggregator
autoconf(
    name = "selinux-selinux-h",
    visibility = ["//visibility:public"],
    deps = [
        ":gl_CHECK_HEADER_SELINUX_SELINUX_H",
        ":gl_HEADERS_SELINUX_SELINUX_H",
        ":gl_LIBSELINUX",
    ],
)
