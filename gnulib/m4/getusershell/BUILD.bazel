"""https://github.com/coreutils/gnulib/blob/1039a5f2cee3cda1c11f64a5eb3a15b2e87cd2f0/m4/getusershell.m4"""

load("//autoconf:autoconf_toolchain.bzl", autoconf = "autoconf_cache")
load("//autoconf:checks.bzl", "checks")

autoconf(
    name = "gl_FUNC_GETUSERSHELL",
    checks = [
        # AC_CHECK_FUNCS_ONCE([getusershell])
        checks.AC_CHECK_FUNC(
            "getusershell",
            name = "ac_cv_func_getusershell",
        ),
        checks.AC_DEFINE(
            "HAVE_GETUSERSHELL",
            condition = "ac_cv_func_getusershell",
            if_false = None,
            if_true = 1,
        ),
        # if test $ac_cv_func_getusershell = yes; then
        #   HAVE_GETUSERSHELL=1
        #   AC_CHECK_DECLS([getusershell])
        #   if test $ac_cv_have_decl_getusershell = no; then
        #     HAVE_DECL_GETUSERSHELL=0
        #   fi
        # else
        #   HAVE_GETUSERSHELL=0
        #   HAVE_DECL_GETUSERSHELL=0
        # fi
        # (HAVE_GETUSERSHELL itself is only AC_SUBSTed by gl_UNISTD_H_DEFAULTS.)
        checks.AC_CHECK_DECL(
            "getusershell",
            name = "ac_cv_have_decl_getusershell",
            includes = ["#include <unistd.h>"],
            requires = ["ac_cv_func_getusershell"],
        ),
        # AC_CHECK_DECLS always defines HAVE_DECL_GETUSERSHELL (0 or 1), but it
        # only runs when the function exists.
        checks.AC_DEFINE(
            "HAVE_DECL_GETUSERSHELL",
            condition = "ac_cv_have_decl_getusershell",
            if_false = 0,
            if_true = 1,
            requires = ["ac_cv_func_getusershell"],
        ),
        checks.AC_SUBST(
            "HAVE_DECL_GETUSERSHELL",
            condition = "ac_cv_func_getusershell && ac_cv_have_decl_getusershell",
            if_false = 0,
            if_true = 1,
        ),
        # case "$host_os" in *-musl* | midipix*) REPLACE_GETUSERSHELL=1 ;; esac
        checks.AC_SUBST("REPLACE_GETUSERSHELL", 0),
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//autoconf/macros/AC_CANONICAL_HOST",
        "//autoconf/macros/AC_CHECK_INCLUDES_DEFAULT",
        "//gnulib/m4/extensions",
    ],
)

# AC_DEFUN([gl_PREREQ_GETUSERSHELL], [:])
autoconf(
    name = "gl_PREREQ_GETUSERSHELL",
    checks = [],
    visibility = ["//visibility:public"],
)

autoconf(
    name = "getusershell",
    visibility = ["//visibility:public"],
    deps = [
        ":gl_FUNC_GETUSERSHELL",
        ":gl_PREREQ_GETUSERSHELL",
    ],
)
