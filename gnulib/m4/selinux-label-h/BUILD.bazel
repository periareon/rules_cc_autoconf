"""https://github.com/coreutils/gnulib/blob/1039a5f2cee3cda1c11f64a5eb3a15b2e87cd2f0/m4/selinux-label-h.m4"""

load("//autoconf:autoconf_toolchain.bzl", autoconf = "autoconf_cache")
load("//autoconf:checks.bzl", "checks")

autoconf(
    name = "selinux-label-h",
    checks = [
        # GL_GENERATE_SELINUX_LABEL_H (gl_CONDITIONAL_HEADER): the replacement header is generated
        # unless <selinux/label.h> exists (and --with-selinux is not "no", which the
        # port assumes: the option is the project's).  The probe carries no
        # define: the port leaves HAVE_* for the headers to the project.
        checks.AC_CHECK_HEADER(
            "selinux/label.h",
            name = "ac_cv_header_selinux_label_h",
        ),
        checks.M4_VARIABLE(
            "GL_GENERATE_SELINUX_LABEL_H",
            condition = "ac_cv_header_selinux_label_h",
            if_false = "true",
            if_true = "false",
        ),
        # gl_HEADERS_SELINUX_LABEL_H checks for selinux/label.h header
        # On macOS, SELinux is not available, so the header check would fail
        # But the golden file only shows basic header defines
    ],
    visibility = ["//visibility:public"],
    deps = [
        # For test compatibility - need basic header defines
        "//autoconf/macros/AC_CHECK_INCLUDES_DEFAULT",
    ],
)
