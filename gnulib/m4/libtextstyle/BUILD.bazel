"""https://github.com/coreutils/gnulib/blob/1039a5f2cee3cda1c11f64a5eb3a15b2e87cd2f0/m4/libtextstyle.m4"""

load("//autoconf:autoconf_toolchain.bzl", autoconf = "autoconf_cache")
load("//autoconf:checks.bzl", "checks")

autoconf(
    name = "libtextstyle",
    checks = [
        checks.AC_SUBST("HAVE_LIBTEXTSTYLE", "no"),
        # gl_LIBTEXTSTYLE_OPTIONAL without the library: the stub textstyle.h is
        # generated (TEXTSTYLE_H=textstyle.h, gl_CONDITIONAL_HEADER([textstyle.h])).
        checks.AC_SUBST("TEXTSTYLE_H", "textstyle.h"),
        checks.M4_VARIABLE("GL_GENERATE_TEXTSTYLE_H", "true"),
    ],
    visibility = ["//visibility:public"],
)
