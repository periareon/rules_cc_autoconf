"""https://github.com/coreutils/gnulib/blob/1039a5f2cee3cda1c11f64a5eb3a15b2e87cd2f0/m4/once.m4"""

load("//autoconf:autoconf_toolchain.bzl", autoconf = "autoconf_cache")

autoconf(
    name = "gl_ONCE",
    visibility = ["//visibility:public"],
    # AC_REQUIRE([gl_THREADLIB]): the whole threadlib machinery as GNU expands it (its
    # AC_CHECK_HEADERS_ONCE([threads.h]) included), which the port's aggregate carries.
    deps = ["//gnulib/m4/threadlib"],
)

autoconf(
    name = "once",
    visibility = ["//visibility:public"],
    deps = [":gl_ONCE"],
)
