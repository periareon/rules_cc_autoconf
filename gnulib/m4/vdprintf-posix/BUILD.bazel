"""https://github.com/coreutils/gnulib/blob/1039a5f2cee3cda1c11f64a5eb3a15b2e87cd2f0/m4/vdprintf-posix.m4"""

load("//autoconf:autoconf_toolchain.bzl", autoconf = "autoconf_cache")

# gl_FUNC_VDPRINTF_IS_POSIX: computes the shell variable
# gl_cv_func_vdprintf_posix from the gl_PRINTF_* results; no define/subst of
# its own.
autoconf(
    name = "gl_FUNC_VDPRINTF_IS_POSIX",
    checks = [],
    visibility = ["//visibility:public"],
    deps = [
        "//gnulib/m4/vdprintf:gl_CHECK_FUNCS_ANDROID_vdprintf",  # gl_CHECK_FUNCS_ANDROID([vdprintf]) in gl_FUNC_VDPRINTF_IS_POSIX
        # Note: The m4 file requires many gl_PRINTF_* macros for gl_FUNC_VDPRINTF_IS_POSIX,
        # but since we're using golden file expectations, we don't need to include them all.
        "//autoconf/macros/AC_CHECK_INCLUDES_DEFAULT",
    ],
)

# On macOS, vdprintf is not POSIX compliant so gl_REPLACE_VDPRINTF is invoked.
autoconf(
    name = "gl_FUNC_VDPRINTF_POSIX",
    checks = [],
    visibility = ["//visibility:public"],
    deps = [
        ":gl_FUNC_VDPRINTF_IS_POSIX",  # AC_REQUIRE([gl_FUNC_VDPRINTF_IS_POSIX])
        # Note: gl_STDIO_H_DEFAULTS is a _DEFAULTS function, so we don't track it as a dependency - line 11 (from vdprintf.m4)
        "//gnulib/m4/vasnprintf",
    ] + select({
        # glibc's vdprintf is POSIX compliant: gl_REPLACE_VDPRINTF is not invoked.
        "@platforms//os:linux": [],
        # Elsewhere gl_cv_func_vdprintf_posix=no -> gl_REPLACE_VDPRINTF, which
        # replaces an existing vdprintf (macOS) and leaves REPLACE_VDPRINTF=0
        # where the function is absent (MSVC).
        "//conditions:default": ["//gnulib/m4/vdprintf:gl_REPLACE_VDPRINTF"],
    }),
)

autoconf(
    name = "vdprintf-posix",
    visibility = ["//visibility:public"],
    deps = [
        ":gl_FUNC_VDPRINTF_IS_POSIX",
        ":gl_FUNC_VDPRINTF_POSIX",
    ],
)
