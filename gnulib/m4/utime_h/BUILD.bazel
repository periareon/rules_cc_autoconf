"""https://github.com/coreutils/gnulib/blob/1039a5f2cee3cda1c11f64a5eb3a15b2e87cd2f0/m4/utime_h.m4"""

load("//autoconf:autoconf_toolchain.bzl", autoconf = "autoconf_cache")
load("//autoconf:checks.bzl", "checks")
load("//gnulib:macros.bzl", gl_macros = "macros")

autoconf(
    name = "gl_UTIME_H",
    checks = [
        # AC_CHECK_HEADERS_ONCE([utime.h]) defines HAVE_UTIME_H only when found
        checks.AC_CHECK_HEADER(
            "utime.h",
            define = "HAVE_UTIME_H",
        ),
        # if test $ac_cv_header_utime_h = yes; then HAVE_UTIME_H=1 else 0
        checks.AC_SUBST(
            "HAVE_UTIME_H",
            condition = "ac_cv_header_utime_h",
        ),
    ] + gl_macros.GL_NEXT_HEADERS(["utime.h"]),
    visibility = ["//visibility:public"],
    deps = [
        "//gnulib/m4/include_next",  # gl_CHECK_NEXT_HEADERS uses include_next
        # Note: AC_CHECK_INCLUDES_DEFAULT is added for test compatibility
        "//autoconf/macros/AC_CHECK_INCLUDES_DEFAULT",
    ],
)

autoconf(
    name = "gl_UTIME_H_DEFAULTS",
    checks = [
        checks.AC_SUBST("HAVE_UTIME", 1),
        checks.AC_SUBST("REPLACE_UTIME", 0),
    ],
    visibility = ["//visibility:private"],
)

autoconf(
    name = "gl_UTIME_H_REQUIRE_DEFAULTS",
    checks = [
        checks.AC_SUBST("GNULIB_UTIME", 0),
        # Microsoft deprecated alias function names
        checks.AC_SUBST("GNULIB_MDA_UTIME", 1),
    ],
    visibility = ["//visibility:private"],
    deps = [
        ":gl_UTIME_H_DEFAULTS",
    ],
)

# gl_UTIME_MODULE_INDICATOR([modulename]): expands gl_UTIME_H_REQUIRE_DEFAULTS
# and sets GNULIB_<MODULE>; the per-module indicator itself is not modelled.
# Deps-only; kept out of the umbrella because the defaults reach consumers via
# the toolchain `defaults` attribute (see //gnulib/toolchain).
autoconf(
    name = "gl_UTIME_MODULE_INDICATOR",
    checks = [],
    visibility = ["//visibility:public"],
    deps = [
        ":gl_UTIME_H_REQUIRE_DEFAULTS",
    ],
)

autoconf(
    name = "defaults",
    visibility = ["//visibility:public"],
    deps = [
        ":gl_UTIME_H_REQUIRE_DEFAULTS",
    ],
)

autoconf(
    name = "utime_h",
    visibility = ["//visibility:public"],
    deps = [
        ":gl_UTIME_H",
    ],
)
