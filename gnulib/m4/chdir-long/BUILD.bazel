"""https://github.com/coreutils/gnulib/blob/1039a5f2cee3cda1c11f64a5eb3a15b2e87cd2f0/m4/chdir-long.m4"""

load("//autoconf:autoconf_toolchain.bzl", autoconf = "autoconf_cache")
load("//autoconf:checks.bzl", "checks")

autoconf(
    name = "gl_FUNC_CHDIR_LONG",
    checks = [
        # gl_FUNC_CHDIR_LONG: AC_EGREP_CPP checks if PATH_MAX is defined, after
        # gl_PATHMAX_SNIPPET arranged it the way "pathmax.h" does (260 on native Windows,
        # MAXPATHLEN where that is all there is): the sources see the same PATH_MAX.
        # If PATH_MAX is defined → gl_cv_have_unlimited_file_name_length=no
        # If PATH_MAX is NOT defined → gl_cv_have_unlimited_file_name_length=yes
        checks.AC_TRY_COMPILE(
            name = "gl_cv_path_max_defined",
            code = """\
#if HAVE_UNISTD_H
# include <unistd.h>
#endif
#include <limits.h>
#if defined HAVE_SYS_PARAM_H && !defined PATH_MAX && !defined MAXPATHLEN
# include <sys/param.h>
#endif
#if !defined PATH_MAX && defined MAXPATHLEN
# define PATH_MAX MAXPATHLEN
#endif
#ifdef __hpux
# undef PATH_MAX
# define PATH_MAX 1024
#endif
#if defined _WIN32 && ! defined __CYGWIN__
# undef PATH_MAX
# define PATH_MAX 260
#endif
#ifdef PATH_MAX
int x = PATH_MAX;
int main(void) { return x; }
#else
#error PATH_MAX not defined
#endif
""",
            language = "c",
        ),
        # The shell variable's value, as GNU sets it: "no" when PATH_MAX is defined, "yes"
        # otherwise.  gnulib.mk compiles chdir-long.c under `test "$gl_cv_..." = no`, which
        # consumers spell by value (`gl_cv_have_unlimited_file_name_length==no`): the result
        # is a variable with two values, not a probe, so a bare name does not read as yes/no.
        checks.M4_VARIABLE(
            "gl_cv_have_unlimited_file_name_length",
            condition = "gl_cv_path_max_defined",
            if_false = "yes",
            if_true = "no",
        ),
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//gnulib/m4/pathmax:gl_PATHMAX_SNIPPET_PREREQ",
    ],
)

autoconf(
    name = "chdir-long",
    visibility = ["//visibility:public"],
    deps = [
        ":gl_FUNC_CHDIR_LONG",
    ],
)
