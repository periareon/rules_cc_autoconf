"""https://github.com/coreutils/gnulib/blob/1039a5f2cee3cda1c11f64a5eb3a15b2e87cd2f0/m4/net_if_h.m4"""

load("//autoconf:autoconf_toolchain.bzl", autoconf = "autoconf_cache")
load("//autoconf:checks.bzl", "checks", "utils")
load("//gnulib:macros.bzl", gl_macros = "macros")

# gl_HEADER_NET_IF - single AC_DEFUN
autoconf(
    name = "gl_HEADER_NET_IF",
    checks = [
        # AC_CACHE_CHECK([whether <net/if.h> is self-contained])
        checks.AC_TRY_COMPILE(
            name = "_gl_cv_header_net_if_h_selfcontained",
            code = utils.AC_LANG_PROGRAM(
                ["#include <net/if.h>"],
                "struct if_nameindex ni;",
            ),
            language = "c",
        ),

        # AC_CHECK_HEADERS([net/if.h], ...) - only when not self-contained
        # else (not self-contained):
        #   AC_CHECK_HEADERS([net/if.h], [], [], [[#include <sys/socket.h>]])
        checks.AC_CHECK_HEADER(
            "net/if.h",
            name = "_gl_cv_header_net_if_h",
            define = "HAVE_NET_IF_H",
            includes = ["#include <sys/socket.h>"],
            requires = ["!_gl_cv_header_net_if_h_selfcontained"],
        ),

        # AC_SUBST([HAVE_NET_IF_H]) - only set when not self-contained
        #   if test $ac_cv_header_net_if_h = yes; then HAVE_NET_IF_H=1 else 0
        #   AC_SUBST([HAVE_NET_IF_H])
        # When the header is self-contained the AC_SUBST is registered but the
        # variable is never assigned, i.e. "" (the skipped check renders "").
        checks.AC_SUBST(
            "HAVE_NET_IF_H",
            condition = "_gl_cv_header_net_if_h",
            if_false = "0",
            if_true = "1",
            requires = ["!_gl_cv_header_net_if_h_selfcontained"],
        ),

        # gl_NEXT_HEADERS([net/if.h]) - only called when not self-contained
    ] + gl_macros.GL_NEXT_HEADERS(
        ["net/if.h"],
        condition = "!_gl_cv_header_net_if_h_selfcontained",
    ),
    visibility = ["//visibility:public"],
    deps = [
        "//autoconf/macros/AC_CHECK_INCLUDES_DEFAULT",
        "//gnulib/m4/include_next",
    ],
)

autoconf(
    name = "net_if_h",
    visibility = ["//visibility:public"],
    deps = [":gl_HEADER_NET_IF"],
)
