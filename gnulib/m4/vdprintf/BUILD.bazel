"""https://github.com/coreutils/gnulib/blob/1039a5f2cee3cda1c11f64a5eb3a15b2e87cd2f0/m4/vdprintf.m4"""

load("//autoconf:autoconf_toolchain.bzl", autoconf = "autoconf_cache")
load("//autoconf:checks.bzl", "checks")

# gl_CHECK_FUNCS_ANDROID([vdprintf], [[#include <stdio.h>]]) - shared by
# gl_FUNC_VDPRINTF and gl_FUNC_VDPRINTF_IS_POSIX (vdprintf-posix).
autoconf(
    name = "gl_CHECK_FUNCS_ANDROID_vdprintf",
    checks = [
        checks.AC_CHECK_FUNC("vdprintf"),
        # AC_CHECK_FUNCS defines HAVE_VDPRINTF in config.h only when the
        # function is found (e.g. MSVC has no vdprintf).
        checks.AC_DEFINE(
            "HAVE_VDPRINTF",
            condition = "ac_cv_func_vdprintf",
            if_false = None,
            if_true = 1,
        ),
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//autoconf/macros/AC_CHECK_INCLUDES_DEFAULT",
    ],
)

# gl_FUNC_VDPRINTF
# if test $ac_cv_func_vdprintf = no; then
#   HAVE_VDPRINTF=0
#   gl_REPLACE_VDPRINTF   (leaves REPLACE_VDPRINTF=0: the function is absent)
# fi
autoconf(
    name = "gl_FUNC_VDPRINTF",
    checks = [
        # Overrides the gl_STDIO_H_DEFAULTS value of 1.
        checks.AC_SUBST(
            "HAVE_VDPRINTF",
            condition = "ac_cv_func_vdprintf",
            if_false = 0,
            if_true = 1,
        ),
    ],
    visibility = ["//visibility:public"],
    deps = [
        ":gl_CHECK_FUNCS_ANDROID_vdprintf",
        "//autoconf/macros/AC_CHECK_INCLUDES_DEFAULT",
    ],
)

# gl_REPLACE_VDPRINTF, when invoked unconditionally (vdprintf-posix, vdprintf-gnu):
# sets REPLACE_VDPRINTF=1 when vdprintf exists (replacement mode); stays 0
# when the function is absent. HAVE_VDPRINTF keeps its default of 1 here.
autoconf(
    name = "gl_REPLACE_VDPRINTF",
    checks = [
        checks.AC_SUBST(
            "REPLACE_VDPRINTF",
            condition = "ac_cv_func_vdprintf",
            if_false = "0",
            if_true = "1",
        ),
    ],
    visibility = ["//visibility:public"],
    deps = [
        ":gl_CHECK_FUNCS_ANDROID_vdprintf",
        ":gl_PREREQ_VDPRINTF",
        # Note: gl_STDIO_H_DEFAULTS is a _DEFAULTS function, so we don't track it as a dependency
        # For test compatibility
        "//autoconf/macros/AC_CHECK_INCLUDES_DEFAULT",
    ],
)

# Prerequisites of lib/vdprintf.c: AC_DEFUN([gl_PREREQ_VDPRINTF], [:]) does nothing.
autoconf(
    name = "gl_PREREQ_VDPRINTF",
    checks = [],
    visibility = ["//visibility:public"],
)

# Umbrella mirroring the conformance configure.ac (gl_FUNC_VDPRINTF and
# gl_PREREQ_VDPRINTF); gl_REPLACE_VDPRINTF is the unconditional-replace entry
# point used by vdprintf-posix/-gnu and is deliberately not included.
autoconf(
    name = "vdprintf",
    visibility = ["//visibility:public"],
    deps = [
        ":gl_FUNC_VDPRINTF",
        ":gl_PREREQ_VDPRINTF",
        "//autoconf/macros/AC_CHECK_INCLUDES_DEFAULT",
    ],
)
