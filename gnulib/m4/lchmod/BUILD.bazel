"""https://github.com/coreutils/gnulib/blob/1039a5f2cee3cda1c11f64a5eb3a15b2e87cd2f0/m4/lchmod.m4"""

load("//autoconf:autoconf_toolchain.bzl", autoconf = "autoconf_cache")
load("//autoconf:checks.bzl", "checks")

# gl_CHECK_FUNCS_ANDROID([lchmod]) - the probe plus its config.h define.
# fchmodat and lchown only run this probe and must not touch the HAVE_LCHMOD
# subst, which gl_FUNC_LCHMOD alone lowers from its gl_SYS_STAT_H_DEFAULTS
# value (1).
autoconf(
    name = "gl_CHECK_FUNCS_ANDROID_lchmod",
    checks = [
        checks.AC_CHECK_FUNC(
            "lchmod",
            define = "HAVE_LCHMOD",
        ),
    ],
    visibility = ["//gnulib:__subpackages__"],
    deps = [
        "//autoconf/macros/AC_CHECK_INCLUDES_DEFAULT",
        "//gnulib/m4/extensions",
    ],
)

autoconf(
    name = "gl_FUNC_LCHMOD",
    checks = [
        # if test "$ac_cv_func_lchmod" = no; then HAVE_LCHMOD=0
        checks.AC_SUBST(
            "HAVE_LCHMOD",
            condition = "ac_cv_func_lchmod",
        ),
    ],
    visibility = ["//visibility:public"],
    deps = [
        ":gl_CHECK_FUNCS_ANDROID_lchmod",  # gl_CHECK_FUNCS_ANDROID([lchmod])
        # Note: gl_SYS_STAT_H_DEFAULTS is a _DEFAULTS function, so we ignore it per user's instruction
        "//gnulib/m4/extensions",  # AC_REQUIRE([AC_USE_SYSTEM_EXTENSIONS])

        # Note: AC_CHECK_INCLUDES_DEFAULT is added for test compatibility
        "//autoconf/macros/AC_CHECK_INCLUDES_DEFAULT",
    ],
)

# gl_PREREQ_LCHMOD: prerequisites of lib/lchmod.c (none).
autoconf(
    name = "gl_PREREQ_LCHMOD",
    checks = [],
    visibility = ["//visibility:public"],
)

autoconf(
    name = "lchmod",
    visibility = ["//visibility:public"],
    deps = [
        ":gl_FUNC_LCHMOD",
        ":gl_PREREQ_LCHMOD",
    ],
)
