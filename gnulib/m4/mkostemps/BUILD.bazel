"""https://github.com/coreutils/gnulib/blob/1039a5f2cee3cda1c11f64a5eb3a15b2e87cd2f0/m4/mkostemps.m4"""

load("//autoconf:autoconf_toolchain.bzl", autoconf = "autoconf_cache")
load("//autoconf:checks.bzl", "checks")

autoconf(
    name = "gl_FUNC_MKOSTEMPS",
    checks = [
        # gl_CHECK_FUNCS_ANDROID is similar to AC_CHECK_FUNC but with Android-specific handling
        # Use internal define to avoid conflict with substitution variable
        checks.AC_CHECK_FUNC(
            "mkostemps",
            name = "_gl_cv_func_mkostemps",
        ),

        # Set HAVE_MKOSTEMPS as define if function exists
        checks.AC_DEFINE(
            "HAVE_MKOSTEMPS",
            "1",
            requires = ["_gl_cv_func_mkostemps==1"],
        ),

        # if test $ac_cv_func_mkostemps != yes; then HAVE_MKOSTEMPS=0
        checks.AC_SUBST(
            "HAVE_MKOSTEMPS",
            condition = "_gl_cv_func_mkostemps",
        ),

        # Otherwise, REPLACE_MKOSTEMPS=0 (default)
        # Based on golden file, REPLACE_MKOSTEMPS=0 on macOS
        checks.AC_SUBST("REPLACE_MKOSTEMPS", 0),
    ],
    visibility = ["//visibility:public"],
    deps = [
        # AC_REQUIRE([gl_STDLIB_H_DEFAULTS]) - line 12 (ignore, it's a _DEFAULTS function)
        "//gnulib/m4/extensions",  # AC_REQUIRE([AC_USE_SYSTEM_EXTENSIONS])
        # Note: AC_CHECK_INCLUDES_DEFAULT is added for test compatibility
        "//autoconf/macros/AC_CHECK_INCLUDES_DEFAULT",
    ],
)

autoconf(
    name = "mkostemps",
    visibility = ["//visibility:public"],
    deps = [
        ":gl_FUNC_MKOSTEMPS",
    ],
)
