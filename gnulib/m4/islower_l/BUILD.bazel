"""https://github.com/coreutils/gnulib/blob/1039a5f2cee3cda1c11f64a5eb3a15b2e87cd2f0/m4/islower_l.m4"""

load("//autoconf:autoconf_toolchain.bzl", autoconf = "autoconf_cache")
load("//autoconf:checks.bzl", "checks")

autoconf(
    name = "gl_FUNC_ISLOWER_L",
    checks = [
        # AC_CHECK_FUNCS_ONCE([islower_l]): autoconf's plain link probe, which
        # declares the function itself.  A probe through <ctype.h> would miss
        # it on macOS, where islower_l is declared only via <xlocale.h>.
        checks.AC_CHECK_FUNC(
            "islower_l",
            define = "HAVE_ISLOWER_L",
        ),
        # if test $ac_cv_func_islower_l = no; then HAVE_ISLOWER_L=0; fi
        # Overrides the gl_CTYPE_H_DEFAULTS value of 1 (e.g. MSVC has no islower_l).
        checks.AC_SUBST(
            "HAVE_ISLOWER_L",
            condition = "ac_cv_func_islower_l",
            if_false = "0",
            if_true = "1",
        ),
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//autoconf/macros/AC_CHECK_INCLUDES_DEFAULT",
        "//gnulib/m4/c-strtod",
        "//gnulib/m4/ctype_h",
        "//gnulib/m4/extensions",  # AC_REQUIRE([AC_USE_SYSTEM_EXTENSIONS]) - needed for islower_l to be declared
    ],
)

autoconf(
    name = "islower_l",
    visibility = ["//visibility:public"],
    deps = [
        ":gl_FUNC_ISLOWER_L",
    ],
)
