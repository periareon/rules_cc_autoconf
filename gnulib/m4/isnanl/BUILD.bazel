"""https://github.com/coreutils/gnulib/blob/1039a5f2cee3cda1c11f64a5eb3a15b2e87cd2f0/m4/isnanl.m4

gl_FUNC_ISNANL:
- AC_REQUIRE([gl_MATH_H_DEFAULTS])
- gl_HAVE_ISNANL_NO_LIBM (gl_cv_func_isnanl_no_libm)
- gl_HAVE_ISNANL_IN_LIBM (gl_cv_func_isnanl_in_libm) when not usable without libm
- gl_FUNC_ISNANL_WORKS (gl_cv_func_isnanl_works)
- HAVE_ISNANL=0 unless isnanl links and works
- AC_SUBST([ISNANL_LIBM])

gl_FUNC_ISNANL_NO_LIBM:
- AC_DEFINE([HAVE_ISNANL_IN_LIBC]) when isnanl links without libm and works

gl_PREREQ_ISNANL:
- gl_LONG_DOUBLE_EXPONENT_LOCATION
- AC_REQUIRE([gl_LONG_DOUBLE_VS_DOUBLE])

gl_HAVE_ISNANL_NO_LIBM / gl_HAVE_ISNANL_IN_LIBM / gl_FUNC_ISNANL_WORKS are
exposed as their own targets.
"""

load("//autoconf:autoconf_toolchain.bzl", autoconf = "autoconf_cache")
load("//autoconf:checks.bzl", "checks", "utils")

# m4 line 72: AC_LANG_PROGRAM used by gl_HAVE_ISNANL_NO_LIBM and gl_HAVE_ISNANL_IN_LIBM.
_ISNANL_LINK_CODE = utils.AC_LANG_PROGRAM(
    [
        "#include <math.h>",
        "#if (__GNUC__ >= 4) || (__clang_major__ >= 4)",
        "# undef isnanl",
        "# define isnanl(x) __builtin_isnan ((long double)(x))",
        "#elif defined isnan",
        "# undef isnanl",
        "# define isnanl(x) isnan ((long double)(x))",
        "#endif",
        "long double x;",
    ],
    "return isnanl (x);",
)

# m4 line 125: gl_FUNC_ISNANL_WORKS test program (AC_RUN_IFELSE).
# MSVC rejects the constant expression 0.0L / 0.0L (error C2124), so this
# fails to compile there, matching GNU's "whether isnanl works... no".
_ISNANL_WORKS_CODE = r"""
#include <float.h>
#include <limits.h>
#include <math.h>
#if (__GNUC__ >= 4) || (__clang_major__ >= 4)
# undef isnanl
# define isnanl(x) __builtin_isnan ((long double)(x))
#elif defined isnan
# undef isnanl
# define isnanl(x) isnan ((long double)(x))
#endif
#define NWORDS \
  ((sizeof (long double) + sizeof (unsigned int) - 1) / sizeof (unsigned int))
typedef union { unsigned int word[NWORDS]; long double value; }
        memory_long_double;
#define NaNl() (0.0L / 0.0L)
int main ()
{
  int result = 0;

  if (!isnanl (NaNl ()))
    result |= 1;

  {
    memory_long_double m;
    unsigned int i;

    /* The isnanl function should be immune against changes in the sign bit and
       in the mantissa bits.  The xor operation twiddles a bit that can only be
       a sign bit or a mantissa bit (since the exponent never extends to
       bit 31).  */
    m.value = NaNl ();
    m.word[NWORDS / 2] ^= (unsigned int) 1 << (sizeof (unsigned int) * CHAR_BIT - 1);
    for (i = 0; i < NWORDS; i++)
      m.word[i] |= 1;
    if (!isnanl (m.value))
      result |= 1;
  }

#if ((defined __ia64 && LDBL_MANT_DIG == 64) || (defined __x86_64__ || defined __amd64__) || (defined __i386 || defined __i386__ || defined _I386 || defined _M_IX86 || defined _X86_)) && !HAVE_SAME_LONG_DOUBLE_AS_DOUBLE
/* Representation of an 80-bit 'long double' as an initializer for a sequence
   of 'unsigned int' words.  */
# ifdef WORDS_BIGENDIAN
#  define LDBL80_WORDS(exponent,manthi,mantlo) \
     { ((unsigned int) (exponent) << 16) | ((unsigned int) (manthi) >> 16), \
       ((unsigned int) (manthi) << 16) | ((unsigned int) (mantlo) >> 16),   \
       (unsigned int) (mantlo) << 16                                        \
     }
# else
#  define LDBL80_WORDS(exponent,manthi,mantlo) \
     { mantlo, manthi, exponent }
# endif
  { /* Quiet NaN.  */
    static memory_long_double x =
      { LDBL80_WORDS (0xFFFF, 0xC3333333, 0x00000000) };
    if (!isnanl (x.value))
      result |= 2;
  }
  {
    /* Signalling NaN.  */
    static memory_long_double x =
      { LDBL80_WORDS (0xFFFF, 0x83333333, 0x00000000) };
    if (!isnanl (x.value))
      result |= 2;
  }
  /* isnanl should return something even for noncanonical values.  */
  { /* Pseudo-NaN.  */
    static memory_long_double x =
      { LDBL80_WORDS (0xFFFF, 0x40000001, 0x00000000) };
    if (isnanl (x.value) && !isnanl (x.value))
      result |= 4;
  }
  { /* Pseudo-Infinity.  */
    static memory_long_double x =
      { LDBL80_WORDS (0xFFFF, 0x00000000, 0x00000000) };
    if (isnanl (x.value) && !isnanl (x.value))
      result |= 8;
  }
  { /* Pseudo-Zero.  */
    static memory_long_double x =
      { LDBL80_WORDS (0x4004, 0x00000000, 0x00000000) };
    if (isnanl (x.value) && !isnanl (x.value))
      result |= 16;
  }
  { /* Unnormalized number.  */
    static memory_long_double x =
      { LDBL80_WORDS (0x4000, 0x63333333, 0x00000000) };
    if (isnanl (x.value) && !isnanl (x.value))
      result |= 32;
  }
  { /* Pseudo-Denormal.  */
    static memory_long_double x =
      { LDBL80_WORDS (0x0000, 0x83333333, 0x00000000) };
    if (isnanl (x.value) && !isnanl (x.value))
      result |= 64;
  }
#endif

  return result;
}
"""

autoconf(
    name = "gl_HAVE_ISNANL_NO_LIBM",
    checks = [
        # m4 line 66: gl_HAVE_ISNANL_NO_LIBM
        checks.AC_TRY_LINK(
            name = "gl_cv_func_isnanl_no_libm",
            code = _ISNANL_LINK_CODE,
        ),
    ],
    visibility = ["//visibility:public"],
)

autoconf(
    name = "gl_HAVE_ISNANL_IN_LIBM",
    checks = [
        # m4 line 89: gl_HAVE_ISNANL_IN_LIBM (only when not usable without libm)
        checks.AC_TRY_LINK(
            name = "gl_cv_func_isnanl_in_libm",
            code = _ISNANL_LINK_CODE,
            linkopts = ["-lm"],
            requires = ["!gl_cv_func_isnanl_no_libm"],
        ),
    ],
    visibility = ["//visibility:public"],
    deps = [
        ":gl_HAVE_ISNANL_NO_LIBM",  # the guard above comes from the gl_FUNC_ISNANL caller
    ],
)

autoconf(
    name = "gl_FUNC_ISNANL_WORKS",
    checks = [
        # m4 line 116: gl_FUNC_ISNANL_WORKS (AC_RUN_IFELSE, modelled as a link test;
        # the program compiles and links wherever GNU's run reports yes).
        checks.AC_TRY_LINK(
            name = "gl_cv_func_isnanl_works",
            code = _ISNANL_WORKS_CODE,
            compile_defines = [
                "HAVE_SAME_LONG_DOUBLE_AS_DOUBLE",
                "WORDS_BIGENDIAN",
            ],
            requires = ["gl_cv_func_isnanl_no_libm || gl_cv_func_isnanl_in_libm"],
        ),
    ],
    visibility = ["//visibility:public"],
    deps = [
        # The guard above comes from the gl_FUNC_ISNANL caller.
        ":gl_HAVE_ISNANL_IN_LIBM",
        ":gl_HAVE_ISNANL_NO_LIBM",
        "//autoconf/macros/AC_CANONICAL_HOST",  # AC_REQUIRE([AC_CANONICAL_HOST])
        "//gnulib/m4/gnulib-common:gl_BIGENDIAN",  # AC_REQUIRE([gl_BIGENDIAN])
        "//gnulib/m4/math_h:long-double-vs-double",  # AC_REQUIRE([gl_LONG_DOUBLE_VS_DOUBLE])
    ],
)

autoconf(
    name = "gl_FUNC_ISNANL",
    checks = [
        # m4 line 34: HAVE_ISNANL=0 unless gl_func_isnanl = yes
        checks.AC_SUBST(
            "HAVE_ISNANL",
            condition = "gl_cv_func_isnanl_works",
            if_false = 0,
            if_true = 1,
        ),
        # m4 line 18/29: ISNANL_LIBM=-lm only when isnanl needs libm and works.
        # Canonical owner of ISNANL_LIBM; asinl/atanl get it from here.
        checks.AC_SUBST(
            "ISNANL_LIBM",
            condition = "gl_cv_func_isnanl_in_libm && gl_cv_func_isnanl_works",
            if_false = "",
            if_true = "-lm",
        ),
    ],
    visibility = ["//visibility:public"],
    deps = [
        ":gl_FUNC_ISNANL_WORKS",
        ":gl_HAVE_ISNANL_IN_LIBM",
        ":gl_HAVE_ISNANL_NO_LIBM",
        "//gnulib/m4/math_h",  # AC_REQUIRE([gl_MATH_H_DEFAULTS])
    ],
)

autoconf(
    name = "gl_FUNC_ISNANL_NO_LIBM",
    checks = [
        # m4 line 53 (gl_FUNC_ISNANL_NO_LIBM): AC_DEFINE([HAVE_ISNANL_IN_LIBC], [1])
        # when isnanl links without libm and works.
        checks.AC_DEFINE(
            "HAVE_ISNANL_IN_LIBC",
            condition = "gl_cv_func_isnanl_no_libm && gl_cv_func_isnanl_works",
            if_false = None,
            if_true = 1,
        ),
    ],
    visibility = ["//visibility:public"],
    deps = [
        ":gl_FUNC_ISNANL_WORKS",
        ":gl_HAVE_ISNANL_NO_LIBM",
    ],
)

autoconf(
    name = "gl_PREREQ_ISNANL",
    visibility = ["//visibility:public"],
    deps = [
        "//gnulib/m4/exponentl",  # gl_LONG_DOUBLE_EXPONENT_LOCATION
        "//gnulib/m4/math_h:long-double-vs-double",  # AC_REQUIRE([gl_LONG_DOUBLE_VS_DOUBLE])
    ],
)

# Umbrella target kept for existing dependants.
autoconf(
    name = "isnanl",
    visibility = ["//visibility:public"],
    deps = [
        ":gl_FUNC_ISNANL",
        ":gl_FUNC_ISNANL_NO_LIBM",
        ":gl_FUNC_ISNANL_WORKS",
        ":gl_HAVE_ISNANL_IN_LIBM",
        ":gl_HAVE_ISNANL_NO_LIBM",
        ":gl_PREREQ_ISNANL",
        "//gnulib/m4/exponentd",  # Provides DBL_EXPBIT0_BIT, DBL_EXPBIT0_WORD (needed for test compatibility)
        # For test compatibility
        "//autoconf/macros/AC_CHECK_INCLUDES_DEFAULT",
    ],
)
