"""https://github.com/coreutils/gnulib/blob/1039a5f2cee3cda1c11f64a5eb3a15b2e87cd2f0/m4/libgmp.m4"""

load("//autoconf:autoconf_toolchain.bzl", autoconf = "autoconf_cache")
load("//autoconf:checks.bzl", "checks")

autoconf(
    name = "gl_LIBGMP",
    checks = [
        # AC_CHECK_HEADERS([gmp.h gmp/gmp.h], [break])
        checks.AC_CHECK_HEADER(
            "gmp.h",
            define = "HAVE_GMP_H",
        ),
        checks.AC_CHECK_HEADER(
            "gmp/gmp.h",
            define = "HAVE_GMP_GMP_H",
            requires = ["!ac_cv_header_gmp_h"],
        ),
        # Without the havelib module: AC_SEARCH_LIBS([__gmpz_roinit_n], [gmp]),
        # only attempted when a header was found.
        checks.AC_SEARCH_LIBS(
            "__gmpz_roinit_n",
            ["gmp"],
            requires = ["ac_cv_header_gmp_h"],
            subst = "LIBGMP",
        ),
        checks.AC_SUBST(
            "HAVE_LIBGMP",
            condition = "ac_cv_search___gmpz_roinit_n",
            if_false = "no",
            if_true = "yes",
        ),
        checks.AC_SUBST(
            "LTLIBGMP",
            condition = "ac_cv_search___gmpz_roinit_n",
            if_false = "",
            if_true = "-lgmp",
        ),
        # serial 8: gmp.h is generated (as a wrapper for mini-gmp.h or gmp/gmp.h) unless
        # the library and its own gmp.h are both there.
        checks.M4_VARIABLE(
            "GL_GENERATE_GMP_H",
            condition = "ac_cv_search___gmpz_roinit_n && ac_cv_header_gmp_h",
            if_false = "true",
            if_true = "false",
        ),
        # gl_CONDITIONAL([GL_GENERATE_MINI_GMP_H], [test $HAVE_LIBGMP != yes]): an automake
        # conditional in GNU; a substitution here, since the generated gmp.h wrapper (which
        # gnulib.mk writes with echo under that conditional) reads it as @GL_GENERATE_MINI_GMP_H@.
        checks.AC_SUBST(
            "GL_GENERATE_MINI_GMP_H",
            condition = "ac_cv_search___gmpz_roinit_n",
            if_false = "true",
            if_true = "false",
        ),
        # gl_CONDITIONAL([GL_GENERATE_GMP_GMP_H], [test $HAVE_LIBGMP = yes && test "$ac_cv_header_gmp_h" != yes])
        checks.AC_SUBST(
            "GL_GENERATE_GMP_GMP_H",
            condition = "ac_cv_search___gmpz_roinit_n && !ac_cv_header_gmp_h",
            if_false = "false",
            if_true = "true",
        ),
    ],
    visibility = ["//visibility:public"],
    deps = [
        # For test compatibility - need basic header defines
        "//autoconf/macros/AC_CHECK_INCLUDES_DEFAULT",
    ],
)

autoconf(
    name = "libgmp",
    visibility = ["//visibility:public"],
    deps = [
        ":gl_LIBGMP",
    ],
)
