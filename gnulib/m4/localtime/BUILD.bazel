"""https://github.com/coreutils/gnulib/blob/1039a5f2cee3cda1c11f64a5eb3a15b2e87cd2f0/m4/localtime.m4"""

load("//autoconf:autoconf_toolchain.bzl", autoconf = "autoconf_cache")
load("//autoconf:checks.bzl", "checks")

# gl_FUNC_LOCALTIME: the only decision is made on $host_os.
#   case "$host_os" in
#     mingw* | windows*) REPLACE_LOCALTIME=1 ;;
#   esac
autoconf(
    name = "gl_FUNC_LOCALTIME",
    checks = select({
        "@platforms//os:windows": [
            checks.AC_SUBST("REPLACE_LOCALTIME", 1),
        ],
        "//conditions:default": [],
    }),
    visibility = ["//visibility:public"],
    deps = [
        "//autoconf/macros/AC_CANONICAL_HOST",  # AC_REQUIRE([AC_CANONICAL_HOST]),
        # AC_REQUIRE([gl_TIME_H_DEFAULTS]) is a _DEFAULTS macro (toolchain defaults).
    ],
)

autoconf(
    name = "localtime",
    visibility = ["//visibility:public"],
    deps = [
        ":gl_FUNC_LOCALTIME",
    ],
)
