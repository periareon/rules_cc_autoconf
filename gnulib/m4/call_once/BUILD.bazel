"""https://github.com/coreutils/gnulib/blob/1039a5f2cee3cda1c11f64a5eb3a15b2e87cd2f0/m4/call_once.m4"""

load("//autoconf:autoconf_toolchain.bzl", autoconf = "autoconf_cache")
load("//gnulib:macros.bzl", gl_macros = "macros")

# gl_CHECK_FUNCS_ANDROID([call_once], [[#include <threads.h>]]) is an
# unconditional link test (no <threads.h> needed): glibc >= 2.28 and MSVC's
# UCRT link it, macOS does not. AC_CACHE_CHECK([whether call_once works]) is
# a host_os guess that is "no" only on Cygwin, and the "future*" branch
# (REPLACE_CALL_ONCE=1) is Android-only.
autoconf(
    name = "gl_FUNC_CALL_ONCE",
    checks = gl_macros.GL_CHECK_FUNCS_ANDROID(
        ["call_once"],
        includes = ["#include <threads.h>"],
    ),
    visibility = ["//visibility:public"],
    deps = [
        "//autoconf/macros/AC_CANONICAL_HOST",  # AC_REQUIRE([AC_CANONICAL_HOST])
        "//autoconf/macros/AC_CHECK_INCLUDES_DEFAULT",
        "//gnulib/m4/include_next",  # Required for INCLUDE_NEXT variables
        "//gnulib/m4/threads_h",  # AC_REQUIRE([gl_THREADS_H])
    ],
)

autoconf(
    name = "call_once",
    visibility = ["//visibility:public"],
    deps = [
        ":gl_FUNC_CALL_ONCE",
    ],
)
