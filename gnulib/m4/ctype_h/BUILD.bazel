"""https://github.com/coreutils/gnulib/blob/1039a5f2cee3cda1c11f64a5eb3a15b2e87cd2f0/m4/ctype_h.m4"""

load("//autoconf:autoconf_defaults.bzl", "autoconf_defaults")
load("//autoconf:autoconf_toolchain.bzl", autoconf = "autoconf_cache")
load("//autoconf:checks.bzl", "checks")
load("//gnulib:macros.bzl", gl_macros = "macros")

# gl_CTYPE_H - Header check and GNULIB module indicators

autoconf(
    name = "ctype_h",
    checks = gl_macros.GL_NEXT_HEADERS(["ctype.h"]) + [
        checks.AC_CHECK_HEADER(
            "ctype.h",
            define = "HAVE_CTYPE_H",
        ),
    ],
    default_deps = [
        ":defaults",  # the header's own defaults, as its m4 requires
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//gnulib/m4/include_next",  # For NEXT_CTYPE_H
    ],
)

autoconf_defaults(
    name = "gl_CTYPE_H_DEFAULTS",
    substs = {
        "HAVE_ISALNUM_L": "1",
        "HAVE_ISALPHA_L": "1",
        "HAVE_ISBLANK": "1",
        "HAVE_ISBLANK_L": "1",
        "HAVE_ISCNTRL_L": "1",
        "HAVE_ISDIGIT_L": "1",
        "HAVE_ISGRAPH_L": "1",
        "HAVE_ISLOWER_L": "1",
        "HAVE_ISPRINT_L": "1",
        "HAVE_ISPUNCT_L": "1",
        "HAVE_ISSPACE_L": "1",
        "HAVE_ISUPPER_L": "1",
        "HAVE_ISXDIGIT_L": "1",
        "HAVE_TOLOWER_L": "1",
        "HAVE_TOUPPER_L": "1",
    },
    visibility = ["//visibility:private"],
)

autoconf_defaults(
    name = "gl_CTYPE_H_REQUIRE_DEFAULTS",
    substs = {
        "GNULIB_ISALNUM_L": "0",
        "GNULIB_ISALPHA_L": "0",
        "GNULIB_ISBLANK": "0",
        "GNULIB_ISBLANK_L": "0",
        "GNULIB_ISCNTRL_L": "0",
        "GNULIB_ISDIGIT_L": "0",
        "GNULIB_ISGRAPH_L": "0",
        "GNULIB_ISLOWER_L": "0",
        "GNULIB_ISPRINT_L": "0",
        "GNULIB_ISPUNCT_L": "0",
        "GNULIB_ISSPACE_L": "0",
        "GNULIB_ISUPPER_L": "0",
        "GNULIB_ISXDIGIT_L": "0",
        "GNULIB_TOLOWER_L": "0",
        "GNULIB_TOUPPER_L": "0",
    },
    visibility = ["//visibility:private"],
    deps = [
        ":gl_CTYPE_H_DEFAULTS",
    ],
)

autoconf_defaults(
    name = "defaults",
    visibility = ["//visibility:public"],
    deps = [
        ":gl_CTYPE_H_REQUIRE_DEFAULTS",
    ],
)
