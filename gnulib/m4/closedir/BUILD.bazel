"""https://github.com/coreutils/gnulib/blob/1039a5f2cee3cda1c11f64a5eb3a15b2e87cd2f0/m4/closedir.m4"""

load("//autoconf:autoconf_toolchain.bzl", autoconf = "autoconf_cache")
load("//autoconf:checks.bzl", "checks")

autoconf(
    name = "gl_FUNC_CLOSEDIR",
    checks = [
        # Use internal define to avoid conflict with AC_SUBST
        checks.AC_CHECK_FUNC(
            "closedir",
            name = "_gl_have_closedir",
        ),

        # AC_CHECK_FUNCS([closedir]) defines HAVE_CLOSEDIR only when found;
        # the subst is 0 when closedir is missing, 1 otherwise.
        checks.AC_DEFINE(
            "HAVE_CLOSEDIR",
            condition = "_gl_have_closedir",
            if_false = None,
            if_true = 1,
        ),
        checks.AC_SUBST(
            "HAVE_CLOSEDIR",
            condition = "_gl_have_closedir",
            if_false = 0,
            if_true = 1,
        ),

        # REPLACE_CLOSEDIR is set to 1 only when closedir exists and
        # - DIR_HAS_FD_MEMBER = 0 (DIR structure doesn't have fd member, e.g., on Windows), or
        # - gl_TEST_FCHDIR finds HAVE_FCHDIR = 0.
        # Without closedir the M4 sets HAVE_CLOSEDIR=0 and never runs
        # gl_TEST_FCHDIR, so the HAVE_FCHDIR subst keeps its default there.
        checks.AC_SUBST(
            "REPLACE_CLOSEDIR",
            condition = "_gl_have_closedir && (DIR_HAS_FD_MEMBER==0 || !ac_cv_func_fchdir)",
            if_false = 0,
            if_true = 1,
        ),
    ],
    visibility = ["//visibility:public"],
    deps = [
        # Note: gl_DIRENT_H_DEFAULTS is a _DEFAULTS function, so we ignore it per user's instruction
        "//autoconf/macros/AC_CANONICAL_HOST",  # AC_REQUIRE([AC_CANONICAL_HOST])
        # DIR_HAS_FD_MEMBER comes from dirent_h (gl_DIRENT_DIR)
        "//gnulib/m4/dirent_h",
        "//gnulib/m4/dirent_h:gl_DIRENT_DIR",  # AC_REQUIRE([gl_DIRENT_DIR])
        # AC_CHECK_FUNCS_ONCE([fchdir]) - probe + config.h define only
        "//gnulib/m4/fchdir:AC_CHECK_FUNCS_ONCE_fchdir",
        # Note: AC_CHECK_INCLUDES_DEFAULT is added for test compatibility
        "//autoconf/macros/AC_CHECK_INCLUDES_DEFAULT",
    ],
)

autoconf(
    name = "closedir",
    visibility = ["//visibility:public"],
    deps = [
        ":gl_FUNC_CLOSEDIR",
    ],
)
