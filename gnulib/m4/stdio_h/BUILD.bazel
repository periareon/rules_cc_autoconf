"""https://github.com/coreutils/gnulib/blob/1039a5f2cee3cda1c11f64a5eb3a15b2e87cd2f0/m4/stdio_h.m4"""

load("//autoconf:autoconf_defaults.bzl", "autoconf_defaults")
load("//autoconf:autoconf_toolchain.bzl", autoconf = "autoconf_cache")
load("//autoconf:checks.bzl", "checks")
load("//gnulib:macros.bzl", gl_macros = "macros")

# Shared AC_CHECK_DECL(_snprintf) used by stdio_h and vasnprintf's gl_PREREQ_VASNPRINTF.
autoconf(
    name = "gl_HAVE_DECL__SNPRINTF",
    checks = [
        # AC_CHECK_DECLS([_snprintf], , , [[#include <stdio.h>]]) in
        # gl_PREREQ_VASNPRINTF: config.h define only, never an AC_SUBST.
        checks.AC_CHECK_DECL(
            "_snprintf",
            define = "HAVE_DECL__SNPRINTF",
            includes = ["#include <stdio.h>"],
        ),
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//autoconf/macros/AC_CHECK_INCLUDES_DEFAULT",
    ],
)

# gl_STDIO_H_EARLY - m4 lines 9-29: AC_DEFINE([__USE_MINGW_ANSI_STDIO]) must
# happen early because several printf/snprintf probes depend on it.
autoconf(
    name = "gl_STDIO_H_EARLY",
    checks = [
        # This makes printf/scanf use GNU-style format specifiers
        checks.AC_DEFINE("__USE_MINGW_ANSI_STDIO", "1"),
    ],
    visibility = ["//visibility:public"],
)

autoconf(
    name = "gl_STDIO_H",
    checks = [
        # From gl_STDIO_H: Check which flavor of printf attribute matches inttypes macros
        # Lines 39-53: AC_CACHE_CHECK + AC_COMPILE_IFELSE
        # Sets GNULIB_PRINTF_ATTRIBUTE_FLAVOR_GNU=1 when compilation FAILS (gnu printf flavor)
        checks.AC_TRY_COMPILE(
            name = "_gl_cv_printf_attribute_flavor_system",
            code = """\
#define __STDC_FORMAT_MACROS 1
#include <stdio.h>
#include <inttypes.h>
/* For non-mingw systems, compilation will trivially succeed.
   For mingw, compilation will succeed for older mingw (system
   printf, "I64d") and fail for newer mingw (gnu printf, "lld"). */
#if (defined _WIN32 && ! defined __CYGWIN__) && \
  (__GNUC__ > 4 || (__GNUC__ == 4 && __GNUC_MINOR__ >= 4))
extern char PRIdMAX_probe[sizeof PRIdMAX == sizeof "I64d" ? 1 : -1];
#endif
int main(void) { return 0; }
""",
            language = "c",
        ),
        # Set GNULIB_PRINTF_ATTRIBUTE_FLAVOR_GNU when system flavor check fails
        checks.AC_DEFINE(
            "GNULIB_PRINTF_ATTRIBUTE_FLAVOR_GNU",
            condition = "!_gl_cv_printf_attribute_flavor_system",
        ),
    ] + gl_macros.GL_NEXT_HEADERS(["stdio.h"]) + [

        # Use subst=True to create both subst variables and config.h defines
        # The original m4 sets HAVE_DECL_*=0 if not found, otherwise uses default (1)
        checks.AC_CHECK_DECL(
            "fcloseall",
            define = "HAVE_DECL_FCLOSEALL",
            includes = ["#include <stdio.h>"],
            subst = True,
            # Note: stdio_h itself needs HAVE_DECL_FCLOSEALL=0 when not found (for its test)
            # But modules that depend on stdio_h transitively shouldn't have it at all
            # This is handled by making vasnprintf check for _snprintf directly instead of depending on stdio_h
        ),
        checks.AC_CHECK_DECL(
            "getw",
            define = "HAVE_DECL_GETW",
            includes = ["#include <stdio.h>"],
            subst = True,
        ),
        checks.AC_CHECK_DECL(
            "putw",
            define = "HAVE_DECL_PUTW",
            includes = ["#include <stdio.h>"],
            subst = True,
        ),

        # ac_cv_have_decl__snprintf from gl_HAVE_DECL__SNPRINTF (shared with vasnprintf)
    ] + select({
        # m4_ifdef([gl_NONBLOCKING_IO], [gl_NONBLOCKING_IO
        #   if test $gl_cv_have_nonblocking != yes; then
        #     REPLACE_STDIO_READ_FUNCS=1 / REPLACE_STDIO_WRITE_FUNCS=1 ...])
        # gl_NONBLOCKING_IO_BODY decides gl_cv_have_nonblocking purely from
        # $host_os: "no" on mingw/windows, "yes" everywhere else.
        "@platforms//os:windows": [
            checks.AC_SUBST("REPLACE_STDIO_READ_FUNCS", 1),
            checks.AC_SUBST("REPLACE_STDIO_WRITE_FUNCS", 1),
        ],
        # m4_ifdef([gl_SIGNAL_SIGPIPE], [gl_SIGNAL_SIGPIPE
        #   if test $gl_cv_header_signal_h_SIGPIPE != yes; then
        #     REPLACE_STDIO_WRITE_FUNCS=1 ...])
        "//conditions:default": [
            checks.AC_SUBST("REPLACE_STDIO_READ_FUNCS", 0),
            checks.AC_SUBST(
                "REPLACE_STDIO_WRITE_FUNCS",
                condition = "gl_cv_header_signal_h_SIGPIPE",
                if_false = 1,
                if_true = 0,
            ),
        ],
    }),
    default_deps = [
        ":defaults",  # AC_REQUIRE: gl_STDIO_H_DEFAULTS
    ],
    visibility = ["//visibility:public"],
    deps = [
        ":gl_HAVE_DECL__SNPRINTF",
        "//gnulib/m4/sigpipe:gl_SIGNAL_SIGPIPE",  # m4_ifdef([gl_SIGNAL_SIGPIPE], [gl_SIGNAL_SIGPIPE])
        # Note: gl_STDIO_H_DEFAULTS is a _DEFAULTS function, so we don't track it as a dependency
        # The defaults are provided by the toolchain/defaults target
        "//gnulib/m4/include_next",
        # Note: AC_CHECK_INCLUDES_DEFAULT is added for test compatibility
        "//autoconf/macros/AC_CHECK_INCLUDES_DEFAULT",
    ],
)

# gl_STDIO_MODULE_INDICATOR([modulename]): gl_STDIO_H_REQUIRE_DEFAULTS (the
# defaults are supplied through the toolchain's :defaults target) and
# GNULIB_<module>=1 for the named module; no checks of its own.
autoconf(
    name = "gl_STDIO_MODULE_INDICATOR",
    checks = [],
    default_deps = [
        ":defaults",  # through a macro it invokes: gl_STDIO_H_DEFAULTS
        "//gnulib/m4/stdlib_h:defaults",  # gl_STDIO_H_REQUIRE_DEFAULTS invokes gl_STDLIB_H_REQUIRE_DEFAULTS
    ],
    visibility = ["//visibility:public"],
)

autoconf(
    name = "stdio_h",
    default_deps = [
        ":defaults",  # the header's own defaults, as its m4 requires
    ],
    visibility = ["//visibility:public"],
    deps = [
        ":gl_STDIO_H",
        ":gl_STDIO_H_EARLY",
        ":gl_STDIO_MODULE_INDICATOR",
    ],
)

