"""https://github.com/coreutils/gnulib/blob/1039a5f2cee3cda1c11f64a5eb3a15b2e87cd2f0/m4/double-slash-root.m4"""

load("//autoconf:autoconf_toolchain.bzl", autoconf = "autoconf_cache")
load("//autoconf:checks.bzl", "checks")

# gl_DOUBLE_SLASH_ROOT: a native shell probe (`ls -di / //` plus
# `wc //dev/null`). On Linux/macOS // and / are the same inode, so the macro
# defines nothing. On native Windows (MSYS shell) // is a UNC-style root
# distinct from /, so gl_cv_double_slash_root=yes. Cross-compiling only
# Cygwin and z/OS are known to be distinct.
autoconf(
    name = "gl_DOUBLE_SLASH_ROOT",
    checks = select({
        "@platforms//os:windows": [
            checks.M4_VARIABLE("gl_cv_double_slash_root", "yes"),
            checks.AC_DEFINE("DOUBLE_SLASH_IS_DISTINCT_ROOT", 1),
        ],
        "//conditions:default": [
            checks.M4_VARIABLE("gl_cv_double_slash_root", "no"),
        ],
    }),
    visibility = ["//visibility:public"],
    deps = [
        "//autoconf/macros/AC_CANONICAL_HOST",  # AC_REQUIRE([AC_CANONICAL_HOST])
    ],
)

autoconf(
    name = "double-slash-root",
    visibility = ["//visibility:public"],
    deps = [
        ":gl_DOUBLE_SLASH_ROOT",
    ],
)
