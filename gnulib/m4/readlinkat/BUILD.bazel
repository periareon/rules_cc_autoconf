"""https://github.com/coreutils/gnulib/blob/1039a5f2cee3cda1c11f64a5eb3a15b2e87cd2f0/m4/readlinkat.m4"""

load("//autoconf:autoconf_toolchain.bzl", autoconf = "autoconf_cache")
load("//autoconf:checks.bzl", "checks")

autoconf(
    name = "readlinkat",
    checks = [
        checks.AC_CHECK_FUNC(
            "readlinkat",
            define = "HAVE_READLINKAT",
            subst = True,
        ),
    ] + select({
        # M4 m4/readlinkat.m4 sets REPLACE_READLINKAT when the runtime
        # trailing-slash probe fails. On macOS the SDK probe decides.
        "@platforms//os:macos": [
            checks.AC_SUBST(
                "REPLACE_READLINKAT",
                condition = "gl_cv_macos_sdk_modern",
                if_true = "0",
                if_false = "1",
            ),
        ],
        "//conditions:default": [
            checks.AC_SUBST("REPLACE_READLINKAT", "0"),
        ],
    }),
    visibility = ["//visibility:public"],
    deps = [
        "//gnulib/m4/extensions",
        "//gnulib/m4/readlink",
    ],
)
