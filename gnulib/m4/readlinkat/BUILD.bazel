"""https://github.com/coreutils/gnulib/blob/1039a5f2cee3cda1c11f64a5eb3a15b2e87cd2f0/m4/readlinkat.m4"""

load("//autoconf:autoconf_toolchain.bzl", autoconf = "autoconf_cache")
load("//autoconf:checks.bzl", "checks")

# gl_CHECK_FUNCS_ANDROID([readlinkat]) - the probe plus its config.h define.
# gl_PREREQ_FCHMODAT only runs this probe and must not touch the
# HAVE_READLINKAT subst, which gl_FUNC_READLINKAT alone lowers from its
# gl_UNISTD_H_DEFAULTS value (1).
autoconf(
    name = "gl_CHECK_FUNCS_ANDROID_readlinkat",
    checks = [
        checks.AC_CHECK_FUNC(
            "readlinkat",
            define = "HAVE_READLINKAT",
        ),
    ],
    visibility = ["//gnulib:__subpackages__"],
    deps = [
        "//autoconf/macros/AC_CHECK_INCLUDES_DEFAULT",
    ],
)

autoconf(
    name = "gl_FUNC_READLINKAT",
    checks = [
        # if test $ac_cv_func_readlinkat = no; then HAVE_READLINKAT=0
        checks.AC_SUBST(
            "HAVE_READLINKAT",
            condition = "ac_cv_func_readlinkat",
        ),
    ] + select({
        # On macOS the SDK probe decides.
        "@platforms//os:macos": [
            checks.AC_SUBST(
                "REPLACE_READLINKAT",
                condition = "gl_cv_macos_sdk_modern",
                if_false = "1",
                if_true = "0",
            ),
        ],
        # M4 m4/readlinkat.m4 sets REPLACE_READLINKAT when the signature or
        # the readlink trailing-slash / truncation probes fail; Linux passes
        # them all. Without readlinkat (Windows) the M4 sets HAVE_READLINKAT=0
        # and leaves REPLACE_READLINKAT alone (0; the "future" declaration
        # case only exists on Android). Consumers must compile
        # lib/readlinkat.c when HAVE_READLINKAT==0 || REPLACE_READLINKAT==1
        # (gnulib GL_COND_OBJ_READLINKAT).
        "//conditions:default": [
            checks.AC_SUBST("REPLACE_READLINKAT", "0"),
        ],
    }),
    visibility = ["//visibility:public"],
    deps = [
        ":gl_CHECK_FUNCS_ANDROID_readlinkat",
        "//gnulib/m4/extensions",
        "//gnulib/m4/readlink",
    ],
)

autoconf(
    name = "readlinkat",
    visibility = ["//visibility:public"],
    deps = [
        ":gl_FUNC_READLINKAT",
    ],
)
