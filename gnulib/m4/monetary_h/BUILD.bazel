"""https://github.com/coreutils/gnulib/blob/1039a5f2cee3cda1c11f64a5eb3a15b2e87cd2f0/m4/monetary_h.m4"""

load("//autoconf:autoconf_toolchain.bzl", autoconf = "autoconf_cache")
load("//autoconf:checks.bzl", "checks")
load("//gnulib:macros.bzl", gl_macros = "macros")

# NEXT_MONETARY_H, NEXT_AS_FIRST_DIRECTIVE_MONETARY_H, and GL_GENERATE_MONETARY_H
autoconf(
    name = "gl_MONETARY_H",
    checks = [
        # Use internal define to avoid conflict with substitution variable
        checks.AC_CHECK_HEADER(
            "monetary.h",
            name = "_gl_cv_header_monetary_h",
        ),

        # Set HAVE_MONETARY_H as define if header exists
        checks.AC_DEFINE(
            "HAVE_MONETARY_H",
            requires = ["_gl_cv_header_monetary_h==1"],
        ),
        checks.AC_SUBST(
            "HAVE_MONETARY_H",
            condition = "_gl_cv_header_monetary_h",
        ),
    ] + gl_macros.GL_CHECK_NEXT_HEADERS(["monetary.h"]),
    # HAVE_STRFMON_L / REPLACE_STRFMON_L are gl_MONETARY_H_DEFAULTS values
    # (AC_REQUIREd here, provided through the toolchain's :defaults).
    # gl_FUNC_STRFMON_L (strfmon_l.m4) owns the HAVE_STRFMON_L override.
    visibility = ["//visibility:public"],
    deps = [
        # AC_REQUIRE([gl_MONETARY_H_DEFAULTS]) - line 14 (ignore, it's a _DEFAULTS function)
        "//gnulib/m4/include_next",  # gl_CHECK_NEXT_HEADERS([monetary.h])
        "//gnulib/m4/locale_h",  # AC_CHECK_HEADERS_ONCE([xlocale.h]) / HAVE_XLOCALE_H
        "//autoconf/macros/AC_C_RESTRICT",  # AC_REQUIRE([AC_C_RESTRICT])
        # Note: AC_CHECK_INCLUDES_DEFAULT is added for test compatibility
        "//autoconf/macros/AC_CHECK_INCLUDES_DEFAULT",
    ],
)

autoconf(
    name = "gl_MONETARY_H_DEFAULTS",
    checks = [
        checks.AC_SUBST("HAVE_STRFMON_L", 1),
        checks.AC_SUBST("REPLACE_STRFMON_L", 0),
    ],
    visibility = ["//visibility:private"],
)

autoconf(
    name = "gl_MONETARY_H_REQUIRE_DEFAULTS",
    checks = [
        checks.AC_SUBST("GNULIB_STRFMON_L", 0),
    ],
    visibility = ["//visibility:private"],
    deps = [
        ":gl_MONETARY_H_DEFAULTS",
    ],
)

autoconf(
    name = "defaults",
    visibility = ["//visibility:public"],
    deps = [
        ":gl_MONETARY_H_REQUIRE_DEFAULTS",
    ],
)

# gl_MONETARY_MODULE_INDICATOR([modulename]): gl_MONETARY_H_REQUIRE_DEFAULTS +
# gl_MODULE_INDICATOR_SET_VARIABLE; the GNULIB_* defaults are toolchain-level
# (:defaults), so this is modelled like gl_UNISTD_MODULE_INDICATOR.
autoconf(
    name = "gl_MONETARY_MODULE_INDICATOR",
    checks = [],
    visibility = ["//visibility:public"],
    deps = [
        ":gl_MONETARY_H",
    ],
)

autoconf(
    name = "monetary_h",
    visibility = ["//visibility:public"],
    deps = [
        ":gl_MONETARY_H",
        ":gl_MONETARY_MODULE_INDICATOR",
    ],
)
