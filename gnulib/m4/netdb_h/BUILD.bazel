"""https://github.com/coreutils/gnulib/blob/1039a5f2cee3cda1c11f64a5eb3a15b2e87cd2f0/m4/netdb_h.m4"""

load("//autoconf:autoconf_defaults.bzl", "autoconf_defaults")
load("//autoconf:autoconf_toolchain.bzl", autoconf = "autoconf_cache")
load("//autoconf:checks.bzl", "checks")
load("//gnulib:macros.bzl", gl_macros = "macros")

autoconf(
    name = "netdb_h",
    checks = [
        # gl_CHECK_NEXT_HEADERS([netdb.h]) - sets NEXT_NETDB_H and NEXT_AS_FIRST_DIRECTIVE_NETDB_H
    ] + gl_macros.GL_CHECK_NEXT_HEADERS(["netdb.h"]) + [
        checks.AC_CHECK_HEADER(
            "netdb.h",
            define = "HAVE_NETDB_H",
            subst = True,
        ),
    ],
    default_deps = [
        ":defaults",  # the header's own defaults, as its m4 requires
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//gnulib/m4/include_next",

        # Note: AC_CHECK_INCLUDES_DEFAULT is added for test compatibility
        "//autoconf/macros/AC_CHECK_INCLUDES_DEFAULT",
    ],
)

autoconf_defaults(
    name = "gl_NETDB_H_DEFAULTS",
    substs = {
        "HAVE_DECL_FREEADDRINFO": "1",
        "HAVE_DECL_GAI_STRERROR": "1",
        "HAVE_DECL_GETADDRINFO": "1",
        "HAVE_DECL_GETNAMEINFO": "1",
        # HAVE_* defaults
        "HAVE_STRUCT_ADDRINFO": "1",
        # REPLACE_* defaults
        "REPLACE_GAI_STRERROR": "0",
        "REPLACE_GETADDRINFO": "0",
    },
    visibility = ["//visibility:private"],
)

autoconf_defaults(
    name = "gl_NETDB_H_REQUIRE_DEFAULTS",
    substs = {
        "GNULIB_GETADDRINFO": "0",
    },
    visibility = ["//visibility:private"],
    deps = [
        ":gl_NETDB_H_DEFAULTS",
    ],
)

autoconf_defaults(
    name = "defaults",
    visibility = ["//visibility:public"],
    deps = [
        ":gl_NETDB_H_REQUIRE_DEFAULTS",
    ],
)
