"""https://github.com/coreutils/gnulib/blob/1039a5f2cee3cda1c11f64a5eb3a15b2e87cd2f0/m4/utimensat.m4"""

load("//autoconf:autoconf_toolchain.bzl", autoconf = "autoconf_cache")
load("//autoconf:checks.bzl", "checks")

# gl_CHECK_FUNCS_ANDROID([utimensat], [[#include <sys/stat.h>]]): probe and
# config.h define, shared with gl_UTIMENS (which never substitutes HAVE_UTIMENSAT).
autoconf(
    name = "gl_CHECK_FUNCS_ANDROID_utimensat",
    checks = [
        checks.AC_CHECK_FUNC(
            "utimensat",
            define = "HAVE_UTIMENSAT",
        ),
    ],
    visibility = ["//visibility:public"],
)

autoconf(
    name = "gl_FUNC_UTIMENSAT",
    checks = [
        # if test $ac_cv_func_utimensat = no; then HAVE_UTIMENSAT=0
        checks.AC_SUBST(
            "HAVE_UTIMENSAT",
            condition = "ac_cv_func_utimensat",
        ),
    ] + select({
        "@platforms//os:macos": [
            checks.AC_SUBST("REPLACE_UTIMENSAT", "1"),
        ],
        "//conditions:default": [],
    }),
    visibility = ["//visibility:public"],
    deps = [
        ":gl_CHECK_FUNCS_ANDROID_utimensat",
        "//gnulib/m4/extensions",
        "//gnulib/m4/openat",  # AC_REQUIRE([gl_FUNC_OPENAT])
        "//gnulib/m4/sys_stat_h",  # AC_REQUIRE([gl_SYS_STAT_H_DEFAULTS])
        # For test compatibility
        "//autoconf/macros/AC_CHECK_INCLUDES_DEFAULT",
    ],
)

autoconf(
    name = "utimensat",
    visibility = ["//visibility:public"],
    deps = [
        ":gl_FUNC_UTIMENSAT",
    ],
)
