"""https://github.com/coreutils/gnulib/blob/1039a5f2cee3cda1c11f64a5eb3a15b2e87cd2f0/m4/pthread-cond.m4"""

load("//autoconf:autoconf_toolchain.bzl", autoconf = "autoconf_cache")
load("//autoconf:checks.bzl", "checks")

autoconf(
    name = "gl_PTHREAD_COND",
    checks = select({
        # case "$host_os" in mingw* | windows*) && test $gl_threads_api = windows
        # (the Bazel default on @platforms//os:windows, see threadlib): gnulib
        # replaces the functions, the HAVE_* defaults (1) are left alone.
        "@platforms//os:windows": [
            checks.AC_SUBST("REPLACE_PTHREAD_COND_INIT", "1"),
            checks.AC_SUBST("REPLACE_PTHREAD_CONDATTR_INIT", "1"),
            checks.AC_SUBST("REPLACE_PTHREAD_CONDATTR_DESTROY", "1"),
            checks.AC_SUBST("REPLACE_PTHREAD_COND_WAIT", "1"),
            checks.AC_SUBST("REPLACE_PTHREAD_COND_TIMEDWAIT", "1"),
            checks.AC_SUBST("REPLACE_PTHREAD_COND_SIGNAL", "1"),
            checks.AC_SUBST("REPLACE_PTHREAD_COND_BROADCAST", "1"),
            checks.AC_SUBST("REPLACE_PTHREAD_COND_DESTROY", "1"),
        ],
        # Elsewhere: if test $HAVE_PTHREAD_H = 0 then HAVE_*=0. HAVE_PTHREAD_H
        # is ac_cv_header_pthread_h from gl_PTHREAD_H_PART1.
        "//conditions:default": [
            checks.AC_SUBST(
                "HAVE_PTHREAD_COND_INIT",
                condition = "ac_cv_header_pthread_h",
                if_false = "0",
                if_true = "1",
            ),
            checks.AC_SUBST(
                "HAVE_PTHREAD_CONDATTR_INIT",
                condition = "ac_cv_header_pthread_h",
                if_false = "0",
                if_true = "1",
            ),
            checks.AC_SUBST(
                "HAVE_PTHREAD_CONDATTR_DESTROY",
                condition = "ac_cv_header_pthread_h",
                if_false = "0",
                if_true = "1",
            ),
            checks.AC_SUBST(
                "HAVE_PTHREAD_COND_WAIT",
                condition = "ac_cv_header_pthread_h",
                if_false = "0",
                if_true = "1",
            ),
            checks.AC_SUBST(
                "HAVE_PTHREAD_COND_TIMEDWAIT",
                condition = "ac_cv_header_pthread_h",
                if_false = "0",
                if_true = "1",
            ),
            checks.AC_SUBST(
                "HAVE_PTHREAD_COND_SIGNAL",
                condition = "ac_cv_header_pthread_h",
                if_false = "0",
                if_true = "1",
            ),
            checks.AC_SUBST(
                "HAVE_PTHREAD_COND_BROADCAST",
                condition = "ac_cv_header_pthread_h",
                if_false = "0",
                if_true = "1",
            ),
            checks.AC_SUBST(
                "HAVE_PTHREAD_COND_DESTROY",
                condition = "ac_cv_header_pthread_h",
                if_false = "0",
                if_true = "1",
            ),
        ],
    }),
    visibility = ["//visibility:public"],
    deps = [
        "//gnulib/m4/pthread_h",
        "//gnulib/m4/threadlib",
        # For test compatibility
        "//autoconf/macros/AC_CHECK_INCLUDES_DEFAULT",
    ],
)

autoconf(
    name = "pthread-cond",
    visibility = ["//visibility:public"],
    deps = [
        ":gl_PTHREAD_COND",
    ],
)
