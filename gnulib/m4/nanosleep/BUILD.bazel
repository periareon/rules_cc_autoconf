"""https://github.com/coreutils/gnulib/blob/1039a5f2cee3cda1c11f64a5eb3a15b2e87cd2f0/m4/nanosleep.m4"""

load("//autoconf:autoconf_toolchain.bzl", autoconf = "autoconf_cache")
load("//autoconf:checks.bzl", "checks")

# gl_FUNC_NANOSLEEP from nanosleep.m4
# Upstream unconditionally calls AC_SEARCH_LIBS([nanosleep], [rt posix4]).
autoconf(
    name = "gl_FUNC_NANOSLEEP",
    checks = [
        # Function existence check (for HAVE_NANOSLEEP condition).
        checks.AC_CHECK_FUNC(
            "nanosleep",
            name = "_gl_cv_func_nanosleep",
        ),
        # AC_SEARCH_LIBS([nanosleep], [rt posix4]) for library flag detection.
        checks.AC_SEARCH_LIBS(
            "nanosleep",
            [
                "rt",
                "posix4",
            ],
            subst = "NANOSLEEP_LIB",
        ),
        checks.AC_SUBST("LIB_NANOSLEEP", ""),
        checks.AC_SUBST(
            "HAVE_NANOSLEEP",
            condition = "_gl_cv_func_nanosleep",
            if_false = "0",
            if_true = "1",
        ),

        # if test "x$ac_cv_search_nanosleep" != xno; then
        #   "for working nanosleep" (AC_RUN_IFELSE): on the Unix hosts we
        #   target the result is 'no (mishandles large arguments)', i.e.
        #   REPLACE_NANOSLEEP=1 and HAVE_BUG_BIG_NANOSLEEP.
        checks.AC_DEFINE(
            "HAVE_BUG_BIG_NANOSLEEP",
            condition = "_gl_cv_func_nanosleep",
            if_false = None,
            if_true = 1,
        ),
        # else
        #   "for static inline nanosleep" (mingw's libwinpthreads inline):
        #   if it compiles, REPLACE_NANOSLEEP=1; HAVE_NANOSLEEP=0.
        checks.AC_TRY_COMPILE(
            name = "gl_cv_static_inline_nanosleep",
            code = """\
#include <time.h>

int main(void) {
    static struct timespec ts1;
    static struct timespec ts2;
    return nanosleep (&ts1, &ts2);
}
""",
            language = "c",
            requires = ["!_gl_cv_func_nanosleep"],
        ),
        checks.AC_SUBST(
            "REPLACE_NANOSLEEP",
            condition = "_gl_cv_func_nanosleep || gl_cv_static_inline_nanosleep",
            if_false = 0,
            if_true = 1,
        ),
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//autoconf/macros/AC_CANONICAL_HOST",
        "//autoconf/macros/AC_CHECK_DECLS_ONCE_ALARM",
        "//autoconf/macros/AC_CHECK_INCLUDES_DEFAULT",
        "//gnulib/m4/extensions",
        "//gnulib/m4/multiarch",
    ],
)

autoconf(
    name = "nanosleep",
    visibility = ["//visibility:public"],
    deps = [
        ":gl_FUNC_NANOSLEEP",
    ],
)
