"""https://github.com/coreutils/gnulib/blob/1039a5f2cee3cda1c11f64a5eb3a15b2e87cd2f0/m4/wcswidth.m4"""

load("//autoconf:autoconf_toolchain.bzl", autoconf = "autoconf_cache")
load("//autoconf:checks.bzl", "checks")

autoconf(
    name = "gl_FUNC_WCSWIDTH",
    checks = [
        # gl_FUNC_WCSWIDTH checks for wcswidth function
        checks.AC_CHECK_FUNC(
            "wcswidth",
            define = "HAVE_WCSWIDTH",
        ),
        # M4: if test $ac_cv_func_wcswidth = no; then HAVE_WCSWIDTH=0; fi
        # Override the gl_WCHAR_H_DEFAULTS value of 1 when the function is
        # absent (e.g. MSVC).
        checks.AC_SUBST(
            "HAVE_WCSWIDTH",
            condition = "ac_cv_func_wcswidth",
            if_false = "0",
            if_true = "1",
        ),
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//gnulib/m4/wcwidth:gl_FUNC_WCWIDTH",  # AC_REQUIRE([gl_FUNC_WCWIDTH])
        # For test compatibility
        "//autoconf/macros/AC_CHECK_INCLUDES_DEFAULT",
    ],
)

autoconf(
    name = "wcswidth",
    visibility = ["//visibility:public"],
    deps = [
        ":gl_FUNC_WCSWIDTH",
    ],
)
