"""https://github.com/coreutils/gnulib/blob/1039a5f2cee3cda1c11f64a5eb3a15b2e87cd2f0/m4/read.m4"""

load("//autoconf:autoconf_toolchain.bzl", autoconf = "autoconf_cache")
load("//autoconf:checks.bzl", "checks")

autoconf(
    name = "gl_FUNC_READ",
    checks = [
        # gl_FUNC_READ: REPLACE_READ=1 when the MSVC invalid parameter handler
        # exists (gl_MSVC_INVAL) or non-blocking I/O is unavailable
        # (gl_NONBLOCKING_IO); both hold on native Windows and neither on
        # Linux/macOS, so the MSVC probe alone decides here.
        checks.AC_SUBST(
            "REPLACE_READ",
            condition = "ac_cv_func__set_invalid_parameter_handler",
        ),
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//gnulib/m4/msvc-inval",  # m4_ifdef([gl_MSVC_INVAL], [AC_REQUIRE([gl_MSVC_INVAL])])
        # Note: gl_UNISTD_H_DEFAULTS is a _DEFAULTS function, so we don't track it as a dependency
        # For test compatibility
        "//autoconf/macros/AC_CHECK_INCLUDES_DEFAULT",
    ],
)

# Prerequisites of lib/read.c: AC_DEFUN([gl_PREREQ_READ], [:]) - nothing to do.
autoconf(
    name = "gl_PREREQ_READ",
    checks = [],
    visibility = ["//visibility:public"],
)

autoconf(
    name = "read",
    visibility = ["//visibility:public"],
    deps = [
        ":gl_FUNC_READ",
        ":gl_PREREQ_READ",
    ],
)
