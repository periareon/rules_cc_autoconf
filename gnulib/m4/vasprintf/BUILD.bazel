"""https://github.com/coreutils/gnulib/blob/1039a5f2cee3cda1c11f64a5eb3a15b2e87cd2f0/m4/vasprintf.m4"""

load("//autoconf:autoconf_toolchain.bzl", autoconf = "autoconf_cache")
load("//autoconf:checks.bzl", "checks")

# AC_CHECK_FUNCS_ONCE([vasprintf]) plus the HAVE_VASPRINTF results shared by
# gl_FUNC_VASPRINTF and gl_REPLACE_VASPRINTF (vasprintf-posix/-gnu call the
# latter directly).
autoconf(
    name = "AC_CHECK_FUNCS_ONCE_vasprintf",
    checks = [
        checks.AC_CHECK_FUNC("vasprintf"),
        # AC_CHECK_FUNCS defines HAVE_VASPRINTF in config.h only when the
        # function is found (e.g. MSVC has no vasprintf).
        checks.AC_DEFINE(
            "HAVE_VASPRINTF",
            condition = "ac_cv_func_vasprintf",
            if_false = None,
            if_true = 1,
        ),
        # gl_REPLACE_VASPRINTF: if test $ac_cv_func_vasprintf = yes; then
        #   REPLACE_VASPRINTF=1; else HAVE_VASPRINTF=0; fi
        # gl_FUNC_VASPRINTF only calls gl_REPLACE_VASPRINTF when the function is
        # absent, so both entry points agree on HAVE_VASPRINTF (overrides the
        # gl_STDIO_H_DEFAULTS value of 1).
        checks.AC_SUBST(
            "HAVE_VASPRINTF",
            condition = "ac_cv_func_vasprintf",
            if_false = 0,
            if_true = 1,
        ),
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//autoconf/macros/AC_CHECK_INCLUDES_DEFAULT",
    ],
)

# gl_REPLACE_VASPRINTF, when invoked unconditionally (vasprintf-posix, vasprintf-gnu):
# an existing vasprintf is replaced; an absent one only sets HAVE_VASPRINTF=0.
autoconf(
    name = "gl_REPLACE_VASPRINTF",
    checks = [
        checks.AC_SUBST(
            "REPLACE_VASPRINTF",
            condition = "ac_cv_func_vasprintf",
            if_false = 0,
            if_true = 1,
        ),
    ],
    visibility = ["//visibility:public"],
    deps = [
        ":AC_CHECK_FUNCS_ONCE_vasprintf",
        ":gl_PREREQ_ASPRINTF",
        ":gl_PREREQ_VASPRINTF",
        ":gl_PREREQ_VASPRINTF_H",
        # Note: gl_STDIO_H_DEFAULTS is a _DEFAULTS function, so we don't track it as a dependency
        # For test compatibility
        "//autoconf/macros/AC_CHECK_INCLUDES_DEFAULT",
    ],
)

# Prerequisites of the vasprintf portion of lib/stdio.h.
autoconf(
    name = "gl_PREREQ_VASPRINTF_H",
    checks = [],
    visibility = ["//visibility:public"],
    deps = [
        "//gnulib/m4/extensions",  # AC_REQUIRE([AC_USE_SYSTEM_EXTENSIONS])
    ],
)

# Prerequisites of lib/vasprintf.c (empty in the m4).
autoconf(
    name = "gl_PREREQ_VASPRINTF",
    checks = [],
    visibility = ["//visibility:public"],
)

# Prerequisites of lib/asprintf.c (empty in the m4).
autoconf(
    name = "gl_PREREQ_ASPRINTF",
    checks = [],
    visibility = ["//visibility:public"],
)

# gl_FUNC_VASPRINTF: gl_REPLACE_VASPRINTF is reached only when vasprintf is
# absent, in which case it leaves REPLACE_VASPRINTF at its default of 0.
autoconf(
    name = "gl_FUNC_VASPRINTF",
    checks = [],
    visibility = ["//visibility:public"],
    deps = [
        ":AC_CHECK_FUNCS_ONCE_vasprintf",
        "//autoconf/macros/AC_CHECK_INCLUDES_DEFAULT",
        "//gnulib/m4/extensions",  # AC_REQUIRE([AC_USE_SYSTEM_EXTENSIONS]) via gl_REPLACE_VASPRINTF -> gl_PREREQ_VASPRINTF_H
    ],
)

# Umbrella mirroring the conformance configure.ac (gl_FUNC_VASPRINTF and the
# gl_PREREQ_* macros); gl_REPLACE_VASPRINTF is the unconditional-replace entry
# point used by vasprintf-posix/-gnu and is deliberately not included.
autoconf(
    name = "vasprintf",
    visibility = ["//visibility:public"],
    deps = [
        ":gl_FUNC_VASPRINTF",
        ":gl_PREREQ_ASPRINTF",
        ":gl_PREREQ_VASPRINTF",
        ":gl_PREREQ_VASPRINTF_H",
    ],
)
