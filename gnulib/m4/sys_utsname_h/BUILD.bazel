"""https://github.com/coreutils/gnulib/blob/1039a5f2cee3cda1c11f64a5eb3a15b2e87cd2f0/m4/sys_utsname_h.m4"""

load("//autoconf:autoconf_toolchain.bzl", autoconf = "autoconf_cache")
load("//autoconf:checks.bzl", "checks")
load("//gnulib:macros.bzl", gl_macros = "macros")

# Configure a replacement for <sys/utsname.h>
autoconf(
    name = "gl_SYS_UTSNAME_H",
    checks = [
        # Note: gl_SYS_UTSNAME_H_DEFAULTS is a _DEFAULTS function, so we ignore it per user's instruction
        checks.AC_CHECK_HEADER(
            "sys/utsname.h",
            name = "ac_cv_header_sys_utsname_h",
        ),
        # if test $ac_cv_header_sys_utsname_h != yes; then
        #   HAVE_SYS_UTSNAME_H=0; HAVE_STRUCT_UTSNAME=0
        # else
        #   HAVE_SYS_UTSNAME_H=1
        #   AC_CHECK_TYPES([struct utsname], [], [HAVE_STRUCT_UTSNAME=0], ...)
        # fi
        checks.AC_SUBST(
            "HAVE_SYS_UTSNAME_H",
            condition = "ac_cv_header_sys_utsname_h",
            if_false = "0",
            if_true = "1",
        ),
        checks.AC_SUBST(
            "HAVE_STRUCT_UTSNAME",
            condition = "ac_cv_type_struct_utsname",
            if_false = "0",
            if_true = "1",
        ),
    ] + gl_macros.GL_CHECK_NEXT_HEADERS(["sys/utsname.h"]) + [
        # AC_CHECK_HEADERS_ONCE (via gl_CHECK_NEXT_HEADERS) defines
        # HAVE_SYS_UTSNAME_H in config.h only when the header exists.
        checks.AC_DEFINE(
            "HAVE_SYS_UTSNAME_H",
            condition = "ac_cv_header_sys_utsname_h",
            if_false = None,
            if_true = 1,
        ),
        checks.AC_CHECK_TYPE(
            "struct utsname",
            name = "ac_cv_type_struct_utsname",
            # buildifier: leave-alone
            includes = [
                "#include <stddef.h>",
                "#include <sys/utsname.h>",
            ],
            requires = ["ac_cv_header_sys_utsname_h==1"],
        ),

        # AC_CHECK_TYPES defines HAVE_STRUCT_UTSNAME in config.h only when the
        # type exists (the check is skipped when the header is missing).
        checks.AC_DEFINE(
            "HAVE_STRUCT_UTSNAME",
            condition = "ac_cv_type_struct_utsname",
            if_false = None,
            if_true = 1,
        ),
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//gnulib/m4/include_next",  # gl_CHECK_NEXT_HEADERS([sys/utsname.h])
        # For test compatibility
        "//autoconf/macros/AC_CHECK_INCLUDES_DEFAULT",
    ],
)

# defaults - Default AC_SUBST values. Added to gnulib_toolchain.

autoconf(
    name = "gl_SYS_UTSNAME_H_DEFAULTS",
    checks = [
        checks.AC_SUBST("HAVE_UNAME", 1),
        checks.AC_SUBST("HAVE_STRUCT_UTSNAME", 1),
    ],
    visibility = ["//visibility:private"],
)

autoconf(
    name = "gl_SYS_UTSNAME_H_REQUIRE_DEFAULTS",
    checks = [
        checks.AC_SUBST("GNULIB_UNAME", 0),
    ],
    visibility = ["//visibility:private"],
    deps = [
        ":gl_SYS_UTSNAME_H_DEFAULTS",
    ],
)

autoconf(
    name = "defaults",
    visibility = ["//visibility:public"],
    deps = [
        ":gl_SYS_UTSNAME_H_REQUIRE_DEFAULTS",
    ],
)

# with_defaults - For external consumers who don't use the toolchain

# gl_SYS_UTSNAME_MODULE_INDICATOR([modulename]): gl_SYS_UTSNAME_H_REQUIRE_DEFAULTS (the
# defaults are supplied through the toolchain's :defaults target) and
# GNULIB_<module>=1 for the named module; no checks of its own.
autoconf(
    name = "gl_SYS_UTSNAME_MODULE_INDICATOR",
    checks = [],
    visibility = ["//visibility:public"],
)

autoconf(
    name = "sys_utsname_h",
    visibility = ["//visibility:public"],
    deps = [
        ":gl_SYS_UTSNAME_H",
        ":gl_SYS_UTSNAME_MODULE_INDICATOR",
    ],
)
