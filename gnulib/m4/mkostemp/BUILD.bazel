"""https://github.com/coreutils/gnulib/blob/1039a5f2cee3cda1c11f64a5eb3a15b2e87cd2f0/m4/mkostemp.m4"""

load("//autoconf:autoconf_toolchain.bzl", autoconf = "autoconf_cache")
load("//autoconf:checks.bzl", "checks")
load("//gnulib:macros.bzl", gl_macros = "macros")

autoconf(
    name = "mkostemp",
    checks = gl_macros.GL_CHECK_FUNCS_ANDROID(
        ["mkostemp"],
        includes = ["#include <stdlib.h>"],
    ) + [
        checks.AC_SUBST(
            "HAVE_MKOSTEMP",
            condition = "ac_cv_func_mkostemp",
            if_false = 0,
            if_true = 1,
        ),
        # Upstream gnulib sets this to 1 when mkostemp is unavailable, but
        # is available in a future version of Android. That state is not
        # currently modeled.
        checks.AC_SUBST("REPLACE_MKOSTEMP", 0),
    ],
    visibility = ["//visibility:public"],
    deps = [
        # AC_REQUIRE([gl_STDLIB_H_DEFAULTS]) - line 12 (ignore, it's a _DEFAULTS function)
        "//gnulib/m4/extensions",
        # Note: AC_CHECK_INCLUDES_DEFAULT is added for test compatibility
        "//autoconf/macros/AC_CHECK_INCLUDES_DEFAULT",
    ],
)
