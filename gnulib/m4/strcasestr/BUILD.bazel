"""https://github.com/coreutils/gnulib/blob/1039a5f2cee3cda1c11f64a5eb3a15b2e87cd2f0/m4/strcasestr.m4"""

load("//autoconf:autoconf_toolchain.bzl", autoconf = "autoconf_cache")
load("//autoconf:checks.bzl", "checks")

autoconf(
    name = "gl_FUNC_STRCASESTR_SIMPLE",
    checks = [
        # AC_CHECK_FUNCS([strcasestr])
        checks.AC_CHECK_FUNC(
            "strcasestr",
            define = "HAVE_STRCASESTR",
        ),

        # if test $ac_cv_func_strcasestr = no; then
        #   HAVE_STRCASESTR=0
        # fi
        # Overrides the gl_STRING_H_DEFAULTS value of 1 (e.g. MSVC has no strcasestr).
        checks.AC_SUBST(
            "HAVE_STRCASESTR",
            condition = "ac_cv_func_strcasestr",
            if_false = 0,
            if_true = 1,
        ),
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//gnulib/m4/memchr",  # AC_REQUIRE([gl_FUNC_MEMCHR])

        # Note: AC_CHECK_INCLUDES_DEFAULT is added for test compatibility
        "//autoconf/macros/AC_CHECK_INCLUDES_DEFAULT",
    ],
)

autoconf(
    name = "gl_FUNC_STRCASESTR",
    checks = select({
        "@platforms//os:macos": [
            # gl_cv_func_strcasestr_linear (AC_RUN_IFELSE) fails on macOS:
            # macOS golden expects REPLACE_STRCASESTR "1"
            checks.AC_SUBST("REPLACE_STRCASESTR", "1"),
        ],
        "//conditions:default": [],
    }),
    visibility = ["//visibility:public"],
    deps = [
        ":gl_FUNC_STRCASESTR_SIMPLE",  # AC_REQUIRE([gl_FUNC_STRCASESTR_SIMPLE])
    ],
)

# gl_PREREQ_STRCASESTR - lines 155-157 (empty)
autoconf(
    name = "gl_PREREQ_STRCASESTR",
    checks = [],
    visibility = ["//visibility:public"],
)

autoconf(
    name = "strcasestr",
    visibility = ["//visibility:public"],
    deps = [
        ":gl_FUNC_STRCASESTR",
        ":gl_FUNC_STRCASESTR_SIMPLE",
        ":gl_PREREQ_STRCASESTR",
    ],
)
