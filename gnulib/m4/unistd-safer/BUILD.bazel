"""https://github.com/coreutils/gnulib/blob/1039a5f2cee3cda1c11f64a5eb3a15b2e87cd2f0/m4/unistd-safer.m4"""

load("//autoconf:autoconf_toolchain.bzl", autoconf = "autoconf_cache")

autoconf(
    name = "gl_UNISTD_SAFER",
    checks = [],
    visibility = ["//visibility:public"],
    deps = [
        # gl_UNISTD_SAFER only calls AC_CHECK_FUNCS_ONCE([pipe]): HAVE_PIPE is a
        # config.h define here; neither gl_FUNC_PIPE nor gl_UNISTD_H_DEFAULTS
        # is required.
        "//gnulib/m4/pipe:AC_CHECK_FUNCS_ONCE_pipe",
        # For test compatibility - need basic header defines
        "//autoconf/macros/AC_CHECK_INCLUDES_DEFAULT",
    ],
)

autoconf(
    name = "unistd-safer",
    visibility = ["//visibility:public"],
    deps = [
        ":gl_UNISTD_SAFER",
    ],
)
