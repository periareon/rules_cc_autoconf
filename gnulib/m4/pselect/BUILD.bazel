"""https://github.com/coreutils/gnulib/blob/1039a5f2cee3cda1c11f64a5eb3a15b2e87cd2f0/m4/pselect.m4"""

load("//autoconf:autoconf_toolchain.bzl", autoconf = "autoconf_cache")
load("//autoconf:checks.bzl", "checks")

autoconf(
    name = "gl_FUNC_PSELECT",
    checks = [
        # AC_CHECK_FUNCS_ONCE([pselect])
        # On macOS, pselect is available
        checks.AC_CHECK_FUNC(
            "pselect",
            define = "HAVE_PSELECT",
        ),
        # if test $ac_cv_func_pselect = no || test $gl_cv_sig_pselect = no; then
        #   REPLACE_PSELECT=1
        # fi
        # (The runtime EBADF check and the signature check pass on glibc/macOS;
        # on MSVC there is no pselect at all.)
        checks.AC_SUBST(
            "REPLACE_PSELECT",
            condition = "ac_cv_func_pselect",
            if_false = "1",
            if_true = "0",
        ),
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//autoconf/macros/AC_CANONICAL_HOST",  # AC_REQUIRE([AC_CANONICAL_HOST])
        "//gnulib/m4/sys_select_h",  # AC_REQUIRE([gl_SYS_SELECT_H])
    ],
)

autoconf(
    name = "pselect",
    visibility = ["//visibility:public"],
    deps = [
        ":gl_FUNC_PSELECT",
        # For test compatibility - need basic header defines
        "//autoconf/macros/AC_CHECK_INCLUDES_DEFAULT",
    ],
)
