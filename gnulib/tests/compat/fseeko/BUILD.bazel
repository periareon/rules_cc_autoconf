load("//gnulib/tests:gnu_gnulib_diff_test_suite.bzl", "gnu_gnulib_diff_test_suite")

gnu_gnulib_diff_test_suite(
    name = "fseeko_test",
    bazel_autoconf_target = "//gnulib/m4/fseeko",
    config_h_in = "config.h.in",
    configure_ac = "configure.ac",
    known_divergences = {
        # fseeko.m4 runs gl_FUNC_FFLUSH_STDIN only when fseeko exists, so GNU
        # leaves FUNC_FFLUSH_STDIN undefined on MSVC. The port's dependency on
        # //gnulib/m4/fflush:gl_FUNC_FFLUSH_STDIN cannot be conditional, and
        # the define may have only one shape across the gnulib graph.
        "FUNC_FFLUSH_STDIN": "defined unconditionally by the shared fflush check; the m4 skips it without fseeko",
    },
    m4_files = ["@gnulib//:all_m4"],
    subst_h_in = "subst.h.in",
    test_c = "test_fseeko.c",
)
