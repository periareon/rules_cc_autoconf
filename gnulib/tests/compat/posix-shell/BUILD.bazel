load("//gnulib/tests:gnu_gnulib_diff_test_suite.bzl", "gnu_gnulib_diff_test_suite")

gnu_gnulib_diff_test_suite(
    name = "posix-shell_test",
    bazel_autoconf_target = "//gnulib/m4/posix-shell",
    config_h_in = "config.h.in",
    configure_ac = "configure.ac",
    known_divergences = {
        # gl_POSIX_SHELL tries $CONFIG_SHELL first, so GNU's answer is whatever
        # shell ran configure (the rules_shell bash); the port picks a fixed
        # per-platform shell.
        "POSIX_SHELL": "depends on the CONFIG_SHELL used to run configure",
        "PREFERABLY_POSIX_SHELL": "depends on the CONFIG_SHELL used to run configure",
    },
    m4_files = ["@gnulib//:all_m4"],
    subst_h_in = "subst.h.in",
    test_c = "test_posix-shell.c",
)
