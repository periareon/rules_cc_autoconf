load("//autoconf/tests/gnu:conformance.bzl", "gnu_autoconf_conformance_test")
load("//gnulib/tests:gnu_gnulib_diff_test_suite.bzl", "gnu_gnulib_diff_test_suite")

_WAITQUEUE = "gl_cv_func_pthread_rwlock_good_waitqueue runs a timing test on linux*-gnu* whose result varies with load; :pthread-rwlock_test_waitqueue_guess checks the port's cross-compile guess"

gnu_gnulib_diff_test_suite(
    name = "pthread-rwlock_test",
    bazel_autoconf_target = "//gnulib/m4/pthread-rwlock",
    config_h_in = "config.h.in",
    configure_ac = "configure.ac",
    known_divergences = select({
        "@platforms//os:linux": {
            "PTHREAD_RWLOCK_BAD_WAITQUEUE": _WAITQUEUE,
            "REPLACE_PTHREAD_RWLOCKATTR_INIT": _WAITQUEUE,
            "REPLACE_PTHREAD_RWLOCK_INIT": _WAITQUEUE,
        },
        "//conditions:default": {},
    }),
    m4_files = ["@gnulib//:all_m4"],
    subst_h_in = "subst.h.in",
    test_c = "test_pthread-rwlock.c",
)

# configure.ac with the wait queue test's cross-compile guess preset on
# linux*-gnu*, so every host compares the values unmasked.
gnu_autoconf_conformance_test(
    name = "pthread-rwlock_test_waitqueue_guess",
    size = "medium",
    autoconf_target = "//gnulib/m4/pthread-rwlock",
    bazel_config_h = ":pthread-rwlock_test_bazel_config_h",
    bazel_subst_h = ":pthread-rwlock_test_bazel_subst_h",
    config_h_in = "config.h.in",
    configure_ac = "configure_waitqueue_guess.ac",
    m4_files = ["@gnulib//:all_m4"],
    subst_h_in = "subst.h.in",
    verify_variables = True,
)
