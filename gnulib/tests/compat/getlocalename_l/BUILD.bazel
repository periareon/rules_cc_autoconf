load("//gnulib/tests:gnu_gnulib_diff_test_suite.bzl", "gnu_gnulib_diff_test_suite")

gnu_gnulib_diff_test_suite(
    name = "getlocalename_l_test",
    bazel_autoconf_target = "//gnulib/m4/getlocalename_l",
    config_h_in = "config.h.in",
    configure_ac = "configure.ac",
    known_divergences = {
        # Only one target may own a substitution.  REPLACE_NEWLOCALE is owned
        # by gl_FUNC_NEWLOCALE, which on macOS also reports newlocale's
        # null-base bug; gl_PREREQ_GETLOCALENAME_L_UNSAFE alone (this fixture)
        # only knows the "future OS version" case, so GNU says 0 there.
        "REPLACE_NEWLOCALE": "owned by gl_FUNC_NEWLOCALE, whose macOS null-base check this macro does not run",
    },
    m4_files = ["@gnulib//:all_m4"],
    subst_h_in = "subst.h.in",
    test_c = "test_getlocalename_l.c",
)
