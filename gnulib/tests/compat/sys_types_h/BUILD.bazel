load("//autoconf:autoconf.bzl", "autoconf")
load("//gnulib/tests:gnu_gnulib_diff_test_suite.bzl", "gnu_gnulib_diff_test_suite")

# configure.ac calls AC_HEADER_MAJOR itself, as a project would; the port
# does not carry it (upstream gl_SYS_TYPES_H never requires it).
autoconf(
    name = "sys_types_h_with_major",
    deps = [
        "//autoconf/macros/AC_HEADER_MAJOR",
        "//gnulib/m4/sys_types_h",
    ],
)

gnu_gnulib_diff_test_suite(
    name = "sys_types_h_test",
    bazel_autoconf_target = ":sys_types_h_with_major",
    config_h_in = "config.h.in",
    configure_ac = "configure.ac",
    m4_files = ["@gnulib//:all_m4"],
    subst_h_in = "subst.h.in",
    test_c = "test_sys_types_h.c",
)
