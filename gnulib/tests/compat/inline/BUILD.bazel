load("//gnulib/tests:gnu_gnulib_diff_test_suite.bzl", "gnu_gnulib_diff_test_suite")

gnu_gnulib_diff_test_suite(
    name = "inline_test",
    bazel_autoconf_target = "//gnulib/m4/inline",
    config_h_in = "config.h.in",
    configure_ac = "configure.ac",
    known_divergences = {
        # Upstream gl_INLINE also fails when __NO_INLINE__ is defined, i.e.
        # whenever the compiler runs without optimisation. The port only tests
        # the keyword so config.h does not flip between -c opt and -c fastbuild.
        "HAVE_INLINE": "port ignores __NO_INLINE__ (optimisation level); see //gnulib/m4/inline",
    },
    m4_files = ["@gnulib//:all_m4"],
    subst_h_in = "subst.h.in",
    test_c = "test_inline.c",
)
