load("//gnulib/tests:gnu_gnulib_diff_test_suite.bzl", "gnu_gnulib_diff_test_suite")

gnu_gnulib_diff_test_suite(
    name = "unlockpt_test",
    bazel_autoconf_target = "//gnulib/m4/unlockpt",
    config_h_in = "config.h.in",
    configure_ac = "configure.ac",
    known_divergences = {
        # gl_FUNC_UNLOCKPT lowers HAVE_UNLOCKPT when unlockpt is missing but only
        # AC_REQUIREs gl_UNISTD_H_DEFAULTS; the AC_SUBST lives in
        # gl_STDLIB_H_DEFAULTS, which a full gnulib configure always has.
        # Standalone GNU therefore leaves the placeholder, while the shared
        # port must substitute the lowered value for full builds.
        "HAVE_UNLOCKPT": "AC_SUBST owned by gl_STDLIB_H_DEFAULTS, which unlockpt.m4 does not require",
    },
    m4_files = ["@gnulib//:all_m4"],
    subst_h_in = "subst.h.in",
    test_c = "test_unlockpt.c",
)
