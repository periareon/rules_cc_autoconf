        "HAVE_JAVA": "AC_PATH_PROG probes the host PATH for an installed program; the Bazel port does not search the host",
        "HAVE_JAVA_IN_PATH": "AC_PATH_PROG probes the host PATH for an installed program; the Bazel port does not search the host",
        "HAVE_JRE": "AC_PATH_PROG probes the host PATH for an installed program; the Bazel port does not search the host",
        "HAVE_JRE_IN_PATH": "AC_PATH_PROG probes the host PATH for an installed program; the Bazel port does not search the host",
    },
    m4_files = ["@gnulib//:all_m4"],
    subst_h_in = "subst.h.in",
    test_c = "test_javaexec.c",
)
