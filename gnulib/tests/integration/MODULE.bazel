    module_name = "openssl",
    patch_strip = 1,
    patches = ["//patches:openssl.patch"],
)

# texlive 2026.1.bcr.1 is not on the Bazel Central Registry yet
# (https://github.com/bazelbuild/bazel-central-registry/pull/10989); this
# reproduces that registry entry: its source archive, its overlay (as an
# add-files patch) and its own patches. Replace with the plain bazel_dep once
# the PR merges.
archive_override(
    module_name = "texlive",
    integrity = "sha256-yxINMU086yOsYIrxfd0sYjr88CMx9ACg8l7q1bisHXA=",
    patch_strip = 1,
    patches = [
        "//patches:texlive_overlay.patch",
        "//patches:texlive_texk_psutils_unistd_msvc.patch",
        "//patches:texlive_utils_ps2eps_bbox_c_msvc.patch",
    ],
    strip_prefix = "texlive-20260301-source",
    urls = [
        # The mirrors from source.json come first: texlive.info is slow and
        # has handed CI a corrupt download (Bazel stops at the first checksum
        # mismatch instead of trying the next URL). mirror.bazel.build only
        # carries the archive once the registry PR merges.
        "https://ftp.tu-chemnitz.de/pub/tug/historic/systems/texlive/2026/texlive-20260301-source.tar.xz",
        "https://mirrors.tuna.tsinghua.edu.cn/tex-historic-archive/systems/texlive/2026/texlive-20260301-source.tar.xz",
        "https://mirror.nju.edu.cn/tex-historic/systems/texlive/2026/texlive-20260301-source.tar.xz",
        "https://texlive.info/historic/systems/texlive/2026/texlive-20260301-source.tar.xz",
    ],
)

