# Alternate C/C++ toolchains the integration tests also run with, each
# enabled by a `--config` in `.bazelrc`. None of these modules registers
# toolchains on its own, so without a config the default toolchain is used.

# hermeticbuild/hermetic-llvm
bazel_dep(name = "llvm", version = "0.8.24")

# hermetic-llvm trims the macOS SDK to a handful of frameworks. gnulib's
# INTL_MACOSX_LIBS links CoreServices as well ("framework not found for
# -framework CoreServices" from wget2), so it is added here. The tag's list
# replaces the module's defaults rather than extending them, hence the full
# set.
osx = use_extension("@llvm//extensions:osx.bzl", "osx")
osx.frameworks(names = [
    # hermetic-llvm defaults
    "CoreFoundation",
    "Foundation",
    "Kernel",
    "OSLog",
    "Security",
    "SystemConfiguration",
    # gnulib INTL_MACOSX_LIBS. CoreServices.tbd re-exports CFNetwork, and
    # ld64.lld refuses a stub whose re-export it cannot locate ("unable to
    # locate re-export with install name .../CFNetwork").
    "CoreServices",
    "CFNetwork",
])

# bazel-contrib/toolchains_llvm
bazel_dep(name = "toolchains_llvm", version = "1.11.2")

toolchains_llvm = use_extension("@toolchains_llvm//toolchain/extensions:llvm.bzl", "llvm")
toolchains_llvm.toolchain(
    name = "llvm_toolchain",
    # The range toolchains_llvm's own BCR test module is verified with.
    llvm_versions = {"": "latest:>=17.0.0,<20"},
)
use_repo(toolchains_llvm, "llvm_toolchain")

# rules_m4 / rules_bison toolchains backed by the BCR `m4` and `bison` modules
# built here, instead of the sources those rule sets bundle (see
# toolchains/BUILD.bazel). Root registrations win over the rule sets' own.
register_toolchains("//toolchains:all")

# The BCR overlays of these modules predate the current gnulib ports
# (GNU-faithful Windows results, conditions spelled with the upstream probe
# names) or trip over a Bazel toolchain quirk; each patch under patches/
# documents what it changes and why. Drop them as the overlays are updated.

single_version_override(
    module_name = "bison",
    patch_strip = 1,
    patches = [
