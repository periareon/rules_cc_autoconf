"""rules_cc_autoconf gnulib integrations test"""

module(
    name = "gnulib_integration_test",
)

bazel_dep(name = "rules_cc_autoconf", version = "0.24.0")
local_path_override(
    module_name = "rules_cc_autoconf",
    path = "../../..",
)

bazel_dep(name = "bazel_skylib", version = "1.9.2")
bazel_dep(name = "bison", version = "3.8.2.bcr.10")
bazel_dep(name = "ffmpeg", version = "9.0.1.beta.bcr.5")
bazel_dep(name = "flex", version = "2.6.4.bcr.7")
bazel_dep(name = "gmp", version = "6.3.0.bcr.2")
bazel_dep(name = "libgd", version = "2.3.3")
bazel_dep(name = "libmicrohttpd", version = "1.0.2.bcr.1")
bazel_dep(name = "libpcap", version = "1.10.5.bcr.3")
bazel_dep(name = "libssh2", version = "1.11.1.bcr.1")
bazel_dep(name = "libwebsockets", version = "4.5.2")
bazel_dep(name = "m4", version = "1.4.21.bcr.5")
bazel_dep(name = "mosquitto", version = "2.1.2.bcr.2")
bazel_dep(name = "patch", version = "2.8.bcr.2")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "postgres", version = "18.4")
bazel_dep(name = "readline", version = "8.3.bcr.1")
bazel_dep(name = "tcl_lang", version = "9.0.4")
bazel_dep(name = "tcpdump", version = "4.99.6")
bazel_dep(name = "tftp-hpa", version = "6.0")
bazel_dep(name = "x264", version = "2023.10.1.bcr.6")

# The BCR overlays of these modules predate GNU-faithful Windows results from
# the gnulib ports; the patches adapt them (see patches/*.patch).

single_version_override(
    module_name = "bison",
    patch_strip = 1,
    patches = ["//patches:bison.patch"],
)

single_version_override(
    module_name = "m4",
    patch_strip = 1,
    patches = ["//patches:m4.patch"],
)

single_version_override(
    module_name = "patch",
    patch_strip = 1,
    patches = ["//patches:patch.patch"],
)
