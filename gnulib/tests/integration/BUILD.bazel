# Kept manual: nvc 1.21.0.bcr.1 analyzes cleanly against HEAD (the duplicate
# PACKAGE_VERSION subst of 1.21.0 is gone), but it builds llvm-project 17
# from source, which is too expensive for every integration run.
alias(
    name = "nvc",
    actual = "@nvc",
    tags = ["manual"],
    target_compatible_with = select({
        "@platforms//os:linux": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
)

