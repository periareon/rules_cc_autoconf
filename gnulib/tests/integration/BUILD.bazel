    build_test(
        name = "{}_build_test".format(name),
        targets = [":{}".format(name)],
    )
    for name in [
        "bison",
        "ffmpeg",
        "flex",
        "gmp",
        "libgd",
        "libmicrohttpd",
        "libpcap",
        "libssh2",
        "libwebsockets",
        "m4",
        "mosquitto",
        "patch",
        "readline",
        "tcpdump",
        "tftp-hpa",
        "x264",
    ]
