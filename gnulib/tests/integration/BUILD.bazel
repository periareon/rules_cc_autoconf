load("@bazel_skylib//lib:selects.bzl", "selects")
load("@bazel_skylib//rules:build_test.bzl", "build_test")
load("@bazel_skylib//rules:common_settings.bzl", "string_flag")

# Which C++ toolchain the run was configured with; set by the matching
# `--config` in .bazelrc so targets can opt out of one toolchain on one OS.
string_flag(
    name = "toolchain",
    build_setting_default = "default",
    values = [
        "default",
        "hermetic_llvm",
        "toolchains_llvm",
    ],
)

config_setting(
    name = "hermetic_llvm",
    flag_values = {":toolchain": "hermetic_llvm"},
)

# hermetic-llvm builds Windows with clang for the MinGW ABI. Overlays whose
# Windows configuration is MSVC-shaped (and that upstream does not build for
# MinGW either) are excluded there; they still run with the MSVC toolchain.
selects.config_setting_group(
    name = "hermetic_llvm_windows",
    match_all = [
        ":hermetic_llvm",
        "@platforms//os:windows",
    ],
)

# One alias per BCR module that depends on `rules_cc_autoconf`.  Platform
# restrictions mirror each module's own BCR `presubmit.yml` platform list.

alias(
    name = "bison",
    actual = "@bison",
)

alias(
    name = "cpio",
    actual = "@cpio",
    target_compatible_with = select({
        "@platforms//os:windows": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
)

alias(
    name = "flex",
    actual = "@flex",
)

# gawk's Windows build compiles its pc/ sources with MSVC-only assumptions
# (no -Ipc for <dlfcn.h>/<langinfo.h>, MSVC-only mbrtoc32/socket shims).
alias(
    name = "gawk",
    actual = "@gawk",
    target_compatible_with = select({
        ":hermetic_llvm_windows": ["@platforms//:incompatible"],
