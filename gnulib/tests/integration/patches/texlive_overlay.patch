+cc_library(
+    name = "w2c_config",
+    hdrs = [
+        "cpascal.h",
+        "help.h",
+        "texmfmem.h",
+        "texmfmp.h",
+        "texmfmp-help.h",
+        "w2c/config.h",
+        ":w2c_c_auto_h",
+    ],
+    includes = ["."],
+    visibility = ["//:__subpackages__"],
+    deps = ["//texk/kpathsea"],
+)
