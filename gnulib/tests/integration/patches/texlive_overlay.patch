+cc_library(
+    name = "md5",
+    # md5main.c is upstream's standalone `md5main` check program (it
+    # defines its own main()); libmd5.am keeps it out of libmd5.a. It
+    # must not be in the library: link.exe resolves the entry point by
+    # searching libraries too, and picks md5main's main() over the
+    # engine's, so pdftex.exe/tex.exe would print md5main's usage.
+    srcs = glob(
+        ["libmd5/*.c"],
+        exclude = ["libmd5/md5main.c"],
