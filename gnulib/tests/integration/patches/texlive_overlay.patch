+# =============================================================================
+# omegaware/ — Omega/Aleph WEB helpers. odvicopy/odvitype use the plain
+# `tangle` path (their .web + .ch sit under omegaware/). The other four
+# (ofm2opl, opl2ofm, ovf2ovp, ovp2ovf, otangle) need `otangle` + `tie -m`
+# merges upstream — deferred pending a Bazel port of that chain.
+# =============================================================================
+
+[
+    web_utility(
+        name = name,
+        ch = "omegaware/" + name + ".ch",
+        web = "omegaware/" + name + ".web",
+    )
+    for name in [
+        "odvicopy",
+        "odvitype",
+    ]
+]
+
+# =============================================================================
+# otps/ — Omega Translation Process programs (plain C, no WEB pipeline).
+# =============================================================================
+
+[
+    cc_binary(
+        name = name,
+        srcs = srcs,
+        copts = TEXLIVE_COPTS,
+        includes = ["otps"],
+        local_defines = TEXLIVE_LOCAL_DEFINES,
+        tags = ["manual"],
+        visibility = ["//visibility:public"],
+        deps = [
+            ":web2c_lib",
+            "//texk/kpathsea",
+        ],
+    )
+    for name, srcs in [
+        (
+            "otp2ocp",
+            [
+                "otps/otp.h",
+                "otps/otp-lexer.c",
+                "otps/otp-parser.c",
+                "otps/otp-parser.h",
+                "otps/otp2ocp.c",
+                "otps/routines.c",
+                "otps/routines.h",
+                "otps/yystype.h",
+            ],
+        ),
+        (
+            "outocp",
+            [
+                "otps/otp.h",
+                "otps/outocp.c",
+                "otps/routines.h",
+            ],
+        ),
+    ]
+]
+
+# =============================================================================
+# luatex - Lua-scriptable TeX engine
+# =============================================================================
+
+# libunilib (the bundled FontForge unilib) expects a config.h that upstream
+# generates via autoconf. We provide a minimal stub: <stdbool.h> for
+# true/false, <stdint.h> for uint*_t, and <kpathsea/lib.h> for the
+# xmalloc/xrealloc/xstrdup/xcalloc declarations the unilib sources use
+# (older GCC silently warned on the implicit decls; Debian 13's GCC
+# treats `-Wimplicit-function-declaration` as a hard error).
+write_file(
+    name = "libunilib_config_h_gen",
+    out = "luatexdir/unilib/config.h",
+    content = [
+        "#ifndef _LIBUNILIB_CONFIG_H",
+        "#define _LIBUNILIB_CONFIG_H",
+        "#include <stdbool.h>",
+        "#include <stdint.h>",
+        "#include <kpathsea/lib.h>",
+        "#endif",
+        "",
+    ],
+)
+
+# Private config.h wrapper kept out of libunilib's public surface so
+# downstream consumers (libluatex etc.) do not see <config.h> from here.
+cc_library(
+    name = "libunilib_config",
+    hdrs = [":libunilib_config_h_gen"],
+    strip_include_prefix = "luatexdir/unilib",
+    deps = ["//texk/kpathsea"],
+)
+
+cc_library(
+    name = "libunilib",
+    srcs = glob(["luatexdir/unilib/*.c"]),
+    hdrs = glob(["luatexdir/unilib/*.h"]),
+    copts = TEXLIVE_COPTS + force_include_copts("config.h"),
+    implementation_deps = [":libunilib_config"],
+    strip_include_prefix = "luatexdir/unilib",
+)
+
+cc_library(
+    name = "libluatex",
+    srcs = glob(
+        [
+            "luatexdir/**/*.c",
+            "luatexdir/**/*.h",
+        ],
+        exclude = [
+            "luatexdir/unilib/**",
+            "luatexdir/luatex.c",
+        ],
+    ),
+    copts = TEXLIVE_COPTS,
+    local_defines = TEX_ENGINE_DEFINES + ["LuaTeX"],
+    tags = ["manual"],
+    deps = [
+        ":libunilib",
+        ":md5",
+        ":web2c_lib",
+        "//texk/kpathsea",
+        "@libpng//:png",
+        "@lua//:liblua",
+        "@pplib",
+        "@zlib",
+        "@zziplib",
+    ],
+)
+
+cc_binary(
+    name = "luatex",
+    srcs = ["luatexdir/luatex.c"],
+    copts = TEXLIVE_COPTS,
+    linkopts = MATH_LINKOPTS,
+    local_defines = TEX_ENGINE_DEFINES + ["LuaTeX"],
+    tags = ["manual"],
+    visibility = ["//visibility:public"],
+    deps = [":libluatex"],
+)
+
+# =============================================================================
+# luahbtex - LuaTeX with HarfBuzz
+# =============================================================================
+
+cc_binary(
+    name = "luahbtex",
+    srcs = ["luatexdir/luatex.c"],
+    copts = TEXLIVE_COPTS,
+    linkopts = MATH_LINKOPTS,
+    local_defines = TEX_ENGINE_DEFINES + [
+        "LuaTeX",
+        "LuaHBTeX",
+    ],
+    tags = ["manual"],
+    visibility = ["//visibility:public"],
+    deps = [
+        ":libluatex",
+        "@harfbuzz",
+    ],
+)
+
+# =============================================================================
+# xetex - Unicode TeX engine
+# =============================================================================
+
+cc_library(
+    name = "libxetex",
+    srcs = glob(
+        [
+            "xetexdir/*.c",
+            "xetexdir/*.cpp",
+        ],
+        exclude = [
+            "xetexdir/XeTeXFontInst_Mac.cpp",
+            "xetexdir/XeTeX_mac.c",
+        ],
+    ) + select({
+        "@platforms//os:macos": [
+            "xetexdir/XeTeXFontInst_Mac.cpp",
+            "xetexdir/XeTeX_mac.c",
+        ],
+        "//conditions:default": [],
+    }),
+    hdrs = glob(["xetexdir/*.h"]) + glob(["xetexdir/image/*.h"]),
+    copts = TEXLIVE_COPTS,
+    local_defines = TEX_ENGINE_DEFINES + ["XeTeX"],
+    tags = ["manual"],
+    deps = [
+        ":web2c_lib",
+        "//texk/kpathsea",
+        "@freetype",
+        "@harfbuzz",
+        "@libpng//:png",
+        "@pplib",
+        "@teckit//:TECkit",
+        "@zlib",
+    ],
+)
+
+# =============================================================================
+# hitex - HiTeX engine
+# =============================================================================
+
+cc_binary(
+    name = "hitex",
+    srcs = glob([
+        "hitexdir/*.c",
+        "hitexdir/*.h",
+    ]),
+    copts = TEXLIVE_COPTS,
+    linkopts = MATH_LINKOPTS,
+    local_defines = TEX_ENGINE_DEFINES + ["HiTeX"],
+    tags = ["manual"],
+    visibility = ["//visibility:public"],
+    deps = [
+        ":web2c_lib",
+        "//texk/kpathsea",
+        "@harfbuzz",
+        "@zlib",
+    ],
+)
+
+# =============================================================================
+# MetaPost library and programs
+# =============================================================================
+
+cc_library(
+    name = "libmplib",
+    srcs = glob(["mplibdir/*.c"]),
+    hdrs = glob(["mplibdir/*.h"]),
+    copts = TEXLIVE_COPTS,
+    local_defines = TEXLIVE_LOCAL_DEFINES,
+    tags = ["manual"],
+    deps = [
+        ":web2c_lib",
+        "//libs/mpfi",
+        "//texk/kpathsea",
+        "@cairo",
+        "@libpng//:png",
+        "@mpfr",
+        "@zlib",
+    ],
+)
+
+# =============================================================================
+# METAFONT
+# =============================================================================
+
+# mflua support libraries
+cc_library(
+    name = "mflualpeg",
+    srcs = glob([
+        "mfluadir/**/*.c",
+        "mfluadir/**/*.h",
+    ]),
+    copts = TEXLIVE_COPTS,
+    local_defines = TEXLIVE_LOCAL_DEFINES,
+    tags = ["manual"],
+    deps = [
+        "//texk/kpathsea",
+        "@lua//:liblua",
+    ],
+)
+
+# =============================================================================
+# Aleph
+# =============================================================================
+
+cc_library(
+    name = "libaleph",
+    srcs = glob(["alephdir/*.c"]),
+    hdrs = glob(["alephdir/*.h"]),
+    copts = TEXLIVE_COPTS,
+    local_defines = TEX_ENGINE_DEFINES + ["Aleph"],
+    tags = ["manual"],
+    deps = [
+        ":web2c_lib",
+        "//texk/kpathsea",
+    ],
+)
+
+# =============================================================================
+# Tests
+# =============================================================================
+
+[
+    genrule(
+        name = engine + "_version",
+        outs = [engine + "_version.txt"],
+        cmd = "$(execpath :{engine}) --version > $@".format(engine = engine),
+        tags = ["manual"],
+        tools = [":" + engine],
+    )
+    for engine in [
+        "luatex",
+        "luahbtex",
+        "hitex",
+    ]
+]
+
+sh_texlive_test(
+    name = "tangle_test",
+    bin = ":tangle",
+    data = ["//texk/kpathsea"] + glob(["cftests/**"]),
+    main = "tangle.test",
+    target_compatible_with = select({
+        "@platforms//os:windows": ["@platforms//:incompatible"],
+        "//conditions:default": [],
+    }),
+)
+
+# Upstream's own pdftex smoke: runs `pdftex --version` and `--help` to
+# verify the binary loads and the version banner prints. Cheap, no
+# texmf data needed — the more substantive end-to-end test is
+# `bazel build @texlive//:pdflatex_fmt`, which compiles the LaTeX
+# kernel and only succeeds if pdftex + texmf-dist work together.
+sh_texlive_test(
+    name = "pdftex_test",
+    bin = ":pdftex",
+    main = "pdftexdir/pdftex.test",
+    target_compatible_with = select({
+        "@platforms//os:windows": ["@platforms//:incompatible"],
+        "//conditions:default": [],
+    }),
+)
diff --git a/texk/web2c/web2c/BUILD.bazel b/texk/web2c/web2c/BUILD.bazel
new file mode 100644
--- /dev/null
+++ b/texk/web2c/web2c/BUILD.bazel
@@ -0,0 +1,228 @@
+"""web2c bootstrap tools - tangle, ctangle, web2c, fixwrites, splitup."""
+
+load("@bazel_skylib//rules:copy_file.bzl", "copy_file")
+load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
+load(
+    "//bazel:texlive.bzl",
+    "FLEX_MSVC_DEFINES",
+    "TEXLIVE_COPTS",
+    "TEXLIVE_LOCAL_DEFINES",
+    "ctangle_cweb",
+    "tangle_web",
+    "web2c_convert",
+)
+
+# Define files and the coerce.h tail consumed by TeX-engine pipelines in
+# the parent package.
+exports_files([
+    "common.defines",
+    "texmf.defines",
+    "mfmp.defines",
+    "coerce.h",
+])
+
+# =============================================================================
+# Step 1: Bootstrap tools from pre-distributed sources
+# =============================================================================
+
+# tangleboot: Pascal bootstrap converted to C via web2c pipeline.
+web2c_convert(
+    name = "tangleboot_c",
+    src = "//texk/web2c:tangleboot.pin",
+    outs = [
+        "tangleboot.c",
+        "tangleboot.h",
+    ],
+    defines = ["common.defines"],
+    program = "tangleboot",
+)
+
+cc_binary(
+    name = "tangleboot",
+    srcs = [":tangleboot_c"],
+    copts = TEXLIVE_COPTS,
+    local_defines = TEXLIVE_LOCAL_DEFINES,
+    deps = [
+        "//texk/kpathsea",
+        "//texk/web2c:web2c_lib",
+    ],
+)
+
+# ctangleboot: built from pre-distributed .cin files (C bootstrap).
+copy_file(
+    name = "copy_ctangleboot_c",
+    src = "//texk/web2c:ctangleboot.cin",
+    out = "ctangleboot.c",
+)
+
+copy_file(
+    name = "copy_cwebboot_c",
+    src = "//texk/web2c:cwebboot.cin",
+    out = "cwebboot.c",
+)
+
+cc_binary(
+    name = "ctangleboot",
+    srcs = [
+        ":copy_ctangleboot_c",
+        ":copy_cwebboot_c",
+    ],
+    copts = TEXLIVE_COPTS,
+    local_defines = TEXLIVE_LOCAL_DEFINES,
+    deps = [
+        "//texk/kpathsea",
+        "//texk/web2c:w2c_config",
+        "//texk/web2c:web2c_lib",
+    ],
+)
+
+# web2c tool: Pascal-to-C converter (from pre-generated parser/lexer).
+cc_binary(
+    name = "web2c_tool",
+    srcs = [
+        "coerce.h",
+        "kps.c",
+        "main.c",
+        "web2c.h",
+        "web2c-lexer.c",
+        "web2c-parser.c",
+        "web2c-parser.h",
+    ],
+    copts = TEXLIVE_COPTS,
+    local_defines = TEXLIVE_LOCAL_DEFINES + FLEX_MSVC_DEFINES,
+    visibility = ["//visibility:public"],
+    deps = [
+        "//texk/kpathsea",
+        "//texk/web2c:w2c_config",
+    ],
+)
+
+# fixwrites: post-processes web2c output.
+cc_binary(
+    name = "fixwrites",
+    srcs = ["fixwrites.c"],
+    copts = TEXLIVE_COPTS,
+    visibility = ["//visibility:public"],
+    deps = ["//texk/web2c:w2c_config"],
+)
+
+# splitup: splits large generated C files.
+cc_binary(
+    name = "splitup",
+    srcs = ["splitup.c"],
+    copts = TEXLIVE_COPTS,
+    visibility = ["//visibility:public"],
+    deps = ["//texk/web2c:w2c_config"],
+)
+
+# makecpool: generates string pool files.
+cc_binary(
+    name = "makecpool",
+    srcs = ["makecpool.c"],
+    copts = TEXLIVE_COPTS,
+    visibility = ["//visibility:public"],
+)
+
+# tie: combines a master WEB source with multiple change files. The upstream
+# tie.c hard-codes max_file_index=9, which is too low for engines like
+# pdftex/luatex that stack 18+ change files. tie-w2c.ch lifts that to 32,
+# so we re-tangle tie.w with the change file rather than using the
+# pre-distributed tie.c.
+ctangle_cweb(
+    name = "tie_c_gen",
+    out = "tie.c",
+    ch = "//texk/web2c:tiedir/tie-w2c.ch",
+    w_file = "//texk/web2c:tiedir/tie.w",
+)
+
+cc_binary(
+    name = "tie",
+    srcs = [":tie_c_gen"],
+    copts = TEXLIVE_COPTS,
+    local_defines = TEXLIVE_LOCAL_DEFINES,
+    visibility = ["//visibility:public"],
+    deps = [
+        "//texk/kpathsea",
+        "//texk/web2c:web2c_lib",
+    ],
+)
+
+# =============================================================================
+# Step 2: Build real tangle from tangle.web
+# =============================================================================
+
+tangle_web(
+    name = "tangle_p",
+    ch = "//texk/web2c:tangle.ch",
+    tangle_tool = ":tangleboot",
+    web = "//texk/web2c:tangle.web",
+)
+
+web2c_convert(
+    name = "tangle_c_gen",
+    src = ":tangle_p",
+    outs = [
+        "tangle.c",
+        "tangle.h",
+    ],
+    defines = ["common.defines"],
+    program = "tangle",
+)
+
+cc_binary(
+    name = "tangle",
+    srcs = [":tangle_c_gen"],
+    copts = TEXLIVE_COPTS,
+    local_defines = TEXLIVE_LOCAL_DEFINES,
+    visibility = ["//texk/web2c:__subpackages__"],
+    deps = [
+        "//texk/kpathsea",
+        "//texk/web2c:web2c_lib",
+    ],
+)
+
+# =============================================================================
+# Step 3: Build real ctangle from CWEB sources
+# =============================================================================
+
+# Bootstrap: use ctangleboot (not the ctangle_cweb rule, which depends on
+# the final ctangle binary we're building here).
+ctangle_cweb(
+    name = "ctangle_c_gen",
+    out = "ctangle_gen.c",
+    ch = "//texk/web2c:cwebdir/ctang-w2c.ch",
+    ctangle_tool = ":ctangleboot",
+    extra_srcs = [
+        "//texk/web2c:cwebdir/comm-w2c.h",
+        "//texk/web2c:cwebdir/iso_types.w",
+    ],
+    w_file = "//texk/web2c:cwebdir/ctangle.w",
+)
+
+ctangle_cweb(
+    name = "cweb_c_gen",
+    out = "cweb_gen.c",
+    ch = "//texk/web2c:cwebdir/comm-w2c.ch",
+    ctangle_tool = ":ctangleboot",
+    extra_srcs = [
+        "//texk/web2c:cwebdir/comm-w2c.h",
+        "//texk/web2c:cwebdir/iso_types.w",
+    ],
+    w_file = "//texk/web2c:cwebdir/common.w",
+)
+
+cc_binary(
+    name = "ctangle",
+    srcs = [
+        ":ctangle_c_gen",
+        ":cweb_c_gen",
+    ],
+    copts = TEXLIVE_COPTS,
+    local_defines = TEXLIVE_LOCAL_DEFINES,
+    visibility = ["//texk/web2c:__subpackages__"],
+    deps = [
+        "//texk/kpathsea",
+        "//texk/web2c:w2c_config",
+        "//texk/web2c:web2c_lib",
+    ],
+)
diff --git a/texk/xdvipsk/BUILD.bazel b/texk/xdvipsk/BUILD.bazel
new file mode 100644
--- /dev/null
+++ b/texk/xdvipsk/BUILD.bazel
@@ -0,0 +1,57 @@
+load("@rules_cc//cc:cc_library.bzl", "cc_library")
+load("//bazel:texlive.bzl", "force_include_copts", "texk_program")
+
+# otflib is xdvipsk's bundled OpenType Font library (font subsetting code).
+# Not in BCR — built as part of xdvipsk here. Its .c files do
+# `#include "xdvips.h"` from the parent dir, so we expose that header here
+# and surface the parent dir on the include path.
+cc_library(
+    name = "otflib",
+    srcs = glob(["otflib/*.c"]),
+    hdrs = glob(["otflib/*.h"]) + [
+        "config.h",
+        "debug.h",
+        "paths.h",
+        "protos.h",
+        "protos_add.h",
+        "xdvips.h",
+    ],
+    copts = ["-w"] + force_include_copts("texlive-c-auto.h"),
+    includes = [
+        ".",
+        "otflib",
+    ],
+    local_defines = [
+        "HAVE_CONFIG_H",
+        "XDVIPSK",
+        "UNIX",
+        "KPATHSEA",
+    ],
+    tags = ["manual"],
+    deps = [
+        "//:common_config",
+        "//texk/kpathsea",
+    ],
+)
+
+texk_program(
+    name = "xdvipsk",
+    srcs = glob(["*.c"]),
+    hdrs = glob(["*.h"]),
+    copts = force_include_copts("texlive-c-auto.h"),
+    local_defines = [
+        "XDVIPSK",
+        "SHIFTLOWCHARS",
+    ],
+    tags = ["manual"],  # depends on otflib & has its own TL_VERSION header issues
+    deps = [
+        ":otflib",
+        "//:common_config",
+        "@freetype",
+        "@libjpeg_turbo//:jpeg",
+        "@libpng//:png",
+        "@libtiff//:tiff",
+        "@lua//:liblua",
+        "@zlib",
+    ],
+)
