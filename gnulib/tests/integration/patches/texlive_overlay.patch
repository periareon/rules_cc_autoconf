diff --git a/texk/psutils/BUILD.bazel b/texk/psutils/BUILD.bazel
new file mode 100644
--- /dev/null
+++ b/texk/psutils/BUILD.bazel
@@ -0,0 +1,107 @@
+load("@bazel_skylib//rules:write_file.bzl", "write_file")
+load("@rules_cc//cc:cc_library.bzl", "cc_library")
+load("//bazel:texlive.bzl", "force_include_copts", "texk_program")
+
+# Upstream's binary-io.h is empty and `set_binary_mode` is supplied by
+# gnulib on Windows. On POSIX, stdin/stdout are already binary-safe, so a
+# no-op is correct.
+write_file(
+    name = "binary_io_shim",
+    out = "binary-io-shim.h",
+    content = [
+        "#ifndef BINARY_IO_SHIM_H",
+        "#define BINARY_IO_SHIM_H",
+        "static inline int set_binary_mode(int fd, int mode) {",
+        "    (void)fd; (void)mode;",
+        "    return 0;",
+        "}",
+        "#endif",
+        "",
+    ],
+)
+
+# Bazel equivalent of upstream's autoheader-generated config.h. The
+# guard + trailing `#include <texlive.h>` mirrors what
+# texk/psutils/configure.ac injects via AH_TOP/AH_BOTTOM into
+# config.h.in. We have no AC_CHECK_HEADERS probes of our own, so the
+# middle "Define to 1 if you have ..." block is empty.
+#
+# The progname.h declarations are inlined here (rather than via
+# `#include "progname.h"`) because Bazel's -I order resolves the bare
+# include to kpathsea's identically-named header instead of the TL
+# wrapper's. Mirrored verbatim from texk/psutils/progname.h.
+write_file(
+    name = "psutils_config_h",
+    out = "psutils_config.h",
+    content = [
+        "#ifndef _PSUTILS_CONFIG_H",
+        "#define _PSUTILS_CONFIG_H 1",
+        "",
+        "#include <texlive.h>",
+        "",
+        "extern const char *program_name;",
+        "extern void set_program_name(const char *argv0);",
+        "",
+        "#endif /* _PSUTILS_CONFIG_H */",
+        "",
+    ],
+)
+
+cc_library(
+    name = "libpsutils",
+    srcs = [
+        "paper-size.c",
+        "progname.c",
+        "psutils-src/psspec.c",
+        "psutils-src/psutil.c",
+        "verror.c",
+    ],
+    hdrs = [
+        "binary-io.h",
+        "progname.h",
+        "psutils-src/psspec.h",
+        "psutils-src/psutil.h",
+        "texlive.h",
+        "verror.h",
+        "xvasprintf.h",
+        ":binary_io_shim",
+        ":psutils_config_h",
+    ],
+    copts = ["-w"] + force_include_copts("psutils_config.h"),
+    includes = [
+        ".",
+        "psutils-src",
+    ],
+    deps = [
+        "//texk/kpathsea",
+        "@libpaper",
+    ],
+)
+
+[
+    texk_program(
+        name = prog,
+        srcs = ["psutils-src/" + prog + ".c"],
+        copts = force_include_copts("binary-io-shim.h") +
+                force_include_copts("psutils_config.h"),
+        local_defines = select({
+            "@platforms//os:windows": [],
+            "//conditions:default": ["O_BINARY=0"],
+        }),
+        deps = [":libpsutils"],
+    )
+    for prog in [
+        "epsffit",
+        "psbook",
+        "psnup",
+        "psresize",
+        "psselect",
+        "pstops",
+    ]
+]
+
+alias(
+    name = "psutils",
+    actual = ":pstops",
+    visibility = ["//visibility:public"],
+)
diff --git a/texk/ptexenc/BUILD.bazel b/texk/ptexenc/BUILD.bazel
new file mode 100644
--- /dev/null
+++ b/texk/ptexenc/BUILD.bazel
@@ -0,0 +1,93 @@
+"""ptexenc - Japanese TeX encoding library."""
+
+load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
+load("@rules_cc//cc:cc_library.bzl", "cc_library")
+load("@rules_cc_autoconf//autoconf:autoconf_hdr.bzl", "autoconf_hdr")
+load("//bazel:texlive.bzl", "force_include_copts")
+
+autoconf_hdr(
+    name = "c_auto_h",
+    out = "ptexenc/c-auto.h",
+    template = "c-auto.in",
+    deps = ["//:configure"],
+)
+
+cc_library(
+    name = "ptexenc",
+    srcs = [
+        "kanjicnv.c",
+        "ptexenc.c",
+        "unicode.c",
+        "unicode-jp.c",
+    ],
+    hdrs = [
+        "jisx0208.h",
+        "ptexenc/kanjicnv.h",
+        "ptexenc/ptexenc.h",
+        "ptexenc/unicode.h",
+        "ptexenc/unicode-jp.h",
+        "tex8benc.h",
+    ] + [":c_auto_h"],
+    copts = select({
+        "@rules_cc//cc/compiler:clang-cl": ["/w"],
+        "@rules_cc//cc/compiler:msvc-cl": ["/w"],
+        "//conditions:default": ["-w"],
+    }),
+    # NO_PTENC_DLL forces PTENCDLL to expand to nothing so MSVC consumers
+    # stop emitting __declspec(dllimport) for ptexenc symbols (static
+    # linking — we don't ship a ptexenc.dll). Mirrors NO_KPSE_DLL in
+    # //texk/kpathsea.
+    defines = select({
+        "@rules_cc//cc/compiler:clang-cl": ["NO_PTENC_DLL"],
+        "@rules_cc//cc/compiler:msvc-cl": ["NO_PTENC_DLL"],
+        "//conditions:default": [],
+    }),
+    include_prefix = "ptexenc",
+    includes = ["."],
+    local_defines = [
+        "HAVE_CONFIG_H",
+        "KPATHSEA",
+        "PTEXENC",
+    ] + select({
+        "//:kanji_iconv_enabled": ["KANJI_ICONV=1"],
+        "//conditions:default": [],
+    }),
+    strip_include_prefix = ".",
+    visibility = ["//visibility:public"],
+    deps = ["//texk/kpathsea"],
+)
+
+cc_binary(
+    name = "ptekf",
+    srcs = ["ptekf.c"],
+    # TL_VERSION comes from a force-included header instead of a -D
+    # copt because Bazel/cl.exe response-file quoting eats whitespace
+    # in string-valued defines.
+    copts = select({
+        "@rules_cc//cc/compiler:clang-cl": ["/w"],
+        "@rules_cc//cc/compiler:msvc-cl": ["/w"],
+        "//conditions:default": ["-w"],
+    }) + force_include_copts("tl_strings.h"),
+    # WIN32 must be set for ptekf's `#if defined(_WIN32)` branch to
+    # reach the kpathsea_instance fields declared under `#if defined
+    # (WIN32)` in kpathsea/types.h (File_system_codepage,
+    # Is_cp932_system, etc.). texk_program callers get this from
+    # TEXLIVE_LOCAL_DEFINES; ptekf is a plain cc_binary so we set it
+    # here directly.
+    local_defines = ["HAVE_CONFIG_H"] + select({
+        "@platforms//os:windows": ["WIN32"],
+        "//conditions:default": [],
+    }),
+    visibility = ["//visibility:public"],
+    deps = [
+        ":ptexenc",
+        "//bazel:tl_strings",
+    ],
+)
+
+genrule(
+    name = "ptekf_version",
+    outs = ["ptekf_version.txt"],
+    cmd = "$(execpath :ptekf) --version > $@",
+    tools = [":ptekf"],
+)
