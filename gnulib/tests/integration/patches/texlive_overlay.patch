+        "lib/coredump.c",
+        "lib/eofeoln.c",
+        "lib/fprintreal.c",
+        "lib/input2int.c",
+        "lib/inputint.c",
+        "lib/main.c",
+        "lib/openclose.c",
+        "lib/printversion.c",
+        "lib/setupvar.c",
+        "lib/uexit.c",
+        "lib/usage.c",
+        "lib/version.c",
