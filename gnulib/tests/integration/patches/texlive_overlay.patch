+cc_binary(
+    name = "tex",
+    srcs = ["texextra.c"],
+    copts = TEXLIVE_COPTS,
+    linkopts = MATH_LINKOPTS + IPC_LINKOPTS,
+    local_defines = TEX_ENGINE_DEFINES + [
+        "TeX",
+        "__SyncTeX__",
+    ] + engine_main_defines("tex"),
+    tags = ["manual"],
+    visibility = ["//visibility:public"],
+    deps = [":libtex"],
