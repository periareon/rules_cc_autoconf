+    "enctexdir/enctex-pdftex.ch",
+    "enctexdir/enctex-tex.ch",
+
+    # SyncTeX change files referenced by various engines. The .ch0/.ch1/.ch2
+    # suffix is the patch level: lower numbers apply first, higher numbers
+    # clean up "REMOVE ME" sentinels from the lower-numbered ones.
+    "synctexdir/synctex-def.ch0",
+    "synctexdir/synctex-mem.ch0",
+    "synctexdir/synctex-mem.ch2",
+    "synctexdir/synctex-e-mem.ch0",
+    "synctexdir/synctex-e-mem.ch1",
