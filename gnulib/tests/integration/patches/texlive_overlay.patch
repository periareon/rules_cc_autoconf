diff --git a/texk/bibtex-x/BUILD.bazel b/texk/bibtex-x/BUILD.bazel
new file mode 100644
--- /dev/null
+++ b/texk/bibtex-x/BUILD.bazel
@@ -0,0 +1,44 @@
+load("@bazel_skylib//rules:write_file.bzl", "write_file")
+load("@rules_cc//cc:cc_library.bzl", "cc_library")
+load("//bazel:texlive.bzl", "force_include_copts", "texk_program")
+
+# IMPLEMENTATION + BANNER values contain whitespace; passing them via
+# -D copts triggers Bazel/cl.exe response-file quoting bugs. Emit them
+# as a force-includable header so the quotes are just plain C source.
+write_file(
+    name = "bibtex8_strings_h",
+    out = "bibtex8_strings.h",
+    content = [
+        "#ifndef BIBTEX8_STRINGS_H",
+        "#define BIBTEX8_STRINGS_H",
+        '#define IMPLEMENTATION "C99 (8 bit)"',
+        '#define BANNER "This is 8-bit Big BibTeX"',
+        "#endif",
+        "",
+    ],
+)
+
+cc_library(
+    name = "bibtex8_strings",
+    hdrs = [":bibtex8_strings_h"],
+    includes = ["."],
+)
+
+texk_program(
+    name = "bibtex8",
+    srcs = glob(["*.c"]),
+    hdrs = glob(["*.h"]),
+    copts = force_include_copts("bibtex8_strings.h"),
+    # Without SUPPORT_8BIT, bibtex8 ships a crippled 7-bit build. Upstream
+    # bibtex-x/Makefile.am unconditionally sets this for the bibtex8 binary.
+    local_defines = [
+        "SUPPORT_8BIT",
+        "VERSION=\\\"3.71\\\"",
+        "EXT_VERSION=\\\"3.71\\\"",
+    ],
+    deps = [":bibtex8_strings"],
+)
+
+# bibtexu uses ICU's ustdio.h (icuio) which has no upstream Bazel target.
+# TODO: Add an icuio cc_library overlay to the ICU module, or build icuio
+# from TeX Live's bundled ICU source. For now, bibtexu is excluded.
diff --git a/texk/chktex/BUILD.bazel b/texk/chktex/BUILD.bazel
new file mode 100644
--- /dev/null
+++ b/texk/chktex/BUILD.bazel
@@ -0,0 +1,30 @@
+load("//bazel:texlive.bzl", "force_include_copts", "texk_program")
+
+texk_program(
+    name = "chktex",
+    srcs = glob(["chktex-src/*.c"]),
+    hdrs = glob(["chktex-src/*.h"]),
+    copts = force_include_copts("texlive-c-auto.h"),
+    # Upstream pins the POSIX-ERE regex backend (HAVE_POSIX_ERE) and
+    # explicitly disables PCRE (HAVE_PCRE=0); without these FindErrs.c's
+    # backend selection is undefined.
+    local_defines = [
+        "HAVE_CONFIG_H",
+        "TEX_LIVE",
+        "HAVE_POSIX_ERE",
+        "HAVE_PCRE=0",
+        "VERSION=\\\"1.7.9\\\"",
+        "PACKAGE_VERSION=\\\"1.7.9\\\"",
+        "CONFIG_H_NAME=\\\"texlive-c-auto.h\\\"",
+    ],
+    # FindErrs.c needs <regex.h> for POSIX ERE. MSVC ships neither
+    # <regex.h> nor PCRE; MinGW does provide regex via its CRT, so the
+    # gate is compiler-level, not OS-level. Bundling regex / PCRE
+    # would be a large dependency add for a single linter.
+    target_compatible_with = select({
+        "@rules_cc//cc/compiler:clang-cl": ["@platforms//:incompatible"],
+        "@rules_cc//cc/compiler:msvc-cl": ["@platforms//:incompatible"],
+        "//conditions:default": [],
+    }),
+    deps = ["//:common_config"],
+)
