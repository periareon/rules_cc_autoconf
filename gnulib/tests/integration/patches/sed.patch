# sed 4.10: the overlay pinned -std=gnu11 (/std:c11) on sed's sources while
# the gnulib ports' probes ran under the build's standard; on macOS the two
# disagreed about c32rtomb's declaration and the overlay hard-coded
# HAVE_C32RTOMB per platform to paper over it.  The standard of a build is
# the root module's (the toolchain's default, --copt): the pin is dropped,
# the c32rtomb port's own probe is used, and the C11 requirement upstream's
# AC_PROG_CC enforces becomes a check that stops the build with the flag to
# add when it is not met.
#
#
# The gl_FUNC_ACL port probes acl_entries itself and provides the
# NEED_ACL_ENTRIES variable gnulib.mk reads, so the overlay's own probe and
# subst would be second producers and are dropped.
#
# Remove once the overlay on the Bazel Central Registry is updated.
# Defaults as the converter generates them: `defaults = True` is gone (the
# autoconf toolchain carries no defaults any more) and the main autoconf
# target reads the headers' `:defaults` the configure script AC_REQUIREs
# through `default_deps = GNULIB_M4_DEFAULT_DEPS`.
--- a/BUILD.bazel
+++ b/BUILD.bazel
@@ -45,17 +45,13 @@
     flag_values = {":enable_i18n": "True"},
 )
 
+# No -std: sed needs C11 (`static_assert` via <assert.h> in localeinfo.c and
+# other gnulib sources), which `:autoconf` checks for; the standard itself is
+# the build's, so that the gnulib probes and these sources see the same
+# headers.
 COPTS = select({
-    # Sed requires C11+ for `static_assert` via <assert.h> in several gnulib
-    # sources (localeinfo.c etc.).
-    "@rules_cc//cc/compiler:msvc-cl": [
-        "/w",
-        "/std:c11",
-    ],
-    "//conditions:default": [
-        "-w",
-        "-std=gnu11",
-    ],
+    "@rules_cc//cc/compiler:msvc-cl": ["/w"],
+    "//conditions:default": ["-w"],
 })
 
 LOCAL_DEFINES = [
@@ -95,24 +91,16 @@
     }),
 )
 
-# Upstream's gl_CHECK_FUNC_C32RTOMB probes c32rtomb at the autoconf toolchain's
-# own compile flags rather than the consumer's; on macOS, libSystem's <uchar.h>
-# hides the c32rtomb prototype unless a feature-test macro is set that
-# -std=gnu11 doesn't activate, so the probe says "available" but sed's TU
-# can't see the decl.  We sidestep the probe and pin HAVE_C32RTOMB from
-# platform knowledge: Linux glibc has it; macOS at gnu11 doesn't expose the
-# decl; MSVC has no <uchar.h> at all.  Other substs/cache vars come from the
-# toolchain defaults + mbrtoc32's transitive :gl_C32RTOMB_SANITYCHECK dep.
+# gl_FUNC_C32RTOMB (m4/c32rtomb.m4).  The port's probes run under the same
+# flags as sed's own sources -- the toolchain's and the command line's,
+# since neither pins a C standard -- so what they see in <uchar.h> is what
+# the sources will see.  (An earlier overlay compiled the sources under
+# -std=gnu11 while the probes ran without it, and had to pin HAVE_C32RTOMB
+# from platform knowledge to keep the two from disagreeing on macOS.)
 autoconf(
     name = "m4_c32rtomb",
-    checks = select({
-        "@platforms//os:linux": [
-            checks.AC_SUBST("HAVE_C32RTOMB", 1),
-        ],
-        "//conditions:default": [
-            checks.AC_SUBST("HAVE_C32RTOMB", 0),
-        ],
-    }),
+    checks = [],
+    deps = ["@rules_cc_autoconf//gnulib/m4/c32rtomb"],
 )
 
 # Gnulib m4 module deps (from gnulib-comp.m4)
@@ -375,6 +363,42 @@
     "@rules_cc_autoconf//gnulib/m4/zzgnulib",
 ]
 
+# The gl_<HEADER>_H_DEFAULTS the configure script AC_REQUIREs: the headers' `:defaults`,
+# read beneath the results (a probe of the same name overrides a default).
+GNULIB_M4_DEFAULT_DEPS = [
+    "@rules_cc_autoconf//gnulib/m4/arpa_inet_h:defaults",
+    "@rules_cc_autoconf//gnulib/m4/ctype_h:defaults",
+    "@rules_cc_autoconf//gnulib/m4/dirent_h:defaults",
+    "@rules_cc_autoconf//gnulib/m4/fcntl_h:defaults",
+    "@rules_cc_autoconf//gnulib/m4/inttypes:defaults",
+    "@rules_cc_autoconf//gnulib/m4/langinfo_h:defaults",
+    "@rules_cc_autoconf//gnulib/m4/locale_h:defaults",
+    "@rules_cc_autoconf//gnulib/m4/math_h:defaults",
+    "@rules_cc_autoconf//gnulib/m4/pthread_h:defaults",
+    "@rules_cc_autoconf//gnulib/m4/sched_h:defaults",
+    "@rules_cc_autoconf//gnulib/m4/signal_h:defaults",
+    "@rules_cc_autoconf//gnulib/m4/stddef_h:defaults",
+    "@rules_cc_autoconf//gnulib/m4/stdio_h:defaults",
+    "@rules_cc_autoconf//gnulib/m4/stdlib_h:defaults",
+    "@rules_cc_autoconf//gnulib/m4/string_h:defaults",
+    "@rules_cc_autoconf//gnulib/m4/sys_ioctl_h:defaults",
+    "@rules_cc_autoconf//gnulib/m4/sys_random_h:defaults",
+    "@rules_cc_autoconf//gnulib/m4/sys_select_h:defaults",
+    "@rules_cc_autoconf//gnulib/m4/sys_socket_h:defaults",
+    "@rules_cc_autoconf//gnulib/m4/sys_stat_h:defaults",
+    "@rules_cc_autoconf//gnulib/m4/sys_time_h:defaults",
+    "@rules_cc_autoconf//gnulib/m4/sys_types_h:defaults",
+    "@rules_cc_autoconf//gnulib/m4/sys_uio_h:defaults",
+    "@rules_cc_autoconf//gnulib/m4/time_h:defaults",
+    "@rules_cc_autoconf//gnulib/m4/uchar_h:defaults",
+    "@rules_cc_autoconf//gnulib/m4/unicase_h:defaults",
+    "@rules_cc_autoconf//gnulib/m4/unictype_h:defaults",
+    "@rules_cc_autoconf//gnulib/m4/uninorm_h:defaults",
+    "@rules_cc_autoconf//gnulib/m4/unistd_h:defaults",
+    "@rules_cc_autoconf//gnulib/m4/wchar_h:defaults",
+    "@rules_cc_autoconf//gnulib/m4/wctype_h:defaults",
+]
+
 # Gnulib header module deps not already in GNULIB_M4_DEPS.
 # The autoconf_hdr rules use defaults=True for toolchain-level defaults.
 GNULIB_HDR_DEPS = [
@@ -554,7 +578,9 @@
