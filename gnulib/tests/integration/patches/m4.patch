# Windows (MSVC) fixes for the m4 1.4.21.bcr.5 overlay: gnulib compiles a
# replacement source when HAVE_X = 0 || REPLACE_X = 1, but the overlay only
# checks REPLACE_X; the cache variables of the probes are used where the HAVE_*
# name is published both as define and as subst. REPLACE_FCHDIR is referenced
# through its cache name (the bare name also matches the gl_UNISTD_H_DEFAULTS
# subst). fdopen and write are tests-only gnulib modules in GNU m4, so their
# indicators are 0. mbrtowc.c, localename-unsafe.c and bcrypt.lib are needed by
# REPLACE_MBRTOWC, REPLACE_SETLOCALE and getrandom on MSVC.
--- a/BUILD.bazel
+++ b/BUILD.bazel
@@ -158,7 +158,7 @@
 
         # gl_STDIO_MODULE_INDICATOR (AC_SUBST for stdio.in.h)
         checks.AC_SUBST("GNULIB_FCLOSE", 1),
-        checks.AC_SUBST("GNULIB_FDOPEN", 1),
+        checks.AC_SUBST("GNULIB_FDOPEN", 0),
         checks.AC_SUBST("GNULIB_FFLUSH", 1),
         checks.AC_SUBST("GNULIB_FGETC", 1),
         checks.AC_SUBST("GNULIB_FGETS", 1),
@@ -213,7 +213,7 @@
         checks.AC_SUBST("GNULIB_RMDIR", 1),
         checks.AC_SUBST("GNULIB_SLEEP", 1),
         checks.AC_SUBST("GNULIB_SYMLINK", 1),
-        checks.AC_SUBST("GNULIB_WRITE", 1),
+        checks.AC_SUBST("GNULIB_WRITE", 0),
         checks.AC_SUBST("GNULIB_UNISTD_H_GETOPT", 1),
         checks.AC_SUBST("GNULIB_FTRUNCATE", 1),
 
@@ -850,18 +850,18 @@
         "lib/btowc.c": "REPLACE_BTOWC",
         "lib/canonicalize-lgpl.c": "REPLACE_CANONICALIZE_FILE_NAME",
         "lib/close.c": "REPLACE_CLOSE",
-        "lib/closedir.c": "REPLACE_CLOSEDIR",
-        "lib/dirfd.c": "REPLACE_DIRFD",
+        "lib/closedir.c": "!_gl_have_closedir || REPLACE_CLOSEDIR",
+        "lib/dirfd.c": "(!ac_cv_func_dirfd && !gl_cv_func_dirfd_macro) || REPLACE_DIRFD",
         "lib/dup.c": "REPLACE_DUP",
         "lib/dup2.c": "REPLACE_DUP2",
-        "lib/fchdir.c": "REPLACE_FCHDIR",
+        "lib/fchdir.c": "ac_cv_define_REPLACE_FCHDIR",
         "lib/fclose.c": "REPLACE_FCLOSE",
-        "lib/fcntl.c": "REPLACE_FCNTL",
+        "lib/fcntl.c": "!ac_cv_func_fcntl || REPLACE_FCNTL",
         "lib/fdopendir.c": "REPLACE_FDOPENDIR",
         "lib/fflush.c": "REPLACE_FFLUSH",
         "lib/fopen.c": "REPLACE_FOPEN",
         "lib/fpending.c": "COMPILE_FPENDING",
-        "lib/fpurge.c": "REPLACE_FPURGE",
+        "lib/fpurge.c": "!ac_cv_func_fpurge || REPLACE_FPURGE",
         "lib/free.c": "REPLACE_FREE",
         "lib/fseek.c": "REPLACE_FSEEK",
         "lib/fseeko.c": "gl_cv_func_fseeko==0 || REPLACE_FSEEKO==1",
@@ -871,7 +871,7 @@
         "lib/ftell.c": "REPLACE_FTELL",
         "lib/ftello.c": "gl_cv_func_ftello==0 || REPLACE_FTELLO==1",
         "lib/getcwd.c": "REPLACE_GETCWD",
-        "lib/getdtablesize.c": "REPLACE_GETDTABLESIZE",
+        "lib/getdtablesize.c": "!ac_cv_func_getdtablesize || REPLACE_GETDTABLESIZE",
         "lib/getopt.c": "COMPILE_GETOPT",
         "lib/getopt1.c": "COMPILE_GETOPT",
         "lib/getprogname.c": "COMPILE_GETPROGNAME",
@@ -879,34 +879,38 @@
         "lib/iconv.c": "REPLACE_ICONV",
         "lib/iconv_close.c": "REPLACE_ICONV",
         "lib/iconv_open.c": "REPLACE_ICONV_OPEN",
+        "lib/isnand.c": "!gl_cv_func_isnand_no_libm",
+        "lib/isnanf.c": "!gl_cv_func_isnanf_no_libm || !gl_cv_func_isnanf_works",
+        "lib/isnanl.c": "!gl_cv_func_isnanl_no_libm || !gl_cv_func_isnanl_works",
         "lib/lseek.c": "REPLACE_LSEEK",
         "lib/lstat.c": "REPLACE_LSTAT",
         "lib/mbrtoc32.c": "COMPILE_MBRTOC32",
-        "lib/mbrtowc.c": "COMPILE_MBRTOWC",
+        "lib/mbrtowc.c": "COMPILE_MBRTOWC || REPLACE_MBRTOWC",
         "lib/mbsinit.c": "REPLACE_MBSINIT",
         "lib/mbtowc.c": "REPLACE_MBTOWC",
         "lib/memchr.c": "REPLACE_MEMCHR",
         "lib/mempcpy.c": "COMPILE_MEMPCPY",
