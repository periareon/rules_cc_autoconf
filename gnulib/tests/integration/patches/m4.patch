         "lib/wcrtomb.c": "REPLACE_WCRTOMB",
         "lib/wctype.c": "REPLACE_WCTYPE",
         "lib/wcwidth.c": "REPLACE_WCWIDTH",
@@ -1199,7 +1203,10 @@
     linkopts = M4_LINKOPTS + select({
         "@platforms//os:linux": ["-lpthread"],
