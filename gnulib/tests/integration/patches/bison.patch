+        "lib/iswxdigit.c": "ac_cv_func_iswcntrl && !REPLACE_ISWCNTRL && REPLACE_ISWXDIGIT",
         "lib/lstat.c": "REPLACE_LSTAT",
-        "lib/mbrtowc.c": "COMPILE_MBRTOWC",
+        "lib/mbrtowc.c": "COMPILE_MBRTOWC || REPLACE_MBRTOWC",
+        "lib/mbsinit.c": "!_gl_cv_func_mbsinit || REPLACE_MBSINIT",
         "lib/mempcpy.c": "COMPILE_MEMPCPY",
         "lib/obstack_printf.c": "COMPILE_OBSTACK_PRINTF",
-        "lib/open.c": "COMPILE_OPEN",
+        "lib/open.c": "COMPILE_OPEN || REPLACE_OPEN",
+        "lib/openat.c": "!ac_cv_func_openat || REPLACE_OPENAT",
+        # at-internal, openat-die and save-cwd: pulled in by openat and
+        # fdopendir when the system lacks the function.
+        "lib/openat-die.c": "!ac_cv_func_openat || !ac_cv_func_fdopendir",
+        "lib/openat-proc.c": "!ac_cv_func_openat || !ac_cv_func_fdopendir",
+        "lib/opendir.c": "!_gl_cv_func_opendir || REPLACE_OPENDIR",
         "lib/perror.c": "REPLACE_PERROR",
         "lib/printf.c": "REPLACE_PRINTF",
+        "lib/raise.c": "REPLACE_RAISE",
         "lib/rawmemchr.c": "COMPILE_RAWMEMCHR",
-        "lib/readlink.c": "REPLACE_READLINK",
+        "lib/readdir.c": "!ac_cv_func_readdir || REPLACE_READDIR",
+        "lib/readlink.c": "!ac_cv_func_readlink || REPLACE_READLINK",
         "lib/reallocarray.c": "COMPILE_REALLOCARRAY",
         "lib/rename.c": "REPLACE_RENAME",
+        "lib/rewinddir.c": "!ac_cv_func_rewinddir || REPLACE_REWINDDIR",
+        "lib/rmdir.c": "REPLACE_RMDIR",
+        "lib/save-cwd.c": "!ac_cv_func_openat || !ac_cv_func_fdopendir",
         "lib/snprintf.c": "REPLACE_SNPRINTF",
         # --- Spawn replacement (all-or-nothing when REPLACE_POSIX_SPAWN=1) ---
         "lib/spawn.c": "ac_cv_define_REPLACE_POSIX_SPAWN",
@@ -780,13 +814,13 @@
         "lib/spawnp.c": "ac_cv_define_REPLACE_POSIX_SPAWN",
         "lib/sprintf.c": "REPLACE_SPRINTF",
         "lib/stat.c": "REPLACE_STAT",
-        "lib/strchrnul.c": "REPLACE_STRCHRNUL",
