+        "lib/fcntl.c": "!ac_cv_func_fcntl || REPLACE_FCNTL",
+        "lib/fd-hook.c": "REPLACE_CLOSE",
+        "lib/fdopendir.c": "!ac_cv_func_fdopendir || REPLACE_FDOPENDIR",
