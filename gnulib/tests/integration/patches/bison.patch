# Windows (MSVC) fixes for the bison 3.8.2.bcr.10 overlay against GNU-faithful
# rules_cc_autoconf results.  gnulib compiles a replacement source when
# HAVE_X = 0 || REPLACE_X = 1, but the overlay only checked REPLACE_X; the
# probes' cache variables are used where the HAVE_* name is published both as
# define and as subst (fcntl, readlink, strchrnul, vasprintf, strerror_r,
# fstatat, getdelim, mbsinit, fdopendir, openat, the dirent functions,
# isnand/isnanl).  REPLACE_CLOSE/DUP/DUP2/GETCWD/UNLINK/OPEN/RMDIR/RAISE/
# MBRTOWC are 1 on MSVC, which also pulls in the getcwd -> fdopendir/openat ->
# fchdir -> dirent cluster that GNU bison's gnulib-comp.m4 enables when
# REPLACE_GETCWD = 1 (hence the generated lib/dirent.h, the dup indicator and
# the fd-hook/filenamecat-lgpl/openat-die/openat-proc/save-cwd helpers).
# iswdigit/iswxdigit are skipped when <wctype.h> already redefines the isw*
# functions, as gnulib-comp.m4 does.  The ports now publish
# HAVE_STPCPY/HAVE_STPNCPY themselves, so the overlay's local overrides are
# duplicates.  GNU's AC_C_RESTRICT yields `#define restrict /**/` on MSVC,
# which the rules' AC_C_RESTRICT port reproduces, so no local define is needed.
--- a/BUILD.bazel
+++ b/BUILD.bazel
@@ -18,6 +18,7 @@
 
 GENERATED_SRCS = {
     "lib/alloca.h": "lib/alloca.in.h",
+    "lib/dirent.h": "lib/dirent.in.h",
     "lib/fcntl.h": "lib/fcntl.in.h",
     "lib/getopt-cdefs.h": "lib/getopt-cdefs.in.h",
     "lib/getopt.h": "lib/getopt.in.h",
@@ -263,6 +264,7 @@
         # leaving GNULIB_ACCESS=0 avoids an rpl_access redirect conflict.
         checks.AC_SUBST("GNULIB_CHDIR", 1),
         checks.AC_SUBST("GNULIB_CLOSE", 1),
+        checks.AC_SUBST("GNULIB_DUP", 1),
         checks.AC_SUBST("GNULIB_DUP2", 1),
         checks.AC_SUBST("GNULIB_ENVIRON", 1),
         checks.AC_SUBST("GNULIB_FCHDIR", 1),
@@ -646,8 +648,6 @@
             # Override string_h toolchain defaults for POSIX functions missing
             # on Windows.  Without these the generated string.h skips their
             # declarations, causing implicit-int errors on MSVC.
-            checks.AC_SUBST("HAVE_STPCPY", 0),
-            checks.AC_SUBST("HAVE_STPNCPY", 0),
             # MSVC's _access() doesn't support X_OK (mode=1) and returns
             # EINVAL. Enable gnulib access replacement (lib/access.c) which
             # converts X_OK to R_OK before calling _access().
@@ -737,31 +737,65 @@
     name = "gnulib_conditional_srcs",
     srcs = {
         # --- REPLACE_* gated (upstream gnulib decides) ---
-        "lib/asprintf.c": "REPLACE_VASPRINTF",
+        "lib/asprintf.c": "!ac_cv_func_vasprintf || REPLACE_VASPRINTF",
         # --- COMPILE_* gated (function absent → replacement compiled) ---
         "lib/canonicalize-lgpl.c": "COMPILE_CANONICALIZE_LGPL",
+        "lib/close.c": "REPLACE_CLOSE",
+        "lib/closedir.c": "!_gl_have_closedir || REPLACE_CLOSEDIR",
+        "lib/dirfd.c": "(!ac_cv_func_dirfd && !gl_cv_func_dirfd_macro) || REPLACE_DIRFD",
+        "lib/dup.c": "REPLACE_DUP",
+        "lib/dup2.c": "REPLACE_DUP2",
