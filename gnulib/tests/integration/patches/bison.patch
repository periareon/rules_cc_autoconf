# Defaults as the converter generates them: `defaults = True` is gone (the
# autoconf toolchain carries no defaults any more) and the main autoconf
# target reads the headers' `:defaults` the configure script AC_REQUIREs
# through `default_deps = GNULIB_M4_DEFAULT_DEPS`.
--- a/BUILD.bazel
+++ b/BUILD.bazel
@@ -79,6 +79,37 @@
     )
 ]
 
+# The gl_<HEADER>_H_DEFAULTS the configure script AC_REQUIREs: the headers' `:defaults`,
+# read beneath the results (a probe of the same name overrides a default).
+GNULIB_M4_DEFAULT_DEPS = [
+    "@rules_cc_autoconf//gnulib/m4/dirent_h:defaults",
+    "@rules_cc_autoconf//gnulib/m4/fcntl_h:defaults",
+    "@rules_cc_autoconf//gnulib/m4/iconv_h:defaults",
+    "@rules_cc_autoconf//gnulib/m4/inttypes:defaults",
+    "@rules_cc_autoconf//gnulib/m4/locale_h:defaults",
+    "@rules_cc_autoconf//gnulib/m4/math_h:defaults",
+    "@rules_cc_autoconf//gnulib/m4/sched_h:defaults",
+    "@rules_cc_autoconf//gnulib/m4/signal_h:defaults",
+    "@rules_cc_autoconf//gnulib/m4/spawn_h:defaults",
+    "@rules_cc_autoconf//gnulib/m4/stddef_h:defaults",
+    "@rules_cc_autoconf//gnulib/m4/stdio_h:defaults",
+    "@rules_cc_autoconf//gnulib/m4/stdlib_h:defaults",
+    "@rules_cc_autoconf//gnulib/m4/string_h:defaults",
+    "@rules_cc_autoconf//gnulib/m4/strings_h:defaults",
+    "@rules_cc_autoconf//gnulib/m4/sys_ioctl_h:defaults",
+    "@rules_cc_autoconf//gnulib/m4/sys_resource_h:defaults",
+    "@rules_cc_autoconf//gnulib/m4/sys_stat_h:defaults",
+    "@rules_cc_autoconf//gnulib/m4/sys_time_h:defaults",
+    "@rules_cc_autoconf//gnulib/m4/sys_times_h:defaults",
+    "@rules_cc_autoconf//gnulib/m4/sys_types_h:defaults",
+    "@rules_cc_autoconf//gnulib/m4/sys_wait_h:defaults",
+    "@rules_cc_autoconf//gnulib/m4/termios_h:defaults",
+    "@rules_cc_autoconf//gnulib/m4/time_h:defaults",
+    "@rules_cc_autoconf//gnulib/m4/unistd_h:defaults",
+    "@rules_cc_autoconf//gnulib/m4/wchar_h:defaults",
+    "@rules_cc_autoconf//gnulib/m4/wctype_h:defaults",
+]
+
 # Package information from configure.ac
 autoconf_package_info(
     name = "bison_package_info",
@@ -467,6 +498,7 @@
 # AC_CHECK_FUNCS_ONCE([setlocale]) - line 288
 autoconf(
     name = "configure_ac",
+    default_deps = GNULIB_M4_DEFAULT_DEPS,
     checks = [
         # checks.AC_C_INLINE(),
         checks.AC_CHECK_FUNC("setlocale"),
@@ -673,7 +705,6 @@
     autoconf_hdr(
