# grep 3.12: the BCR overlay was written against an earlier rules_cc_autoconf
# whose gnulib ports published some results differently. The ports now follow
# gnulib itself, which changes how the source conditions have to be spelled:
#
#   - A HAVE_X operand (bare or as `ac_cv_subst_HAVE_X`) may resolve to the
#     *_H_DEFAULTS substitution, which is always 1, instead of the value the
#     function's module lowers. Where the port's probe (`ac_cv_func_x`,
#     `ac_cv_have_decl_x`, ...) is visible it is used instead: it is unique
#     and always carries a value, mirroring gnulib's own
#     `test $ac_cv_func_x = no` tests.
#   - gl_FUNC_FCHDIR and gl_FUNC_CLOSE: the fchdir port now emits the
#     REPLACE_FCHDIR (and, on Windows, REPLACE_OPEN_DIRECTORY) defines and the
#     close port the REPLACE_CLOSE substitution; the local copies were
#     duplicate-result errors.
#   - gl_LANGINFO_H no longer probes T_FMT_AMPM (dropped upstream together
#     with HAVE_LANGINFO_T_FMT_AMPM); nl_langinfo.m4 lines 27-31 test CODESET,
#     ALTMON, ABALTMON and ERA only.
#   - REPLACE_STRERROR_0 is a shell variable (plus an AC_DEFINE when strerror(0)
#     is broken) in m4/strerror.m4; it was never AC_SUBSTed. The port keeps the
#     probe result as `_gl_cv_func_strerror_0_works`, so
#       test -n "$ERRNO_H" || test $REPLACE_STRERROR_0 = 1
#     becomes `GL_GENERATE_ERRNO_H==true || !_gl_cv_func_strerror_0_works`.
#
# Remove once the overlay on the Bazel Central Registry is updated against a
# rules_cc_autoconf release that contains these ports.
--- a/BUILD.bazel
+++ b/BUILD.bazel
@@ -181,7 +181,6 @@
     "ac_cv_func_nl_langinfo",
     "!(" + " && ".join([
         "ac_cv_subst_HAVE_LANGINFO_CODESET==1",
-        "ac_cv_subst_HAVE_LANGINFO_T_FMT_AMPM==1",
         "ac_cv_subst_HAVE_LANGINFO_ALTMON==1",
         "ac_cv_subst_HAVE_LANGINFO_ABALTMON==1",
         "ac_cv_subst_HAVE_LANGINFO_ERA==1",
@@ -527,40 +526,13 @@
     ],
 )
 
-# gl_FUNC_FCHDIR (m4/fchdir.m4 lines 29-64).  `@rules_cc_autoconf//gnulib/m4/
-# fchdir` probes the function and lets the dup/dup2/close/fcntl/opendir/
-# closedir modules flip their REPLACE_* variables when it is missing, but it
-# never emits the config.h *define* REPLACE_FCHDIR that the same block
-# produces (line 30) -- distinct from the Makefile variable of that name,
-# which stays 0.  lib/fdopendir.c, lib/opendir.c, lib/close.c, lib/dup2.c
-# and friends key their directory-fd bookkeeping on the define, and on
-# Windows fdopendir.c refuses to build without it ("GNULIB_defined_DIR but
-# fchdir not replaced").  The fchdir module is reached through ten others, so
-# the define is added beside it rather than by replacing it.
-#
-# TODO: drop once `@rules_cc_autoconf//gnulib/m4/fchdir` defines
-# REPLACE_FCHDIR (and REPLACE_OPEN_DIRECTORY) itself.
+# gl_FUNC_FCHDIR (m4/fchdir.m4 lines 29-64) is fully covered by
+# `@rules_cc_autoconf//gnulib/m4/fchdir`, including the config.h defines
+# REPLACE_FCHDIR and (on Windows) REPLACE_OPEN_DIRECTORY. Kept as an empty
+# aggregate because other targets list it.
 autoconf(
     name = "m4_fchdir",
-    checks = [
-        # Lines 29-31.  Lines 21-27 (fchdir present but DIR has no fd
-        # member) do not arise on any supported libc.
-        checks.AC_DEFINE(
-            "REPLACE_FCHDIR",
-            requires = ["!ac_cv_func_fchdir"],
-        ),
-    ] + select({
-        # Lines 35-63: an AC_RUN_IFELSE that cannot run here; upstream's own
-        # guess for native Windows is "no" (line 52).  Elsewhere the block is
-        # skipped because fchdir exists.
-        "@platforms//os:windows": [
-            checks.AC_DEFINE(
-                "REPLACE_OPEN_DIRECTORY",
-                requires = ["!ac_cv_func_fchdir"],
-            ),
-        ],
-        "//conditions:default": [],
-    }),
+    checks = [],
     deps = ["@rules_cc_autoconf//gnulib/m4/fchdir"],
 )
 
@@ -598,12 +570,10 @@
 
 autoconf(
     name = "m4_close",
-    checks = [
-        checks.AC_SUBST(
-            "REPLACE_CLOSE",
-            condition = "ac_cv_subst_HAVE_MSVC_INVALID_PARAMETER_HANDLER==1 || ac_cv_header_winsock2_h || !ac_cv_func_fchdir",
-        ),
-    ],
+    # gl_FUNC_CLOSE is now covered by `@rules_cc_autoconf//gnulib/m4/close`,
+    # which substitutes REPLACE_CLOSE under the same condition; a second
+    # REPLACE_CLOSE here is a duplicate-subst error.
+    checks = [],
     deps = [
         "@rules_cc_autoconf//gnulib/m4/fchdir",
         "@rules_cc_autoconf//gnulib/m4/msvc-inval",
