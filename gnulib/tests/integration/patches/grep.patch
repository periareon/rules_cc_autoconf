-                copts = copts,
-                requires = ["!gl_cv_static_assert_keyword"],
-            ),
-        ]
-        for compiler, copts in C_STD_COPTS.items()
-    }) + [
+    checks = [
+        checks.AC_TRY_COMPILE(
+            name = "gl_cv_static_assert_keyword",
+            code = STATIC_ASSERT_PROBE.format(include = ""),
+        ),
+        checks.AC_TRY_COMPILE(
+            name = "gl_cv_static_assert_macro",
+            code = STATIC_ASSERT_PROBE.format(include = "#include <assert.h>"),
+            requires = ["!gl_cv_static_assert_keyword"],
+        ),
         checks.AC_DEFINE(
             "HAVE_C_STATIC_ASSERT",
             requires = ["gl_cv_static_assert_keyword"],
@@ -527,40 +501,13 @@
     ],
