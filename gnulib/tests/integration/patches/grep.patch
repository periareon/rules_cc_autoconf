# grep 3.12: the BCR overlay was written against an earlier rules_cc_autoconf
# whose gnulib ports published some results differently. The ports now follow
# gnulib itself, which changes how the source conditions have to be spelled:
#
#   - A HAVE_X operand (bare or as `ac_cv_subst_HAVE_X`) may resolve to the
#     *_H_DEFAULTS substitution, which is always 1, instead of the value the
#     function's module lowers. Where the port's probe (`ac_cv_func_x`,
#     `ac_cv_have_decl_x`, ...) is visible it is used instead: it is unique
#     and always carries a value, mirroring gnulib's own
#     `test $ac_cv_func_x = no` tests.
#   - gl_FUNC_FCHDIR and gl_FUNC_CLOSE: the fchdir port now emits the
#     REPLACE_FCHDIR (and, on Windows, REPLACE_OPEN_DIRECTORY) defines and the
#     close port the REPLACE_CLOSE substitution; the local copies were
#     duplicate-result errors.
#   - gl_FUNC_ERROR: the error_h port now derives COMPILE_ERROR_C itself;
#     the local AC_SUBST copy was a duplicate-result error.
#   - gl_LANGINFO_H no longer probes T_FMT_AMPM (dropped upstream together
#     with HAVE_LANGINFO_T_FMT_AMPM); nl_langinfo.m4 lines 27-31 test CODESET,
#     ALTMON, ABALTMON and ERA only.
#   - REPLACE_STRERROR_0 is a shell variable (plus an AC_DEFINE when strerror(0)
#     is broken) in m4/strerror.m4; it was never AC_SUBSTed. The port keeps the
#     probe result as `_gl_cv_func_strerror_0_works`, so
#       test -n "$ERRNO_H" || test $REPLACE_STRERROR_0 = 1
#     becomes `GL_GENERATE_ERRNO_H==true || !_gl_cv_func_strerror_0_works`.
#
#
# Separately, the overlay pinned -std=gnu11 (/std:c11) on grep's sources and
# on its static_assert probes, while the gnulib ports' probes ran under the
# build's standard; on macOS the two disagreed about c32rtomb's declaration
# and the overlay hard-coded HAVE_C32RTOMB per platform to paper over it.
# The standard of a build is the root module's (the toolchain's default,
# --copt): the pins are dropped, the c32rtomb port's own probe is used, and
# the C11 requirement upstream's AC_PROG_CC enforces becomes a check that
# stops the build with the flag to add when it is not met.
#
# Remove once the overlay on the Bazel Central Registry is updated against a
# rules_cc_autoconf release that contains these ports.
--- a/BUILD.bazel
+++ b/BUILD.bazel
@@ -86,29 +86,16 @@
     }),
 )
 
-# Upstream's gl_CHECK_FUNC_C32RTOMB probes c32rtomb with the autoconf
-# toolchain's own flags rather than the consumer's; on macOS libSystem's
-# <uchar.h> hides the prototype unless a feature-test macro that -std=gnu11
-# doesn't set is active, so the probe says "available" but grep's TU can't
-# see the declaration.  Pin the answer from platform knowledge instead.
-#
-# The pin must agree with HAVE_WORKING_C32RTOMB, which the c32rtomb module
-# still probes: gnulib never produces HAVE_C32RTOMB=0 together with
-# HAVE_WORKING_C32RTOMB=1, and in that combination lib/c32rtomb.c is
-# compiled without the rpl_ rename and its "call the system function"
-# branch (lib/c32rtomb.c line 47) calls itself -- `grep -i` overflowed the
-# stack on Windows that way.  UCRT declares c32rtomb in <uchar.h> exactly as
-# the probe reports, so Windows gets the probe's answer, like Linux.
+# gl_FUNC_C32RTOMB (m4/c32rtomb.m4).  The port's probes run under the same
+# flags as grep's own sources -- the toolchain's and the command line's,
+# since neither pins a C standard -- so what they see in <uchar.h> is what
+# the sources will see.  (An earlier overlay compiled the sources under
+# -std=gnu11 while the probes ran without it, and had to pin HAVE_C32RTOMB
+# from platform knowledge to keep the two from disagreeing on macOS.)
 autoconf(
     name = "m4_c32rtomb",
-    checks = selects.with_or({
-        ("@platforms//os:linux", "@platforms//os:windows"): [
-            checks.AC_SUBST("HAVE_C32RTOMB", 1),
-        ],
-        "//conditions:default": [
-            checks.AC_SUBST("HAVE_C32RTOMB", 0),
-        ],
-    }),
+    checks = [],
+    deps = ["@rules_cc_autoconf//gnulib/m4/c32rtomb"],
 )
 
