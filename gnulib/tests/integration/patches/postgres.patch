# postgres 18.4: the Windows defines were spelled as `/D` options, which only
# MSVC-style drivers accept; clang targeting MinGW (the hermetic_llvm config)
# rejects them as file names. Spell them `-D` for other drivers. Further
# MinGW issues remain beyond this (socklen_t, localtime_r in libpq).
#
# Remove once the overlay on the Bazel Central Registry is updated.
--- a/BUILD.bazel
+++ b/BUILD.bazel
@@ -1163,7 +1163,15 @@
     # `local_defines`/`defines`. Symbol names match upstream meson
     # exactly (`WINDOWS`, not `_WINDOWS`).
     copts = select({
-        "@platforms//os:windows": [
+        "@rules_cc//cc/compiler:clang-cl": [
+            "/DWIN32",
+            "/DWINDOWS",
+            "/D__WIN32__",
+            "/D__WINDOWS__",
+            "/D_CRT_SECURE_NO_DEPRECATE",
+            "/D_CRT_NONSTDC_NO_DEPRECATE",
+        ],
+        "@rules_cc//cc/compiler:msvc-cl": [
             "/DWIN32",
             "/DWINDOWS",
             "/D__WIN32__",
@@ -1171,6 +1179,15 @@
             "/D_CRT_SECURE_NO_DEPRECATE",
             "/D_CRT_NONSTDC_NO_DEPRECATE",
         ],
+        # clang / gcc driving the MinGW target
+        "@platforms//os:windows": [
+            "-DWIN32",
+            "-DWINDOWS",
+            "-D__WIN32__",
+            "-D__WINDOWS__",
+            "-D_CRT_SECURE_NO_DEPRECATE",
+            "-D_CRT_NONSTDC_NO_DEPRECATE",
+        ],
         "//conditions:default": [],
     }),
     # Also on `defines` so they propagate to consumer-compile commands
