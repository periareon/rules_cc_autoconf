+++ b/BUILD.bazel
@@ -1285,9 +1285,9 @@
 STDBIT_H_CONDITION = "ac_cv_subst_HAVE_STDBIT_H==0 || ac_cv_define_HAVE_DECL_STDC_ROTATE_LEFT_UC==0"
 
 GNULIB_HDR_CONDITIONS = {
-    "glob": "!ac_cv_header_glob_h || !ac_cv_define_HAVE_GLOB || ac_cv_subst_REPLACE_GLOB==1",
+    "glob": "!ac_cv_header_glob_h || !ac_cv_func_glob || ac_cv_subst_REPLACE_GLOB==1",
     "stdbit": STDBIT_H_CONDITION,
-    "stdcountof": "!(ac_cv_subst_HAVE_STDCOUNTOF_H==1 && ac_cv_subst_CXX_HAVE_STDCOUNTOF_H==1)",
+    "stdcountof": "!(ac_cv_header_stdcountof_h && ac_cv_subst_CXX_HAVE_STDCOUNTOF_H==1)",
 }
 
