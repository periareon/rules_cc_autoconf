# wget2 2.3.0: `@rules_cc_autoconf//gnulib/m4/fseterr` now records its probe
# under gnulib's own cache name, ac_cv_func___fseterr (m4/fseterr.m4 uses
# AC_CHECK_FUNCS_ONCE), instead of the ac_cv_try_compile_HAVE___FSETERR the
# overlay was written against.
#
# Remove once the overlay on the Bazel Central Registry is updated against a
# rules_cc_autoconf release that contains this port.
# Defaults as the converter generates them: `defaults = True` is gone (the
# autoconf toolchain carries no defaults any more) and the main autoconf
# target reads the headers' `:defaults` the configure script AC_REQUIREs
# through `default_deps = GNULIB_M4_DEFAULT_DEPS`.
--- a/BUILD.bazel
+++ b/BUILD.bazel
@@ -802,8 +802,55 @@
     "CLOEXEC",
 ]
 
+
+# The gl_<HEADER>_H_DEFAULTS the configure script AC_REQUIREs: the headers' `:defaults`,
+# read beneath the results (a probe of the same name overrides a default).
+GNULIB_M4_DEFAULT_DEPS = [
+    "@rules_cc_autoconf//gnulib/m4/arpa_inet_h:defaults",
+    "@rules_cc_autoconf//gnulib/m4/ctype_h:defaults",
+    "@rules_cc_autoconf//gnulib/m4/dirent_h:defaults",
+    "@rules_cc_autoconf//gnulib/m4/fcntl_h:defaults",
+    "@rules_cc_autoconf//gnulib/m4/fnmatch_h:defaults",
+    "@rules_cc_autoconf//gnulib/m4/glob_h:defaults",
+    "@rules_cc_autoconf//gnulib/m4/inttypes:defaults",
+    "@rules_cc_autoconf//gnulib/m4/langinfo_h:defaults",
+    "@rules_cc_autoconf//gnulib/m4/locale_h:defaults",
+    "@rules_cc_autoconf//gnulib/m4/netdb_h:defaults",
+    "@rules_cc_autoconf//gnulib/m4/poll_h:defaults",
+    "@rules_cc_autoconf//gnulib/m4/pthread_h:defaults",
+    "@rules_cc_autoconf//gnulib/m4/sched_h:defaults",
+    "@rules_cc_autoconf//gnulib/m4/signal_h:defaults",
+    "@rules_cc_autoconf//gnulib/m4/spawn_h:defaults",
+    "@rules_cc_autoconf//gnulib/m4/stdbit_h:defaults",
+    "@rules_cc_autoconf//gnulib/m4/stddef_h:defaults",
+    "@rules_cc_autoconf//gnulib/m4/stdio_h:defaults",
+    "@rules_cc_autoconf//gnulib/m4/stdlib_h:defaults",
+    "@rules_cc_autoconf//gnulib/m4/string_h:defaults",
+    "@rules_cc_autoconf//gnulib/m4/strings_h:defaults",
+    "@rules_cc_autoconf//gnulib/m4/sys_file_h:defaults",
+    "@rules_cc_autoconf//gnulib/m4/sys_ioctl_h:defaults",
+    "@rules_cc_autoconf//gnulib/m4/sys_random_h:defaults",
+    "@rules_cc_autoconf//gnulib/m4/sys_select_h:defaults",
+    "@rules_cc_autoconf//gnulib/m4/sys_socket_h:defaults",
+    "@rules_cc_autoconf//gnulib/m4/sys_stat_h:defaults",
+    "@rules_cc_autoconf//gnulib/m4/sys_time_h:defaults",
+    "@rules_cc_autoconf//gnulib/m4/sys_types_h:defaults",
+    "@rules_cc_autoconf//gnulib/m4/sys_uio_h:defaults",
+    "@rules_cc_autoconf//gnulib/m4/sys_wait_h:defaults",
+    "@rules_cc_autoconf//gnulib/m4/time_h:defaults",
+    "@rules_cc_autoconf//gnulib/m4/uchar_h:defaults",
+    "@rules_cc_autoconf//gnulib/m4/unicase_h:defaults",
+    "@rules_cc_autoconf//gnulib/m4/unictype_h:defaults",
+    "@rules_cc_autoconf//gnulib/m4/uninorm_h:defaults",
+    "@rules_cc_autoconf//gnulib/m4/unistd_h:defaults",
+    "@rules_cc_autoconf//gnulib/m4/utime_h:defaults",
+    "@rules_cc_autoconf//gnulib/m4/wchar_h:defaults",
+    "@rules_cc_autoconf//gnulib/m4/wctype_h:defaults",
+]
+
 autoconf(
     name = "autoconf",
+    default_deps = GNULIB_M4_DEFAULT_DEPS,
     # The check list below follows `configure.ac` top to bottom.  Everything
     # wget2 itself asks for is written out here rather than depended on, so
     # each entry can be read against the line of `configure.ac` it came from.
@@ -1122,7 +1169,6 @@
 autoconf_hdr(
     name = "config",
     out = "config/config.h",
-    defaults = True,
     # The rules_cc_autoconf `nl_langinfo` port answers NL_LANGINFO_MTSAFE=0
     # on every platform but Linux; gnulib's m4/nl_langinfo.m4:46 answers 0
     # only on Solaris, and lib/nl_langinfo.c:157 takes a 0 to mean Solaris'
@@ -1224,7 +1270,6 @@
     autoconf_hdr(
         name = "lib_{}_h".format(stem.replace("/", "_")),
         out = "lib/{}.h".format(stem),
-        defaults = True,
         inlines = GL_INLINES,
         mode = "subst",
         substitutions = LIB_HDR_SUBSTITUTIONS.get(stem, {}),
@@ -1267,7 +1312,6 @@
     autoconf_hdr(
         name = "lib_{}_h_processed".format(stem),
         out = "_gnulib_cond/{}.h".format(stem),
-        defaults = True,
         inlines = GL_INLINES,
         mode = "subst",
         template = "lib/{}.in.h".format(stem),
@@ -1425,7 +1469,7 @@
     "GL_COND_OBJ_FREOPEN": "ac_cv_subst_REPLACE_FREOPEN==1",
     "GL_COND_OBJ_FSEEK": "ac_cv_subst_REPLACE_FSEEK==1",
     "GL_COND_OBJ_FSEEKO": "!gl_cv_func_fseeko || ac_cv_subst_REPLACE_FSEEKO==1",
-    "GL_COND_OBJ_FSETERR": "ac_cv_try_compile_HAVE___FSETERR==0",
+    "GL_COND_OBJ_FSETERR": "!ac_cv_func___fseterr",
     "GL_COND_OBJ_FSTAT": "ac_cv_subst_REPLACE_FSTAT==1",
     "GL_COND_OBJ_FSTATAT": "!ac_cv_define_HAVE_FSTATAT || ac_cv_subst_REPLACE_FSTATAT==1",
     "GL_COND_OBJ_FSYNC": "!ac_cv_func_fsync",
@@ -1903,7 +1947,6 @@
         "lib/wmempcpy.c": "GL_COND_OBJ_WMEMPCPY",
         "lib/write.c": "GL_COND_OBJ_WRITE",
     }.items()},
-    defaults = True,
     naming = "per_target",
     deps = [":autoconf"],
 )
