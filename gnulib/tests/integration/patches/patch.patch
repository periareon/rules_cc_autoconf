         "lib/getcwd-lgpl.c": "REPLACE_GETCWD",
-        "lib/getdtablesize.c": "REPLACE_GETDTABLESIZE",
+        "lib/getdtablesize.c": "!ac_cv_func_getdtablesize || REPLACE_GETDTABLESIZE",
         "lib/getgroups.c": "REPLACE_GETGROUPS",
         "lib/getopt.c": "COMPILE_GETOPT",
         "lib/getopt1.c": "COMPILE_GETOPT",
-        "lib/getprogname.c": "REPLACE_GETPROGNAME",
+        "lib/getprogname.c": "!ac_cv_func_getprogname || REPLACE_GETPROGNAME",
         "lib/getrandom.c": "COMPILE_GETRANDOM",
         "lib/gettimeofday.c": "REPLACE_GETTIMEOFDAY",
         # group-member.c excluded on MSVC: uses gid_t/struct group (POSIX-only)
@@ -821,7 +806,7 @@
         "lib/lseek.c": "REPLACE_LSEEK",
         "lib/lstat.c": "REPLACE_LSTAT",
         "lib/mbrtoc32.c": "COMPILE_MBRTOC32",
-        "lib/mbrtowc.c": "COMPILE_MBRTOWC",
+        "lib/mbrtowc.c": "COMPILE_MBRTOWC || REPLACE_MBRTOWC",
         "lib/mbsinit.c": "REPLACE_MBSINIT",
         "lib/memchr.c": "REPLACE_MEMCHR",
         "lib/mempcpy.c": "COMPILE_MEMPCPY",
@@ -830,39 +815,39 @@
