+    "@rules_cc_autoconf//gnulib/m4/time_h:defaults",
+    "@rules_cc_autoconf//gnulib/m4/uchar_h:defaults",
+    "@rules_cc_autoconf//gnulib/m4/unictype_h:defaults",
