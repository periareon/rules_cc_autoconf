# Windows (MSVC) fixes for the patch 2.8.bcr.2 overlay against GNU-faithful
# rules_cc_autoconf results.
#
# gnulib compiles a replacement source when HAVE_X = 0 || REPLACE_X = 1
# (m4/gnulib-comp.m4, GL_COND_OBJ_*), but the overlay only checks REPLACE_X.
# The cache variables of the probes (ac_cv_func_*, _gl_cv_func_fstatat,
# _gl_cv_func_opendir,
# _gl_have_closedir, ac_cv_func_dirfd / gl_cv_func_dirfd_macro for the plain
# shell variable HAVE_DIRFD) are used where the HAVE_* name is published both
# as define and as subst. On MSVC none of closedir, dirfd, faccessat, fchmodat,
# fcntl, fdopendir, fstatat, futimens, getdtablesize, getprogname, openat,
# opendir, readdir, readlink, readlinkat, renameat, setenv, stpcpy,
# symlinkat, timegm, unlinkat, unsetenv and utimensat exist (HAVE_*=0,
# REPLACE_*=0, exactly as GNU configure reports), and localtime_r/gmtime_r
# are missing too (HAVE_LOCALTIME_R=0 selects time_r.c).
# fchdir.c is compiled when HAVE_FCHDIR = 0 || REPLACE_FCHDIR = 1, which is
# exactly when gl_FUNC_FCHDIR AC_DEFINEs REPLACE_FCHDIR in config.h; the
# define is referenced through its cache name ac_cv_define_REPLACE_FCHDIR
# because the bare name also matches the gl_UNISTD_H_DEFAULTS subst.
# The ports now report REPLACE_MBRTOWC=1 on MSVC (the overlay hard-codes
# COMPILE_MBRTOWC=0 there), so mbrtowc.c also follows REPLACE_MBRTOWC.
# strerror-override.c follows GNU's rule
#   test -n "$ERRNO_H" || test $REPLACE_STRERROR_0 = 1
# (ERRNO_H is non-empty iff gl_cv_header_errno_h_complete=no, and
# REPLACE_STRERROR_0 is AC_DEFINEd iff the strerror(0) probe fails) instead of
# the per-OS COMPILE_STRERROR_OVERRIDE hard-code: on MSVC the generated errno.h
# defines errno values, so strerror.c (REPLACE_STRERROR=1) calls the extern
# strerror_override().
# The hard-coded MSVC source list that re-added closedir.c ... utimensat.c
# (duplicating what autoconf_srcs now selects, LNK4006) and the local
# HAVE_TIMESPEC_GET / REPLACE_FCHDIR defines (now in config.h) are removed.
# getrandom.c calls BCryptGenRandom on MSVC, so bcrypt.lib is linked.
--- a/BUILD.bazel
+++ b/BUILD.bazel
@@ -13,18 +13,6 @@
 ] + select({
     "@platforms//os:macos": [
         "_DARWIN_C_SOURCE",
-    ],
-    "//conditions:default": [],
-}) + select({
-    # MSVC 2015+ provides timespec_get (C11). The gnulib AC_CHECK_FUNC for
-    # timespec_get may fail on MSVC, but the function is always available.
-    # Without this, gettime.c falls through to gettimeofday (unavailable).
-    "@rules_cc//cc/compiler:msvc-cl": [
-        "HAVE_TIMESPEC_GET",
-        # gnulib's dirent.h defines its own DIR type on MSVC
-        # (GNULIB_defined_DIR=1). fdopendir.c requires REPLACE_FCHDIR
-        # to be set as a preprocessor macro when this is the case.
-        "REPLACE_FCHDIR=1",
     ],
     "//conditions:default": [],
 })
@@ -426,17 +414,14 @@
     ] + select({
         "@platforms//os:linux": [
             checks.AC_SUBST("COMPILE_OPEN", "0"),
-            checks.AC_SUBST("COMPILE_STRERROR_OVERRIDE", "0"),
             checks.AC_SUBST("COMPILE_MBRTOWC", "1"),
         ],
         "@platforms//os:macos": [
             checks.AC_SUBST("COMPILE_OPEN", "1"),
-            checks.AC_SUBST("COMPILE_STRERROR_OVERRIDE", "1"),
             checks.AC_SUBST("COMPILE_MBRTOWC", "0"),
         ],
         "//conditions:default": [
             checks.AC_SUBST("COMPILE_OPEN", "0"),
-            checks.AC_SUBST("COMPILE_STRERROR_OVERRIDE", "0"),
             checks.AC_SUBST("COMPILE_MBRTOWC", "0"),
         ],
     }),
@@ -783,35 +768,35 @@
         "lib/chmod.c": "REPLACE_CHMOD",
         "lib/chown.c": "REPLACE_CHOWN",
         "lib/close.c": "REPLACE_CLOSE",
-        "lib/closedir.c": "REPLACE_CLOSEDIR",
-        "lib/dirfd.c": "REPLACE_DIRFD",
+        "lib/closedir.c": "!_gl_have_closedir || REPLACE_CLOSEDIR",
+        "lib/dirfd.c": "(!ac_cv_func_dirfd && !gl_cv_func_dirfd_macro) || REPLACE_DIRFD",
