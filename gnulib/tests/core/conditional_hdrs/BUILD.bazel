load("@rules_cc//cc:cc_test.bzl", "cc_test")
load("//autoconf:autoconf.bzl", "autoconf")
load("//autoconf:checks.bzl", "checks")
load("//gnulib:conditional_hdrs.bzl", "cc_gnulib_conditional_hdrs")

# Two AC_SUBST variables drive the per-header conditions: COND_TRUE
# resolves truthy and COND_FALSE resolves falsy, so the rule writes the
# truthy header into the TreeArtifact and writes nothing for the falsy
# one (matching gnulib's `rm -f $@` branch).
autoconf(
    name = "conditions",
    checks = [
        checks.AC_SUBST("COND_TRUE", "true"),
        checks.AC_SUBST("COND_FALSE", "false"),
    ],
)

cc_gnulib_conditional_hdrs(
    name = "gen",
    hdrs = {
        "src/gl_conditional_falsy.h": "COND_FALSE",
        "src/gl_conditional_truthy.h": "COND_TRUE",
    },
    deps = [":conditions"],
)

# Verifies that:
#   - the truthy header is present in the TreeArtifact and exposes its
#     sentinel via `#include "gl_conditional_truthy.h"`,
#   - the falsy header is absent (rule wrote no file), so
#     `__has_include("gl_conditional_falsy.h")` reports 0.
cc_test(
    name = "include_test",
    srcs = ["include_test.cc"],
    deps = [":gen"],
)

# `defaults = True`: conditions over the toolchain defaults (GL_GENERATE_*_H
# of header packages the project never configures itself), with a
# dependency's own result taking precedence.  gnulib's "false" is falsy to
# the runner, so a false GL_GENERATE variable is tested as `!VAR`.
cc_gnulib_conditional_hdrs(
    name = "gen_defaults",
    hdrs = {
        "src/gl_conditional_default.h": "!GL_GENERATE_ICONV_H",
    },
    defaults = True,
    deps = [":conditions"],
)

autoconf(
    name = "conditions_override",
    checks = [
        checks.M4_VARIABLE("GL_GENERATE_ICONV_H", "true"),
    ],
)

cc_gnulib_conditional_hdrs(
    name = "gen_defaults_overridden",
    hdrs = {
        "src/gl_conditional_override.h": "GL_GENERATE_ICONV_H==true",
        "src/gl_conditional_override_absent.h": "!GL_GENERATE_ICONV_H",
    },
    defaults = True,
    deps = [":conditions_override"],
)

cc_test(
    name = "defaults_test",
    srcs = ["defaults_test.cc"],
    deps = [
        ":gen_defaults",
        ":gen_defaults_overridden",
    ],
)
