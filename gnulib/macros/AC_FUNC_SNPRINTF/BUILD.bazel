"""AC_FUNC_SNPRINTF - Bazel-specific shared macro

Checks for snprintf function. This is a Bazel-specific macro to deduplicate
the snprintf check across many gnulib modules.

Defines:
  - HAVE_SNPRINTF (if snprintf function exists)
  - ac_cv_func_snprintf (cache variable)
"""

load("//autoconf:autoconf_toolchain.bzl", autoconf = "autoconf_cache")
load("//autoconf:checks.bzl", "checks", "utils")

autoconf(
    name = "AC_FUNC_SNPRINTF",
    checks = [
        # GNU's program alone: gnulib documents snprintf as "missing on MSVC 14"
        # and gl_REPLACE_SNPRINTF is built on that answer; the default
        # AC_CHECK_FUNC code list would say yes on MSVC.
        # https://github.com/coreutils/gnulib/blob/1039a5f2cee3cda1c11f64a5eb3a15b2e87cd2f0/doc/posix-functions/snprintf.texi#L15-L16
        # https://github.com/coreutils/gnulib/blob/1039a5f2cee3cda1c11f64a5eb3a15b2e87cd2f0/m4/snprintf.m4#L45-L62
        checks.AC_CHECK_FUNC(
            "snprintf",
            name = "ac_cv_func_snprintf",
            code = utils.AC_LANG_FUNC_LINK_TRY("snprintf"),
        ),
        # AC_CHECK_FUNCS semantics: HAVE_SNPRINTF is defined to 1 when the
        # probe links and left undefined otherwise (MSVC: UCRT inlines
        # snprintf in <stdio.h>, so the probe reports it absent, as GNU does).
        checks.AC_DEFINE(
            "HAVE_SNPRINTF",
            condition = "ac_cv_func_snprintf",
            if_false = None,
            if_true = 1,
        ),
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//autoconf/macros/AC_CHECK_INCLUDES_DEFAULT",
    ],
)
