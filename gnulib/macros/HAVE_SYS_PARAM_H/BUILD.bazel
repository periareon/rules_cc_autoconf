load("//autoconf:autoconf_toolchain.bzl", autoconf = "autoconf_cache")
load("//autoconf:checks.bzl", "checks")

autoconf(
    name = "ac_cv_header_sys_param_h",
    checks = [
        checks.AC_CHECK_HEADER("sys/param.h"),
    ],
    visibility = ["//visibility:public"],
)

autoconf(
    name = "HAVE_SYS_PARAM_H",
    checks = [
        # AC_CHECK_HEADERS_ONCE([sys/param.h]) only defines the config.h macro.
        # The HAVE_SYS_PARAM_H subst is gl_UNISTD_H_DEFAULTS' (0), raised by
        # gl_FUNC_GETPAGESIZE alone.
        checks.AC_DEFINE(
            "HAVE_SYS_PARAM_H",
            requires = ["ac_cv_header_sys_param_h"],
        ),
    ],
    visibility = ["//visibility:public"],
    deps = [
        ":ac_cv_header_sys_param_h",
    ],
)
