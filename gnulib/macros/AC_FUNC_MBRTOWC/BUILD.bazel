"""AC_FUNC_MBRTOWC - Bazel-specific shared macro

Checks for mbrtowc function. This is a Bazel-specific macro to deduplicate
the mbrtowc check across many gnulib modules.

Defines:
  - HAVE_MBRTOWC (if mbrtowc function exists)
  - ac_cv_func_mbrtowc (cache variable)
"""

load("//autoconf:autoconf_toolchain.bzl", autoconf = "autoconf_cache")
load("//autoconf:checks.bzl", "checks")

# AC_CHECK_FUNCS_ONCE([mbrtowc]) - the bare probe plus its config.h define,
# for modules (vasnprintf) that only probe and never touch the HAVE_MBRTOWC
# substitution of gl_WCHAR_H_DEFAULTS.
autoconf(
    name = "AC_CHECK_FUNCS_ONCE_mbrtowc",
    checks = [
        # Check for mbrtowc function
        checks.AC_CHECK_FUNC(
            "mbrtowc",
            name = "ac_cv_func_mbrtowc",
        ),
        # AC_CHECK_FUNCS semantics: defined to 1 when found, else undefined.
        checks.AC_DEFINE(
            "HAVE_MBRTOWC",
            condition = "ac_cv_func_mbrtowc",
            if_false = None,
            if_true = 1,
        ),
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//autoconf/macros/AC_CHECK_INCLUDES_DEFAULT",
    ],
)

autoconf(
    name = "AC_FUNC_MBRTOWC",
    checks = [
        # if test $ac_cv_func_mbrtowc = no; then HAVE_MBRTOWC=0; fi
        # (lowers the gl_WCHAR_H_DEFAULTS substitution) - shared so mbrtowc
        # and btowc don't duplicate
        checks.AC_SUBST(
            "HAVE_MBRTOWC",
            condition = "ac_cv_func_mbrtowc",
            if_false = "0",
            if_true = "1",
        ),
    ],
    visibility = ["//visibility:public"],
    deps = [
        ":AC_CHECK_FUNCS_ONCE_mbrtowc",
        "//autoconf/macros/AC_CHECK_INCLUDES_DEFAULT",
    ],
)
