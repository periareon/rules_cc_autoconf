load("@bazel_skylib//:bzl_library.bzl", "bzl_library")

bzl_library(
    name = "bzl_lib",
    srcs = glob(
        ["*.bzl"],
        allow_empty = True,
    ),
    visibility = [
        "//autoconf:__pkg__",
        "//gnulib:__pkg__",
    ],
    deps = [
        "@bazel_features//:features",
        "@bazel_skylib//lib:paths",
        "@bazel_skylib//rules:common_settings",
        "@rules_cc//cc:action_names_bzl",
        "@rules_cc//cc:find_cc_toolchain_bzl",
        "@rules_cc//cc/common",
    ],
)
