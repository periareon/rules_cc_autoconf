# //gnulib/m4/posix_spawn_faction_addchdir:gl_FUNC_POSIX_SPAWN_FILE_ACTIONS_ADDCHDIR
autoconf(
    name = "gnulib/m4/posix_spawn_faction_addchdir/gl_FUNC_POSIX_SPAWN_FILE_ACTIONS_ADDCHDIR",
    checks = [
        # Define HAVE_*_NP from the shared check result.
        checks.AC_DEFINE(
            "HAVE_POSIX_SPAWN_FILE_ACTIONS_ADDCHDIR_NP",
            requires = ["ac_cv_func_posix_spawn_file_actions_addchdir_np==1"],
        ),
    ] + select({
        # macOS: header-based probes for posix_spawn_file_actions_addchdir
        # consistently fail under Bazel's macOS toolchain even on macOS 13+
        # (where the symbol is in libSystem). <spawn.h> hides the decl
        # behind _DARWIN_C_SOURCE / __DARWIN_C_LEVEL, and the framework's
        # `compile_defines` only prepends `#define` text — equivalent to
        # an inline `#define` and not sufficient because <sys/cdefs.h>
        # may already have computed __DARWIN_C_LEVEL by the time we get
        # to <spawn.h>. Substitute the SDK-version compile probe.
        "@platforms//os:macos": [
            checks.AC_TRY_COMPILE(
                name = "ac_cv_func_posix_spawn_file_actions_addchdir",
                code = """\
#include <Availability.h>
#if !defined(__MAC_OS_X_VERSION_MIN_REQUIRED) \\
    || __MAC_OS_X_VERSION_MIN_REQUIRED < 110000
#error "macOS deployment target is older than 11.0 (Big Sur)"
#endif
int main(void) { return 0; }
""",
            ),
        ],
        # AC_CHECK_FUNCS_ONCE([posix_spawn_file_actions_addchdir]). The POSIX
        # name was added in macOS 13 / glibc 2.29.
        "//conditions:default": [
            checks.AC_TRY_LINK(
                name = "ac_cv_func_posix_spawn_file_actions_addchdir",
                code = """\
#include <spawn.h>
int main(void) {
    posix_spawn_file_actions_t a;
    return posix_spawn_file_actions_addchdir(&a, ".");
}
""",
                compile_defines = [
                    "_DARWIN_C_SOURCE",
                    "_GNU_SOURCE",
                ],
            ),
        ],
    }) + [
        # AC_DEFINE for config.h alongside the AC_SUBST for subst.h —
        # AC_CHECK_FUNCS_ONCE emits both when the function is present.
        checks.AC_DEFINE(
            "HAVE_POSIX_SPAWN_FILE_ACTIONS_ADDCHDIR",
            requires = ["ac_cv_func_posix_spawn_file_actions_addchdir==1"],
        ),
        checks.AC_SUBST(
            "HAVE_POSIX_SPAWN_FILE_ACTIONS_ADDCHDIR",
            condition = "ac_cv_func_posix_spawn_file_actions_addchdir",
            if_false = "0",
            if_true = "1",
        ),
        checks.AC_SUBST(
            "REPLACE_POSIX_SPAWN_FILE_ACTIONS_ADDCHDIR",
            condition = "ac_cv_func_posix_spawn_file_actions_addchdir",
            if_false = "0",
            if_true = "1",
        ),
    ],
    default_deps = [":gnulib/m4/spawn_h/defaults"],
    visibility = ["//visibility:private"],
    deps = [
        ":gnulib/m4/extensions/extensions",
        ":gnulib/m4/posix_spawn/gl_POSIX_SPAWN_MINIMAL",
        ":gnulib/m4/posix_spawn_faction_addchdir/ac_cv_func_posix_spawn_file_actions_addchdir_np",
        "//autoconf/macros/AC_CHECK_INCLUDES_DEFAULT",
    ],
)

