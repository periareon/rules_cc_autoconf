# //gnulib/m4/printf:gl_SWPRINTF_WORKS
autoconf(
    name = "gnulib/m4/printf/gl_SWPRINTF_WORKS",
    checks = [
        checks.AC_CHECK_FUNC(
            "swprintf",
            # GNU's program alone: gnulib records swprintf as "only defined as a
            # macro on MSVC 14"; the default AC_CHECK_FUNC code list would say
            # yes on MSVC.
            # https://github.com/coreutils/gnulib/blob/1039a5f2cee3cda1c11f64a5eb3a15b2e87cd2f0/doc/posix-functions/swprintf.texi#L22-L23
            # https://github.com/coreutils/gnulib/blob/1039a5f2cee3cda1c11f64a5eb3a15b2e87cd2f0/m4/printf.m4#L2068
            code = utils.AC_LANG_FUNC_LINK_TRY("swprintf"),
            define = "HAVE_SWPRINTF",
        ),
    ] + select({
        # On Linux with glibc: swprintf works correctly
        "@platforms//os:linux": [
            checks.AC_DEFINE("HAVE_WORKING_SWPRINTF", "1"),
        ],
        # MSVC's UCRT swprintf passes the runtime test (null wide characters in
        # the output) even though the cross-compile guess for mingw/windows is
        # "no" (mingw's msvcrt is broken).
        "@platforms//os:windows": [
            checks.AC_DEFINE("HAVE_WORKING_SWPRINTF", "1"),
        ],
        # On macOS: swprintf does not work correctly (golden shows #undef)
        "//conditions:default": [],
    }),
    visibility = ["//visibility:private"],
    deps = ["//autoconf/macros/AC_CHECK_INCLUDES_DEFAULT"],
)

