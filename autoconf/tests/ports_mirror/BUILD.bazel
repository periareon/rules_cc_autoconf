            name = "ac_cv_type__Bool",
        ),
        # AC_CHECK_TYPE only creates cache variable, need AC_DEFINE for config.h
        checks.AC_DEFINE(
            "HAVE__BOOL",
            condition = "ac_cv_type__Bool",
            if_true = 1,
        ),
        # Also set as substitution variable for subst.h
        # if test "$ac_cv_type__Bool" = yes; then HAVE__BOOL=1 else HAVE__BOOL=0 fi
        checks.AC_SUBST(
            "HAVE__BOOL",
            condition = "ac_cv_type__Bool",
            if_false = 0,
            if_true = 1,
        ),
        # AC_CHECK_HEADER_STDBOOL - check stdbool.h conforms to C99 or later
        checks.AC_TRY_COMPILE(
            code = """\
#include <stdbool.h>

/* "true" and "false" should be usable in #if expressions and
   integer constant expressions, and "bool" should be a valid
   type name. */

#if !true
  #error "'true' is not true"
#endif
#if true != 1
  #error "'true' is not equal to 1"
#endif
char b[true == 1 ? 1 : -1];
char c[true];

#if false
  #error "'false' is not false"
#endif
#if false != 0
  #error "'false' is not equal to 0"
#endif
char d[false == 0 ? 1 : -1];

enum { e = false, f = true, g = false * true, h = true * 256 };

char i[(bool) 0.5 == true ? 1 : -1];
char j[(bool) 0.0 == false ? 1 : -1];
char k[sizeof (bool) > 0 ? 1 : -1];

struct sb { bool s: 1; bool t; } s;
char l[sizeof s.t > 0 ? 1 : -1];

bool m[h];
char n[sizeof m == h * sizeof m[0] ? 1 : -1];
char o[-1 - (bool) 0 < 0 ? 1 : -1];

bool p = true;
bool *pp = &p;

int main(void) {
    bool ps = &s;
    *pp |= p;
    *pp |= ! p;
    return (!b + !c + !d + !e + !f + !g + !h + !i + !j + !k
            + !l + !m + !n + !o + !p + !pp + !ps);
}
""",
            define = "HAVE_STDBOOL_H",
        ),
    ],
    visibility = ["//visibility:private"],
    deps = ["//autoconf/macros/AC_CHECK_INCLUDES_DEFAULT"],
)

# //gnulib/m4/stdckdint_h:stdckdint_h
autoconf(
    name = "gnulib/m4/stdckdint_h/stdckdint_h",
    checks = [
        # gl_STDCKDINT_H checks for stdckdint.h header
        # stdckdint.h is a C23 header, not available on Ubuntu 22.04 (glibc 2.35)
        checks.AC_CHECK_HEADER(
            "stdckdint.h",
            name = "ac_cv_header_stdckdint_h",
            define = "HAVE_STDCKDINT_H",
            subst = "HAVE_STDCKDINT_H",
        ),
        # gl_cv_header_cxx_stdckdint_h: can stdckdint.h be included in C++?
        # Upstream only probes when the C header exists; the probe fails
        # (and both substs are 0) when the framework has no C++ compiler.
        checks.AC_TRY_COMPILE(
            name = "gl_cv_header_cxx_stdckdint_h",
            code = """\
#include <stdckdint.h>
""",
            language = "cpp",
        ),
        checks.AC_SUBST(
            "HAVE_CXX_STDCKDINT_H",
            condition = "gl_cv_header_cxx_stdckdint_h",
            if_false = "0",
            if_true = "1",
        ),
        # gl_cv_header_cxx_stdckdint_h_works: ISO C++26 compliant?
        checks.AC_TRY_COMPILE(
            name = "gl_cv_header_cxx_stdckdint_h_works",
            code = """\
#include <stdckdint.h>
int
main (void)
{
  int r;
  int a = 1;
  int b = 1;
  return !!(ckd_add (&r, a, b) || ckd_sub (&r, a, b) || ckd_mul (&r, a, b));
}
""",
            language = "cpp",
        ),
        checks.AC_SUBST(
            "HAVE_WORKING_CXX_STDCKDINT_H",
            condition = "gl_cv_header_cxx_stdckdint_h_works",
            if_false = "0",
            if_true = "1",
        ),
        # gl_cv_header_c_stdckdint_h: can stdckdint.h be included in C?
        checks.AC_TRY_COMPILE(
            name = "gl_cv_header_c_stdckdint_h",
            code = """\
#include <stdckdint.h>
int main(void) {
    return 0;
}
""",
        ),
        checks.AC_SUBST(
            "HAVE_C_STDCKDINT_H",
            condition = "gl_cv_header_c_stdckdint_h",
            if_false = "0",
            if_true = "1",
        ),
        # gl_cv_header_c_stdckdint_h_works: ISO C23 compliant?
        checks.AC_TRY_COMPILE(
            name = "gl_cv_header_c_stdckdint_h_works",
            code = """\
#include <stdckdint.h>
int main(void) {
    int r;
    int a = 1;
    int b = 1;
    return !!(ckd_add(&r, a, b) || ckd_sub(&r, a, b)
              || ckd_mul(&r, a, b));
}
""",
        ),
        checks.AC_SUBST(
            "HAVE_WORKING_C_STDCKDINT_H",
            condition = "gl_cv_header_c_stdckdint_h_works",
            if_false = "0",
            if_true = "1",
        ),
        # GL_GENERATE_STDCKDINT_H: upstream sets this true whenever the system
        # header doesn't exist, can't be included in C, or fails the C23
        # ckd_add/sub/mul probe.  Every probe includes the header itself (a
        # missing header is a failed probe, not a skipped one, so the variable
        # is always produced: a `requires` chain left it absent where the
        # header is missing), and the "works" probe covers all three failure
        # modes — checking its negation is sufficient.
        checks.M4_VARIABLE(
            "GL_GENERATE_STDCKDINT_H",
            condition = "gl_cv_header_c_stdckdint_h_works",
            if_false = "true",
            if_true = "false",
        ),
    ] + gl_macros.GL_CHECK_NEXT_HEADERS(["stdckdint.h"]),
    visibility = ["//visibility:private"],
    deps = [
        ":gnulib/m4/include_next/include_next",
        "//autoconf/macros/AC_CHECK_INCLUDES_DEFAULT",
    ],
)

# //gnulib/m4/stdcountof_h:gl_STDCOUNTOF_H
autoconf(
    name = "gnulib/m4/stdcountof_h/gl_STDCOUNTOF_H",
    checks = [
        # M4: AC_CHECK_HEADERS_ONCE([stdcountof.h])
        # Sets ac_cv_header_stdcountof_h and (via `define`) emits
        # `#define HAVE_STDCOUNTOF_H 1` in config.h when the probe
        # succeeds.
        checks.AC_CHECK_HEADER(
            "stdcountof.h",
            define = "HAVE_STDCOUNTOF_H",
        ),
        # M4: HAVE_STDCOUNTOF_H = (probe == yes ? 1 : 0); AC_SUBST.
        # Drives subst.h from the same probe result config.h is using,
        # so the two stay consistent (previously this was hardcoded "0",
        # which contradicted config.h on any toolchain that ships the
        # header and caused goldens to flap whenever Apple toggled
        # <stdcountof.h> in/out of Xcode 26.x).
        checks.AC_SUBST(
            "HAVE_STDCOUNTOF_H",
            condition = "ac_cv_header_stdcountof_h",
            if_false = "0",
            if_true = "1",
        ),
        # M4: CXX_HAVE_STDCOUNTOF_H defaults to 1; only set to 0 if the
        # C++ compiler is present AND a C++ compile of
        #     #include <stdcountof.h>
        #     int a[] = { 86, 47 };
        #     unsigned int a_n = countof (a);
        # fails. The comment in upstream M4 calls out clang 21
        # specifically: the header exists but uses _Countof, which isn't
        # a C++ built-in. We model the probe directly via AC_TRY_COMPILE
        # with language="cpp"; if the framework's CXX support is absent
        # the probe fails and we emit 0 (a stricter result than upstream
        # M4, which would keep the default 1 when $CXX = no — acceptable
        # since gnulib's stdcountof.in.h treats CXX_HAVE_STDCOUNTOF_H==0
        # as "generate the replacement", which is the safe direction).
        checks.AC_TRY_COMPILE(
            name = "gl_cv_cxx_have_stdcountof_h",
            code = """\
#include <stdcountof.h>
int a[] = { 86, 47 };
unsigned int a_n = countof (a);
""",
            language = "cpp",
        ),
        checks.AC_SUBST(
            "CXX_HAVE_STDCOUNTOF_H",
            condition = "gl_cv_cxx_have_stdcountof_h",
            if_false = "0",
            if_true = "1",
        ),
        # GL_GENERATE_STDCOUNTOF_H (gl_CONDITIONAL_HEADER): the replacement is
        # generated unless both the C and the C++ compiler accept the header.
        # An M4_VARIABLE, like GL_GENERATE_ALLOCA_H: an automake conditional.
        checks.M4_VARIABLE(
            "GL_GENERATE_STDCOUNTOF_H",
            condition = "ac_cv_header_stdcountof_h && gl_cv_cxx_have_stdcountof_h",
            if_false = "true",
            if_true = "false",
        ),
    ] + gl_macros.GL_NEXT_HEADERS(["stdcountof.h"]),
    visibility = ["//visibility:private"],
    deps = [
        ":gnulib/m4/include_next/include_next",
        "//autoconf/macros/AC_CHECK_INCLUDES_DEFAULT",
    ],
)

