# //gnulib/m4/sys_types_h:gl_SYS_TYPES_H
autoconf(
    name = "gnulib/m4/sys_types_h/gl_SYS_TYPES_H",
    checks = [
        # gl_SYS_TYPES_H checks for sys/types.h header

        # AC_HEADER_MAJOR checks where major/minor/makedev are defined
        # On modern Linux (glibc), they're in sys/sysmacros.h
        # major/minor/makedev are AC_HEADER_MAJOR's business: upstream gl_SYS_TYPES_H
        # never requires it (sys_types_h.m4 only redefines the macro for autoconf before
        # 2.70.1).  Probing here made MAJOR_IN_SYSMACROS a second producer for any project
        # that calls AC_HEADER_MAJOR itself (coreutils).
        checks.AC_CHECK_TYPE(
            "blksize_t",
            name = "ac_cv_type_blksize_t",
        ),
        # AC_CHECK_TYPE only creates substitution variables, not config.h defines
        checks.AC_SUBST(
            "HAVE_BLKSIZE_T",
            condition = "ac_cv_type_blksize_t",
            if_false = 0,
            if_true = 1,
        ),
        checks.AC_CHECK_TYPE(
            "blkcnt_t",
            name = "ac_cv_type_blkcnt_t",
        ),
        # AC_CHECK_TYPE only creates substitution variables, not config.h defines
        checks.AC_SUBST(
            "HAVE_BLKCNT_T",
            condition = "ac_cv_type_blkcnt_t",
            if_false = 0,
            if_true = 1,
        ),

        # Use sane struct stat types in OpenVMS 8.2 and later
        checks.AC_DEFINE("_USE_STD_STAT", "1"),
    ] + gl_macros.GL_NEXT_HEADERS(["sys/types.h"]) + select({
        # AC_SUBST([WINDOWS_STAT_INODES]) is in gl_SYS_TYPES_H in the real m4.
        # gl_WINDOWS_STAT_INODES only sets the shell variable; sys_types_h does the subst.
        "@platforms//os:windows": [
            checks.AC_SUBST("WINDOWS_STAT_INODES", "1"),
        ],
        "//conditions:default": [
            checks.AC_SUBST("WINDOWS_STAT_INODES", "0"),
        ],
    }),
    default_deps = [":gnulib/m4/sys_types_h/defaults"],
    visibility = ["//visibility:private"],
    deps = [
        ":gnulib/m4/extensions/extensions",
        ":gnulib/m4/include_next/include_next",
        ":gnulib/m4/largefile/gl_LARGEFILE",
        ":gnulib/m4/off64_t/off64_t",
        ":gnulib/m4/windows-stat-inodes/windows-stat-inodes",
        "//autoconf/macros/AC_CHECK_INCLUDES_DEFAULT",
        "//autoconf/macros/AC_TYPE_MODE_T",
        "//autoconf/macros/AC_TYPE_PID_T",
    ],
)

