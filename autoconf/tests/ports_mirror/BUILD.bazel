# //gnulib/m4/inet_ntop:gl_FUNC_INET_NTOP
autoconf(
    name = "gnulib/m4/inet_ntop/gl_FUNC_INET_NTOP",
    checks = [
        # HAVE_INET_NTOP=1
        # INET_NTOP_LIB=
        # gl_PREREQ_SYS_H_WINSOCK2
        # if test $HAVE_WINSOCK2_H = 1; then
        #   dnl Native Windows provides it in -lws2_32 with stdcall calling
        #   dnl convention: REPLACE_INET_NTOP=1, and if <ws2tcpip.h> declares it
        #   dnl INET_NTOP_LIB="-lws2_32" else HAVE_DECL_INET_NTOP=0.
        # else
        #   AC_SEARCH_LIBS([inet_ntop], [nsl resolv network socket], [],
        #     [AC_CHECK_FUNCS([inet_ntop]); if no: HAVE_INET_NTOP=0])
        #   AC_CHECK_HEADERS_ONCE([netdb.h])
        #   AC_CHECK_DECLS([inet_ntop]) with <arpa/inet.h> and <netdb.h>
        #   if no: HAVE_DECL_INET_NTOP=0
        # fi
        # (On glibc/macOS inet_ntop is in libc, so INET_NTOP_LIB stays empty.)
        checks.AC_CHECK_FUNC(
            "inet_ntop",
            name = "_gl_cv_func_inet_ntop",
            requires = ["HAVE_WINSOCK2_H==0"],
        ),
        checks.AC_SUBST(
            "HAVE_INET_NTOP",
            condition = "HAVE_WINSOCK2_H==1 || _gl_cv_func_inet_ntop",
            if_false = "0",
            if_true = "1",
        ),
        # (The probe is not gated on the Unix branch: on native Windows the
        # header is absent, so the result is the same #undef, and the ungated
        # probe shares its result with gl_NETDB_H.)
        checks.AC_CHECK_HEADER(
            "netdb.h",
            define = "HAVE_NETDB_H",
        ),
        checks.AC_CHECK_DECL(
            "inet_ntop",
            compile_defines = [
                "HAVE_WINSOCK2_H",
                "HAVE_NETDB_H",
            ],
            define = "HAVE_DECL_INET_NTOP",
            includes = _GNULIB_M4_INET_NTOP_DECL_INCLUDES,
        ),
        checks.AC_SUBST(
            "HAVE_DECL_INET_NTOP",
            condition = "ac_cv_have_decl_inet_ntop",
            if_false = "0",
            if_true = "1",
        ),
        checks.AC_SUBST(
            "INET_NTOP_LIB",
            condition = "HAVE_WINSOCK2_H==1 && ac_cv_have_decl_inet_ntop",
            if_false = "",
            if_true = "-lws2_32",
        ),
        checks.AC_SUBST(
            "REPLACE_INET_NTOP",
            condition = "HAVE_WINSOCK2_H==1",
            if_false = "0",
            if_true = "1",
        ),
    ],
    default_deps = [":gnulib/m4/arpa_inet_h/defaults"],
    visibility = ["//visibility:private"],
    deps = [
        ":gnulib/m4/extensions/extensions",
        ":gnulib/m4/sys_socket_h/gl_PREREQ_SYS_H_WINSOCK2",
        "//autoconf/macros/AC_CHECK_INCLUDES_DEFAULT",
        "//autoconf/macros/AC_C_RESTRICT",
    ],
)

