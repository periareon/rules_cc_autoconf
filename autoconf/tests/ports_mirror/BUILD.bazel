        # Note: HAVE_WORKING_C32RTOMB is now provided by c32rtomb:gl_C32RTOMB_SANITYCHECK dependency

        # Note: These variables are provided by dependencies:
        # - GNULIBHEADERS_OVERRIDE_CHAR32_T from uchar_h
        # - HAVE_C32RTOMB from c32rtomb
        # - HAVE_DECL_WCWIDTH from wcwidth
        # - HAVE_MBRTOC16 from mbrtoc16
    ],
    default_deps = [":gnulib/m4/uchar_h/defaults"],
    visibility = ["//visibility:private"],
    deps = [
        ":gnulib/m4/mbrtoc32/gl_CHECK_FUNC_MBRTOC32",
        ":gnulib/m4/mbrtoc32/gl_MBRTOC32_C_LOCALE",
        ":gnulib/m4/mbrtoc32/gl_MBRTOC32_EMPTY_INPUT",
        ":gnulib/m4/mbrtoc32/gl_MBRTOC32_SANITYCHECK",
        ":gnulib/m4/mbrtoc32/gl_MBRTOC32_UTF8_LOCALE",
        ":gnulib/m4/mbrtowc/gl_MBSTATE_T_BROKEN",
        ":gnulib/m4/mbrtowc/mbrtowc_base",
        ":gnulib/m4/mbstate_t/mbstate_t",
        ":gnulib/m4/uchar_h/uchar_h",
