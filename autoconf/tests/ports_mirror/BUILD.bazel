# //gnulib/m4/nl_langinfo:gl_FUNC_NL_LANGINFO
autoconf(
    name = "gnulib/m4/nl_langinfo/gl_FUNC_NL_LANGINFO",
    checks = [
        # We need to also set it in subst.h (GL_CHECK_FUNCS_ANDROID pattern)
        checks.AC_SUBST(
            "HAVE_NL_LANGINFO",
            condition = "ac_cv_func_nl_langinfo",  # From AC_FUNC_NL_LANGINFO dependency
            if_false = "0",
            if_true = "1",
        ),
        # If nl_langinfo exists but has issues, replace it. If it doesn't exist
        # (e.g. Windows), don't set REPLACE — gnulib provides it from scratch.
        # The m4 only AC_DEFINEs REPLACE_NL_LANGINFO inside the "exists" branch,
        # so it stays undefined in config.h when nl_langinfo is missing.
        checks.AC_DEFINE(
            "REPLACE_NL_LANGINFO",
            condition = "ac_cv_func_nl_langinfo",
            if_false = None,
            if_true = 1,
        ),
        checks.AC_SUBST(
            "REPLACE_NL_LANGINFO",
            condition = "ac_cv_func_nl_langinfo",
            if_false = 0,
            if_true = 1,
        ),
        # Based on golden file, LIB_NL_LANGINFO="" (empty string) on macOS
        checks.AC_SUBST("LIB_NL_LANGINFO", ""),
    ] + select({
        # nl_langinfo.m4:19-24: `case "$host_os" in darwin* | solaris*) NL_LANGINFO_MTSAFE=0 ;;
        # *) 1 ;; esac` (macOS 26's nl_langinfo is not multithread-safe), defined only when
        # nl_langinfo exists (not on native Windows).  lib/nl_langinfo.c's `!NL_LANGINFO_MTSAFE`
        # branch handles macOS; only its `__sun` part reaches for Solaris names.
        "@platforms//os:macos": [
            checks.AC_DEFINE_UNQUOTED(
                "NL_LANGINFO_MTSAFE",
                "0",
                requires = ["ac_cv_func_nl_langinfo"],
            ),
        ],
        "//conditions:default": [
            checks.AC_DEFINE_UNQUOTED(
                "NL_LANGINFO_MTSAFE",
                "1",
                requires = ["ac_cv_func_nl_langinfo"],
            ),
        ],
    }),
    default_deps = [":gnulib/m4/langinfo_h/defaults"],
    visibility = ["//visibility:private"],
    deps = [
        ":gnulib/m4/langinfo_h/gl_LANGINFO_H",
        ":gnulib/m4/setlocale_null/setlocale_null",
        ":gnulib/m4/threadlib/threadlib",
        ":gnulib/macros/AC_FUNC_NL_LANGINFO/AC_FUNC_NL_LANGINFO",
        "//autoconf/macros/AC_CANONICAL_HOST",
        "//autoconf/macros/AC_CHECK_INCLUDES_DEFAULT",
    ],
)

