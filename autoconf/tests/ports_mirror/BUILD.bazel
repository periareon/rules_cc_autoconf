# //gnulib/m4/lock:gl_LOCK
autoconf(
    name = "gnulib/m4/lock/gl_LOCK",
    checks = select({
        # if test "$gl_threads_api" = posix: on Windows gl_THREADLIB picks
        # the native Windows API, so the <pthread.h> probes are skipped and
        # HAVE_PTHREAD_RWLOCK / HAVE_PTHREAD_MUTEX_RECURSIVE stay undefined.
        "@platforms//os:windows": [],
        "//conditions:default": [
            # Mac OS X 10.1 lacks the pthread_rwlock_t type and the pthread_rwlock_* functions
            checks.AC_CHECK_TYPE(
                "pthread_rwlock_t",
                define = "HAVE_PTHREAD_RWLOCK",
                includes = ["#include <pthread.h>"],
            ),

            # glibc defines PTHREAD_MUTEX_RECURSIVE as enum, not as a macro.
            # AC_COMPILE_IFELSE: define HAVE_PTHREAD_MUTEX_RECURSIVE only when
            # PTHREAD_MUTEX_RECURSIVE can be used as an integer.
            checks.AC_TRY_COMPILE(
                code = utils.AC_LANG_PROGRAM(
                    ["#include <pthread.h>"],
                    [
                        "#if __FreeBSD__ == 4",
                        'error "No, in FreeBSD 4.0 recursive mutexes actually don\'t work."',
                        "#elif (defined __ENVIRONMENT_MAC_OS_X_VERSION_MIN_REQUIRED__ \\",
                        "       && __ENVIRONMENT_MAC_OS_X_VERSION_MIN_REQUIRED__ < 1070)",
                        'error "No, in Mac OS X < 10.7 recursive mutexes actually don\'t work."',
                        "#else",
                        "int x = (int)PTHREAD_MUTEX_RECURSIVE;",
                        "return !x;",
                        "#endif",
                    ],
                ),
                define = "HAVE_PTHREAD_MUTEX_RECURSIVE",
            ),
        ],
    }),
    visibility = ["//visibility:private"],
    deps = [
        ":gnulib/m4/lock/gl_PREREQ_LOCK",
        ":gnulib/m4/pthread_rwlock_rdlock/pthread_rwlock_rdlock",
        ":gnulib/m4/threadlib/gl_THREADLIB",
        "//autoconf/macros/AC_CHECK_INCLUDES_DEFAULT",
    ],
)

