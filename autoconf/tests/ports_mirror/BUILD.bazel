# //gnulib/m4/getlocalename_l:gl_PREREQ_GETLOCALENAME_L_UNSAFE
autoconf(
    name = "gnulib/m4/getlocalename_l/gl_PREREQ_GETLOCALENAME_L_UNSAFE",
    checks = [
        # AC_CHECK_HEADERS_ONCE([langinfo.h]) - config.h define only (the
        # HAVE_LANGINFO_H subst belongs to gl_LANGINFO_H).
        checks.AC_CHECK_HEADER(
            "langinfo.h",
            define = "HAVE_LANGINFO_H",
        ),
        # if test $HAVE_LOCALE_T = 1; then
        #   gl_CHECK_FUNCS_ANDROID([newlocale]) / ([duplocale]) / ([freelocale])
        # else  (e.g. MSVC: no locale_t)
        #   gl_cv_onwards_func_{newlocale,duplocale,freelocale}='future OS version'
        #   gl_func_{newlocale,duplocale,freelocale}=no
        # fi
        # if test $gl_func_newlocale != yes; then
        #   HAVE_NEWLOCALE=0; case ... future*) REPLACE_NEWLOCALE=1 ;;
        # fi  (same for duplocale and freelocale)
        #
        # HAVE_NEWLOCALE and REPLACE_NEWLOCALE come from
        # //gnulib/m4/newlocale:gl_FUNC_NEWLOCALE, the one owner of those
        # substitutions.  Its REPLACE_NEWLOCALE is a superset of the "future
        # OS version" case above: on macOS it is also 1 for newlocale's
        # null-base bug, which this macro alone would not detect (see the
        # known divergence in //gnulib/tests/compat/getlocalename_l).
        # HAVE_FREELOCALE and REPLACE_FREELOCALE likewise come from
