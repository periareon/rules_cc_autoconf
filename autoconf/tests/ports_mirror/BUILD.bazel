# //gnulib/m4/chown:gl_FUNC_CHOWN_FOLLOWS_SYMLINK
autoconf(
    name = "gnulib/m4/chown/gl_FUNC_CHOWN_FOLLOWS_SYMLINK",
    checks = [
        checks.AC_TRY_LINK(
            name = "gl_cv_func_chown_follows_symlink",
            code = """\
#include <unistd.h>
#include <stdlib.h>
#include <errno.h>

        int
        main ()
        {
          int result = 0;
          char const *dangling_symlink = "conftest.dangle";

          unlink (dangling_symlink);
          if (symlink ("conftest.no-such", dangling_symlink))
            abort ();

          /* Exit successfully on a conforming system,
             i.e., where chown must fail with ENOENT.  */
          if (chown (dangling_symlink, getuid (), getgid ()) == 0)
            result |= 1;
          if (errno != ENOENT)
            result |= 2;
          return result;
        }
""",
        ),
        checks.AC_DEFINE(
            "CHOWN_MODIFIES_SYMLINK",
            requires = ["!gl_cv_func_chown_follows_symlink"],
        ),
    ],
    visibility = ["//visibility:private"],
    deps = ["//autoconf/macros/AC_CHECK_INCLUDES_DEFAULT"],
)

