# //gnulib/m4/renameat:gl_FUNC_RENAMEAT
autoconf(
    name = "gnulib/m4/renameat/gl_FUNC_RENAMEAT",
    checks = [

        # Note: gl_STDIO_H_DEFAULTS is a _DEFAULTS function, so we ignore it per user's instruction
        checks.AC_CHECK_HEADER(
            "linux/fs.h",
            define = "HAVE_LINUX_FS_H",
        ),
        checks.AC_CHECK_FUNC(
            "renameat",
            define = "HAVE_RENAMEAT",
            subst = True,
        ),

        # Set REPLACE_RENAMEAT substitution variable
        # If renameat exists and REPLACE_RENAME=1, then REPLACE_RENAMEAT=1
        # (without renameat the M4 sets HAVE_RENAMEAT=0 instead).
        # Otherwise, REPLACE_RENAMEAT=0
        checks.AC_SUBST(
            "REPLACE_RENAMEAT",
            condition = "ac_cv_func_renameat && REPLACE_RENAME==1",
            if_false = 0,
            if_true = 1,
        ),
        checks.AC_CHECK_FUNC(
            "renameat2",
            name = "ac_cv_func_renameat2",
        ),
        checks.AC_DEFINE(
            "HAVE_RENAMEAT2",
            condition = "ac_cv_func_renameat2",
            if_false = None,
            if_true = 1,
        ),
        # AC_RUN_IFELSE for renameat2 is skipped - runtime checks can't be done in Bazel.
        # Conditioning on the link check is the best approximation, matching what autoconf
        # does when cross-compiling for Linux ("guessing yes"), but only when the function
        # actually exists in libc (glibc >= 2.28 or musl >= 1.2.4).
        checks.AC_DEFINE(
            "HAVE_WORKING_RENAMEAT2",
            condition = "ac_cv_func_renameat2",
            if_false = None,
            if_true = 1,
        ),
    ],
    default_deps = [":gnulib/m4/stdio_h/defaults"],
    visibility = ["//visibility:private"],
    deps = [
        ":gnulib/m4/extensions/extensions",
        ":gnulib/m4/openat/openat",
        ":gnulib/m4/rename/rename",
        "//autoconf/macros/AC_CANONICAL_HOST",
        "//autoconf/macros/AC_CHECK_INCLUDES_DEFAULT",
    ],
)

