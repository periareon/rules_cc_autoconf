autoconf(
    name = "gnulib/m4/isfinite/gl_ISFINITE",
    checks = [
        # m4 line 15: AC_CHECK_DECLS([isfinite], , , [[#include <math.h>]])
        checks.AC_CHECK_DECL(
            "isfinite",
            define = "HAVE_DECL_ISFINITE",
            includes = ["#include <math.h>"],
        ),
        # m4 line 17: gl_CHECK_MATH_LIB([ISFINITE_LIBM], ...) - first without libm
        checks.AC_TRY_LINK(
            name = "gl_cv_func_isfinite_no_libm",
            code = _GNULIB_M4_ISFINITE_ISFINITE_LINK_CODE,
            requires = ["ac_cv_have_decl_isfinite"],
        ),
        # The shell variable gnulib.mk's gl_CONDITIONAL reads (`test $gl_func_isfinite_no_libm = no`).
        checks.M4_VARIABLE(
            "gl_func_isfinite_no_libm",
            condition = "gl_cv_func_isfinite_no_libm",
            if_false = "no",
            if_true = "yes",
        ),
        # ... then with -lm
        checks.AC_TRY_LINK(
            name = "gl_cv_func_isfinite_in_libm",
            code = _GNULIB_M4_ISFINITE_ISFINITE_LINK_CODE,
            linkopts = ["-lm"],
            requires = [
                "ac_cv_have_decl_isfinite",
                "!gl_cv_func_isfinite_no_libm",
            ],
        ),
        # m4 line 26-31: REPLACE_ISFINITE=1 unless declared, linkable and
        # isfinite(long double) works (also on Solaris, which is not modelled).
        checks.AC_SUBST(
            "REPLACE_ISFINITE",
            condition = "ac_cv_have_decl_isfinite && (gl_cv_func_isfinite_no_libm || gl_cv_func_isfinite_in_libm) && gl_cv_func_isfinitel_works",
            if_false = 1,
            if_true = 0,
        ),
        # m4 line 30: ISFINITE_LIBM is the library found by gl_CHECK_MATH_LIB,
        # reset to empty when the replacement is used.
        checks.AC_SUBST(
            "ISFINITE_LIBM",
            condition = "!gl_cv_func_isfinite_no_libm && gl_cv_func_isfinite_in_libm && gl_cv_func_isfinitel_works",
            if_false = "",
            if_true = "-lm",
        ),
    ],
    default_deps = [":gnulib/m4/math_h/defaults"],
    visibility = ["//visibility:private"],
    deps = [
        ":gnulib/m4/exponentd/exponentd",
        ":gnulib/m4/exponentl/exponentl",
        ":gnulib/m4/extensions/extensions",
        ":gnulib/m4/isfinite/gl_ISFINITEL_WORKS",
        ":gnulib/m4/math_h/long-double-vs-double",
