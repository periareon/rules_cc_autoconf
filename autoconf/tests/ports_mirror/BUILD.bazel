# //gnulib/m4/spawn_h:gl_HAVE_POSIX_SPAWN
autoconf(
    name = "gnulib/m4/spawn_h/gl_HAVE_POSIX_SPAWN",
    checks = select({
        "@platforms//os:windows": [
            # Windows has no POSIX spawn API.  UCRT ships a spawn.h
            # (with _spawnl etc.) but not posix_spawn().  Skip the link
            # check and hard-code the result.
            checks.AC_SUBST("HAVE_POSIX_SPAWN", 0),
        ],
        "//conditions:default": [
            # gl_CHECK_FUNCS_ANDROID([posix_spawn], [[#include <spawn.h>]])
            # Use extern declaration trick - don't include header to avoid conflicts
            # The function check uses linking, so it will detect the function even without header
            checks.AC_CHECK_FUNC(
                "posix_spawn",
                define = "HAVE_POSIX_SPAWN",
                # Don't include spawn.h - use extern declaration trick instead
                # This matches gl_CHECK_FUNCS_ANDROID behavior
                subst = True,
            ),
        ],
    }) + [
        # POSIX_SPAWN_LIB and LIB_POSIX_SPAWN substitution variables
        # AC_SEARCH_LIBS([posix_spawn], [rt], ...) - typically empty on macOS/Linux
        checks.AC_SUBST("POSIX_SPAWN_LIB", ""),
        checks.AC_SUBST("LIB_POSIX_SPAWN", ""),
    ],
    default_deps = [":gnulib/m4/spawn_h/defaults"],
    visibility = ["//visibility:private"],
    deps = ["//autoconf/macros/AC_CHECK_INCLUDES_DEFAULT"],
)

# //gnulib/m4/spawn_h:gl_SPAWN_H
autoconf(
    name = "gnulib/m4/spawn_h/gl_SPAWN_H",
    checks = [
        # gl_SPAWN_H checks for spawn.h header
        checks.AC_CHECK_HEADER(
            "spawn.h",
            define = "HAVE_SPAWN_H",
            subst = True,  # Also create substitution variable
        ),
    ] + gl_macros.GL_CHECK_NEXT_HEADERS(["spawn.h"]) + select({
        "@platforms//os:windows": [
            # Windows has no POSIX spawn types.  Emit explicit subst values
            # so @HAVE_POSIX_SPAWNATTR_T@ etc. are "0" rather than empty
            # (which would make `#if !` invalid).
            checks.AC_SUBST("HAVE_POSIX_SPAWNATTR_T", "0"),
            checks.AC_SUBST("HAVE_POSIX_SPAWN_FILE_ACTIONS_T", "0"),
        ],
        "//conditions:default": [
            checks.AC_CHECK_TYPE(
                "posix_spawnattr_t",
                name = "_gl_cv_type_posix_spawnattr_t",
                includes = ["#include <spawn.h>"],
            ),
            checks.AC_CHECK_TYPE(
                "posix_spawn_file_actions_t",
                name = "_gl_cv_type_posix_spawn_file_actions_t",
                includes = ["#include <spawn.h>"],
            ),
            checks.AC_DEFINE(
                "HAVE_POSIX_SPAWNATTR_T",
                requires = ["_gl_cv_type_posix_spawnattr_t==1"],
                subst = True,
            ),
            checks.AC_DEFINE(
                "HAVE_POSIX_SPAWN_FILE_ACTIONS_T",
                requires = ["_gl_cv_type_posix_spawn_file_actions_t==1"],
                subst = True,
            ),
        ],
    }),
    default_deps = [":gnulib/m4/spawn_h/defaults"],
    visibility = ["//visibility:private"],
    deps = [
        ":gnulib/m4/include_next/include_next",
        ":gnulib/m4/spawn_h/gl_HAVE_POSIX_SPAWN",
        "//autoconf/macros/AC_CHECK_INCLUDES_DEFAULT",
        "//autoconf/macros/AC_TYPE_MODE_T",
