            # HAVE_REALLOC_0_NONNULL stays undefined.
        ],
    }),
    default_deps = [":gnulib/m4/stdlib_h/defaults"],
    visibility = ["//visibility:private"],
    deps = [
        ":gnulib/m4/realloc/gl_FUNC_REALLOC_POSIX",
