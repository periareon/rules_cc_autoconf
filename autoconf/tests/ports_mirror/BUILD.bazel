# //gnulib/m4/c32rtomb:gl_CHECK_FUNC_C32RTOMB
autoconf(
    name = "gnulib/m4/c32rtomb/gl_CHECK_FUNC_C32RTOMB",
    checks = [
        # M4: AC_CHECK_DECL([c32rtomb], ..., [#include <uchar.h>]).
        #
        # On macOS this is the probe to trust, not the deployment target: an
        # earlier revision answered "yes" from __MAC_OS_X_VERSION_MIN_REQUIRED
        # whenever the target was 11.0 or later, and consumers then failed to
        # compile (sed and grep calling c32rtomb with HAVE_C32RTOMB=1 and no
        # declaration in sight) under a hermetic LLVM toolchain whose SDK
        # headers do not declare it.  A declaration the probe cannot see is
        # one the sources cannot see either, since both compile with the same
        # flags; "no" then makes gnulib declare and supply c32rtomb itself,
        # which is what configure does on such a system.
        checks.AC_CHECK_DECL(
            "c32rtomb",
            name = "ac_cv_have_decl_c32rtomb",
            includes = ["#ifdef __HAIKU__\n#include <stdint.h>\n#endif\n#include <uchar.h>"],
        ),
        # M4: if test $ac_cv_have_decl_c32rtomb = yes; then
        #       AC_LINK_IFELSE(...) else gl_cv_func_c32rtomb=no.
        checks.AC_TRY_LINK(
            name = "gl_cv_func_c32rtomb",
            code = """\
#include <stdlib.h>
#ifdef __HAIKU__
#include <stdint.h>
#endif
#include <uchar.h>
int main(void) {
    char buf[8];
    return c32rtomb(buf, 0, NULL) == 0;
}
""",
            requires = ["ac_cv_have_decl_c32rtomb==1"],
        ),
    ],
    visibility = ["//visibility:private"],
    deps = ["//autoconf/macros/AC_CHECK_INCLUDES_DEFAULT"],
)

# //gnulib/m4/c32rtomb:gl_FUNC_C32RTOMB
autoconf(
    name = "gnulib/m4/c32rtomb/gl_FUNC_C32RTOMB",
    checks = [
        # M4: if test $gl_cv_func_c32rtomb = no; then HAVE_C32RTOMB=0; fi
        # Override the gl_UCHAR_H_DEFAULTS toolchain default (1) when the
        # function is absent.
        checks.AC_SUBST(
            "HAVE_C32RTOMB",
            condition = "gl_cv_func_c32rtomb",
            if_false = "0",
            if_true = "1",
        ),
        # M4 lines 23-58: inside the "c32rtomb exists" arm, set
        # REPLACE_C32RTOMB=1 if ANY of:
        #   (a) HAVE_WORKING_MBRTOC32 == 0 (line 25-27)
        #   (b) gl_cv_func_c32rtomb_retval != yes (runtime; line 28-51)
        #       cross-compile guess: aix*=no, others=yes
        #   (c) HAVE_WORKING_C32RTOMB == 0 (line 56-58)
        # (a) and (c) are real substs from sibling modules. (b) is a runtime
        # probe and the cross-compile guess is "yes" everywhere except AIX,
        # which we don't target - so we don't model it here.
        checks.AC_SUBST(
            "REPLACE_C32RTOMB",
            condition = "gl_cv_func_c32rtomb==1 && (HAVE_WORKING_MBRTOC32==0 || HAVE_WORKING_C32RTOMB==0)",
            if_false = "0",
            if_true = "1",
        ),
    ] + select({
        # (b) on native Windows the native run gives gl_cv_func_c32rtomb_retval=no
        #     (c32rtomb (NULL, 0, NULL) != 1): C32RTOMB_RETVAL_BUG is defined.
        #     REPLACE_C32RTOMB is already 1 there via HAVE_WORKING_MBRTOC32=0.
        "@platforms//os:windows": [
            checks.AC_DEFINE(
                "C32RTOMB_RETVAL_BUG",
                "1",
                requires = ["gl_cv_func_c32rtomb==1"],
            ),
        ],
        "//conditions:default": [],
    }),
    default_deps = [":gnulib/m4/uchar_h/defaults"],
    visibility = ["//visibility:private"],
    deps = [
        ":gnulib/m4/c32rtomb/gl_C32RTOMB_SANITYCHECK",
        ":gnulib/m4/c32rtomb/gl_CHECK_FUNC_C32RTOMB",
        ":gnulib/m4/locale-fr/locale-fr",
        ":gnulib/m4/locale-zh/locale-zh",
        ":gnulib/m4/mbrtoc32/gl_MBRTOC32_SANITYCHECK",
        "//autoconf/macros/AC_CANONICAL_HOST",
        "//autoconf/macros/AC_CHECK_INCLUDES_DEFAULT",
    ],
)

