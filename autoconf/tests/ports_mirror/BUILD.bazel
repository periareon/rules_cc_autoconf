autoconf(
    name = "gnulib/m4/vasnprintf/gl_PREREQ_VASNWPRINTF",
    checks = [
        # Note: HAVE_SWPRINTF comes from printf dependency via gl_SWPRINTF_WORKS
        checks.AC_CHECK_DECL(
            "_snwprintf",
            define = "HAVE_DECL__SNWPRINTF",
            includes = ["#include <stdio.h>"],
        ),
        checks.AC_CHECK_DECL(
            "wcsnlen",
            define = "HAVE_DECL_WCSNLEN",
            includes = ["#include <wchar.h>"],
        ),
        # NEED_WPRINTF_DIRECTIVE_C: unless both gl_cv_func_mbrtowc_C_locale_sans_EILSEQ
        #   and gl_cv_func_swprintf_C_locale_sans_EILSEQ are yes (runtime tests).
        # NEED_WPRINTF_DIRECTIVE_LA: unless gl_cv_func_swprintf_directive_la is yes.
        # NEED_WPRINTF_DIRECTIVE_LC: unless gl_cv_func_swprintf_directive_lc is yes.
    ] + select({
        # glibc: swprintf (L"%c", '\377') fails in the C locale (glibc 2.35);
        # 'La' and 'lc' work.
        "@platforms//os:linux": [
            checks.AC_DEFINE("NEED_WPRINTF_DIRECTIVE_C", "1"),
        ],
        # MSVC: 'c' and 'lc' work, 'La' produces wrong values.
        "@platforms//os:windows": [
            checks.AC_DEFINE("NEED_WPRINTF_DIRECTIVE_LA", "1"),
        ],
        # macOS: 'c' and 'lc' are broken, 'La' works.
        "//conditions:default": [
            checks.AC_DEFINE("NEED_WPRINTF_DIRECTIVE_C", "1"),
            checks.AC_DEFINE("NEED_WPRINTF_DIRECTIVE_LC", "1"),
        ],
    }) + [
    ],
    visibility = ["//visibility:private"],
    deps = [
        ":gnulib/m4/printf/gl_SWPRINTF_DIRECTIVE_LA",
        ":gnulib/m4/printf/gl_SWPRINTF_DIRECTIVE_LC",
