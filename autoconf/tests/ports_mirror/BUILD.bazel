# //gnulib/m4/fsusage:gl_FILE_SYSTEM_USAGE
autoconf(
    name = "gnulib/m4/fsusage/gl_FILE_SYSTEM_USAGE",
    checks = [
        checks.AC_TRY_LINK(
            name = "fu_cv_sys_stat_statvfs",
            code = utils.AC_LANG_PROGRAM(
                [_gnulib_m4_fsusage_fu_cv_sys_stat_statvfs_include],
                "statvfs (0, &fsd);",
            ),
        ),
        checks.AC_TRY_LINK(
            name = "fu_cv_sys_stat_statvfs64",
            code = utils.AC_LANG_PROGRAM(
                [_gnulib_m4_fsusage_fu_cv_sys_stat_statvfs64_include],
                "statvfs64 (0, &fsd);",
            ),
            requires = ["fu_cv_sys_stat_statvfs"],
        ),
        checks.AC_DEFINE(
            "STAT_STATVFS64",
            requires = [
                "fu_cv_sys_stat_statvfs",
                "fu_cv_sys_stat_statvfs64",
            ],
        ),
        checks.AC_DEFINE(
            "STAT_STATVFS",
            requires = [
                "fu_cv_sys_stat_statvfs",
                "!fu_cv_sys_stat_statvfs64",
            ],
        ),
        # macOS uses BSD-style statfs with f_bsize member (statvfs check fails).
        # M4 runs the program below (AC_RUN_IFELSE, cross-compile guess "no");
        # hosts without <sys/mount.h>/<sys/vfs.h> or statfs (Windows) fail to
        # build it.
        checks.AC_TRY_LINK(
            name = "fu_cv_sys_stat_statfs2_bsize",
            code = """\
#ifdef HAVE_SYS_PARAM_H
#include <sys/param.h>
#endif
#ifdef HAVE_SYS_MOUNT_H
#include <sys/mount.h>
#endif
#ifdef HAVE_SYS_VFS_H
#include <sys/vfs.h>
#endif
  int
  main ()
  {
    struct statfs fsd;
    fsd.f_bsize = 0;
    return statfs (".", &fsd) != 0;
  }
""",
            compile_defines = [
                "HAVE_SYS_MOUNT_H",
                "HAVE_SYS_PARAM_H",
                "HAVE_SYS_VFS_H",
            ],
            requires = ["!fu_cv_sys_stat_statvfs"],
        ),
        checks.AC_DEFINE(
            "STAT_STATFS2_BSIZE",
            requires = ["fu_cv_sys_stat_statfs2_bsize"],
        ),
        # gl_FILE_SYSTEM_USAGE([gl_cv_fs_space=yes], [gl_cv_fs_space=no]) from gl_FSUSAGE: the
        # action-if-found runs when one of the space-reporting calls works (fsusage.c is
        # compiled on it; coreutils builds df on it).  The variable holds the word GNU assigns,
        # so consumers compare it by value (`gl_cv_fs_space==yes`).
        checks.M4_VARIABLE(
            "gl_cv_fs_space",
            condition = "fu_cv_sys_stat_statvfs || fu_cv_sys_stat_statvfs64 || fu_cv_sys_stat_statfs2_bsize",
            if_false = "no",
            if_true = "yes",
        ),
    ] + select({
        # Linux also has statfs with f_frsize member
        "@platforms//os:linux": [
            checks.AC_DEFINE("STAT_STATFS2_FRSIZE", 1),
        ],
        "//conditions:default": [],
    }),
    visibility = ["//visibility:private"],
    deps = [
        ":gnulib/m4/mountlist/mountlist",
        ":gnulib/macros/HAVE_SYS_PARAM_H/HAVE_SYS_PARAM_H",
        ":gnulib/macros/HAVE_SYS_VFS_H/HAVE_SYS_VFS_H",
        "//autoconf/macros/AC_SYS_LARGEFILE",
    ],
)

