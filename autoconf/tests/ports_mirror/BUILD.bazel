# //gnulib/m4/memmem:gl_FUNC_MEMMEM_SIMPLE
autoconf(
    name = "gnulib/m4/memmem/gl_FUNC_MEMMEM_SIMPLE",
    checks = [

        # Use internal define to avoid conflict with substitution variable
        checks.AC_CHECK_FUNC(
            "memmem",
            name = "ac_cv_func_memmem",
        ),

        # if test $ac_cv_func_memmem = yes; then
        #   HAVE_MEMMEM=1
        # else
        #   HAVE_MEMMEM=0
        # fi
        # AC_CHECK_FUNCS([memmem]) defines HAVE_MEMMEM in config.h only when the
        # function is found (e.g. MSVC has no memmem).
        checks.AC_DEFINE(
            "HAVE_MEMMEM",
            condition = "ac_cv_func_memmem",
            if_false = None,
            if_true = 1,
        ),

        # AC_CHECK_DECLS_ONCE([memmem]) defines HAVE_DECL_MEMMEM to 1 or 0.
        # The declaration needs _GNU_SOURCE before glibc 2.38 (memmem.m4
        # requires AC_USE_SYSTEM_EXTENSIONS).
        checks.AC_CHECK_DECL(
            "memmem",
            name = "ac_cv_have_decl_memmem",
            compile_defines = ["_GNU_SOURCE"],
            includes = ["#include <string.h>"],
        ),
        checks.AC_DEFINE(
            "HAVE_DECL_MEMMEM",
            condition = "ac_cv_have_decl_memmem",
            if_false = 0,
            if_true = 1,
        ),

        # if test $ac_cv_have_decl_memmem = no; then
        #   HAVE_DECL_MEMMEM=0
        # else
        #   ... gl_cv_func_memmem_works_always (AC_RUN_IFELSE) ...
        # fi
        # Overrides the gl_STRING_H_DEFAULTS value of 1 when memmem is not declared.
        checks.AC_SUBST(
            "HAVE_DECL_MEMMEM",
            condition = "ac_cv_have_decl_memmem",
            if_false = 0,
            if_true = 1,
        ),
    ] + select({
        # glibc: the gl_cv_func_memmem_works_always runtime test passes.
        "@platforms//os:linux": [
            checks.AC_SUBST("REPLACE_MEMMEM", 0),
        ],
        # Elsewhere the runtime test either fails (macOS) or cannot run (cross
        # guess "guessing no"), so a declared memmem is replaced. When memmem
        # is not declared at all (MSVC) the m4 never reaches that branch and
        # REPLACE_MEMMEM keeps its default of 0.
        "//conditions:default": [
            checks.AC_SUBST(
                "REPLACE_MEMMEM",
                condition = "ac_cv_have_decl_memmem",
                if_false = 0,
                if_true = 1,
            ),
        ],
    }),
    default_deps = [":gnulib/m4/string_h/defaults"],
    visibility = ["//visibility:private"],
