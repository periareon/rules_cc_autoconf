# //gnulib/m4/uchar_h:gl_UCHAR_H
autoconf(
    name = "gnulib/m4/uchar_h/gl_UCHAR_H",
    checks = [
        # gl_CHECK_NEXT_HEADERS([uchar.h]) also checks for the header
        checks.AC_CHECK_HEADER(
            "uchar.h",
            name = "ac_cv_header_uchar_h",
        ),
        # if test $ac_cv_header_uchar_h = yes; then HAVE_UCHAR_H=1 else HAVE_UCHAR_H=0 fi
        checks.AC_DEFINE(
            "HAVE_UCHAR_H",
            requires = ["ac_cv_header_uchar_h==1"],
        ),
        checks.AC_SUBST(
            "HAVE_UCHAR_H",
            condition = "ac_cv_header_uchar_h",
            if_false = "0",
            if_true = "1",
        ),
        # CXX_HAVE_UCHAR_H: check if C++ compiler has <uchar.h>
        # On Linux: yes (glibc). On macOS: yes (libc++).
        checks.AC_TRY_COMPILE(
            name = "gl_cv_cxx_have_uchar_h",
            code = """\
#include <uchar.h>
int main() { return 0; }
""",
            language = "cpp",
        ),
        checks.AC_SUBST(
            "CXX_HAVE_UCHAR_H",
            condition = "gl_cv_cxx_have_uchar_h",
            if_false = "0",
            if_true = "1",
        ),
        # CXX_HAS_CHAR8_TYPE: 0 on all platforms (char8_t is C++20, not yet available)
        checks.AC_SUBST("CXX_HAS_CHAR8_TYPE", "0"),
        # gl_STDINT_BITSIZEOF([wchar_t])
        checks.AC_COMPUTE_INT(
            "BITSIZEOF_WCHAR_T",
            "(int)(sizeof(wchar_t) * CHAR_BIT)",
            includes = [
                "#include <limits.h>",
                "#include <stddef.h>",
            ],
            subst = True,
        ),
        # if test $BITSIZEOF_WCHAR_T -lt 32; then SMALL_WCHAR_T=1
        checks.AC_SUBST(
            "SMALL_WCHAR_T",
            condition = "BITSIZEOF_WCHAR_T<32",
            if_false = "0",
            if_true = "1",
        ),
        # CXX_HAS_UCHAR_TYPES=0
        # if test $HAVE_UCHAR_H = 0; then  (M4 lines 62-87)
        #   gl_cv_cxx_has_uchar_types: does the C++ compiler predefine
        #   char16_t/char32_t?  (Linux/MSVC: <uchar.h> exists, check skipped,
        #   stays 0.  macOS: no C <uchar.h>, clang++ predefines them, 1.)
        checks.AC_TRY_COMPILE(
            name = "gl_cv_cxx_has_uchar_types",
            code = """#include <stddef.h>
char16_t a;
char32_t b;
""",
            language = "cpp",
            requires = ["!ac_cv_header_uchar_h"],
        ),
        checks.AC_SUBST(
            "CXX_HAS_UCHAR_TYPES",
            condition = "gl_cv_cxx_has_uchar_types",
            if_false = "0",
            if_true = "1",
        ),
    ] + gl_macros.GL_CHECK_NEXT_HEADERS(["uchar.h"]),
    default_deps = [":gnulib/m4/uchar_h/defaults"],
    visibility = ["//visibility:private"],
    deps = [
        ":gnulib/m4/include_next/include_next",
        "//autoconf/macros/AC_CHECK_INCLUDES_DEFAULT",
    ],
)

