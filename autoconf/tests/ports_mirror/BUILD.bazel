# //gnulib/m4/iconv:AM_ICONV
autoconf(
    name = "gnulib/m4/iconv/AM_ICONV",
    checks = [
        # Note: AM_ICONV_LINK is provided by AM_ICONV_LINK dependency

        # if test "$am_cv_func_iconv" = yes; then
        #   gl_cv_iconv_nonconst: does the POSIX (non-const) prototype compile?
        # else
        #   gl_cv_iconv_nonconst=yes  (no iconv at all, e.g. MSVC: pick the
        #                             POSIX compliant declaration without const)
        # fi
        checks.AC_TRY_COMPILE(
            name = "_gl_cv_iconv_nonconst",
            code = utils.AC_LANG_PROGRAM(
                ["\n".join([
                    "#include <stdlib.h>",
                    "#include <iconv.h>",
                    "extern",
                    "#ifdef __cplusplus",
                    "\"C\"",
                    "#endif",
                    "size_t iconv (iconv_t cd, char * *inbuf, size_t *inbytesleft, char * *outbuf, size_t *outbytesleft);",
                ])],
                "",
            ),
            language = "c",
            requires = ["_am_cv_func_iconv"],
        ),

        # Define ICONV_CONST as empty string if non-const is supported (or iconv
        # is absent), or "const" if const is required.
        # Use AC_DEFINE_UNQUOTED to match the m4 file and generate trailing space for empty values
        checks.AC_DEFINE_UNQUOTED(
            "ICONV_CONST",
            condition = "_am_cv_func_iconv && !_gl_cv_iconv_nonconst",
            if_false = "",  # Non-const iconv signature - empty, will generate "#define ICONV_CONST " (trailing space)
            if_true = "const",  # Const iconv signature (some systems like Solaris, HP-UX)
            subst = True,  # Also create substitution variable for gnulib generated <iconv.h>
        ),
    ],
    default_deps = [":gnulib/m4/iconv_h/defaults"],
    visibility = ["//visibility:private"],
    deps = [
        ":gnulib/m4/iconv/AM_ICONV_LINK",
        "//autoconf/macros/AC_CHECK_INCLUDES_DEFAULT",
    ],
)

