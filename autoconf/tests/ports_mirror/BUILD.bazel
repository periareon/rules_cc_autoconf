        checks.AC_CHECK_DECL(
            "mbrtoc32",
            name = "ac_cv_have_decl_mbrtoc32",
            includes = ["#include <uchar.h>"],
        ),

        # if test $ac_cv_have_decl_mbrtoc32 = yes; then
