# //gnulib/m4/uchar_h:gl_TYPE_CHAR32_T
autoconf(
    name = "gnulib/m4/uchar_h/gl_TYPE_CHAR32_T",
    checks = [
        checks.AC_TRY_COMPILE(
            name = "gl_cv_type_char32_t_works",
            code = """\
#ifdef __HAIKU__
#include <stdchar.h>
#endif
#include <uchar.h>
int verify[(char32_t)(-1) >= 0 && sizeof (char32_t) == sizeof (unsigned int) ? 1 : -1];
int main(void) { return 0; }
""",
        ),
        checks.AC_SUBST(
            "GNULIBHEADERS_OVERRIDE_CHAR32_T",
            condition = "gl_cv_type_char32_t_works",
            # Use integers (not strings) so the cache value is stored as
            # raw `0`/`1` rather than JSON-quoted `"\"0\""`/`"\"1\""`.
            # Downstream conditions (e.g. c32rtomb's HAVE_WORKING gate)
            # compare against `0` / `1`; the string form would always
            # mismatch and silently take the wrong arm.
            if_false = 1,
            if_true = 0,
        ),
    ],
    default_deps = [":gnulib/m4/uchar_h/defaults"],
    visibility = ["//visibility:private"],
)

