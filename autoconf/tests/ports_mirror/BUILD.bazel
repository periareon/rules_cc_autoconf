# //gnulib/m4/getcwd:gl_FUNC_GETCWD
autoconf(
    name = "gnulib/m4/getcwd/gl_FUNC_GETCWD",
    checks = [
        # Note: gl_UNISTD_H_DEFAULTS is a _DEFAULTS function, so we ignore it per user's instruction

        # Note: AC_RUN_IFELSE for gl_cv_func_getcwd_path_max (lines 122-122) and
        # gl_FUNC_GETCWD_ABORT_BUG (lines 125-125) are not directly portable to
        # Bazel's cross-compilation environment. HAVE_MINIMALLY_WORKING_GETCWD,
        # HAVE_PARTLY_WORKING_GETCWD, and HAVE_GETCWD_SHORTER are set based on
        # golden file expectations for macOS/Linux.
        # On macOS, HAVE_MINIMALLY_WORKING_GETCWD=1 (line 135-138)
        # On macOS/Linux, getcwd works correctly, so REPLACE_GETCWD=0
        checks.AC_DEFINE("HAVE_MINIMALLY_WORKING_GETCWD", "1"),

        # Golden expects HAVE_UNISTD_H="@VAR@" (not "1")
        # Don't set it - let it remain unsubstituted
        # REPLACE_GETCWD=1 when getcwd (NULL, 0) does not allocate, the
        # signature is not POSIX (no <unistd.h> on MSVC), the path-max probe
        # fails or the abort bug is present. macOS/Linux pass the path-max
        # and abort-bug probes and Windows skips them, so this is the same
        # expression as in gl_FUNC_GETCWD_LGPL and the two targets agree.
        checks.AC_SUBST(
            "REPLACE_GETCWD",
            condition = "_gl_cv_func_getcwd_posix_signature",
            if_false = 1,
            if_true = 0,
        ),
    ],
    default_deps = [":gnulib/m4/unistd_h/defaults"],
    visibility = ["//visibility:private"],
    deps = [
        ":gnulib/m4/d-ino/d-ino",
        ":gnulib/m4/getcwd/HAVE_DECL_GETCWD",
        ":gnulib/m4/getcwd/gl_FUNC_GETCWD_NULL",
        ":gnulib/m4/getcwd/gl_FUNC_GETCWD_SIGNATURE",
        ":gnulib/macros/HAVE_SYS_PARAM_H/HAVE_SYS_PARAM_H",
        "//autoconf/macros/AC_CANONICAL_HOST",
        "//autoconf/macros/AC_CHECK_DECLS_ONCE_ALARM",
