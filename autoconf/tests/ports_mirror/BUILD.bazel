# //gnulib/m4/netinet_in_h:gl_HEADER_NETINET_IN
autoconf(
    name = "gnulib/m4/netinet_in_h/gl_HEADER_NETINET_IN",
    checks = [
        # AC_CACHE_CHECK([whether <netinet/in.h> is self-contained])
        checks.AC_TRY_COMPILE(
            name = "gl_cv_header_netinet_in_h_selfcontained",
            code = "struct sockaddr_in sa; (void)sa;",
            includes = ["#include <netinet/in.h>"],
        ),
        checks.AC_CHECK_HEADER(
            "netinet/in.h",
            define = "HAVE_NETINET_IN_H",
        ),

        # Type checks
        checks.AC_CHECK_TYPE(
            "struct sockaddr_in",
            define = "HAVE_STRUCT_SOCKADDR_IN",
            includes = ["#include <netinet/in.h>"],
        ),
        checks.AC_CHECK_TYPE(
            "struct sockaddr_in6",
            define = "HAVE_STRUCT_SOCKADDR_IN6",
            includes = ["#include <netinet/in.h>"],
        ),
        checks.AC_CHECK_TYPE(
            "in_addr_t",
            define = "HAVE_IN_ADDR_T",
            includes = ["#include <netinet/in.h>"],
        ),
        checks.AC_CHECK_TYPE(
            "in_port_t",
            define = "HAVE_IN_PORT_T",
            includes = ["#include <netinet/in.h>"],
        ),

        # Constants check
        checks.AC_TRY_COMPILE(
            code = "int x = INET_ADDRSTRLEN; (void)x;",
            define = "HAVE_INET_ADDRSTRLEN",
            includes = ["#include <netinet/in.h>"],
        ),
        checks.AC_TRY_COMPILE(
            code = "int x = INET6_ADDRSTRLEN; (void)x;",
            define = "HAVE_INET6_ADDRSTRLEN",
            includes = ["#include <netinet/in.h>"],
        ),

        # HAVE_IPV4 / HAVE_IPV6 are defined by gl_SOCKET_FAMILIES (sockpfaf.m4),
        # not by gl_HEADER_NETINET_IN.
        # GL_GENERATE_NETINET_IN_H (gl_CONDITIONAL_HEADER): the wrapper is
        # generated when <netinet/in.h> is not self-contained.  An
        # M4_VARIABLE, like GL_GENERATE_ALLOCA_H: an automake conditional.
        checks.M4_VARIABLE(
            "GL_GENERATE_NETINET_IN_H",
            condition = "gl_cv_header_netinet_in_h_selfcontained",
            if_false = "true",
            if_true = "false",
        ),
        # gl_CHECK_NEXT_HEADERS([netinet/in.h]) - only called when not self-contained
    ] + gl_macros.GL_NEXT_HEADERS(
        ["netinet/in.h"],
        condition = "!gl_cv_header_netinet_in_h_selfcontained",
    ),
    visibility = ["//visibility:private"],
    deps = [
        ":gnulib/m4/include_next/include_next",
        "//autoconf/macros/AC_CHECK_INCLUDES_DEFAULT",
    ],
)

