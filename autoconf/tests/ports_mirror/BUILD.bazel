        # (lowers the gl_WCHAR_H_DEFAULTS substitution)
        checks.AC_SUBST(
            "HAVE_WCRTOMB",
            condition = "ac_cv_func_wcrtomb",
            if_false = 0,
            if_true = 1,
        ),
        checks.AC_CHECK_DECL(
            "wcrtomb",
            name = "ac_cv_have_decl_wcrtomb",
            includes = ["#include <wchar.h>"],
            requires = ["!ac_cv_func_wcrtomb"],
        ),

        # REPLACE_WCRTOMB logic:
        # - If function exists, REPLACE_WCRTOMB=0 (based on golden files, it works correctly on macOS/Linux)
        #   The AC_RUN_IFELSE checks can't be done in Bazel, so we assume it works correctly
        # - If function doesn't exist but declaration exists, REPLACE_WCRTOMB=1
        # - If function doesn't exist and declaration doesn't exist, REPLACE_WCRTOMB=0
        # Based on golden files, REPLACE_WCRTOMB=0 on macOS/Linux (function exists and works correctly)
    ] + select({
        # gl_cv_func_wcrtomb_retval: "Guess no on AIX 4, Solaris, native
        # Windows"; the native MSVC run confirms wcrtomb (NULL, 0, NULL) != 1,
        # so WCRTOMB_RETVAL_BUG is defined and REPLACE_WCRTOMB=1.
        "@platforms//os:windows": [
            checks.AC_DEFINE(
                "WCRTOMB_RETVAL_BUG",
                "1",
                requires = ["ac_cv_func_wcrtomb"],
            ),
            checks.AC_SUBST(
                "REPLACE_WCRTOMB",
                condition = "ac_cv_func_wcrtomb",
                if_false = "0",
                if_true = "1",
            ),
        ],
        "//conditions:default": [
            checks.AC_SUBST("REPLACE_WCRTOMB", 0),
        ],
    }),
    default_deps = [":gnulib/m4/wchar_h/defaults"],
    visibility = ["//visibility:private"],
    deps = [
        ":gnulib/m4/locale-fr/locale-fr",
        ":gnulib/m4/mbrtowc/mbrtowc_base",
        ":gnulib/m4/mbstate_t/mbstate_t",
        ":gnulib/m4/wcrtomb/AC_CHECK_FUNCS_wcrtomb",
        "//autoconf/macros/AC_CHECK_INCLUDES_DEFAULT",
        "//autoconf/macros/AC_TYPE_MBSTATE_T",
    ],
)

