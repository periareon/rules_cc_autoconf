# //gnulib/m4/vsnprintf:gl_FUNC_VSNPRINTF
autoconf(
    name = "gnulib/m4/vsnprintf/gl_FUNC_VSNPRINTF",
    checks = [
        # Note: gl_STDIO_H_DEFAULTS is a _DEFAULTS function, so we ignore it per user's instruction
        checks.AC_CHECK_FUNC(
            "vsnprintf",
            # GNU's program alone: gl_REPLACE_VSNPRINTF is built on GNU's "no" for
            # the UCRT's header-inline vsnprintf; the default AC_CHECK_FUNC code
            # list would say yes on MSVC.
            # https://github.com/coreutils/gnulib/blob/1039a5f2cee3cda1c11f64a5eb3a15b2e87cd2f0/m4/vsnprintf.m4#L45-L62
            code = utils.AC_LANG_FUNC_LINK_TRY("vsnprintf"),
        ),

        # if test $ac_cv_func_vsnprintf = yes; then
        #   case "$gl_cv_func_snprintf_size1" in
        #     *yes)
        #       case "$gl_cv_func_snprintf_retval_c99" in
        #         *yes)
        #           case "$gl_cv_func_printf_positions" in
        #             *yes)
        #           esac
        #       esac
        #   esac
        # fi
        # if test $gl_cv_func_vsnprintf_usable = no; then
        # fi
        # The runtime checks (gl_SNPRINTF_SIZE1, gl_SNPRINTF_RETVAL_C99, gl_PRINTF_POSITIONS)
        # can't be done in Bazel. Based on golden files, vsnprintf is not usable on macOS,
        # so we always call gl_REPLACE_VSNPRINTF.

        # AC_CHECK_FUNCS([vsnprintf]) defines HAVE_VSNPRINTF in config.h only
        # when the function is found; otherwise the macro stays undefined.
        checks.AC_DEFINE(
            "HAVE_VSNPRINTF",
            condition = "ac_cv_func_vsnprintf",
            if_false = None,
            if_true = 1,
        ),
        checks.AC_CHECK_DECL(
            "vsnprintf",
            name = "ac_cv_have_decl_vsnprintf",
            includes = ["#include <stdio.h>"],
        ),

        # if test $ac_cv_have_decl_vsnprintf = no; then
        # fi
        # Set HAVE_DECL_VSNPRINTF as substitution variable and define in config.h
        # On macOS, vsnprintf is declared, so HAVE_DECL_VSNPRINTF=1
        checks.AC_DEFINE(
            "HAVE_DECL_VSNPRINTF",
            1,  # Integer, not string - renders as unquoted 1
            subst = True,  # Also create substitution variable
        ),
    ] + select({
        # gl_cv_func_vsnprintf_usable=no
        # if test $ac_cv_func_vsnprintf = yes; then
        #   gl_SNPRINTF_SIZE1 / gl_SNPRINTF_RETVAL_C99 / gl_PRINTF_POSITIONS
        #   all *yes -> gl_cv_func_vsnprintf_usable=yes
        # fi
        # if test $gl_cv_func_vsnprintf_usable = no; then gl_REPLACE_VSNPRINTF; fi
        # These are runtime tests. On native Windows gl_PRINTF_POSITIONS is "no"
        # (MSVC's printf has no positional arguments; the cross-compile guess
        # for mingw/windows says the same), so vsnprintf is not usable and
        # gl_REPLACE_VSNPRINTF sets REPLACE_VSNPRINTF=1 because vsnprintf is
        # declared. Same constant as vsnprintf-posix so both can share a graph.
        "@platforms//os:windows": [
            checks.AC_SUBST("REPLACE_VSNPRINTF", "1"),
        ],
        # glibc and macOS pass all three runtime tests: vsnprintf is usable.
        "//conditions:default": [],
    }),
    default_deps = [":gnulib/m4/stdio_h/defaults"],
    visibility = ["//visibility:private"],
    deps = [
        ":gnulib/m4/vsnprintf/gl_REPLACE_VSNPRINTF",
        ":gnulib/macros/AC_FUNC_SNPRINTF/AC_FUNC_SNPRINTF",
        "//autoconf/macros/AC_CHECK_INCLUDES_DEFAULT",
    ],
)

