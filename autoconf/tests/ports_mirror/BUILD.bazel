# //gnulib/m4/mktime:mktime
autoconf(
    name = "gnulib/m4/mktime/mktime",
    checks = select({
        # On Linux: __mktime_internal is not exported by glibc
        # mktime works correctly, but gnulib needs its internal version
        "@platforms//os:linux": [
            checks.AC_DEFINE("NEED_MKTIME_INTERNAL", "1"),
            # The shell variable gl_CONDITIONAL([GL_COND_OBJ_MKTIME], [... test
            # $WANT_MKTIME_INTERNAL = 1]) reads.
            checks.M4_VARIABLE("WANT_MKTIME_INTERNAL", "1"),
        ],
        "@platforms//os:macos": [
            # macOS mktime has timezone bugs that require gnulib replacement
            checks.AC_SUBST("REPLACE_MKTIME", "1"),
            checks.AC_DEFINE("NEED_MKTIME_INTERNAL", "1"),
            checks.AC_DEFINE("NEED_MKTIME_WORKING", "1"),
            checks.M4_VARIABLE("WANT_MKTIME_INTERNAL", "1"),
        ],
        "@platforms//os:windows": [
            checks.AC_CHECK_FUNC(
                "__mktime_internal",
                define = "HAVE_MKTIME_INTERNAL",
            ),
            checks.AC_SUBST("REPLACE_MKTIME", "1"),
            checks.AC_DEFINE("NEED_MKTIME_WINDOWS", "1"),
            # gl_cv_func_working_mktime is an AC_RUN_IFELSE whose outcome on
            # Windows depends on the machine (GitHub's runners report no, a
            # developer box with a DST time zone reports yes).  A Bazel probe
            # cannot run the program, so take the m4's own guess for
            # mingw*/windows* hosts: "guessing no" -> NEED_MKTIME_WORKING=1.
            checks.AC_DEFINE("NEED_MKTIME_WORKING", "1"),
            checks.AC_DEFINE(
                "mktime_internal",
                "__mktime_internal",
                requires = ["HAVE_MKTIME_INTERNAL==1"],
            ),
            # Upstream sets the shell variable WANT_MKTIME_INTERNAL=1 here and defines only
            # NEED_MKTIME_INTERNAL; the variable is the M4_VARIABLE below, not a define.
            checks.M4_VARIABLE(
                "WANT_MKTIME_INTERNAL",
                condition = "!HAVE_MKTIME_INTERNAL",
                if_false = "0",
                if_true = "1",
            ),
            checks.AC_DEFINE(
                "NEED_MKTIME_INTERNAL",
                "1",
                requires = ["!HAVE_MKTIME_INTERNAL"],
            ),
        ],
        "//conditions:default": [
            # If __mktime_internal is found, define mktime_internal as __mktime_internal
            # If not found, set WANT_MKTIME_INTERNAL=1 and define NEED_MKTIME_INTERNAL=1
            checks.AC_CHECK_FUNC(
                "__mktime_internal",
                define = "HAVE_MKTIME_INTERNAL",
            ),
            checks.AC_DEFINE(
                "mktime_internal",
                "__mktime_internal",
                requires = ["HAVE_MKTIME_INTERNAL==1"],
            ),
            # Upstream sets the shell variable WANT_MKTIME_INTERNAL=1 here and defines only
            # NEED_MKTIME_INTERNAL; the variable is the M4_VARIABLE below, not a define.
            checks.M4_VARIABLE(
                "WANT_MKTIME_INTERNAL",
                condition = "!HAVE_MKTIME_INTERNAL",
                if_false = "0",
                if_true = "1",
            ),
            checks.AC_DEFINE(
                "NEED_MKTIME_INTERNAL",
                "1",
                requires = ["!HAVE_MKTIME_INTERNAL"],
            ),
        ],
    }),
    default_deps = [":gnulib/m4/time_h/defaults"],
    visibility = ["//visibility:private"],
    deps = [":gnulib/m4/mktime/gl_FUNC_MKTIME_WORKS"],
)

