# //gnulib/m4/mbrtowc:gl_FUNC_MBRTOWC
autoconf(
    name = "gnulib/m4/mbrtowc/gl_FUNC_MBRTOWC",
    checks = select({
        # On Linux (glibc):
        #   gl_MBRTOWC_C_LOCALE → no (EILSEQ in C locale) → MBRTOWC_IN_C_LOCALE_MAYBE_EILSEQ
        #   (gl_MBRTOWC_EMPTY_INPUT passes natively on glibc 2.39)
        #   That alone triggers REPLACE_MBRTOWC=1
        "@platforms//os:linux": [
            checks.AC_SUBST("REPLACE_MBRTOWC", 1),
            checks.AC_DEFINE("MBRTOWC_IN_C_LOCALE_MAYBE_EILSEQ", "1"),
            # gl_MBRTOWC_EMPTY_INPUT only guesses "no" for glibc when cross
            # compiling; the native run on glibc 2.39 (Ubuntu CI) passes, so
            # MBRTOWC_EMPTY_INPUT_BUG stays undefined there, as GNU leaves it.
        ],
        # On native Windows (MSVC), the native run gives:
        #   gl_cv_func_mbrtowc_retval=no             -> MBRTOWC_RETVAL_BUG
        #   gl_cv_func_mbrtowc_stores_incomplete=yes -> MBRTOWC_STORES_INCOMPLETE_BUG
        #   gl_cv_func_mbrtowc_empty_input=no        -> MBRTOWC_EMPTY_INPUT_BUG
        #   gl_cv_func_mbrtowc_C_locale_sans_EILSEQ=yes, null_arg1=yes,
        #   nul_retval="guessing yes" (no suitable locale)
        # Each bug triggers REPLACE_MBRTOWC=1.
        "@platforms//os:windows": [
            checks.AC_SUBST("REPLACE_MBRTOWC", 1),
            checks.AC_DEFINE("MBRTOWC_RETVAL_BUG", "1"),
            checks.AC_DEFINE("MBRTOWC_STORES_INCOMPLETE_BUG", "1"),
            checks.AC_DEFINE("MBRTOWC_EMPTY_INPUT_BUG", "1"),
        ],
        # On macOS: all runtime checks pass → no bugs, no replacement needed.
        # The subst is still emitted so dependants (gl_FUNC_MBRLEN,
        # gl_FUNC_MBSRTOWCS, ...) can condition on REPLACE_MBRTOWC everywhere.
        "//conditions:default": [
            checks.AC_SUBST("REPLACE_MBRTOWC", 0),
        ],
    }),
    default_deps = [":gnulib/m4/wchar_h/defaults"],
    visibility = ["//visibility:private"],
    deps = [
        ":gnulib/m4/mbrtowc/gl_MBRTOWC_C_LOCALE",
