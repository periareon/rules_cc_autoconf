load("@rules_cc//cc:cc_test.bzl", "cc_test")
load("//autoconf:autoconf.bzl", "autoconf")
load("//autoconf:autoconf_hdr.bzl", "autoconf_hdr")
load("//autoconf:autoconf_linkopts.bzl", "autoconf_linkopts")
load("//autoconf:autoconf_package_info.bzl", "autoconf_package_info")
load("//autoconf:checks.bzl", "checks")
load("//autoconf/tests:diff_test.bzl", "diff_test")

# Regression test: per-check `linkopts` must reach the linker on MSVC.
# See CheckRunner::append_msvc_link_block for why they previously did not.
#
# CommandLineToArgvW is the discriminator. It lives in shell32.lib, which the
# MSVC toolchain does not link by default, so the probe can only succeed if
# /DEFAULTLIB:shell32.lib actually reaches the linker.

autoconf_package_info(
    name = "package",
    package_name = "test_linkopts_msvc",
    package_version = "1.0.0",
)

_PROBE_CODE = "int n; LPWSTR *argv = CommandLineToArgvW(L\"\", &n); (void)argv;"

_PROBE_INCLUDES = [
    "#include <windows.h>",
    "#include <shellapi.h>",
]

autoconf(
    name = "autoconf",
    checks = [
        # Positive: linkopts name the library that provides the symbol.
        # Resolves to 0 unless linkopts reach link.exe.
        checks.AC_TRY_LINK(
            code = _PROBE_CODE,
            define = "HAVE_COMMANDLINETOARGVW_WITH_LINKOPTS",
            includes = _PROBE_INCLUDES,
            linkopts = ["/DEFAULTLIB:shell32.lib"],
        ),
        # Negative control: the identical probe with no linkopts. This must
        # stay 0. If shell32.lib ever became a default library the positive
        # check above would pass for the wrong reason, and this catches that.
        checks.AC_TRY_LINK(
            code = _PROBE_CODE,
            define = "HAVE_COMMANDLINETOARGVW_NO_LINKOPTS",
            includes = _PROBE_INCLUDES,
        ),
        # AC_CHECK_LIB passes the library as a bare positional (shell32.lib),
        # which cl forwards to the linker on its own. This path was already
        # working; pin it so the /link change does not regress it.
        checks.AC_CHECK_LIB(
            "shell32",
            "CommandLineToArgvW",
            define = "HAVE_LIBSHELL32_COMMANDLINETOARGVW",
        ),
    ],
    deps = [":package"],
)

autoconf_hdr(
    name = "config",
    out = "config.h",
    template = "config.h.in",
    deps = [":autoconf"],
)

diff_test(
    name = "diff_test",
    file1 = "golden_config_windows.h.in",
    file2 = ":config.h",
    target_compatible_with = select({
        "//autoconf/tests:msvc_like": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
)

cc_test(
    name = "test_linkopts_msvc",
    srcs = [
        "test_linkopts_msvc.c",
        ":config.h",
    ],
    linkopts = ["-DEFAULTLIB:shell32.lib"],
    target_compatible_with = select({
        "//autoconf/tests:msvc_like": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
)

# Regression test: two `autoconf_linkopts` targets in one link.  On MSVC each
# compiles a pragma file into an object the binary links directly; the anchor
# variable in those objects is a pick-any COMDAT, else the link fails with
# LNK2005 (gawk's root and extension `linkopts` in one gawk.exe).  The vars
# need not resolve: the objects, and the collision, exist regardless.
autoconf_linkopts(
    name = "linkopts_first",
    vars = ["NO_SUCH_LINK_VAR"],
    deps = [":autoconf"],
)

autoconf_linkopts(
    name = "linkopts_second",
    vars = ["NO_SUCH_LINK_VAR"],
    deps = [":autoconf"],
)

cc_test(
    name = "test_two_linkopts_targets",
    srcs = ["test_two_linkopts_targets.c"],
    target_compatible_with = select({
        "//autoconf/tests:msvc_like": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [
        ":linkopts_first",
        ":linkopts_second",
    ],
)
