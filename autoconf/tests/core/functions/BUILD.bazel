load("@rules_cc//cc:cc_test.bzl", "cc_test")
load("//autoconf:autoconf.bzl", "autoconf")
load("//autoconf:autoconf_hdr.bzl", "autoconf_hdr")
load("//autoconf:autoconf_package_info.bzl", "autoconf_package_info")
load("//autoconf:checks.bzl", "checks")
load("//autoconf/tests:diff_test.bzl", "diff_test")
load("//autoconf/tests/gnu:conformance.bzl", "gnu_autoconf_conformance_test")

autoconf_package_info(
    name = "package",
    package_name = "test_functions",
    package_version = "1.0.0",
)

autoconf(
    name = "autoconf",
    checks = [
        checks.AC_CHECK_FUNC(
            "malloc",
            define = "HAVE_MALLOC",
        ),
        checks.AC_CHECK_FUNC(
            "free",
            define = "HAVE_FREE",
        ),
        # puts rather than printf: UCRT defines the printf family inline in
        # <stdio.h>, so autoconf's link probe (and this one) reports printf
        # absent on MSVC; puts is an exported symbol everywhere.
        checks.AC_CHECK_FUNC(
            "puts",
            define = "HAVE_PUTS",
        ),
        checks.AC_CHECK_FUNC(
            "strlen",
            define = "HAVE_STRLEN",
        ),
    ],
    deps = [":package"],
)

autoconf_hdr(
    name = "config",
    out = "config.h",
    template = "config.h.in",
    deps = [":autoconf"],
)

diff_test(
    name = "diff_test",
    file1 = "golden_config.h.in",
    file2 = ":config.h",
)

cc_test(
    name = "test_functions",
    srcs = [
        "test_functions.c",
        ":config.h",
    ],
)

gnu_autoconf_conformance_test(
    name = "gnu_autoconf_conformance_test",
    bazel_config_h = ":config",
    config_h_in = "config.h.in",
    configure_ac = "configure.ac",
)
