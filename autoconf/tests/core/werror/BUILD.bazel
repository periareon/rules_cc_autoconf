load("@rules_cc//cc:cc_test.bzl", "cc_test")
load("//autoconf:autoconf.bzl", "autoconf")
load("//autoconf:autoconf_hdr.bzl", "autoconf_hdr")
load("//autoconf:checks.bzl", "checks")
load(":copt_transition.bzl", "autoconf_with_copts")

# `-Werror` from the environment (the toolchain, `--copt`) is stripped from
# every probe: autoconf probes are loose code, and an injected `-Werror` would
# turn unrelated warnings into "no".  `-Werror` a target or check declares is
# the author's, and must reach the probe: configure scripts wrap probes in
# `-Werror` so that a construct the compiler only warns about (jemalloc's
# `format(gnu_printf)` under Apple clang) counts as unsupported.
#
# The probe's `#warning` is on by default in gcc and clang, so it compiles
# with a warning unless `-Werror` (or `-pedantic-errors`) reaches it.  The
# target cases depend on `check_copts`, whose probes are the same without the
# target's flags: they reuse its results if the target's flags ever drop out
# of the checks' identity.
NOT_MSVC = select({
    "//autoconf/tests:msvc_like": ["@platforms//:incompatible"],
    "//conditions:default": [],
})

WARNING_PROBE = """\
#warning "warning probe"
int main(void) {
    return 0;
}
"""

autoconf(
    name = "check_copts",
    checks = [
        checks.AC_TRY_COMPILE(
            name = "test_cv_warning_probe",
            code = WARNING_PROBE,
            define = "WARNING_PROBE_COMPILES",
        ),
        checks.AC_TRY_COMPILE(
            name = "test_cv_warning_probe_cxx",
            code = WARNING_PROBE,
            define = "WARNING_PROBE_COMPILES_CXX",
            language = "cpp",
        ),
        checks.AC_TRY_COMPILE(
            name = "test_cv_check_werror",
            code = WARNING_PROBE,
            copts = ["-Werror"],
            define = "CHECK_WERROR_COMPILES",
        ),
    ],
    target_compatible_with = NOT_MSVC,
)

autoconf(
    name = "command_line_impl",
    checks = [
        checks.AC_TRY_COMPILE(
            name = "test_cv_command_line_werror",
            code = "#ifndef COMMAND_LINE_COPT\n#error \"--copt did not reach the probe\"\n#endif\n" + WARNING_PROBE,
            define = "COMMAND_LINE_WERROR_COMPILES",
        ),
    ],
    target_compatible_with = NOT_MSVC,
)

autoconf_with_copts(
    name = "command_line",
    actual = ":command_line_impl",
    extra_copts = [
        "-DCOMMAND_LINE_COPT",
        "-Werror",
    ],
    target_compatible_with = NOT_MSVC,
)

autoconf(
    name = "target_copts",
    checks = [
        checks.AC_TRY_COMPILE(
            name = "test_cv_target_copts_werror",
            code = WARNING_PROBE,
            define = "TARGET_COPTS_WERROR_COMPILES",
        ),
        checks.AC_TRY_COMPILE(
            name = "test_cv_target_copts_werror_cxx",
            code = WARNING_PROBE,
            define = "TARGET_COPTS_WERROR_COMPILES_CXX",
            language = "cpp",
        ),
        checks.AC_TRY_COMPILE(
            name = "test_cv_target_copts_check_no_error",
            code = WARNING_PROBE,
            copts = ["-Wno-error"],
            define = "TARGET_COPTS_CHECK_NO_ERROR_COMPILES",
        ),
    ],
    copts = ["-Werror"],
    target_compatible_with = NOT_MSVC,
    deps = [":check_copts"],
)

# `-Werror=<name>` is filtered from the environment as well; `cpp` names the
# `#warning` diagnostic in gcc and clang.
autoconf(
    name = "target_copts_named",
    checks = [
        checks.AC_TRY_COMPILE(
            name = "test_cv_target_copts_named_werror",
            code = WARNING_PROBE,
            define = "TARGET_COPTS_NAMED_WERROR_COMPILES",
        ),
    ],
    copts = ["-Werror=cpp"],
    target_compatible_with = NOT_MSVC,
    deps = [":check_copts"],
)

autoconf(
    name = "target_conlyopts",
    checks = [
        checks.AC_TRY_COMPILE(
            name = "test_cv_target_conlyopts_werror",
            code = WARNING_PROBE,
            define = "TARGET_CONLYOPTS_WERROR_COMPILES",
        ),
        checks.AC_TRY_COMPILE(
            name = "test_cv_target_conlyopts_werror_cxx",
            code = WARNING_PROBE,
            define = "TARGET_CONLYOPTS_WERROR_COMPILES_CXX",
            language = "cpp",
        ),
    ],
    conlyopts = ["-Werror"],
    target_compatible_with = NOT_MSVC,
    deps = [":check_copts"],
)

autoconf(
    name = "target_cxxopts",
    checks = [
        checks.AC_TRY_COMPILE(
            name = "test_cv_target_cxxopts_werror_cxx",
            code = WARNING_PROBE,
            define = "TARGET_CXXOPTS_WERROR_COMPILES_CXX",
            language = "cpp",
        ),
        checks.AC_TRY_COMPILE(
            name = "test_cv_target_cxxopts_werror",
            code = WARNING_PROBE,
            define = "TARGET_CXXOPTS_WERROR_COMPILES",
        ),
    ],
    cxxopts = ["-Werror"],
    target_compatible_with = NOT_MSVC,
    deps = [":check_copts"],
)

autoconf_hdr(
    name = "config",
    out = "config.h",
    target_compatible_with = NOT_MSVC,
    template = "config.h.in",
    deps = [
        ":check_copts",
        ":command_line",
        ":target_conlyopts",
        ":target_copts",
        ":target_copts_named",
        ":target_cxxopts",
    ],
)

cc_test(
    name = "test_werror",
    srcs = [
        "test_werror.c",
        ":config.h",
    ],
    target_compatible_with = NOT_MSVC,
)
