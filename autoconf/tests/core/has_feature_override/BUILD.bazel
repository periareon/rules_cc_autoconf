load("@bazel_skylib//lib:selects.bzl", "selects")
load("@rules_cc//cc:cc_test.bzl", "cc_test")
load("//autoconf:autoconf.bzl", "autoconf")
load("//autoconf:autoconf_hdr.bzl", "autoconf_hdr")
load("//autoconf:checks.bzl", "checks")
load("//autoconf:package_info.bzl", "package_info")
load("//autoconf/tests:diff_test.bzl", "diff_test")

_RULE_COPTS_PROBE = """
#if !RULE_COPTS_TEST
#error "copts were not passed"
#endif
int main(void) { return 0; }
"""

_RULE_CXXOPTS_PROBE = """
#if !RULE_CXXOPTS_TEST
#error "cxxopts were not passed"
#endif
int main() { return 0; }
"""

_RULE_LINKOPTS_PROBE = """
#ifdef __cplusplus
extern "C"
#endif
int RULE_LINKOPTS_TEST(void);
int (*volatile rule_linkopts_pointer)(void) = RULE_LINKOPTS_TEST;
int main(void) { return rule_linkopts_pointer == main ? 0 : 1; }
"""

package_info(
    name = "package",
    package_name = "test_has_feature_override",
    package_version = "1.0.0",
)

autoconf(
    name = "transitive_options_check",
    checks = [
        checks.AC_TRY_COMPILE(
            code = _RULE_COPTS_PROBE,
            define = "HAVE_TRANSITIVE_COPTS",
        ),
        checks.AC_TRY_COMPILE(
            code = _RULE_CXXOPTS_PROBE,
            define = "HAVE_TRANSITIVE_CXXOPTS",
            language = "cpp",
        ),
    ] + selects.with_or({
        (
            "@platforms//os:linux",
            "@platforms//os:macos",
        ): [
            checks.AC_TRY_LINK(
                code = _RULE_LINKOPTS_PROBE,
                define = "HAVE_TRANSITIVE_LINKOPTS",
                language = "cpp",
            ),
        ],
        "//conditions:default": [
            checks.AC_DEFINE("HAVE_TRANSITIVE_LINKOPTS", 1),
        ],
    }),
)

autoconf(
    name = "autoconf",
    checks = [
        checks.AC_CHECK_HEADER(
            "stdio.h",
            define = "HAVE_STDIO_H",
        ),
        checks.AC_CHECK_HEADER(
            "stdlib.h",
            define = "HAVE_STDLIB_H",
        ),
        checks.AC_CHECK_HEADER(
            "string.h",
            define = "HAVE_STRING_H",
        ),
        # AC_TRY_COMPILE with per-check copts
        checks.AC_TRY_COMPILE(
            code = "int main(void) { return 0; }",
            copts = ["-DCOMPILE_COPTS_TEST=1"],
            define = "HAVE_COMPILE_COPTS",
        ),
        # AC_TRY_LINK with per-check copts and linkopts
        checks.AC_TRY_LINK(
            code = "int main(void) { return 0; }",
            copts = ["-DLINK_COPTS_TEST=1"],
            define = "HAVE_LINK_COPTS",
            linkopts = ["-lm"],
        ),
        # AC_TRY_COMPILE that should fail — the code references a macro
        # that is only defined via copts, proving copts are actually passed
        checks.AC_TRY_COMPILE(
            code = """
#if !COPTS_ACTUALLY_PASSED
#error "copts were not passed"
#endif
int main(void) { return 0; }
""",
            copts = ["-DCOPTS_ACTUALLY_PASSED=1"],
            define = "HAVE_COPTS_VERIFIED",
        ),
        checks.AC_TRY_COMPILE(
            code = _RULE_COPTS_PROBE,
            define = "HAVE_RULE_COPTS",
        ),
        checks.AC_TRY_COMPILE(
            code = _RULE_CXXOPTS_PROBE,
            define = "HAVE_RULE_CXXOPTS",
            language = "cpp",
        ),
    ] + selects.with_or({
        (
            "@platforms//os:linux",
            "@platforms//os:macos",
        ): [
            checks.AC_TRY_LINK(
                code = _RULE_LINKOPTS_PROBE,
                define = "HAVE_RULE_LINKOPTS",
            ),
        ],
        "//conditions:default": [
            checks.AC_DEFINE("HAVE_RULE_LINKOPTS", 1),
        ],
    }),
    # Pass flags containing shell metacharacters through copts. This
    # exercises the checker binary's shell quoting: parentheses, commas
    # inside parentheses, and nested expressions must remain intact.
    copts = [
        "-DRULE_COPTS_TEST=1",
        # Clang builtins redefined as function-like macros (the original bug report)
        "-D__has_feature(x)=0",
        "-D__has_builtin(x)=0",
        "-D__has_attribute(x)=0",
        "-D__has_extension(x)=0",
        "-D__has_include(x)=0",
        # Multi-arg function-like macro — commas inside parens
        "-DTEST_MULTI_ARG(a,b)=((a)+(b))",
    ],
    cxxopts = ["-DRULE_CXXOPTS_TEST=1"],
    linkopts = select({
        "@platforms//os:linux": [
            "-Wl,--defsym=RULE_LINKOPTS_TEST=main",
        ],
        "@platforms//os:macos": [
            "-Wl,-alias,_main,_RULE_LINKOPTS_TEST",
        ],
        "//conditions:default": [],
    }),
    deps = [
        ":package",
        ":transitive_options_check",
    ],
)

autoconf_hdr(
    name = "config",
    out = "config.h",
    template = "config.h.in",
    deps = [":autoconf"],
)

diff_test(
    name = "diff_test",
    file1 = "golden_config.h.in",
    file2 = ":config.h",
    target_compatible_with = select({
        "@platforms//os:windows": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
)

cc_test(
    name = "test_has_feature_override",
    srcs = [
        "test_has_feature_override.c",
        ":config.h",
    ],
    target_compatible_with = select({
        "@platforms//os:windows": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
)
