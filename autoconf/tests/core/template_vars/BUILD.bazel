load("@bazel_skylib//rules:common_settings.bzl", "int_flag", "string_flag")
load("@rules_cc//cc:cc_test.bzl", "cc_test")
load("//autoconf:autoconf_hdr.bzl", "autoconf_hdr")
load("//autoconf:autoconf_template_vars.bzl", "autoconf_template_vars")
load("//autoconf/tests:diff_test.bzl", "diff_test")
load(":transition.bzl", "transitioned_file")

# ppp's `--with-runtime-dir=DIR`: configure copies the value into PPPD_RUNTIME_DIR, the
# Makefile passes it as `-DPPPD_RUNTIME_DIR="..."` and pppd.pc reads `@PPPD_RUNTIME_DIR@`.
string_flag(
    name = "runtime_dir",
    build_setting_default = "/usr/local/var/run/pppd",
)

int_flag(
    name = "max_links",
    build_setting_default = 4,
)

autoconf_template_vars(
    name = "vars",
    vars = {
        "MAX_LINKS": ":max_links",
        "PPPD_RUNTIME_DIR": ":runtime_dir",
    },
)

# The substitution: `@VAR@` in a template, as from any check.
autoconf_hdr(
    name = "subst",
    out = "subst.h",
    mode = "subst",
    template = "subst.h.in",
    deps = [":vars"],
)

diff_test(
    name = "diff_test",
    file1 = "golden_subst.h",
    file2 = ":subst.h",
)

# The same under a transition that sets the flags: the header follows the setting.
transitioned_file(
    name = "subst_transitioned",
    actual = ":subst",
)

diff_test(
    name = "diff_test_transitioned",
    file1 = "golden_subst_transitioned.h",
    file2 = ":subst_transitioned",
)

# The make variable: a `-D` carrying the value, as the Makefile's CPPFLAGS did; the test
# compares it with the header's substitution.
cc_test(
    name = "test_template_vars",
    srcs = [
        "test_template_vars.c",
        ":subst.h",
    ],
    # Bazel tokenizes a define like a shell word: the C string's quotes are escaped, as a
    # Makefile's `-DX='"..."'` has them.
    local_defines = [
        "PPPD_RUNTIME_DIR=\\\"$(PPPD_RUNTIME_DIR)\\\"",
        "MAX_LINKS=$(MAX_LINKS)",
    ],
    toolchains = [":vars"],
)
