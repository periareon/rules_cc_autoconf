load("@rules_cc//cc:cc_test.bzl", "cc_test")
load("//autoconf:autoconf.bzl", "autoconf")
load("//autoconf:autoconf_hdr.bzl", "autoconf_hdr")
load("//autoconf:autoconf_package_info.bzl", "autoconf_package_info")
load("//autoconf:checks.bzl", "checks")

autoconf_package_info(
    name = "package",
    package_name = "test_alignof",
    package_version = "1.0.0",
)

autoconf(
    name = "autoconf",
    checks = [
        checks.AC_CHECK_ALIGNOF("char"),
        checks.AC_CHECK_ALIGNOF("int"),
        checks.AC_CHECK_ALIGNOF("double"),
    ],
    deps = [":package"],
)

autoconf_hdr(
    name = "config",
    out = "config.h",
    template = "config.h.in",
    deps = [":autoconf"],
)

# Note: alignof values are platform-dependent, so we only run cc_test
cc_test(
    name = "test_alignof",
    srcs = [
        "test_alignof.c",
        ":config.h",
    ],
)
