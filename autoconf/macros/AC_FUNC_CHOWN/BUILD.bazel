"""AC_FUNC_CHOWN - Autoconf builtin macro

Checks if chown() follows POSIX semantics.

Defines:
  - HAVE_CHOWN (if chown works correctly)
"""

load("//autoconf:autoconf_toolchain.bzl", autoconf = "autoconf_cache")
load("//autoconf:checks.bzl", "checks")

autoconf(
    name = "AC_FUNC_CHOWN",
    checks = [
        # GNU autoconf defines HAVE_CHOWN when chown exists and its run-time
        # test (chown of a file to the same owner succeeds) passes; the
        # run-time part is assumed to pass.
        checks.AC_CHECK_FUNC(
            "chown",
            define = "HAVE_CHOWN",
        ),
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//autoconf/macros/AC_CHECK_INCLUDES_DEFAULT",
    ],
)
