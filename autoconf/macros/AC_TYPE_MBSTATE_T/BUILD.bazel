"""AC_TYPE_MBSTATE_T - Autoconf builtin macro

Checks if mbstate_t type is defined.

Defines:
  - mbstate_t (if not defined, defined to int)
"""

load("//autoconf:autoconf_toolchain.bzl", autoconf = "autoconf_cache")
load("//autoconf:checks.bzl", "checks", "utils")

autoconf(
    name = "AC_TYPE_MBSTATE_T",
    checks = [
        # AC_CHECK_TYPE checks if mbstate_t is defined
        # mbstate_t is defined in wchar.h
        checks.AC_CHECK_TYPE(
            "mbstate_t",
            name = "ac_cv_type_mbstate_t",
            includes = [
                utils.AC_INCLUDES_DEFAULT,
                "#include <wchar.h>",
            ],
        ),
        checks.AC_DEFINE(
            "mbstate_t",
            "int",
            requires = ["!ac_cv_type_mbstate_t"],
        ),
        # Define HAVE_MBSTATE_T if type exists
        checks.AC_DEFINE(
            "HAVE_MBSTATE_T",
            requires = ["ac_cv_type_mbstate_t==1"],
        ),
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//autoconf/macros/AC_CHECK_INCLUDES_DEFAULT",
        "//autoconf/macros/AC_USE_SYSTEM_EXTENSIONS",
    ],
)
