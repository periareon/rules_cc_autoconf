"""https://github.com/coreutils/gnulib/blob/1039a5f2cee3cda1c11f64a5eb3a15b2e87cd2f0/m4/fstat.m4"""

load("//autoconf:autoconf_toolchain.bzl", autoconf = "autoconf_cache")
load("//autoconf:checks.bzl", "checks")

# m4/fstat.m4:9
autoconf(
    name = "gl_FUNC_FSTAT",
    checks = select({
        "@platforms//os:macos": [
            # REPLACE_FSTAT is assigned by the shell of the m4 (an AC_SUBST'd gnulib default)
            checks.AC_SUBST("REPLACE_FSTAT", 1),
        ],
        "@platforms//os:windows": [
            # REPLACE_FSTAT is assigned by the shell of the m4 (an AC_SUBST'd gnulib default)
            checks.AC_SUBST("REPLACE_FSTAT", 1),
        ],
        "//conditions:default": [
            # REPLACE_FSTAT is assigned by the shell of the m4 (an AC_SUBST'd gnulib default)
            checks.AC_SUBST(
                "REPLACE_FSTAT",
                1,
                requires = ["HAVE_FCHDIR==0 && !gl_cv_func_open_directory_works"],
            ),
        ],
    }),
    default_deps = [
        "//gnulib/m4/sys_stat_h:defaults",  # AC_REQUIRE([gl_SYS_STAT_H_DEFAULTS]) (the header's defaults)
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//autoconf/macros/AC_CANONICAL_HOST",  # AC_REQUIRE([AC_CANONICAL_HOST])
        "//gnulib/m4/fchdir:gl_TEST_FCHDIR",  # m4/fstat.m4:~25: gl_TEST_FCHDIR
    ],
)

# m4/fstat.m4:38
autoconf(
    name = "gl_PREREQ_FSTAT",
    visibility = ["//visibility:public"],
    deps = [
        "//gnulib/m4/stat:gl_PREREQ_STAT_W32",  # AC_REQUIRE([gl_PREREQ_STAT_W32])
        "//gnulib/m4/sys_stat_h:gl_SYS_STAT_H",  # AC_REQUIRE([gl_SYS_STAT_H])
    ],
)

autoconf(
    name = "fstat",
    visibility = ["//visibility:public"],
    deps = [
        ":gl_FUNC_FSTAT",
        ":gl_PREREQ_FSTAT",
    ],
)
