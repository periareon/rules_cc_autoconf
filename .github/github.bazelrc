# Bazel settings for use in Github CI

# Always display the flags being used
common --announce_rc

# Show errors in CI
test --test_output=errors

# Show more information about failures
build --verbose_failures

# UI for cleaner CI output
common --color=no
common --show_timestamps

# Show all failures
common --keep_going

# Use the BuildBuddy remote cache. The config is defined in each workspace's
# `.bazelrc`; credentials come from the home `.bazelrc` written by
# `.github/actions/buildbuddy`. Runs that cannot see secrets (e.g. pull
# requests from forks) fall back to a read-only key, or to no cache at all when
# none is configured.
common --config=remote_cache
common --build_metadata=ROLE=CI
